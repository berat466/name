[
  {
    "id": "C001",
    "name": "VTY uzerinde Telnet acik (acik metin yonetim)",
    "source": "Genel iyi uygulama: Cisco IOS sertlestirme. Kendi Cisco icerigine gore sayfa/bolum ekle.",
    "attack": "T1040",
    "severity": "high",
    "type": "config",
    "present_regex": "^\\s*transport input .*telnet",
    "actions": [
      "alert"
    ],
    "tests": [
      {
        "lines": [
          "line vty 0 4",
          " transport input telnet ssh"
        ],
        "expect_alert": true
      },
      {
        "lines": [
          "line vty 0 4",
          " transport input ssh"
        ],
        "expect_alert": false
      }
    ]
  },
  {
    "id": "C002",
    "name": "service password-encryption kapali",
    "source": "Genel iyi uygulama: Cisco IOS sertlestirme. Kendi Cisco icerigine gore sayfa/bolum ekle.",
    "attack": "T1552",
    "severity": "medium",
    "type": "config",
