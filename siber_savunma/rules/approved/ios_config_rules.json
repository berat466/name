      "alert"
    ],
    "tests": [
      {
        "lines": [
          "hostname R1"
        ],
        "expect_alert": true
      },
      {
        "lines": [
          "service password-encryption"
        ],
        "expect_alert": false
      }
    ]
  },
  {
    "id": "C003",
    "name": "SNMP varsayilan community (public/private)",
    "source": "Genel iyi uygulama: Cisco IOS sertlestirme. Kendi Cisco icerigine gore sayfa/bolum ekle.",
    "attack": "T1602",
    "severity": "high",
    "type": "config",
    "present_regex": "^snmp-server community (public|private)\\b",
    "actions": [
      "alert"
    ],
    "tests": [
      {
        "lines": [
          "snmp-server community public RO"
        ],
        "expect_alert": true
      },
      {
        "lines": [
          "snmp-server community Xk9!aQ2 RO"
        ],
        "expect_alert": false
      }
    ]
  },
  {
