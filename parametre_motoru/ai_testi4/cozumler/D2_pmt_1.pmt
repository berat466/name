sablon rec adet 4000
  alan g rastgele 0 19 1
  alan v rastgele -1000 1000 2
  alan w rastgele 1 10 3
  alan idx dogrusal 0 1
  alan vw sabit 0
  alan u sabit 0
  alan bin sabit 0
  alan rank sabit 0
  alan big sabit 0
  kural vw = v * w
  kural u = v + 1000
  kural bin = u * 16
  kural bin = bin / 2001
son

sablon rec2 adet 4000
  alan v rastgele -1000 1000 2
  alan idx dogrusal 0 1
son

sablon grp adet 20
  alan gid dogrusal 0 1
  alan sv sabit 0
  alan cn sabit 0
  alan sw sabit 0
  alan swv sabit 0
  alan avg sabit 0
  alan rank sabit 0
son

sablon grq adet 20
  alan gid dogrusal 0 1
  alan sv sabit 0
son

sablon dum adet 1
  alan z sabit 0
son

sablon win adet 3993
  alan tt dogrusal 0 1
  alan ws sabit 0
son

; grup toplamlari
etkilesim grp rec eger a.gid == b.g
  kural a.sv = a.sv + b.v
  kural a.cn = a.cn + 1
  kural a.sw = a.sw + b.w
  kural a.swv = a.swv + b.vw
son
etkilesim grq rec eger a.gid == b.g
  kural a.sv = a.sv + b.v
son
etkilesim grp dum
  kural a.avg = a.swv / a.sw
son
; grup siralamasi (sv azalan, esitlikte kucuk no once)
etkilesim grp grq eger b.sv > a.sv
  kural a.rank = a.rank + 1
son
etkilesim grp grq eger b.sv == a.sv ve b.gid < a.gid
  kural a.rank = a.rank + 1
son
; kayit siralamasi (v azalan, esitlikte kucuk indeks once)
etkilesim rec rec2 eger b.v > a.v
  kural a.rank = a.rank + 1
son
etkilesim rec rec2 eger b.v == a.v ve b.idx < a.idx
  kural a.rank = a.rank + 1
son
; 8'li pencere toplamlari
etkilesim win rec eger b.idx >= a.tt ve b.idx <= a.tt + 7
  kural a.ws = a.ws + b.v
son
; grup agirlikli ortalamasindan buyuk v
etkilesim rec grp eger a.g == b.gid ve a.v > b.avg
  kural a.big = 1
son

