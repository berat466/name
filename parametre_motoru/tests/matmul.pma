; 3x3 tamsayi matris carpimi (satir-oncelikli)
data A = 1,2,3, 4,5,6, 7,8,9
data B = 9,8,7, 6,5,4, 3,2,1
space C 9
func main() {
    mov i, 0
li: lt  c, i, 3
    jz  c, end
    mov j, 0
lj: lt  c, j, 3
    jz  c, nexti
    mov k, 0
    mov s, 0
lk: lt  c, k, 3
    jz  c, store
    mul ia, i, 3
    add ia, ia, k
    add pa, A, ia
    ld  a, pa, 0
    mul kb, k, 3
    add kb, kb, j
    add pb, B, kb
    ld  b, pb, 0
    mul t, a, b
    add s, s, t
    add k, k, 1
    jmp lk
store:
    mul ic, i, 3
    add ic, ic, j
    add pc, C, ic
    st  s, pc, 0
    host puti, s
    host putc, 32
    add j, j, 1
    jmp lj
nexti:
    host putc, 10
    add i, i, 1
    jmp li
end:
}
