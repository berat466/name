; Eratosthenes: 100, 1000, 10000 altindaki asal sayisi (bellek: space)
memory 20000
space flags 10001
func count(n) {
    mov i, 0
z:  gt  c, i, n
    jnz c, zd
    add p, flags, i
    st  1, p, 0
    add i, i, 1
    jmp z
zd: st  0, flags, 0
    st  0, flags, 1
    mov i, 2
o:  mul sq, i, i
    ge  c, sq, n
    gt  c2, sq, n
    jnz c2, od
    add p, flags, i
    ld  f, p, 0
    jz  f, on
    mov j, sq
in: gt  c, j, n
    jnz c, on
    add p, flags, j
    st  0, p, 0
    add j, j, i
    jmp in
on: add i, i, 1
    jmp o
od: mov k, 0
    mov cnt, 0
cl: gt  c, k, n
    jnz c, cd
    add p, flags, k
    ld  f, p, 0
    add cnt, cnt, f
    add k, k, 1
    jmp cl
cd: ret cnt
}
func main() {
    call a, count, 99
    host puti, a
    host putc, 10
    call b, count, 999
    host puti, b
    host putc, 10
    call c, count, 9999
    host puti, c
    host putc, 10
}
