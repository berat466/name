; string: yazdir, uzunluk, yerinde ters cevir
data msg = "Merhaba, motor!\n", 0
data word = "stressed", 0
func strlen(p) {
    mov i, 0
l:  add q, p, i
    ld  c, q, 0
    jz  c, d
    add i, i, 1
    jmp l
d:  ret i
}
func print(p) {
l:  ld  c, p, 0
    jz  c, d
    host putc, c
    add p, p, 1
    jmp l
d:  ret 0
}
func reverse(p) {
    call n, strlen, p
    mov lo, 0
    sub hi, n, 1
l:  lt  c, lo, hi
    jz  c, d
    add a, p, lo
    add b, p, hi
    ld  x, a, 0
    ld  y, b, 0
    st  y, a, 0
    st  x, b, 0
    add lo, lo, 1
    sub hi, hi, 1
    jmp l
d:  ret 0
}
func main() {
    call z, print, msg
    call n, strlen, msg
    host puti, n
    host putc, 10
    call z, reverse, word
    call z, print, word
    host putc, 10
}
