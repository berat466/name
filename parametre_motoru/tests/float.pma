; ondalik: Newton karekok, fsqrt, Leibniz pi, donusumler, sifira bolme
func main() {
    mov x, 1.0
    mov i, 0
l:  lt  c, i, 30
    jz  c, d
    fdiv q, 2.0, x
    fadd s, x, q
    fmul x, s, 0.5
    add i, i, 1
    jmp l
d:  host putf, x
    host putc, 10
    fsqrt y, 2.0
    host putf, y
    host putc, 10
    mov k, 0
    mov sign, 1.0
    mov sum, 0.0
pl: lt  c, k, 1000000
    jz  c, pd
    mul m, k, 2
    add m, m, 1
    i2f den, m
    fdiv t, sign, den
    fadd sum, sum, t
    fneg sign, sign
    add k, k, 1
    jmp pl
pd: fmul pi, sum, 4.0
    host putf, pi
    host putc, 10
    f2i a, 3.99
    f2i b, -3.99
    f2i c2, 1.0e30
    host puti, a
    host putc, 32
    host puti, b
    host putc, 32
    host puti, c2
    host putc, 10
    fdiv inf, 1.0, 0.0
    fsub nan, inf, inf
    f2i dn, nan
    host puti, dn
    host putc, 32
    host putf, inf
    host putc, 10
    flt lt1, 1.5, 2.5
    fgt gt1, 1.5, 2.5
    fle le1, 2.5, 2.5
    host puti, lt1
    host puti, gt1
    host puti, le1
    host putc, 10
}
