; cagri penceresi sadelestirmeleri icin tehlikeli desenler
func dbl(x) {
    mul r, x, 2
    ret r
}
func inc(x) {
    add r, x, 1
    ret r
}
func g(x) {
    add r, x, 1000
    ret r
}
func mix(a, b, c) {
    mul t1, a, 100
    mul t2, b, 10
    add t3, t1, t2
    add t4, t3, c
    ret t4
}
func ack(m, n) {
    jnz m, mpos
    add r, n, 1
    ret r
mpos:
    jnz n, npos
    sub m1, m, 1
    call r, ack, m1, 1
    ret r
npos:
    sub n1, n, 1
    call t, ack, m, n1
    sub m1, m, 1
    call r, ack, m1, t
    ret r
}
func early(c) {
    jz c, zero
    ret 7
zero:
    ret 0
}
func main() {
    mov a, 4
    mov b, 5
    add t1, a, 1
    add t2, b, 2
    call r1, mix, t1, t2, a
    host puti, r1
    host putc, 10
    add t, a, 1
    call q1, dbl, t
    call q2, dbl, t
    add u, q1, q2
    host puti, u
    host putc, 10
    add v, a, 3
    call z, g, 5
    call r2, dbl, v
    host puti, r2
    host putc, 10
    mov c, 1
    add w, a, 10
    jz c, join
join:
    call r3, dbl, w
    host puti, r3
    host putc, 10
    mov c, 0
    add w2, a, 20
    jz c, join2
join2:
    call r4, dbl, w2
    host puti, r4
    host putc, 10
    call i1, inc, 1
    call i2, inc, i1
    call i3, inc, i2
    host puti, i3
    host putc, 10
    call ign, g, 1
    call ign2, inc, 100
    host putc, 'k'
    host putc, 10
    mov i, 0
    mov s, 0
loop:
    add tt, i, 1
    call rr, dbl, tt
    add s, s, rr
    add i, i, 1
    lt cc, i, 5
    jnz cc, loop
    host puti, s
    host putc, 10
    call ak, ack, 2, 3
    host puti, ak
    host putc, 10
    call e1, early, 1
    call e0, early, 0
    host puti, e1
    host putc, 32
    host puti, e0
    host putc, 10
}
