; kabarcik siralamasi
data arr = 5, 3, 9, 1, 7, 2, 8, 4, 6, 0
func main() {
    mov n, 10
    mov i, 0
outer:
    sub lim, n, 1
    lt  c, i, lim
    jz  c, show
    mov j, 0
inner:
    sub lim2, n, 1
    sub lim2, lim2, i
    lt  c, j, lim2
    jz  c, onext
    add p, arr, j
    ld  a, p, 0
    ld  b, p, 1
    gt  g, a, b
    jz  g, noswap
    st  b, p, 0
    st  a, p, 1
noswap:
    add j, j, 1
    jmp inner
onext:
    add i, i, 1
    jmp outer
show:
    mov k, 0
pl: lt  c, k, n
    jz  c, end
    add p, arr, k
    ld  a, p, 0
    host puti, a
    host putc, 32
    add k, k, 1
    jmp pl
end:
    host putc, 10
}
