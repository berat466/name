; Pong: raket tus girdisiyle (1 = sola, 2 = saga) hareket eder; top duvarlardan ve raketten seker; 400 kare.
; Girdi, ana bilgisayarin verdigi olay kuyrugundan (poll) gelir; uygulama yalnizca parametre dosyasidir.
memory 20000
space fb 4800

func clear() {
    mov i, 0
l:  lt  c, i, 4800
    jz  c, d
    add p, fb, i
    st  0, p, 0
    add i, i, 1
    jmp l
d:  ret 0
}

func rect(x, y, w, h, col) {
    mov yy, 0
ly: lt  c, yy, h
    jz  c, done
    mov xx, 0
lx: lt  c, xx, w
    jz  c, nexty
    add px, x, xx
    add py, y, yy
    lt  t, px, 0
    jnz t, skip
    ge  t, px, 80
    jnz t, skip
    lt  t, py, 0
    jnz t, skip
    ge  t, py, 60
    jnz t, skip
    mul k, py, 80
    add k, k, px
    add p, fb, k
    st  col, p, 0
skip:
    add xx, xx, 1
    jmp lx
nexty:
    add yy, yy, 1
    jmp ly
done:
    ret 0
}

func main() {
    mov px, 33
    mov bx, 10
    mov by, 10
    mov vx, 1
    mov vy, 1
    mov score, 0
    mov f, 0
fl: lt  c, f, 400
    jz  c, fin
ev: host e, poll
    jz  e, mv
    and key, e, 255
    eq  t, key, 1
    jz  t, notl
    sub px, px, 3
    jmp ev
notl:
    eq  t, key, 2
    jz  t, ev
    add px, px, 3
    jmp ev
mv: lt  t, px, 0
    jz  t, c1
    mov px, 0
c1: gt  t, px, 66
    jz  t, c2
    mov px, 66
c2: add bx, bx, vx
    add by, by, vy
    lt  t, bx, 0
    jz  t, w1
    mov bx, 0
    sub vx, 0, vx
w1: ge  t, bx, 80
    jz  t, w2
    mov bx, 79
    sub vx, 0, vx
w2: lt  t, by, 0
    jz  t, w3
    mov by, 0
    sub vy, 0, vy
w3: lt  t, by, 55
    jnz t, draw
    gt  t, vy, 0
    jz  t, draw
    sub lo, px, 1
    add hi, px, 14
    lt  t, bx, lo
    jnz t, miss
    gt  t, bx, hi
    jnz t, miss
    sub vy, 0, vy
    mov by, 55
    add score, score, 1
    jmp draw
miss:
    sub score, score, 1
    mov bx, 40
    mov by, 10
    mov vx, 1
    mov vy, 1
draw:
    call z, clear
    call z, rect, px, 56, 14, 2, 0x40C0FF
    call z, rect, bx, by, 2, 2, 0xFFFF00
    mul len, score, 2
    call z, rect, 0, 0, len, 2, 0x00FF00
    host r, present, fb, 80, 60
    jnz r, fin
    add f, f, 1
    jmp fl
fin:
    host puti, score
    host putc, 32
    host puti, px
    host putc, 32
    host puti, bx
    host putc, 32
    host puti, by
    host putc, 10
    ret 0
}
