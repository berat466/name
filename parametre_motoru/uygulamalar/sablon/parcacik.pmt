; 10.000 parcacik: TEK sablon, ornek sayisindan bagimsiz tanim. Konum/hiz/renk rastgele ureteclerden gelir.
ekle std.pmt
sahne 160 120
kare 120
arkaplan 0x000010
global g = 1

sablon parcacik adet 10000
  alan x rastgele 0 159 1
  alan y rastgele 0 60 2
  alan vy rastgele 1 3 3
  alan renk rastgele 4210752 16777215 4
  davran yercekimi vy g
  davran hareket y vy
  ; zemine carpinca yukari seker ve enerjisinin 3/4'unu korur
  kural vy = 0 - vy eger y > 119
  kural vy = vy * 3 eger y > 119
  kural vy = vy / 4 eger y > 119
  kural y = 119 eger y > 119
  ciz nokta x, y, renk
son
