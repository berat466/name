memory 1100000
space arr 1000000
func main() {
    mov i, 0
f:  lt  c, i, 1000000
    jz  c, fd
    add p, arr, i
    st  i, p, 0
    add i, i, 1
    jmp f
fd: mov r, 0
    mov s, 0
rl: lt  c, r, 50
    jz  c, done
    mov i, 0
sl: lt  c, i, 1000000
    jz  c, sd
    add p, arr, i
    ld  v, p, 0
    add s, s, v
    add i, i, 1
    jmp sl
sd: add r, r, 1
    jmp rl
done:
    host puti, s
    host putc, 10
}
