; 640x480 kare (307200 sozcuk): hash ve PPM/ASCII yollari
memory 400000
func main() {
    mov i, 0
lp: gei z, i, 307200
    jnz z, d
    modi x, i, 640
    divi y, i, 640
    shli r, x, 16
    muli g, y, 3
    andi g, g, 255
    shli g, g, 8
    add b, x, y
    andi b, b, 255
    or v, r, g
    or v, v, b
    addi a, i, 10
    st v, a, 0
    addi i, i, 1
    jmp lp
d:  host r, present, 10, 640, 480
    host puti, r
    ret 0
}
entry main
