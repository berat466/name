; uc piksel degerleri: 0, 0xFFFFFF, tek kanal, bitisik; 16x16 degisen kare, ascii esigi (0x80) siniri
memory 4000
func main() {
    mov k, 0
kl: mov i, 0
il: gei z, i, 256
    jnz z, id
    add v, i, k
    andi c1, v, 255
    muli c2, v, 7
    andi c2, c2, 255
    muli c3, v, 13
    andi c3, c3, 255
    shli c1, c1, 16
    shli c2, c2, 8
    or v, c1, c2
    or v, v, c3
    eqi z, i, 0
    jz z, s1
    mov v, 0
s1: eqi z, i, 1
    jz z, s2
    mov v, 16777215
s2: eqi z, i, 2
    jz z, s3
    mov v, 128
s3: eqi z, i, 3
    jz z, s4
    mov v, 127
s4: eqi z, i, 4
    jz z, s5
    mov v, 32768
s5: eqi z, i, 5
    jz z, s6
    mov v, 8323072
s6: eqi z, i, 6
    jz z, s7
    mov v, 8355711
s7: addi a, i, 1
    st v, a, 0
    addi i, i, 1
    jmp il
id: host r, present, 1, 16, 16
    addi k, k, 1
    lti z, k, 5
    jnz z, kl
    ret 0
}
entry main
