; farkli boyutlu kareler (son kare PPM/ASCII): 24 bit ustu bitler maskelenmeli
memory 3000
func dolgu(p, n, s) {
    mov i, 0
lp: ge z, i, n
    jnz z, d
    muli v, i, 2654435
    add v, v, s
    shli t, i, 33
    or v, v, t
    shli t, s, 40
    or v, v, t
    add a, p, i
    st v, a, 0
    addi i, i, 1
    jmp lp
d:  ret 0
}
func main() {
    call x, dolgu, 1, 16, 1
    host r, present, 1, 4, 4
    host puti, r
    call x, dolgu, 100, 16, 3
    host r, present, 100, 8, 2
    host puti, r
    call x, dolgu, 200, 1, 77
    host r, present, 200, 1, 1
    host puti, r
    call x, dolgu, 10, 1500, 5
    host r, present, 10, 50, 30
    host puti, r
    call x, dolgu, 10, 2000, 9
    host r, present, 10, 40, 50
    host puti, r
    host putc, 10
    host f, frame
    host puti, f
    ret 0
}
entry main
