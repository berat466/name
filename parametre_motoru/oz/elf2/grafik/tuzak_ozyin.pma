; kirli yigin: derin ozyineleme bellek yazmaclarini doldurur, sonra sinirsiz ozyineleme tuzagi; once kareler sunulur
memory 1000
func ic(n) {
    addi a, n, 1
    addi b, a, 11
    addi c, b, 13
    addi d, c, 17
    mov e, 99999
    mov f, 88888
    lti z, n, 40
    jnz z, k
    ret 0
k:  call x, ic, a
    ret x
}
func sonsuz(n) {
    addi a, n, 1
    addi b, a, 5
    mov c, 77777
    call x, sonsuz, a
    ret x
}
func main() {
    mov i, 0
    st i, i, 1
    host r, present, 1, 4, 4
    call x, ic, 0
    mov v, 12345
    st v, i, 3
    host r, present, 1, 4, 4
    call x, sonsuz, 0
    ret 0
}
entry main
