    mov s, 46
    call x, mark, s
    call x, etpl, @TS_TRAP_FUEL@
    mov s, 50
    call x, mark, s
    ld ur, G, 47
    jz ur, ex0
    call x, etpl, @TS_EXITC_RT@
    jmp ex1
ex0: call x, etpl, @TS_EXITC@
ex1:
    mov s, 36
    call x, mark, s
    call x, blob, PUTIB, 82
    mov s, 37
    call x, mark, s
