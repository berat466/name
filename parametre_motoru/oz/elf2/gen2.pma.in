}

; RT durum blogu goruntusu (bellegin altindaki RT bolgesinin ilk 64 + 2*olay sozcugu)
func rtimg() {
    ld v, G, 4
    call x, eb64, v
    mov z0, 0
    call x, eb64, z0
    mov v, -3750763034362895579
    call x, eb64, v
    call x, eb64, z0
    call x, eb64, z0
    call x, eb64, z0
    call x, eb64, z0
    call x, eb64, z0
    ld v, G, 54
    call x, eb64, v
    ld v, G, 55
    call x, eb64, v
    ld v, G, 56
    call x, eb64, v
    ld nev, G, 57
    call x, eb64, nev
    mov v, 1099511628211
    call x, eb64, v
    mov v, -3750763034362895579
    call x, eb64, v
    mov i, 14
ri: ge z, i, 64
    jnz z, rid
    call x, eb64, z0
    addi i, i, 1
    jmp ri
rid: mov i, 0
    shli nw, nev, 1
re: ge z, i, nw
    jnz z, red
    add a, i, EV
    ld v, a, 0
    call x, eb64, v
    addi i, i, 1
    jmp re
red: ret 0
}

func main() {
