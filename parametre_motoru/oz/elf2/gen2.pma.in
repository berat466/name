    sub t, h, @H_PRESENT@
    add t, t, @RTF_PRESENT@
    add t, t, na
    st t, G, 20
    mov op, @OP_CALL@
    jmp noh
hpv: mov op, @TS_HOST_SYSW@
    jmp noh
hn: add op, h, @TS_HOST_PUTC@
noh:
    jz pv, nopv
    eq z, op, @OP_LD@
    jz z, pv1
    mov op, @TS_LDP@
    jmp nb
pv1: eq z, op, @OP_ST@
    jz z, pv2
    mov op, @TS_STP@
    jmp nb
pv2: eq z, op, @OP_CALL@
    jz z, nb
    ld t, G, 20
    add t, t, na
    st t, G, 20
    mov op, @TS_CALL_P@
    jmp nb
nopv:
nb:
    st gi, G, 59
    call x, emitop, op
    add gi, gi, 1
    jmp ei
eid:
    add f, f, 1
    jmp ef
efd:
    mov s, 30
