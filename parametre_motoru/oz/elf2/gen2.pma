    jnz z, sr1
    lei z, h, 6
    jz z, sr1
srh: ret 1
sr1: addi i, i, 1
    jmp sr
srn: ret 0
}

; RTL (rt.pma listesi) ayricalikli fonksiyon olarak ekle: belirteclerini T'ye kopyala, imleci oraya al
func loadrt(napp, gi) {
    ld nt, G, 0
    ld nr, RTLN, 0
    add e, nt, nr
    gt z, e, 524288
    jz z, lr0
    call x, fail
lr0: mov i, 0
lr: ge z, i, nr
    jnz z, lrd
    add a, i, RTL
    ld v, a, 0
    add b, nt, i
    add b, b, T
    st v, b, 0
    addi i, i, 1
    jmp lr
lrd: st e, G, 0
    addi c, nt, 6
    st c, G, 1
    call nrt, nx
    add f1, napp, nrt
    call gi2, pfuncs, napp, f1, gi
    st f1, G, 11
    ret gi2
}

func parse() {
    ld nt0, G, 0
    jnz nt0, pf0
    call x, fail
pf0: call x, options
    call fl, nx
