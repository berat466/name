    mov s, 46
    call x, mark, s
    call x, etpl, 73
    mov s, 50
    call x, mark, s
    ld ur, G, 47
    jz ur, ex0
    call x, etpl, 79
    jmp ex1
ex0: call x, etpl, 78
ex1:
    mov s, 36
