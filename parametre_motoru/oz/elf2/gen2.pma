pi: ge z, pc, ncode
    jnz z, pid
    ge z, gi, 524288
    jz z, q2
    call x, fail
q2: call op, nx
    ge z, op, 55
    jz z, q3
    call x, fail
q3: add a, gi, OPS
    st op, a, 0
    add a, op, NOPS
    ld nops, a, 0
    mov j, 0
pj: ge z, j, nops
    jnz z, pjd
    call v, nx
    jnz j, pj1
    add a, gi, OA
    st v, a, 0
    jmp pj3
pj1: eq z, j, 1
    jz z, pj2
    add a, gi, OB
    st v, a, 0
    jmp pj3
pj2: add a, gi, OC
    st v, a, 0
pj3: add j, j, 1
    jmp pj
pjd:
    add pc, pc, 1
    add gi, gi, 1
    jmp pi
pid:
    add f, f, 1
    jmp pf
pfd:
    ret gi
}

; uygulamada putf (host 2) ya da present/poll/frame (host 4..6) var mi?
func scanrt(n) {
    mov i, 0
sr: ge z, i, n
    jnz z, srn
    add a, i, OPS
    ld op, a, 0
    eqi z, op, 40
    jz z, sr1
    add a, i, OA
