bd: ret 0
}

func mark(slot) {
    ld p, G, 2
    add t, slot, G
    st p, t, 0
    ret 0
}

; host komutu (G[20] = host kimligi) -> uretilecek komut: ozel host sablonu, calisma zamani islevine CALL (G[20] islev indeksine cevrilir) ya da ayricalikli sistem yazisi
