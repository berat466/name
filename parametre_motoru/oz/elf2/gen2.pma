    st mem, G, 4
    call en, nx
    st en, G, 5
    call nc, nx
    st nc, G, 6
    ld c, G, 1
    st c, G, 7
    add c, c, nc
    st c, G, 1
    call nd, nx
    st nd, G, 8
    ld c, G, 1
    st c, G, 9
    add c, c, nd
    st c, G, 1
    call bss, nx
    st bss, G, 10
    call nf, nx
    gt z, nf, 65500
    jz z, q1
    call x, fail
q1: st nf, G, 11
    st nf, G, 45
    mov z0, 0
    call gi, pfuncs, z0, nf, z0
    st gi, G, 12
    jz fl, pend
    mov f, 0
pn: ge z, f, nf
    jnz z, pend
    call len, nx
    ld c, G, 1
    add c, c, len
    st c, G, 1
    add f, f, 1
    jmp pn
pend:
    call u, scanrt, gi
    ld fg, G, 56
    jz fg, nfg
    mov u, 1
nfg:
    st u, G, 47
    jz u, pdone
    mov rw, 65536
    st rw, G, 48
    ld m, G, 4
    st m, G, 49
    call gi2, loadrt, nf, gi
    st gi2, G, 12
pdone:
    ret 0
}

; ---------- cikti ----------
func eb(x) {
    ld p, G, 2
    add p, p, 1
    st p, G, 2
    ld ps, G, 3
    eq z, ps, 2
    jz z, e1
    host putc, x
e1: ret 0
}

func eb32(v) {
    and t, v, 255
    call x, eb, t
    shr t, v, 8
    and t, t, 255
    call x, eb, t
    shr t, v, 16
    and t, t, 255
    call x, eb, t
    shr t, v, 24
    and t, t, 255
    call x, eb, t
    ret 0
}

func eb64(v) {
    call x, eb32, v
    shr h, v, 32
    call x, eb32, h
    ret 0
}

