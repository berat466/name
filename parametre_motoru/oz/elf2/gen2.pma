    sub r, r, 4
    call x, eb32, r
    ret 0
k3: ld c, G, 22
    and c, c, 63
    call x, eb, c
    ret 0
}

; sablon idx'i yaz; yoksa (-1) desteklenmiyor
func etpl(idx) {
    add t, idx, TPLS
    ld s, t, 0
    ge z, s, 0
    jnz z, e1
    call x, fail
e1: add t, s, TPL
    ld tok, t, 0
    eq z, tok, -1
    jnz z, ed
    call x, etok, tok
    add s, s, 1
    jmp e1
ed: ret 0
}

func blob(base, n) {
    mov i, 0
bl: ge z, i, n
    jnz z, bd
    add t, base, i
    ld v, t, 0
    call x, eb, v
    add i, i, 1
    jmp bl
bd: ret 0
}

func mark(slot) {
    ld p, G, 2
    add t, slot, G
    st p, t, 0
    ret 0
}

func emit_all() {
