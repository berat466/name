    jz z, lw1
    ret 0
lw1: addi i, i, 1
    jmp lw
lwd: ret 1
}

; komut sablonu: yerlesik x86 sablonu varsa o (-6 1 ise ve SEM sablonlanabiliyorsa mikro-islemlerden), yoksa SEM'den
