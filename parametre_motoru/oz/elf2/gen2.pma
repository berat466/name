data SEMDAT = 1 1 1 0 0 4 0 1 0 0 2 1 1 0 0 4 0 1 0 0 3 1 1 0 0 4 0 1 0 0 1 1 1 0 0 1 2 2 0 0 5 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 6 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 7 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 22 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 23 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 8 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 9 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 10 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 11 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 12 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 13 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 14 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 15 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 16 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 17 3 1 2 0 4 0 3 0 0 1 1 1 0 0 20 2 1 0 0 4 0 2 0 0 1 1 1 0 0 21 2 1 0 0 4 0 2 0 0 1 1 1 0 0 1 2 2 0 0 36 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 37 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 38 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 39 3 1 2 0 4 0 3 0 0 1 1 1 0 0 40 2 1 0 0 4 0 2 0 0 1 1 1 0 0 41 2 1 0 0 4 0 2 0 0 1 1 1 0 0 1 2 2 0 0 42 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 43 3 1 2 0 4 0 3 0 0 1 1 1 0 0 1 2 2 0 0 44 3 1 2 0 4 0 3 0 0 1 1 1 0 0 45 2 1 0 0 4 0 2 0 0 1 1 1 0 0 46 2 1 0 0 4 0 2 0 0 28 0 0 0 0 1 1 0 0 0 29 1 1 0 0 1 1 0 0 0 30 1 1 0 0 31 0 1 0 0 1 1 0 0 0 32 1 0 0 0 33 0 0 0 0 1 1 1 0 0 26 2 1 2 0 4 0 2 0 0 1 1 0 0 0 1 2 1 0 0 27 1 2 2 0 1 1 1 0 0 35 2 1 0 0 4 0 2 0 0 34 0 1 0 0 1 1 1 0 0 2 2 2 0 0 5 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 7 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 8 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 11 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 12 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 13 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 24 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 25 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 14 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 15 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 16 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 17 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 18 3 1 2 0 4 0 3 0 0 1 1 1 0 0 2 2 2 0 0 19 3 1 2 0 4 0 3 0 0

; G: 0 NT  1 imlec  2 KONUM  3 GECIS  4 bellek  5 giris  6 nsabit  7 sabit tabani  8 nveri  9 veri tabani  10 bss  11 nfonk  12 toplam komut
;    20 a  21 b  22 c  23 fonksiyon taban komutu  24 gecerli fonksiyon
;    30 EXIT0  31..35 tuzaklar(DIV0 OOB STACK DEPTH ALLOC)  36 PUTI  37 PUTC  38 MESAJLAR  39 SABITLER  40 VERI  41 DOSYA SONU (dosya konumlari)
;    42 yazmac yigini adresi  43 bellek adresi (sanal)

func fail() {
    mov z, 0
    div x, 1, z
    ret 0
}

; ---------- girdi ----------
func put(nt, ng, val) {
    ge e, nt, 524288
    jz e, p1
    call x, fail
p1: jz ng, p2
    neg val, val
p2: add a, nt, T
    st val, a, 0
    ret 0
}

func readall() {
    mov nt, 0
    mov inn, 0
    mov ng, 0
    mov val, 0
loop:
    host ch, getc
    lt e, ch, 0
    jnz e, eof
    le w, ch, 32
    jnz w, ws
    jnz inn, started
    mov inn, 1
    mov ng, 0
    mov val, 0
started:
    eq o, ch, 45
    jz o, dig
    mov ng, 1
    jmp loop
dig:
    sub d, ch, 48
    mul val, val, 10
    add val, val, d
    jmp loop
ws:
    jz inn, loop
    call x, put, nt, ng, val
    add nt, nt, 1
    mov inn, 0
    jmp loop
eof:
    jz inn, done
    call x, put, nt, ng, val
    add nt, nt, 1
done:
    st nt, G, 0
    ret nt
}

func nx() {
    ld c, G, 1
    ld n, G, 0
    ge e, c, n
    jz e, n1
    call x, fail
n1: add a, c, T
    ld v, a, 0
    add c, c, 1
    st c, G, 1
    ret v
}

; secenekler (stdin on eki): -1 yakit | -2 n (kare kod)*n olaylar | -3 azami_kare | -4 ascii_K | -5 bayrak (1 rapor, 2 PPM)
;   -6 k: k=1 sablonu olan komutlar da SEM (sayisal anlam) tanimindan, mikro-islem sablonlariyla uretilir (sablonsuz komutlar her zaman)
func options() {
    mov fu, 4000000000
    st fu, G, 44
op0: ld c, G, 1
    ld n, G, 0
    ge z, c, n
    jnz z, opd
    add t, c, T
    ld tk, t, 0
    gei z, tk, 0
    jnz z, opd
    call x, nx
    eqi z, tk, -1
    jz z, op2
    call v, nx
    st v, G, 44
    jmp op0
op2: eqi z, tk, -2
    jz z, op3
    call cnt, nx
    gti z, cnt, 30000
