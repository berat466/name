; RT durum blogu goruntusu (bellegin altindaki RT bolgesinin ilk 64 + 2*olay sozcugu)
func rtimg() {
    ld v, G, 4
    call x, eb64, v
    mov z0, 0
    call x, eb64, z0
    mov v, -3750763034362895579
    call x, eb64, v
