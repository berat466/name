ed: ret 0
}

; komutun SEM mikro-programi: her ornek [islem, f0..f3]; sablon yuvasi = TS_PRIM0 + islem
func emit_micro(op) {
    add t, op, SEMOFF
    ld lo, t, 0
    ld hi, t, 1
    mov i, lo
em: ge z, i, hi
    jnz z, emd
    mul b, i, 5
    add b, b, SEMDAT
