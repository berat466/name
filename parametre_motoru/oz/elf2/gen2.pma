    jnz z, rid
    call x, eb64, z0
    addi i, i, 1
    jmp ri
rid: mov i, 0
    shli nw, nev, 1
re: ge z, i, nw
    jnz z, red
    add a, i, EV
    ld v, a, 0
    call x, eb64, v
    addi i, i, 1
    jmp re
red: ret 0
}

func main() {
