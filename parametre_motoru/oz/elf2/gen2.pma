    ret 0
bes: call bk, isbackop, op
    jz bk, ep
    add t, op, OPBACK
    ld sl, t, 0
    lti z, sl, 0
    jz z, bes2
    call x, fail
bes2: call x, etpl, sl
    ret 0
ep: call x, etpl, op
    ret 0
}

func blob(base, n) {
