; gen2.pma -- PMB1 listesi -> bagimsiz Linux x86-64 ELF URETICISI (parametre tablosu; sablonlar veridir: sablon.txt -> TPL/TPLS).
; stdin: pm liste bicimi; stdout: ELF64. Desteklenen: tamsayi ALU, karsilastirma, atlama, CAGRI/RET (cok fonksiyon, pencereli yazmaclar),
;   ld/st (sinir denetimli), alloc, host putc/puti/getc, tuzaklar DIV0/OOB/STACK/DEPTH/ALLOC (stderr "TRAP: AD", cikis 2).
; Desteklenmeyen: kayan nokta, present/poll/frame/putf; yakit siniri YOK. Desteklenmeyen girdi -> DIV0 tuzagi (cikis 2), stdout bos.
; Guvenilen (dogrulanmis) tablolar icin: islenen indeksleri denetlenmez (oz/dogr/valid.pmb once calistirilmali: oz/boru.sh).
; Iki gecis: 1) boyutlar/konumlar (cikti yok), 2) gercek cikti (ayni sablonlar, ayni boyutlar).
memory 4194304
entry main
space T 524288
space OPS 524288
space OA 524288
space OB 524288
space OC 524288
space OFF 524288
space FBASE 65536
space FNP 65536
space FNR 65536
space G 64
space EV 65536
