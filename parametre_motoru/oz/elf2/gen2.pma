    st v, G, 62
    ld v, b, 4
    st v, G, 63
    addi s, pid, 81
    call x, etpl, s
    addi i, i, 1
    jmp em
emd: ret 0
}

; SEM'deki her mikro-islemin sablonu var mi (1/0); bos program (HALT gibi) icin 0
func lowerable(op) {
    add t, op, SEMOFF
