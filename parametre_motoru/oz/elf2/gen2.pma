data RTL = 0 16 0 0 0 0 10 0 1 2 1 0 0 35 0 3 20 80 1 3 -65536 37 4 3 0 32 1 78 32 2 78 51 5 1 0 33 5 78 51 5 2 0 33 5 78 53 5 1 4096 33 5 78 53 5 2 4096 33 5 78 32 0 78 51 5 0 0 33 5 78 16 5 4 0 33 5 78 5 6 1 2 4 7 4 0 16 5 7 6 33 5 78 38 1 3 4 38 2 3 5 37 8 3 12 37 9 3 13 43 10 1 255 10 9 9 10 5 9 9 8 45 11 1 8 43 10 11 255 10 9 9 10 5 9 9 8 43 10 2 255 10 9 9 10 5 9 9 8 45 11 2 8 43 10 11 255 10 9 9 10 5 9 9 8 1 12 0 17 5 6 12 33 5 60 3 13 0 12 37 14 13 0 43 14 14 16777215 3 13 4 12 38 14 13 0 43 10 14 255 10 9 9 10 5 9 9 8 45 11 14 8 43 10 11 255 10 9 9 10 5 9 9 8 45 11 14 16 43 10 11 255 10 9 9 10 5 9 9 8 41 12 12 1 31 40 38 9 3 3 37 15 3 2 10 15 15 9 5 15 15 8 38 15 3 2 37 16 3 1 41 16 16 1 38 16 3 1 37 17 3 7 33 17 76 37 18 3 8 32 18 74 17 5 18 16 33 5 76 1 19 0 35 19 1 19 1 35 19 1 19 -1 35 19 0 12 20 1 0 -65536 37 1 0 6 37 2 0 11 17 3 2 1 33 3 18 44 4 1 1 3 5 0 4 37 6 5 64 37 7 0 1 16 3 7 6 33 3 18 37 8 5 65 41 1 1 1 38 1 0 6 1 9 1 44 10 9 32 9 10 10 8 35 10 1 11 0 35 11 0 3 3 1 0 -65536 37 1 0 1 35 1 0 32 153 1 0 -65536 37 1 0 10 43 2 1 1 32 2 65 1 3 2 38 3 0 15 1 28 101 1 29 107 1 30 114 1 31 97 34 7 28 1 28 110 1 29 58 1 30 32 1 31 107 34 7 28 1 28 97 1 29 114 1 30 101 1 31 61 34 7 28 37 28 0 1 34 8 28 1 28 32 1 29 98 1 30 111 1 31 121 34 7 28 1 28 117 1 29 116 1 30 61 1 31 0 34 7 28 37 6 0 4 0 28 6 34 8 28 1 28 120 34 5 28 37 7 0 5 0 28 7 34 8 28 1 28 32 1 29 122 1 30 105 1 31 110 34 7 28 1 28 99 1 29 105 1 30 114 1 31 61 34 7 28 37 28 0 2 34 9 28 1 28 32 1 29 115 1 30 111 1 31 110 34 7 28 1 28 61 34 5 28 37 28 0 3 34 9 28 1 28 10 34 5 28 34 6 28 37 6 0 4 32 6 151 37 7 0 5 37 10 0 0 5 11 6 7 37 1 0 10 43 12 1 2 32 12 109 1 13 3 38 13 0 15 1 28 80 1 29 54 1 30 10 1 31 0 34 7 28 0 28 6 34 8 28 1 28 32 34 5 28 0 28 7 34 8 28 1 28 10 1 29 50 1 30 53 1 31 53 34 7 28 1 28 10 34 5 28 1 14 0 17 15 11 14 33 15 108 3 16 10 14 37 17 16 0 45 18 17 16 0 28 18 34 5 28 45 18 17 8 0 28 18 34 5 28 0 28 17 34 5 28 41 14 14 1 31 94 34 6 28 37 19 0 9 32 19 151 51 15 19 0 33 15 151 1 20 1 38 20 0 15 1 21 0 17 15 7 21 33 15 150 1 22 0 17 15 6 22 33 15 146 5 18 21 6 3 18 18 22 3 18 18 10 0 16 18 37 17 16 0 45 23 17 16 43 23 23 255 45 24 17 8 43 24 24 255 43 25 17 255 0 26 23 17 15 24 26 33 15 135 0 26 24 17 15 25 26 33 15 138 0 26 25 1 27 46 51 15 26 128 33 15 142 1 27 35 0 28 27 34 5 28 3 22 22 19 31 119 1 28 10 34 5 28 3 21 21 19 31 116 34 6 28 1 28 0 35 28 1 12 21 1 1 -65536 37 2 1 14 45 3 2 3 43 4 2 7 44 4 4 3 43 5 0 255 11 6 5 4 3 7 1 3 33 4 11 38 6 7 61440 31 14 37 8 7 61440 9 6 6 8 38 6 7 61440 41 2 2 1 38 2 1 14 51 9 2 32768 33 9 19 34 6 11 1 11 0 35 11 0 9 11 1 0 -65536 37 1 0 14 32 1 9 37 6 0 15 1 7 -4096 0 8 1 40 4 6 1 5 0 38 5 0 14 1 6 0 35 6 4 6 14 32 0 3 0 5 0 34 5 5 32 1 6 0 5 1 34 5 5 32 2 9 0 5 2 34 5 5 32 3 12 0 5 3 34 5 5 1 5 0 35 5 1 10 19 1 1 -65536 1 2 0 47 3 0 10 42 4 3 10 4 5 0 4 41 5 5 48 3 6 1 2 38 5 6 16 41 2 2 1 0 0 3 33 0 2 32 2 17 41 2 2 -1 3 6 1 2 37 9 6 16 34 5 9 31 11 1 9 0 35 9 1 9 17 1 1 15 51 2 1 0 33 2 15 44 3 1 2 12 4 0 3 43 5 4 15 51 2 5 10 32 2 10 41 6 5 48 31 11 41 6 5 87 0 8 6 34 5 8 41 1 1 -1 31 1 1 8 0 35 8
data RTLN = 1182

; G: 0 NT  1 imlec  2 KONUM  3 GECIS  4 bellek  5 giris  6 nsabit  7 sabit tabani  8 nveri  9 veri tabani  10 bss  11 nfonk  12 toplam komut
;    20 a  21 b  22 c  23 fonksiyon taban komutu  24 gecerli fonksiyon
;    30 EXIT0  31..35 tuzaklar(DIV0 OOB STACK DEPTH ALLOC)  36 PUTI  37 PUTC  38 MESAJLAR  39 SABITLER  40 VERI  41 DOSYA SONU (dosya konumlari)
;    42 yazmac yigini adresi  43 bellek adresi (sanal)

func fail() {
    mov z, 0
    div x, 1, z
    ret 0
}

; ---------- girdi ----------
func put(nt, ng, val) {
    ge e, nt, 524288
    jz e, p1
    call x, fail
p1: jz ng, p2
    neg val, val
p2: add a, nt, T
    st val, a, 0
    ret 0
}

func readall() {
    mov nt, 0
    mov inn, 0
    mov ng, 0
    mov val, 0
loop:
    host ch, getc
    lt e, ch, 0
    jnz e, eof
    le w, ch, 32
    jnz w, ws
    jnz inn, started
    mov inn, 1
    mov ng, 0
    mov val, 0
started:
    eq o, ch, 45
    jz o, dig
    mov ng, 1
    jmp loop
dig:
    sub d, ch, 48
    mul val, val, 10
    add val, val, d
    jmp loop
ws:
    jz inn, loop
    call x, put, nt, ng, val
    add nt, nt, 1
    mov inn, 0
    jmp loop
eof:
    jz inn, done
    call x, put, nt, ng, val
    add nt, nt, 1
done:
    st nt, G, 0
    ret nt
}

func nx() {
    ld c, G, 1
    ld n, G, 0
    ge e, c, n
    jz e, n1
    call x, fail
n1: add a, c, T
    ld v, a, 0
    add c, c, 1
    st c, G, 1
    ret v
}

; secenekler (stdin on eki): -1 yakit | -2 n (kare kod)*n olaylar | -3 azami_kare | -4 ascii_K | -5 bayrak (1 rapor, 2 PPM)
func options() {
    mov fu, 4000000000
    st fu, G, 44
op0: ld c, G, 1
    ld n, G, 0
    ge z, c, n
    jnz z, opd
    add t, c, T
    ld tk, t, 0
    gei z, tk, 0
    jnz z, opd
    call x, nx
    eqi z, tk, -1
    jz z, op2
    call v, nx
    st v, G, 44
    jmp op0
op2: eqi z, tk, -2
    jz z, op3
    call cnt, nx
    gti z, cnt, 30000
    jz z, op2a
    call x, fail
op2a: st cnt, G, 57
    mov i, 0
op2l: ge z, i, cnt
    jnz z, op0
    call k, nx
    call cd, nx
    shli t, i, 1
    add a, t, EV
    st k, a, 0
    st cd, a, 1
    addi i, i, 1
    jmp op2l
op3: eqi z, tk, -3
    jz z, op4
    call v, nx
    st v, G, 54
    jmp op0
op4: eqi z, tk, -4
    jz z, op5
    call v, nx
    st v, G, 55
    jmp op0
op5: eqi z, tk, -5
    jz z, op6
    call v, nx
    st v, G, 56
    jmp op0
op6: call x, fail
opd: ret 0
}

; [f0,f1) fonksiyonlarini oku (gi: ilk komut dizini); yeni gi dondurur
func pfuncs(f0, f1, gi) {
    mov f, f0
pf: ge z, f, f1
    jnz z, pfd
    call np, nx
    call nr, nx
    call ncode, nx
    add a, f, FBASE
    st gi, a, 0
    add a, f, FNP
    st np, a, 0
    add a, f, FNR
    st nr, a, 0
    mov pc, 0
pi: ge z, pc, ncode
    jnz z, pid
    ge z, gi, 524288
    jz z, q2
    call x, fail
q2: call op, nx
    ge z, op, 55
    jz z, q3
    call x, fail
q3: add a, gi, OPS
    st op, a, 0
    add a, op, NOPS
    ld nops, a, 0
    mov j, 0
pj: ge z, j, nops
    jnz z, pjd
    call v, nx
    jnz j, pj1
    add a, gi, OA
    st v, a, 0
    jmp pj3
pj1: eq z, j, 1
    jz z, pj2
    add a, gi, OB
    st v, a, 0
    jmp pj3
pj2: add a, gi, OC
    st v, a, 0
pj3: add j, j, 1
    jmp pj
pjd:
    add pc, pc, 1
    add gi, gi, 1
    jmp pi
pid:
    add f, f, 1
    jmp pf
pfd:
    ret gi
}

; uygulamada present/poll/frame (host 4..6) var mi?
func scanrt(n) {
    mov i, 0
sr: ge z, i, n
    jnz z, srn
    add a, i, OPS
    ld op, a, 0
    eqi z, op, 40
    jz z, sr1
    add a, i, OA
    ld h, a, 0
    lti z, h, 4
    jnz z, sr1
    lei z, h, 6
    jz z, sr1
    ret 1
sr1: addi i, i, 1
    jmp sr
srn: ret 0
}

; RTL (rt.pma listesi) ayricalikli fonksiyon olarak ekle: belirteclerini T'ye kopyala, imleci oraya al
func loadrt(napp, gi) {
    ld nt, G, 0
    ld nr, RTLN, 0
    add e, nt, nr
    gt z, e, 524288
    jz z, lr0
    call x, fail
lr0: mov i, 0
lr: ge z, i, nr
    jnz z, lrd
    add a, i, RTL
    ld v, a, 0
    add b, nt, i
    add b, b, T
    st v, b, 0
    addi i, i, 1
    jmp lr
lrd: st e, G, 0
    addi c, nt, 6
    st c, G, 1
    call nrt, nx
    add f1, napp, nrt
    call gi2, pfuncs, napp, f1, gi
    st f1, G, 11
    ret gi2
}

func parse() {
    ld nt0, G, 0
    jnz nt0, pf0
    call x, fail
pf0: call x, options
    call fl, nx
    call mem, nx
    st mem, G, 4
    call en, nx
    st en, G, 5
    call nc, nx
    st nc, G, 6
    ld c, G, 1
    st c, G, 7
    add c, c, nc
    st c, G, 1
    call nd, nx
    st nd, G, 8
    ld c, G, 1
    st c, G, 9
    add c, c, nd
    st c, G, 1
    call bss, nx
    st bss, G, 10
    call nf, nx
    gt z, nf, 65500
    jz z, q1
    call x, fail
q1: st nf, G, 11
    st nf, G, 45
    mov z0, 0
    call gi, pfuncs, z0, nf, z0
    st gi, G, 12
    jz fl, pend
    mov f, 0
pn: ge z, f, nf
    jnz z, pend
    call len, nx
    ld c, G, 1
    add c, c, len
    st c, G, 1
    add f, f, 1
    jmp pn
pend:
    call u, scanrt, gi
    ld fg, G, 56
    jz fg, nfg
    mov u, 1
nfg:
    st u, G, 47
    jz u, pdone
    mov rw, 65536
    st rw, G, 48
    ld m, G, 4
    st m, G, 49
    call gi2, loadrt, nf, gi
    st gi2, G, 12
pdone:
    ret 0
}

; ---------- cikti ----------
func eb(x) {
    ld p, G, 2
    add p, p, 1
    st p, G, 2
    ld ps, G, 3
    eq z, ps, 2
    jz z, e1
    host putc, x
e1: ret 0
}

func eb32(v) {
    and t, v, 255
    call x, eb, t
    shr t, v, 8
    and t, t, 255
    call x, eb, t
    shr t, v, 16
    and t, t, 255
    call x, eb, t
    shr t, v, 24
    and t, t, 255
    call x, eb, t
    ret 0
}

func eb64(v) {
    call x, eb32, v
    shr h, v, 32
    call x, eb32, h
    ret 0
}

; imm32 simgesi (k = simge-256) degeri
func val32(k) {
    ld a, G, 20
    ld b, G, 21
    ld c, G, 22
    eq z, k, 0
    jz z, v1
    mul r, a, 8
    ret r
v1: eq z, k, 1
    jz z, v2
    mul r, b, 8
    ret r
v2: eq z, k, 2
    jz z, v3
    mul r, c, 8
    ret r
v3: eq z, k, 3
    jz z, v4
    ret a
v4: eq z, k, 4
    jz z, v5
    ret b
v5: eq z, k, 5
    jz z, v6
    ret c
v6: eq z, k, 6
    jz z, v7
    ld t, G, 39
    mul r, b, 8
    add r, r, t
    add r, r, 4194304
    ret r
v7: eq z, k, 7
    jz z, v8
    ld r, G, 4
    ret r
v8: eq z, k, 8
    jz z, v9
    ld r, G, 43
    ret r
v9: eq z, k, 9
    jz z, v10
    add t, a, FNR
    ld r, t, 0
    mul r, r, 8
    ret r
v10: eq z, k, 10
    jz z, v11
    add t, a, FNP
    ld r, t, 0
    mul r, r, 8
    ret r
v11: eq z, k, 11
    jz z, v12
    add t, a, FNR
    ld r, t, 0
    add t, a, FNP
    ld s, t, 0
    sub r, r, s
    ret r
v12: lt z, k, 12
    jnz z, v17
    gt z, k, 16
    jnz z, v17
    sub t, k, 12
    add t, t, MSGOFF
    ld r, t, 0
    ld s, G, 38
    add r, r, s
    add r, r, 4194304
    ret r
v17: eq z, k, 17
    jz z, v18
    ld r, G, 42
    ret r
v18: eq z, k, 18
    jz z, v19
    ld r, G, 53
    ret r
v19: eq z, k, 19
    jz z, v20
    ld nd, G, 8
    ld bs, G, 10
    add r, nd, bs
    add r, r, 1
    ret r
v20: eq z, k, 20
    jz z, v21
    ld r, G, 40
    add r, r, 4194304
    ret r
v21: eq z, k, 21
    jz z, v22
    ld r, G, 8
    ret r
v22: eq z, k, 22
    jz z, v23
    ret 4194424
v23: eq z, k, 23
    jz z, v24
    ld r, G, 41
    ret r
v24: eq z, k, 24
    jz z, v25
    ld r, G, 53
    ld m, G, 4
    ld fc, G, 49
    add m, m, fc
    mul m, m, 8
    add r, r, m
    sub r, r, 4194304
    ret r
v25: eq z, k, 25
    jz z, v26
    ld r, G, 44
    ret r
v26: eq z, k, 26
    jz z, v27
    ld r, G, 38
    add r, r, 57
    add r, r, 4194304
    ret r
v27: eq z, k, 27
    jz z, v28
    ld r, G, 48
    ld m, G, 4
    add r, r, m
    ld fc, G, 49
    add r, r, fc
    ret r
v28: eq z, k, 28
    jz z, v29
    ld r, G, 48
    ret r
v29: eq z, k, 29
    jz z, v30
    ld r, G, 48
    mul r, r, -8
    ret r
v30: eq z, k, 30
    jz z, v31
    ld r, G, 43
    sub r, r, 32768
    ret r
v31: eq z, k, 31
    jz z, v32
    add r, b, 1
    mul r, r, 8
    ret r
v32: eq z, k, 32
    jz z, v33
    add r, b, 2
    mul r, r, 8
    ret r
v33: eq z, k, 33
    jz z, v34
    ld r, G, 51
    add r, r, 4194304
    ret r
v34: ld r, G, 57
    shli r, r, 1
    add r, r, 64
    ret r
}

; bagil hedef simgesi (k = simge-300): dosya konumu
func target(k) {
    ld a, G, 20
    ld b, G, 21
    ld fb, G, 23
    eq z, k, 12
    jz z, tk1
    ld r, G, 46
    ret r
tk1: eq z, k, 13
    jz z, tk2
    ld r, G, 50
    ret r
tk2: eq z, k, 14
    jz z, tk0
    ld nap, G, 45
