; islev simgeleri (tur 6..10): alan fv'nin gosterdigi OPERAND DEGERI bir islev indeksidir (komutun call mikro-islemi); tur 6 FREL (girise bagil 32 bit), 7 FNR8 (yazmac sayisi*8),
;   8 FNP8 (parametre sayisi*8), 9 FCNT (yerel yazmac sayisi = yazmac - parametre), 10 HOSTSP (host mikro-islemi: hostmap ile secilen ozel host sablonu ya da calisma zamani CALL'u)
func etok_fn(ty, fv) {
    gei z, fv, 3
    jz z, f1
    call x, fail
f1: add t, fv, 20
    add t, t, G
    ld fn, t, 0
    eqi z, ty, 6
    jz z, f2
    add t, fn, FBASE
    ld t, t, 0
    add t, t, OFF
    ld r, t, 0
    ld p, G, 2
    sub r, r, p
    sub r, r, 4
    call x, eb32, r
    ret 0
f2: eqi z, ty, 7
    jz z, f3
    add t, fn, FNR
    ld r, t, 0
    mul r, r, 8
    call x, eb32, r
    ret 0
f3: eqi z, ty, 8
    jz z, f4
    add t, fn, FNP
    ld r, t, 0
    mul r, r, 8
    call x, eb32, r
    ret 0
f4: eqi z, ty, 9
    jz z, f5
    add t, fn, FNR
    ld r, t, 0
    add t, fn, FNP
    ld q, t, 0
    sub r, r, q
    call x, eb32, r
    ret 0
f5: eqi z, ty, 10
    jz z, f6
    ; HOSTSP: host mikro-islemi -- alan 0 host kimligi operandi (yuva 0), alan 1 pencere tabani (yuva 1) olmali (ozel host sablonlari R_B kullanir)
    jnz fv, f6
    ld sl, G, 61
    eqi z, sl, 1
    jz z, f6
    ld sa, G, 20
    call op2, hostmap
    call x, emitop, op2
    st sa, G, 20
    ret 0
f6: call x, fail
    ret 0
}

func etok(tok) {
    lt z, tok, 256
    jz z, k1
    call x, eb, tok
    ret 0
k1: lt z, tok, 300
    jz z, k2
    sub k, tok, 256
    call v, val32, k
    call x, eb32, v
    ret 0
k2: lt z, tok, 320
    jz z, k3
    sub k, tok, 300
    call t, target, k
    ld p, G, 2
    sub r, t, p
    sub r, r, 4
    call x, eb32, r
    ret 0
k3: lt z, tok, 400
    jz z, k4
    ld c, G, 22
    and c, c, 63
    call x, eb, c
    ret 0
    ; mikro-islem simgeleri (400+): tur = (tok-400)/4: 0 TMP bayti, 1 OPR (8*operand), 2 OPV (operand), 3 KAD (sabit adresi), 4 LIT (alan); k = alan sirasi
k4: sub d, tok, 400
    shri ty, d, 2
    and k, d, 3
    addi t, k, 60
    add t, t, G
    ld fv, t, 0
    eqi z, ty, 12
    jz z, kt13
    ; MARK_Fk: o anki cikti konumunu sakla (mikro-program dongusu basi)
    ld p, G, 2
    st p, G, 70
    ret 0
kt13: eqi z, ty, 13
    jz z, kt14
    ; RELM_Fk: kayitli konuma bagil 32 bit (geri atlama)
    ld p, G, 2
    ld t, G, 70
    sub r, t, p
    sub r, r, 4
    call x, eb32, r
    ret 0
kt14: eqi z, ty, 14
    jz z, kt11
    ; SCR_Fk: kazima sozcugu fv: yigin isaretcisinin 144+8*fv bayt altinda
    mul r, fv, 8
    add r, r, 144
    neg r, r
    call x, eb32, r
    ret 0
kt11: eqi z, ty, 11
    jz z, k4m
    ; OPW_Fk: alan k operand yuvasi (fv) + alan k+1 literal sozcuk indeksi -> 8 * (operand + n) (genis operandin n. sozcugu)
    add t, fv, 20
    add t, t, G
    ld o, t, 0
    addi t, k, 61
    add t, t, G
    ld nn, t, 0
    add o, o, nn
    mul r, o, 8
    call x, eb32, r
    ret 0
k4m: gei z, ty, 6
    jz z, k4n
    call x, etok_fn, ty, fv
    ret 0
k4n: eqi z, ty, 5
    jz z, k4a
    ; REL_TFk: alani fv olan operandin gosterdigi komuta bagil 32 bit hedef
    gei z, fv, 3
    jz z, k4b
    call x, fail
k4b: add t, fv, 20
    add t, t, G
    ld o, t, 0
    ld fb, G, 23
    add t, fb, o
    add t, t, OFF
    ld r2, t, 0
    ld p, G, 2
    sub r2, r2, p
    sub r2, r2, 4
    call x, eb32, r2
    ret 0
k4a: jnz ty, k5
    mul r, fv, -8
    and r, r, 255
    call x, eb, r
    ret 0
k5: eqi z, ty, 4
    jz z, k6
    call x, eb32, fv
    ret 0
k6: gei z, fv, 3
    jz z, k7
    call x, fail
k7: add t, fv, 20
    add t, t, G
    ld o, t, 0
    eqi z, ty, 1
    jz z, k8
    mul r, o, 8
    call x, eb32, r
    ret 0
k8: eqi z, ty, 2
    jz z, k9
    call x, eb32, o
    ret 0
k9: ld t, G, 39
    mul r, o, 8
    add r, r, t
    add r, r, 4194304
    call x, eb32, r
    ret 0
}

; sablon idx'i yaz; yoksa (-1) desteklenmiyor
func etpl(idx) {
    add t, idx, TPLS
    ld s, t, 0
    ge z, s, 0
    jnz z, e1
    call x, fail
e1: add t, s, TPL
    ld tok, t, 0
    eq z, tok, -1
    jnz z, ed
    call x, etok, tok
    add s, s, 1
    jmp e1
ed: ret 0
}

; komutun SEM mikro-programi: her ornek [islem, f0..f3]; sablon yuvasi = TS_PRIM0 + islem
func emit_micro(op) {
    call bk, isbackop, op
    add t, op, SEMOFF
    ld lo, t, 0
    ld hi, t, 1
    mov i, lo
em: ge z, i, hi
    jnz z, emd
    mul b, i, 5
    add b, b, SEMDAT
    ld pid, b, 0
    ld v, b, 1
    st v, G, 60
    ld v, b, 2
    st v, G, 61
    ld v, b, 3
    st v, G, 62
    ld v, b, 4
    st v, G, 63
    addi s, pid, 371
    jz bk, emp
    add t, pid, PRCLS
    ld cl, t, 0
    eqi z, cl, 2
    jz z, emp
    add t, pid, PBACK
    ld s, t, 0
emp: call x, etpl, s
    addi i, i, 1
    jmp em
emd: ret 0
}

; SEM'deki her mikro-islemin sablonu var mi (1/0); bos program (HALT gibi) icin 0
func lowerable(op) {
    add t, op, SEMOFF
    ld lo, t, 0
    ld hi, t, 1
    ge z, lo, hi
    jz z, lw0
    ret 0
lw0: mov i, lo
lw: ge z, i, hi
    jnz z, lwd
    mul b, i, 5
    add b, b, SEMDAT
    ld pid, b, 0
    addi s, pid, 371
    add t, s, TPLS
    ld v, t, 0
    lti z, v, 0
    jz z, lw1
    ret 0
lw1: add t, pid, PRCLS
    ld cl, t, 0
    eqi z, cl, 2
    jz z, lw2
    add t, pid, PBACK
    ld sl, t, 0
    lti z, sl, 0
    jz z, lw2
    ret 0
lw2: addi i, i, 1
    jmp lw
lwd: ret 1
}

; komut geri atlama mi (yakit denetimi gerekir): ayricalikli (RT) olmayan islevde, atlama/kosullu atlama (OPFLOW 2/3) ve hedef <= gecerli komut
func isbackop(op) {
    ld pv, G, 52
    jz pv, ib0
    ret 0
ib0: add t, op, OPFLOW
    ld fw, t, 0
    lti z, fw, 2
    jz z, ib1
    ret 0
ib1: add t, op, OPTGT
    ld ts, t, 0
    add t, ts, 20
    add t, t, G
    ld tg, t, 0
    ld gi, G, 59
    ld fb, G, 23
    sub pcl, gi, fb
    le z, tg, pcl
    jz z, ib2
    ret 1
ib2: ret 0
}

; komut sablonu: yerlesik x86 sablonu varsa o (-6 1 ise ve SEM sablonlanabiliyorsa mikro-islemlerden), yoksa SEM'den; geri atlamalarda yakit varyanti (OPBACK / PBACK)
func emitop(op) {
    ge z, op, 342
    jnz z, ep
    add t, op, TPLS
    ld s, t, 0
    lti z, s, 0
    jnz z, em1
    ld fo, G, 58
    jz fo, bes
