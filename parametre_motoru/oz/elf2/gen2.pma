; [f0,f1) fonksiyonlarini oku (gi: ilk komut dizini); yeni gi dondurur
func pfuncs(f0, f1, gi) {
    mov f, f0
pf: ge z, f, f1
    jnz z, pfd
    call np, nx
    call nr, nx
    call ncode, nx
    add a, f, FBASE
    st gi, a, 0
    add a, f, FNP
    st np, a, 0
    add a, f, FNR
