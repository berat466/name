; rt.pma -- ELF calisma zamani kutuphanesi: sanal cerceve tamponu ana makineleri present / poll / frame ve cikis raporu.
; gen2 bunu uygulama fonksiyonlarinin SONUNA ekler (ayricalikli fonksiyonlar): `host present/poll/frame` komutlari bu islevlere cagri olur.
; Ayricalikli fonksiyonlarda: ld/st adresi RT bolgesini de kapsar (indeks -65536..-1 = RT bolgesi, N.. = kare kopyasi), host present = write(fd, indeks, bayt) sistem cagrisi,
; yakit kontrolu YOK. Sabit (ldk) kullanilmaz: 64 bit sabitler RT durum bloguna uretici tarafindan yazilir.
; RT durum bloku (indeks -65536+k): 0 N(bellek sozcugu) 1 kare 2 zincir 3 son 4 fw 5 fh 6 olay_sirasi 7 cik 8 azami_kare 9 ascii_K 10 bayrak(1 rapor, 2 PPM) 11 olay_sayisi
;   12 FNV_asal 13 FNV_baslangic 14 tampon_bayt 15 tampon_fd 16..40 sayi_isleme 64.. olaylar (kare, kod) ciftleri; 61440.. cikis tamponu (4096 sozcuk)
memory 16
entry rt_main

func rt_main() {
    ret 0
}

func rt_present(ptr, w, h) {
    mov rb, -65536
    ld n, rb, 0
    jz w, bad
    jz h, bad
    lti z, w, 0
    jnz z, bad
    lti z, h, 0
    jnz z, bad
    gti z, w, 4096
    jnz z, bad
    gti z, h, 4096
    jnz z, bad
    jz ptr, bad
    lti z, ptr, 0
    jnz z, bad
    gt z, ptr, n
    jnz z, bad
    mul wh, w, h
    sub rem, n, ptr
    gt z, wh, rem
    jnz z, bad
    st w, rb, 4
    st h, rb, 5
    ld prime, rb, 12
    ld hh, rb, 13
    andi b, w, 255
    xor hh, hh, b
    mul hh, hh, prime
    shri t, w, 8
    andi b, t, 255
    xor hh, hh, b
    mul hh, hh, prime
    andi b, h, 255
    xor hh, hh, b
    mul hh, hh, prime
    shri t, h, 8
    andi b, t, 255
    xor hh, hh, b
    mul hh, hh, prime
    mov i, 0
lp: ge z, i, wh
    jnz z, done
    add a, ptr, i
    ld px, a, 0
    andi px, px, 16777215
    add a, n, i
    st px, a, 0
    andi b, px, 255
    xor hh, hh, b
    mul hh, hh, prime
    shri t, px, 8
    andi b, t, 255
    xor hh, hh, b
    mul hh, hh, prime
    shri t, px, 16
    andi b, t, 255
    xor hh, hh, b
    mul hh, hh, prime
    addi i, i, 1
    jmp lp
done: st hh, rb, 3
    ld ch, rb, 2
    xor ch, ch, hh
    mul ch, ch, prime
    st ch, rb, 2
    ld fr, rb, 1
    addi fr, fr, 1
    st fr, rb, 1
    ld q, rb, 7
    jnz q, one
    ld mk, rb, 8
    jz mk, zero
    ge z, fr, mk
    jnz z, one
zero: ret 0
one: ret 1
bad: ret -1
}

func rt_poll() {
    mov rb, -65536
    ld nx, rb, 6
    ld nev, rb, 11
    ge z, nx, nev
    jnz z, none
    shli o, nx, 1
    add a, rb, o
    ld kare, a, 64
    ld fr, rb, 1
    gt z, kare, fr
    jnz z, none
    ld code, a, 65
    addi nx, nx, 1
    st nx, rb, 6
    mov one, 1
    shli t, one, 32
    or t, t, code
    ret t
none: ret 0
}

func rt_frame() {
    mov rb, -65536
    ld fr, rb, 1
    ret fr
}

; ---- cikis raporu: kare raporu (stderr), PPM (fd 3), ASCII (stdout) ----
func rt_end() {
    mov rb, -65536
    ld fl, rb, 10
    andi rep, fl, 1
    jz rep, noreport
    mov two, 2
    st two, rb, 15
    call x, ws4, 101, 107, 114, 97
    call x, ws4, 110, 58, 32, 107
    call x, ws4, 97, 114, 101, 61
    ld fr, rb, 1
    call x, wnum, fr
    call x, ws4, 32, 98, 111, 121
    call x, ws4, 117, 116, 61, 0
    ld fw, rb, 4
    call x, wnum, fw
    call x, wb, 120
    ld fh, rb, 5
    call x, wnum, fh
    call x, ws4, 32, 122, 105, 110
    call x, ws4, 99, 105, 114, 61
    ld ch, rb, 2
    call x, whex, ch
    call x, ws4, 32, 115, 111, 110
    call x, wb, 61
    ld ls, rb, 3
    call x, whex, ls
    call x, wb, 10
    call x, flush
noreport:
    ld fw, rb, 4
    jz fw, finish
    ld fh, rb, 5
    ld n, rb, 0
    mul wh, fw, fh
    ld fl, rb, 10
    andi pp, fl, 2
    jz pp, ppd2
    ; ---- PPM (fd 3)
    mov three, 3
    st three, rb, 15
    call x, ws4, 80, 54, 10, 0
    call x, wnum, fw
    call x, wb, 32
    call x, wnum, fh
    call x, ws4, 10, 50, 53, 53
    call x, wb, 10
    mov i, 0
pp: ge z, i, wh
    jnz z, ppd
    add a, n, i
    ld px, a, 0
    shri t, px, 16
    call x, wb, t
    shri t, px, 8
    call x, wb, t
    call x, wb, px
    addi i, i, 1
    jmp pp
ppd: call x, flush
ppd2:
    ; ---- ASCII (stdout)
    ld k, rb, 9
    jz k, finish
    lti z, k, 0
    jnz z, finish
    mov one, 1
    st one, rb, 15
    mov y, 0
ay: ge z, y, fh
    jnz z, aend
    mov xx, 0
ax: ge z, xx, fw
    jnz z, axd
    mul t, y, fw
    add t, t, xx
    add t, t, n
    mov a, t
    ld px, a, 0
    shri r1, px, 16
    andi r1, r1, 255
    shri g1, px, 8
    andi g1, g1, 255
    andi b1, px, 255
    mov m, r1
    le z, g1, m
    jnz z, m1
    mov m, g1
m1: le z, b1, m
    jnz z, m2
    mov m, b1
m2: mov ch2, 46
    lti z, m, 128
    jnz z, m3
    mov ch2, 35
m3: call x, wb, ch2
    add xx, xx, k
    jmp ax
axd: call x, wb, 10
    add y, y, k
    jmp ay
aend: call x, flush
finish: ret 0
}

; ---- yardimcilar (tamponlu bayt yazici) ----
func wb(b) {
    mov rb, -65536
    ld c, rb, 14
    shri w, c, 3
    andi s, c, 7
    shli s, s, 3
    andi bb, b, 255
    shl v, bb, s
    add a, rb, w
    jnz s, mrg
    st v, a, 61440
    jmp adv
mrg: ld old, a, 61440
    or v, v, old
    st v, a, 61440
adv: addi c, c, 1
    st c, rb, 14
    lti z, c, 32768
    jnz z, ok
    call x, flush
ok: ret 0
}

func flush() {
    mov rb, -65536
    ld c, rb, 14
    jz c, fe
    ld fd, rb, 15
    mov wi, -4096
    host r, present, fd, wi, c
    mov zero, 0
    st zero, rb, 14
fe: ret 0
}

func ws4(a, b, c, d) {
    jz a, e1
    call x, wb, a
e1: jz b, e2
    call x, wb, b
e2: jz c, e3
    call x, wb, c
e3: jz d, e4
    call x, wb, d
e4: ret 0
}

func wnum(v) {
    mov rb, -65536
    mov n, 0
d1: divi q, v, 10
    muli t, q, 10
    sub r, v, t
    addi r, r, 48
    add a, rb, n
    st r, a, 16
    addi n, n, 1
    mov v, q
    jnz v, d1
d2: jz n, d9
    addi n, n, -1
    add a, rb, n
    ld c, a, 16
    call x, wb, c
    jmp d2
d9: ret 0
}

func whex(v) {
    mov i, 15
h1: lti z, i, 0
    jnz z, h9
    shli sh, i, 2
    shr t, v, sh
    andi nb, t, 15
    lti z, nb, 10
    jz z, h2
    addi c, nb, 48
    jmp h3
h2: addi c, nb, 87
h3: call x, wb, c
    addi i, i, -1
    jmp h1
h9: ret 0
}
