    ret 0
o3: eq z, k, 3
    jz z, o4
    call x, y_ch, 105
    call x, y_ch, 97
    ret 0
o4: eq z, k, 4
    jz z, o5
    call x, y_ch, 105
    call x, y_ch, 98
    ret 0
o5: call x, y_ch, 108
    call x, y_pnum, v
    ret 0
}

; bicim metnini (STRT, fid) yaz. '>' satir basi = 4 bosluk, %o d operand, %n d sayi, %A degisken liste, satir ayirici 10, son satira \n eklenir
func y_fmt(fid) {
    add a, fid, STO
    ld p, a, 0
    mov bol, 1
f1: add a, p, STRT
    ld c, a, 0
    addi p, p, 1
    jz c, fend
    eq z, c, 10
    jz z, f2
    call x, y_ch, 10
    mov bol, 1
    jmp f1
f2: jz bol, f3
    mov bol, 0
    eq z, c, 62
    jz z, f3
    call x, y_ch, 32
    call x, y_ch, 32
    call x, y_ch, 32
    call x, y_ch, 32
    jmp f1
f3: eq z, c, 37
    jz z, fc
    add a, p, STRT
    ld t, a, 0
    addi p, p, 1
    eq z, t, 80
    jz z, fP
    ld np, G, 40
    mov j, 0
fp1: ge z, j, np
    jnz z, f1
    jz j, fp2
    call x, y_ch, 44
    call x, y_ch, 32
fp2: call x, y_ch, 108
    call x, y_pnum, j
    addi j, j, 1
    jmp fp1
fP: eq z, t, 65
    jz z, f4
    ; %A : ", " + operand her eleman icin
    ld nv, G, 38
    ld bs, G, 42
    mov j, 0
fa: ge z, j, nv
    jnz z, f1
    call x, y_ch, 44
    call x, y_ch, 32
    add a, j, bs
    add a, a, VK
    ld k, a, 0
    add a, j, bs
    add a, a, VV
    ld v, a, 0
    call x, y_op, k, v
    addi j, j, 1
    jmp fa
f4: add a, p, STRT
    ld d, a, 0
    addi d, d, -48
    addi p, p, 1
    add a, d, AV
    ld v, a, 0
    eq z, t, 111
    jz z, f5
    add a, d, AK
    ld k, a, 0
    call x, y_op, k, v
    jmp f1
f5: call x, y_pnum, v
    jmp f1
fc: call x, y_ch, c
    jmp f1
fend: call x, y_ch, 10
    ret 0
}

