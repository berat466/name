func y_checkidx(vk, vv, size) {
    eq z, vk, 0
    jz z, c1
    lti z, vv, 0
    jnz z, bad
    ge z, vv, size
    jz z, c0
bad: call x, y_err, 73
c0: st vk, G, 24
    ret vv
c1: call c, y_tmp
    mov one, 1
    st one, G, 28
    ld bl, G, 27
    call x, y_sn, 0, c
    call x, y_sa, 1, vk, vv
    call x, y_emit, 42
    call x, y_sn, 1, bl
    call x, y_emit, 43
    call x, y_sa, 1, vk, vv
    call x, y_sn, 2, size
    call x, y_emit, 44
    call x, y_sn, 1, bl
    call x, y_emit, 43
    st vk, G, 24
    ret vv
}

func y_emit(fid) {
    call x, y_fmt, fid
    ret 0
}

; alan okuma: sablon ti, alan fi, indeks tanimlayicisi (ik,iv)
func y_fieldread(ti, fi, ik, iv) {
    add a, ti, TMF0
    ld f0, a, 0
    add fd, f0, fi
    add a, fd, FDK
    ld kind, a, 0
    add a, fd, FDW
    ld w, a, 0
    eq z, kind, 5
    jnz z, st1
    jnz w, st1
    jmp vir
st1: call p, y_tmp
    call v, y_tmp
    call x, y_sn, 0, p
    call x, y_sn, 1, ti
    call x, y_sn, 2, fi
