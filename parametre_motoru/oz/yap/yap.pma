2 98 44 32 37 110 48 44 32 37 110 49 10 62 106 110 122 32 114 44 32 102 105 110 0 62 108 100 32 102 107 44 32 103 95 107 97 114 101 44 32 48 10 62 97 100 100 32 102 107 44 32 102 107 44 32 49 10 62 115 116 32 102 107 44 32 103 95 107 97 114 101 44 32 48 10 62 97 100 100 32 102 44 32 102 44 32 49 10 62 106 109 112 32 102 108 10 102 105 110 58 0 62 99 97 108 108 32 122 44 32 115 111 110 10 62 114 101 116 32 48 10 125 0
data MAGIC = 80 77 89 49
space SCRD 32

; G: 0 ipos 1 isize 2 nexpr 3 nstmt 4 nglob 5 narr 6 nfn 7 nbh 8 ntm 9 net 10 ngi 11 nag 12 hasbitis 13 bitis 14 ilk 15 son 16 W 17 H 18 BG 19 FRAMES
;    20 ninit 21 nfd 22 ndr 23 nbind 24 RK(sonuc turu) 25 ntmp 26 nlab 27 badlabel 28 needbad 29 outpos 30 bufpos 31 target(0 OUT,1 BUF) 32 CT 33 CA 34 CB 35 CFN 36 CNLOC 37 nloops
;    38 nvar(%A) 39 RT(donus kuyrugu) 40 fnstart(unused) 41 srcpos

func y_err(code) {
    host putc, 72
    host putc, 65
    host putc, 84
    host putc, 65
    host putc, 58
    host putc, 32
    host puti, code
    host putc, 10
    mov z, 0
    div x, 1, z
    ret 0
}

; ---------- girdi okuyucu (LEB128) ----------
func y_ru() {
    mov v, 0
    mov sh, 0
r1: ld p, G, 0
    ld n, G, 1
    ge z, p, n
    jz z, r2
    call x, y_err, 1
r2: add a, p, IB
    ld b, a, 0
    add p, p, 1
    st p, G, 0
    andi lo, b, 127
    lti z, sh, 63
    jnz z, r3
    gti z, lo, 1
    jz z, r3
    call x, y_err, 2
r3: shl t, lo, sh
    or v, v, t
    andi hi, b, 128
    jnz hi, r4
    ret v
r4: addi sh, sh, 7
    gti z, sh, 63
    jz z, r1
    call x, y_err, 3
}

func y_zz() {
    call v, y_ru
    shri h, v, 1
    andi l, v, 1
    neg l, l
    xor r, h, l
    ret r
}

func y_count() {
    call v, y_ru
    lti z, v, 0
    jz z, c1
    call x, y_err, 4
c1: ld n, G, 1
    ld i, G, 0
    sub r, n, i
    gt z, v, r
    jz z, c2
    call x, y_err, 4
c2: ret v
}

func y_idx(limit) {
    call v, y_ru
    lti z, v, 0
    jz z, i1
    call x, y_err, 5
i1: ge z, v, limit
    jz z, i2
    call x, y_err, 5
i2: ret v
}

; ---------- dugum havuzlari ----------
func y_newexpr(k) {
    ld n, G, 2
    addi n, n, 1
    gei z, n, 262144
    jz z, e1
    call x, y_err, 6
e1: st n, G, 2
    add a, n, EK
    st k, a, 0
    ret n
}

func y_newstmt(k) {
    ld n, G, 3
    addi n, n, 1
    gei z, n, 131072
    jz z, e1
    call x, y_err, 7
e1: st n, G, 3
    add a, n, SK
    st k, a, 0
    ret n
}

; ---------- ifade/komut cozumu ----------
func y_dexpr(depth) {
    gti z, depth, 200
    jz z, d0
    call x, y_err, 8
d0: call k, y_ru
    lti z, k, 1
    jnz z, bk
    gei z, k, 19
    jz z, d1
bk: call x, y_err, 9
d1: call e, y_newexpr, k
    eq z, k, 1
    jz z, d2
    call v, y_zz
    add a, e, EV
    st v, a, 0
    ret e
d2: eq z, k, 2
    jnz z, ia
    eq z, k, 3
    jnz z, ia
    eq z, k, 4
    jnz z, ia
    eq z, k, 7
    jnz z, ia
    eq z, k, 8
    jnz z, ia
    eq z, k, 14
    jnz z, ia
    jmp d3
ia: call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    ret e
d3: eq z, k, 11
    jz z, d4
    call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    call v, y_idx, 1048576
    add a, e, EB
    st v, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    ret e
d4: eq z, k, 12
    jz z, d5
    call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    ret e
d5: eq z, k, 13
    jz z, d6
    call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    call n, y_count
    addi d1_, depth, 1
    mov j, 0
    mov prev, 0
d5a: ge z, j, n
    jnz z, d5d
    call c, y_dexpr, d1_
    jnz prev, d5b
    add a, e, EARG
    st c, a, 0
    jmp d5c
d5b: add a, prev, ENX
    st c, a, 0
d5c: mov prev, c
    addi j, j, 1
    jmp d5a
d5d: ret e
d6: eq z, k, 15
    jz z, d7
    call o, y_ru
    lti z, o, 1
    jnz z, d6b
    gti z, o, 20
    jz z, d6a
d6b: call x, y_err, 10
d6a: add a, e, EA
    st o, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    call c, y_dexpr, d1_
    add a, e, EC1
    st c, a, 0
    ret e
d7: eq z, k, 16
    jz z, d8
    call o, y_ru
    lti z, o, 1
    jnz z, d7b
    gti z, o, 3
    jz z, d7a
d7b: call x, y_err, 11
d7a: add a, e, EA
    st o, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    ret e
d8: eq z, k, 17
    jz z, d9
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    call c, y_dexpr, d1_
    add a, e, EC1
    st c, a, 0
    call c, y_dexpr, d1_
    add a, e, EC2
    st c, a, 0
d9: ret e
}

func y_dexpr0() {
    call e, y_dexpr, 0
    ret e
}

func y_dblock(depth) {
    gti z, depth, 100
    jz z, b0
    call x, y_err, 12
b0: call n, y_count
    mov head, 0
    mov tail, 0
    mov j, 0
b1: ge z, j, n
    jnz z, b9
    call k, y_ru
    lti z, k, 1
    jnz z, bk
    gei z, k, 13
    jz z, b2
bk: call x, y_err, 13
b2: call s, y_newstmt, k
    addi d1_, depth, 1
    eq z, k, 1
    jz z, s2
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dexpr0
    add a, s, SE1
    st c, a, 0
    jmp sl
s2: eq z, k, 2
    jz z, s3
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB0
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB1
    st c, a, 0
    jmp sl
s3: eq z, k, 3
    jz z, s4
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB0
    st c, a, 0
    jmp sl
s4: eq z, k, 4
    jz z, s5
    call v, y_idx, 256
    add a, s, SA
    st v, a, 0
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dexpr0
    add a, s, SE1
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB0
    st c, a, 0
    jmp sl
s5: eq z, k, 5
    jnz z, s5a
    eq z, k, 6
    jz z, s6
s5a: call v, y_idx, 1048576
    add a, s, SA
    st v, a, 0
    call n2, y_count
    mov q, 0
    mov prev, 0
s5b: ge z, q, n2
    jnz z, sl
    call c, y_dexpr0
    jnz prev, s5c
    add a, s, SARG
    st c, a, 0
    jmp s5d
s5c: add a, prev, ENX
    st c, a, 0
s5d: mov prev, c
    addi q, q, 1
    jmp s5b
s6: eq z, k, 7
    jnz z, s6a
    eq z, k, 8
    jnz z, s6a
    eq z, k, 9
    jz z, s7
s6a: call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    jmp sl
s7: eq z, k, 12
    jz z, sl
    call n2, y_count
    mov q, 0
    mov prev, 0
s7b: ge z, q, n2
    jnz z, sl
    call c, y_dexpr0
    jnz prev, s7c
    add a, s, SARG
    st c, a, 0
    jmp s7d
s7c: add a, prev, ENX
    st c, a, 0
s7d: mov prev, c
    addi q, q, 1
    jmp s7b
sl: jnz tail, sl2
    mov head, s
    jmp sl3
sl2: add a, tail, SNX
    st s, a, 0
sl3: mov tail, s
    addi j, j, 1
    jmp b1
b9: ret head
}

; ---------- model cozumu ----------
func y_decode() {
    ld n, G, 1
    lti z, n, 4
    jnz z, hb
    mov i, 0
    mov ex, 0
h1: gei z, i, 4
    jnz z, h2
    add a, i, IB
    ld c, a, 0
    add a, i, MAGIC
    ld m, a, 0
    ne z, c, m
    jz z, h1a
    mov ex, 1
h1a: addi i, i, 1
    jmp h1
h2: jz ex, h3
hb: call x, y_err, 20
h3: mov four, 4
    st four, G, 0
    call w, y_ru
    st w, G, 16
    call h, y_ru
    st h, G, 17
    call b, y_ru
    st b, G, 18
    call f, y_ru
    st f, G, 19
    lti z, w, 0
    jnz z, hb
    lti z, h, 0
    jnz z, hb
    gti z, w, 4096
    jnz z, hb
    gti z, h, 4096
    jnz z, hb
    eqi z1, w, 0
    eqi z2, h, 0
    ne z, z1, z2
    jnz z, hb
    ; globaller
    call n1, y_count
    gti z, n1, 65536
    jz z, g0
    call x, y_err, 21
g0: st n1, G, 4
    mov j, 0
g1: ge z, j, n1
    jnz z, g2
    call v, y_zz
    add a, j, GLV
    st v, a, 0
    addi j, j, 1
    jmp g1
g2: ; diziler
    call n1, y_count
    gti z, n1, 4096
