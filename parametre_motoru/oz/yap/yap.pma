; isaretli onluk sayi yaz (INT64_MIN dahil)
func y_pnum(v) {
    mov u, v
    lti z, v, 0
    jz z, p0
    call x, y_ch, 45
    neg u, v
p0: ; u isaretsiz: basamaklari ters sirada SCR alanina (USEDL ile cakismasin: yerel dizi yok -> yigin yerine VV sonu)
    mov nd, 0
p1: lti z, u, 0
    jz z, p2
    ; u >= 2^63 (isaretsiz): q = ((u >> 1) / 5), r = u - 10q (r < 20)
    shri q, u, 1
    divi q, q, 5
    muli t, q, 10
    sub r, u, t
    lti z, r, 10
    jnz z, p3
    addi q, q, 1
    addi r, r, -10
    jmp p3
p2: divi q, u, 10
    muli t, q, 10
    sub r, u, t
p3: addi r, r, 48
    add a, nd, SCRD
    st r, a, 0
    addi nd, nd, 1
    mov u, q
    jnz u, p1
    mov i, nd
p4: jz i, p9
    addi i, i, -1
    add a, i, SCRD
    ld c, a, 0
    call x, y_ch, c
    jmp p4
p9: ret 0
}

; operand tanimlayicisi: tur 0 sayi, 1 gecici v<n>, 2 "i", 3 "ia", 4 "ib", 5 yerel l<n>
func y_op(k, v) {
    eq z, k, 0
    jz z, o1
    call x, y_pnum, v
    ret 0
o1: eq z, k, 1
    jz z, o2
