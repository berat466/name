    st v, a, 0
    call bd, y_dblock, 0
    add a, j, GIB
    st bd, a, 0
    addi j, j, 1
    jmp i1
i9: ; toplamalar
    call n1, y_count
    gti z, n1, 4096
    jz z, o0
    call x, y_err, 39
o0: st n1, G, 11
    mov j, 0
o1: ge z, j, n1
    jnz z, o9
    call v, y_idx, 1048576
    add a, j, AGG
    st v, a, 0
    call op, y_ru
    lti z, op, 1
    jnz z, opbad
    gti z, op, 4
    jz z, o2
opbad: call x, y_err, 40
o2: add a, j, AGOP
    st op, a, 0
    call v, y_idx, 1048576
    add a, j, AGT
    st v, a, 0
    call c, y_dexpr0
    add a, j, AGV
    st c, a, 0
    call c, y_dexpr0
    add a, j, AGC
    st c, a, 0
    addi j, j, 1
    jmp o1
o9: call hb2, y_ru
    gti z, hb2, 1
    jz z, hb3
