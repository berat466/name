; yap.pma -- PMY1 (yapisal sayisal tablo) -> .pma metni OZELLESTIRICISI (parametre tablosu). C++ karsiligi: src/yapisal.cpp (yapisal_to_pma).
; stdin: PMY1 baytlari; stdout: .pma metni (pm yapisal --pma ile BAYT-BAYT ayni). Hata -> stdout'a "HATA kod" yazilir, DIV0 tuzagi (cikis 2).
; Metin bicimleri (fmt.txt) veridir: %o d = operand (tur,deger), %n d = isaretli sayi, %A = degisken arguman listesi; '>' satir basi = 4 bosluk girinti.
; Sinirlar [Kesin]: girdi <= 1 MiB; ifade dugumu 262144, komut dugumu 131072 (davranis acilimi dahil); cikti <= 2 MiB karakter.
memory 16777216
entry main
space IB 1100000
space EK 262144
space EV 262144
space EA 262144
space EB 262144
space EC0 262144
space EC1 262144
space EC2 262144
space EARG 262144
space ENX 262144
space SK 131072
space SA 131072
space SE0 131072
space SE1 131072
space SARG 131072
space SB0 131072
space SB1 131072
space SNX 131072
space BIND 8192
space INITV 131072
space GLV 65536
space ARSZ 4096
space ARIS 4096
space ARIN 4096
space FNP 8192
space FNL 8192
space FNB 8192
space BHP 4096
space BHB 4096
space TMN 1024
space TMF0 1024
space TMNF 1024
space TMR 1024
space TMD0 1024
space TMND 1024
space FDK 65536
space FDP0 65536
space FDP1 65536
space FDP2 65536
space FDW 65536
space DSH 65536
space DA0 65536
space DA1 65536
space DA2 65536
space DA3 65536
space DA4 65536
space ETA 4096
space ETB 4096
space ETC 4096
space ETY 4096
space GIC 4096
space GIT 4096
space GIB 4096
space AGG 4096
space AGOP 4096
space AGT 4096
space AGV 4096
space AGC 4096
space USEDL 512
space LKIR 256
space LDEV 256
space AK 16
space AV 16
space VK 8192
space VV 8192
space OUTA 2200000
space BUFA 1100000
space G 128
data STO = @STO@
data STRT = @STRT@
data MAGIC = 80 77 89 49
space SCRD 32

; G: 0 ipos 1 isize 2 nexpr 3 nstmt 4 nglob 5 narr 6 nfn 7 nbh 8 ntm 9 net 10 ngi 11 nag 12 hasbitis 13 bitis 14 ilk 15 son 16 W 17 H 18 BG 19 FRAMES
;    20 ninit 21 nfd 22 ndr 23 nbind 24 RK(sonuc turu) 25 ntmp 26 nlab 27 badlabel 28 needbad 29 outpos 30 bufpos 31 target(0 OUT,1 BUF) 32 CT 33 CA 34 CB 35 CFN 36 CNLOC 37 nloops
;    38 nvar(%A) 39 RT(donus kuyrugu) 40 fnstart(unused) 41 srcpos

func y_err(code) {
    host putc, 72
    host putc, 65
    host putc, 84
    host putc, 65
    host putc, 58
    host putc, 32
    host puti, code
    host putc, 10
    mov z, 0
    div x, 1, z
    ret 0
}

; ---------- girdi okuyucu (LEB128) ----------
func y_ru() {
    mov v, 0
    mov sh, 0
r1: ld p, G, 0
    ld n, G, 1
    ge z, p, n
    jz z, r2
    call x, y_err, 1
r2: add a, p, IB
    ld b, a, 0
    add p, p, 1
    st p, G, 0
    andi lo, b, 127
    lti z, sh, 63
    jnz z, r3
    gti z, lo, 1
    jz z, r3
    call x, y_err, 2
r3: shl t, lo, sh
    or v, v, t
    andi hi, b, 128
    jnz hi, r4
    ret v
r4: addi sh, sh, 7
    gti z, sh, 63
    jz z, r1
    call x, y_err, 3
}

func y_zz() {
    call v, y_ru
    shri h, v, 1
    andi l, v, 1
    neg l, l
    xor r, h, l
    ret r
}

func y_count() {
    call v, y_ru
    lti z, v, 0
    jz z, c1
    call x, y_err, 4
c1: ld n, G, 1
    ld i, G, 0
    sub r, n, i
    gt z, v, r
    jz z, c2
    call x, y_err, 4
c2: ret v
}

func y_idx(limit) {
    call v, y_ru
    lti z, v, 0
    jz z, i1
    call x, y_err, 5
i1: ge z, v, limit
    jz z, i2
    call x, y_err, 5
i2: ret v
}

; ---------- dugum havuzlari ----------
func y_newexpr(k) {
    ld n, G, 2
    addi n, n, 1
    gei z, n, 262144
    jz z, e1
    call x, y_err, 6
e1: st n, G, 2
    add a, n, EK
    st k, a, 0
    ret n
}

func y_newstmt(k) {
    ld n, G, 3
    addi n, n, 1
    gei z, n, 131072
    jz z, e1
    call x, y_err, 7
e1: st n, G, 3
    add a, n, SK
    st k, a, 0
    ret n
}

; ---------- ifade/komut cozumu ----------
func y_dexpr(depth) {
    gti z, depth, 200
    jz z, d0
    call x, y_err, 8
d0: call k, y_ru
    lti z, k, 1
    jnz z, bk
    gei z, k, 19
    jz z, d1
bk: call x, y_err, 9
d1: call e, y_newexpr, k
    eq z, k, 1
    jz z, d2
    call v, y_zz
    add a, e, EV
    st v, a, 0
    ret e
d2: eq z, k, 2
    jnz z, ia
    eq z, k, 3
    jnz z, ia
    eq z, k, 4
    jnz z, ia
    eq z, k, 7
    jnz z, ia
    eq z, k, 8
    jnz z, ia
    eq z, k, 14
    jnz z, ia
    jmp d3
ia: call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    ret e
d3: eq z, k, 11
    jz z, d4
    call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    call v, y_idx, 1048576
    add a, e, EB
    st v, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    ret e
d4: eq z, k, 12
    jz z, d5
    call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    ret e
d5: eq z, k, 13
    jz z, d6
    call v, y_idx, 1048576
    add a, e, EA
    st v, a, 0
    call n, y_count
    addi d1_, depth, 1
    mov j, 0
    mov prev, 0
d5a: ge z, j, n
    jnz z, d5d
    call c, y_dexpr, d1_
    jnz prev, d5b
    add a, e, EARG
    st c, a, 0
    jmp d5c
d5b: add a, prev, ENX
    st c, a, 0
d5c: mov prev, c
    addi j, j, 1
    jmp d5a
d5d: ret e
d6: eq z, k, 15
    jz z, d7
    call o, y_ru
    lti z, o, 1
    jnz z, d6b
    gti z, o, 20
    jz z, d6a
d6b: call x, y_err, 10
d6a: add a, e, EA
    st o, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    call c, y_dexpr, d1_
    add a, e, EC1
    st c, a, 0
    ret e
d7: eq z, k, 16
    jz z, d8
    call o, y_ru
    lti z, o, 1
    jnz z, d7b
    gti z, o, 3
    jz z, d7a
d7b: call x, y_err, 11
d7a: add a, e, EA
    st o, a, 0
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    ret e
d8: eq z, k, 17
    jz z, d9
    addi d1_, depth, 1
    call c, y_dexpr, d1_
    add a, e, EC0
    st c, a, 0
    call c, y_dexpr, d1_
    add a, e, EC1
    st c, a, 0
    call c, y_dexpr, d1_
    add a, e, EC2
    st c, a, 0
d9: ret e
}

func y_dexpr0() {
    call e, y_dexpr, 0
    ret e
}

func y_dblock(depth) {
    gti z, depth, 100
    jz z, b0
    call x, y_err, 12
b0: call n, y_count
    mov head, 0
    mov tail, 0
    mov j, 0
b1: ge z, j, n
    jnz z, b9
    call k, y_ru
    lti z, k, 1
    jnz z, bk
    gei z, k, 13
    jz z, b2
bk: call x, y_err, 13
b2: call s, y_newstmt, k
    addi d1_, depth, 1
    eq z, k, 1
    jz z, s2
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dexpr0
    add a, s, SE1
    st c, a, 0
    jmp sl
s2: eq z, k, 2
    jz z, s3
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB0
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB1
    st c, a, 0
    jmp sl
s3: eq z, k, 3
    jz z, s4
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB0
    st c, a, 0
    jmp sl
s4: eq z, k, 4
    jz z, s5
    call v, y_idx, 256
    add a, s, SA
    st v, a, 0
    call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    call c, y_dexpr0
    add a, s, SE1
    st c, a, 0
    call c, y_dblock, d1_
    add a, s, SB0
    st c, a, 0
    jmp sl
s5: eq z, k, 5
    jnz z, s5a
    eq z, k, 6
    jz z, s6
s5a: call v, y_idx, 1048576
    add a, s, SA
    st v, a, 0
    call n2, y_count
    mov q, 0
    mov prev, 0
s5b: ge z, q, n2
    jnz z, sl
    call c, y_dexpr0
    jnz prev, s5c
    add a, s, SARG
    st c, a, 0
    jmp s5d
s5c: add a, prev, ENX
    st c, a, 0
s5d: mov prev, c
    addi q, q, 1
    jmp s5b
s6: eq z, k, 7
    jnz z, s6a
    eq z, k, 8
    jnz z, s6a
    eq z, k, 9
    jz z, s7
s6a: call c, y_dexpr0
    add a, s, SE0
    st c, a, 0
    jmp sl
s7: eq z, k, 12
    jz z, sl
    call n2, y_count
    mov q, 0
    mov prev, 0
s7b: ge z, q, n2
    jnz z, sl
    call c, y_dexpr0
    jnz prev, s7c
    add a, s, SARG
    st c, a, 0
    jmp s7d
s7c: add a, prev, ENX
    st c, a, 0
s7d: mov prev, c
    addi q, q, 1
    jmp s7b
sl: jnz tail, sl2
    mov head, s
    jmp sl3
sl2: add a, tail, SNX
    st s, a, 0
sl3: mov tail, s
    addi j, j, 1
    jmp b1
b9: ret head
}

; ---------- model cozumu ----------
func y_decode() {
    ld n, G, 1
    lti z, n, 4
    jnz z, hb
    mov i, 0
    mov ex, 0
h1: gei z, i, 4
    jnz z, h2
    add a, i, IB
    ld c, a, 0
    add a, i, MAGIC
    ld m, a, 0
    ne z, c, m
    jz z, h1a
    mov ex, 1
h1a: addi i, i, 1
    jmp h1
h2: jz ex, h3
hb: call x, y_err, 20
h3: mov four, 4
    st four, G, 0
    call w, y_ru
    st w, G, 16
    call h, y_ru
    st h, G, 17
    call b, y_ru
    st b, G, 18
    call f, y_ru
    st f, G, 19
    lti z, w, 0
    jnz z, hb
    lti z, h, 0
    jnz z, hb
    gti z, w, 4096
    jnz z, hb
    gti z, h, 4096
    jnz z, hb
    eqi z1, w, 0
    eqi z2, h, 0
    ne z, z1, z2
    jnz z, hb
    ; globaller
    call n1, y_count
    gti z, n1, 65536
    jz z, g0
    call x, y_err, 21
g0: st n1, G, 4
    mov j, 0
g1: ge z, j, n1
    jnz z, g2
    call v, y_zz
    add a, j, GLV
    st v, a, 0
    addi j, j, 1
    jmp g1
g2: ; diziler
    call n1, y_count
    gti z, n1, 4096
    jz z, a0
    call x, y_err, 22
a0: st n1, G, 5
    mov j, 0
a1: ge z, j, n1
    jnz z, a9
    call sz, y_ru
    lti z, sz, 1
    jnz z, abad
    gti z, sz, 16777216
    jz z, a2
abad: call x, y_err, 23
a2: add a, j, ARSZ
    st sz, a, 0
    call ni, y_count
    gt z, ni, sz
    jz z, a3
    call x, y_err, 24
a3: ld p, G, 20
    add a, j, ARIS
    st p, a, 0
    add a, j, ARIN
    st ni, a, 0
    add e, p, ni
    gti z, e, 131072
    jz z, a4
    call x, y_err, 25
a4: mov q, 0
a5: ge z, q, ni
    jnz z, a6
    call v, y_zz
    ld p, G, 20
    add a, p, INITV
    st v, a, 0
    addi p, p, 1
    st p, G, 20
    addi q, q, 1
    jmp a5
a6: addi j, j, 1
    jmp a1
a9: ; islevler
    call n1, y_count
    gti z, n1, 8192
    jz z, f0
    call x, y_err, 26
f0: st n1, G, 6
    mov j, 0
f1: ge z, j, n1
    jnz z, f9
    call np, y_idx, 256
    call nl, y_idx, 257
    lt z, nl, np
    jz z, f2
    call x, y_err, 27
f2: add a, j, FNP
    st np, a, 0
    add a, j, FNL
    st nl, a, 0
    call bd, y_dblock, 0
    add a, j, FNB
    st bd, a, 0
    addi j, j, 1
    jmp f1
f9: ; davranislar
    call n1, y_count
    gti z, n1, 4096
    jz z, b0
    call x, y_err, 28
b0: st n1, G, 7
    mov j, 0
b1: ge z, j, n1
    jnz z, b9
    call np, y_idx, 256
    add a, j, BHP
    st np, a, 0
    call bd, y_dblock, 0
    add a, j, BHB
    st bd, a, 0
    addi j, j, 1
    jmp b1
b9: ; sablonlar
    call n1, y_count
    gti z, n1, 1024
    jz z, t0
    call x, y_err, 29
t0: st n1, G, 8
    mov j, 0
t1: ge z, j, n1
    jnz z, t9
    call tn, y_ru
    lti z, tn, 1
    jnz z, tbad
    gti z, tn, 10000000
    jz z, t2
tbad: call x, y_err, 30
t2: add a, j, TMN
    st tn, a, 0
    call nf, y_count
    ld p, G, 21
    add a, j, TMF0
    st p, a, 0
    add a, j, TMNF
    st nf, a, 0
    add e, p, nf
    gti z, e, 65536
    jz z, t3
    call x, y_err, 31
t3: mov q, 0
t4: ge z, q, nf
    jnz z, t8
    ld p, G, 21
    call g, y_ru
    lti z, g, 1
    jnz z, gbad
    gti z, g, 5
    jz z, g1_
gbad: call x, y_err, 32
g1_: add a, p, FDK
    st g, a, 0
    mov zero, 0
    add a, p, FDP0
    st zero, a, 0
    add a, p, FDP1
    st zero, a, 0
    add a, p, FDP2
    st zero, a, 0
    add a, p, FDW
    st zero, a, 0
    eq z, g, 1
    jz z, k2
    call v, y_zz
    add a, p, FDP0
    st v, a, 0
    jmp k9
k2: eq z, g, 2
    jz z, k3
    call v, y_zz
    add a, p, FDP0
    st v, a, 0
    call v, y_zz
    add a, p, FDP1
    st v, a, 0
    jmp k9
k3: eq z, g, 3
    jnz z, k3a
    eq z, g, 4
    jz z, k5
k3a: call v, y_ru
    add a, p, FDP0
    st v, a, 0
    lti z, v, 1
    jz z, k3b
    call x, y_err, 33
k3b: call v, y_zz
    add a, p, FDP1
    st v, a, 0
    call v, y_zz
    add a, p, FDP2
    st v, a, 0
    jmp k9
k5: call v, y_zz
    add a, p, FDP0
    st v, a, 0
    call v, y_zz
    add a, p, FDP1
    st v, a, 0
    call v, y_zz
    add a, p, FDP2
    st v, a, 0
    add a, p, FDP0
    ld lo, a, 0
    add a, p, FDP1
    ld hi, a, 0
    lt z, hi, lo
    jz z, k9
    call x, y_err, 34
k9: addi p, p, 1
    st p, G, 21
    addi q, q, 1
    jmp t4
t8: call bd, y_dblock, 0
    add a, j, TMR
    st bd, a, 0
    call nd, y_count
    ld p, G, 22
    add a, j, TMD0
    st p, a, 0
    add a, j, TMND
    st nd, a, 0
    add e, p, nd
    gti z, e, 65536
    jz z, t8a
    call x, y_err, 35
t8a: mov q, 0
t8b: ge z, q, nd
    jnz z, t8z
    ld p, G, 22
    call sh, y_ru
    lti z, sh, 1
    jnz z, shbad
    gti z, sh, 2
    jz z, t8c
shbad: call x, y_err, 36
t8c: add a, p, DSH
    st sh, a, 0
    mov want, 3
    eq z, sh, 1
    jz z, t8d
    mov want, 5
t8d: mov w2, 0
t8e: ge z, w2, want
    jnz z, t8f
    call ee, y_dexpr0
    eq z, w2, 0
    jz z, d1a
    add a, p, DA0
    st ee, a, 0
    jmp t8g
d1a: eq z, w2, 1
    jz z, d2a
    add a, p, DA1
    st ee, a, 0
    jmp t8g
d2a: eq z, w2, 2
    jz z, d3a
    add a, p, DA2
    st ee, a, 0
    jmp t8g
d3a: eq z, w2, 3
    jz z, d4a
    add a, p, DA3
    st ee, a, 0
    jmp t8g
d4a: add a, p, DA4
    st ee, a, 0
t8g: addi w2, w2, 1
    jmp t8e
t8f: addi p, p, 1
    st p, G, 22
    addi q, q, 1
    jmp t8b
t8z: addi j, j, 1
    jmp t1
t9: ; etkilesimler
    call n1, y_count
    gti z, n1, 4096
    jz z, e0
    call x, y_err, 37
e0: st n1, G, 9
    mov j, 0
e1: ge z, j, n1
    jnz z, e9
    call v, y_idx, 1048576
    add a, j, ETA
    st v, a, 0
    call v, y_idx, 1048576
    add a, j, ETB
    st v, a, 0
    call c, y_dexpr0
    add a, j, ETC
    st c, a, 0
    call bd, y_dblock, 0
    add a, j, ETY
    st bd, a, 0
    addi j, j, 1
    jmp e1
e9: ; girdiler
    call n1, y_count
    gti z, n1, 4096
    jz z, i0
    call x, y_err, 38
i0: st n1, G, 10
    mov j, 0
i1: ge z, j, n1
    jnz z, i9
