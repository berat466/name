}

; ---------- davranis acilimi ----------
func y_clone(e, bb, bn) {
    jnz e, c0
    ret 0
c0: add a, e, EK
    ld k, a, 0
    eq z, k, 14
    jz z, c1
    ; E_PARAM
    lti z, bb, 0
    jnz z, pbad
    add a, e, EA
    ld idx, a, 0
    ge z, idx, bn
    jnz z, pbad
    add a, bb, idx
    add a, a, BIND
    ld src, a, 0
    call r, y_clone, src, -1, 0
    ret r
pbad: call x, y_err, 50
c1: call n, y_newexpr, k
    add a, e, EV
    ld v, a, 0
    add a, n, EV
    st v, a, 0
    add a, e, EA
    ld v, a, 0
    add a, n, EA
    st v, a, 0
    add a, e, EB
    ld v, a, 0
    add a, n, EB
    st v, a, 0
    add a, e, EC0
    ld ch, a, 0
    call r, y_clone, ch, bb, bn
    add a, n, EC0
    st r, a, 0
    add a, e, EC1
    ld ch, a, 0
    call r, y_clone, ch, bb, bn
    add a, n, EC1
    st r, a, 0
    add a, e, EC2
    ld ch, a, 0
    call r, y_clone, ch, bb, bn
    add a, n, EC2
    st r, a, 0
    add a, e, EARG
    ld ch, a, 0
    mov prev, 0
c2: jz ch, c9
    call r, y_clone, ch, bb, bn
    jnz prev, c3
    add a, n, EARG
    st r, a, 0
    jmp c4
c3: add a, prev, ENX
    st r, a, 0
c4: mov prev, r
    add a, ch, ENX
    ld ch, a, 0
    jmp c2
c9: ret n
}

; arguman zincirinin uzunlugu
func y_chain(h) {
    mov n, 0
c1: jz h, c9
    addi n, n, 1
    add a, h, ENX
    ld h, a, 0
    jmp c1
c9: ret n
}

; in listesini (bb,bn baglamiyla) acarak head/tail listesine ekler; yeni head dondurur, kuyruk G[39]'da
func y_expand(in, bb, bn, depth, head, tail) {
    gti z, depth, 16
    jz z, x0
    call x, y_err, 51
x0: mov s, in
x1: jz s, x9
    add a, s, SK
    ld k, a, 0
    eq z, k, 6
    jz z, x4
    ; DAVRAN
    add a, s, SA
    ld bi, a, 0
    ld nbh, G, 7
    ge z, bi, nbh
    jz z, x2
    call x, y_err, 52
x2: add a, bi, BHP
    ld np, a, 0
    add a, s, SARG
    ld ah, a, 0
    call cnt, y_chain, ah
    eq z, cnt, np
    jnz z, x3
    call x, y_err, 53
x3: ld base, G, 23
    add t, base, np
    gti z, t, 8192
    jz z, x3a
    call x, y_err, 54
x3a: st t, G, 23
    mov j, 0
x3b: ge z, j, np
    jnz z, x3d
    call cl, y_clone, ah, bb, bn
    add t, base, j
    add a, t, BIND
    st cl, a, 0
    add a, ah, ENX
    ld ah, a, 0
    addi j, j, 1
    jmp x3b
x3d: add a, bi, BHB
    ld body, a, 0
    addi d1_, depth, 1
    call head, y_expand, body, base, np, d1_, head, tail
    ld tail, G, 39
    jmp xn
x4: call n, y_newstmt, k
    add a, s, SA
    ld v, a, 0
    add a, n, SA
    st v, a, 0
    add a, s, SE0
    ld v, a, 0
    call r, y_clone, v, bb, bn
    add a, n, SE0
    st r, a, 0
    add a, s, SE1
    ld v, a, 0
    call r, y_clone, v, bb, bn
    add a, n, SE1
    st r, a, 0
    add a, s, SARG
    ld ch, a, 0
    mov prev, 0
x5: jz ch, x6
    call r, y_clone, ch, bb, bn
    jnz prev, x5a
    add a, n, SARG
    st r, a, 0
    jmp x5b
x5a: add a, prev, ENX
    st r, a, 0
x5b: mov prev, r
    add a, ch, ENX
    ld ch, a, 0
    jmp x5
x6: add a, s, SB0
    ld v, a, 0
    call r, y_expand, v, bb, bn, depth, 0, 0
    add a, n, SB0
    st r, a, 0
    add a, s, SB1
    ld v, a, 0
    call r, y_expand, v, bb, bn, depth, 0, 0
    add a, n, SB1
    st r, a, 0
    jnz tail, x7
    mov head, n
    jmp x8
x7: add a, tail, SNX
    st n, a, 0
x8: mov tail, n
xn: add a, s, SNX
    ld s, a, 0
    jmp x1
x9: st tail, G, 39
    ret head
}

func y_expblock(h) {
    call r, y_expand, h, -1, 0, 0, 0, 0
    ret r
}

; ---------- cikti ilkelleri ----------
func y_ch(c) {
    ld tg, G, 31
    jnz tg, b1
    ld p, G, 29
    gei z, p, 2200000
    jz z, a1
    call x, y_err, 60
a1: add a, p, OUTA
    st c, a, 0
    addi p, p, 1
    st p, G, 29
    ret 0
b1: ld p, G, 30
    gei z, p, 1100000
    jz z, b2
    call x, y_err, 61
b2: add a, p, BUFA
    st c, a, 0
    addi p, p, 1
    st p, G, 30
    ret 0
}

; isaretli onluk sayi yaz (INT64_MIN dahil)
func y_pnum(v) {
    mov u, v
    lti z, v, 0
    jz z, p0
    call x, y_ch, 45
    neg u, v
p0: ; u isaretsiz: basamaklari ters sirada SCR alanina (USEDL ile cakismasin: yerel dizi yok -> yigin yerine VV sonu)
    mov nd, 0
p1: lti z, u, 0
    jz z, p2
    ; u >= 2^63 (isaretsiz): q = ((u >> 1) / 5), r = u - 10q (r < 20)
    shri q, u, 1
    divi q, q, 5
    muli t, q, 10
    sub r, u, t
    lti z, r, 10
    jnz z, p3
    addi q, q, 1
    addi r, r, -10
    jmp p3
p2: divi q, u, 10
    muli t, q, 10
    sub r, u, t
p3: addi r, r, 48
    add a, nd, SCRD
    st r, a, 0
    addi nd, nd, 1
    mov u, q
    jnz u, p1
    mov i, nd
p4: jz i, p9
    addi i, i, -1
    add a, i, SCRD
    ld c, a, 0
    call x, y_ch, c
    jmp p4
p9: ret 0
}

; operand tanimlayicisi: tur 0 sayi, 1 gecici v<n>, 2 "i", 3 "ia", 4 "ib", 5 yerel l<n>
func y_op(k, v) {
    eq z, k, 0
    jz z, o1
    call x, y_pnum, v
    ret 0
o1: eq z, k, 1
    jz z, o2
    call x, y_ch, 118
    call x, y_pnum, v
    ret 0
o2: eq z, k, 2
    jz z, o3
    call x, y_ch, 105
    ret 0
o3: eq z, k, 3
    jz z, o4
    call x, y_ch, 105
    call x, y_ch, 97
    ret 0
o4: eq z, k, 4
    jz z, o5
    call x, y_ch, 105
    call x, y_ch, 98
    ret 0
o5: call x, y_ch, 108
    call x, y_pnum, v
    ret 0
}

; bicim metnini (STRT, fid) yaz. '>' satir basi = 4 bosluk, %o d operand, %n d sayi, %A degisken liste, satir ayirici 10, son satira \n eklenir
func y_fmt(fid) {
    add a, fid, STO
    ld p, a, 0
    mov bol, 1
f1: add a, p, STRT
    ld c, a, 0
    addi p, p, 1
    jz c, fend
    eq z, c, 10
    jz z, f2
    call x, y_ch, 10
    mov bol, 1
    jmp f1
f2: jz bol, f3
    mov bol, 0
    eq z, c, 62
    jz z, f3
    call x, y_ch, 32
    call x, y_ch, 32
    call x, y_ch, 32
    call x, y_ch, 32
    jmp f1
f3: eq z, c, 37
    jz z, fc
    add a, p, STRT
    ld t, a, 0
    addi p, p, 1
    eq z, t, 80
    jz z, fP
    ld np, G, 40
    mov j, 0
fp1: ge z, j, np
    jnz z, f1
    jz j, fp2
    call x, y_ch, 44
    call x, y_ch, 32
fp2: call x, y_ch, 108
    call x, y_pnum, j
    addi j, j, 1
    jmp fp1
fP: eq z, t, 65
    jz z, f4
    ; %A : ", " + operand her eleman icin
    ld nv, G, 38
    ld bs, G, 42
    mov j, 0
fa: ge z, j, nv
    jnz z, f1
    call x, y_ch, 44
    call x, y_ch, 32
    add a, j, bs
    add a, a, VK
    ld k, a, 0
    add a, j, bs
    add a, a, VV
    ld v, a, 0
    call x, y_op, k, v
    addi j, j, 1
    jmp fa
f4: add a, p, STRT
    ld d, a, 0
    addi d, d, -48
    addi p, p, 1
    add a, d, AV
    ld v, a, 0
    eq z, t, 111
    jz z, f5
    add a, d, AK
    ld k, a, 0
    call x, y_op, k, v
    jmp f1
f5: call x, y_pnum, v
    jmp f1
fc: call x, y_ch, c
    jmp f1
fend: call x, y_ch, 10
    ret 0
}

func y_sa(i, k, v) {
    add a, i, AK
