// RED: E_COROUTINE  -- promise'li korutin parametreleri tek sozcuklu degerler olmali
struct P2 { int a, b; }; struct T { struct promise_type { T get_return_object() { return T(); } std::suspend_always initial_suspend() { return std::suspend_always(); } std::suspend_always final_suspend() noexcept { return std::suspend_always(); } void return_void() { } void unhandled_exception() { } }; }; T f(P2 p) { co_return; } int main() { return 0; }
