inline int sq(int x) { return x * x; }
inline int add3(int a, int b, int c) { return a + b + c; }
inline double half(double d) { return d * 0.5; }
inline long long mix(int a, long long b) { return a * 3 + b; }
inline int fact(int n) { return n <= 1 ? 1 : n * fact(n - 1); }
inline int twice(int x) { return add3(x, x, 0); }
inline int deref(int* p) { return *p + 1; }
inline int clamp(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }
inline unsigned char tob(int x) { return (unsigned char)x; }
int x = 100;
inline int useg(int a) { return a + x; }
int nonin(int a) { return a * 2; }
int main() {
  int a = 7; int x = 3;
  pi(sq(a)); pi(add3(1, 2, 3)); pd(half(5.0)); pi(mix(2, 10)); pi(fact(5)); pi(twice(21));
  pi(deref(&a)); pi(clamp(15, 0, 10)); pi(clamp(-5, 0, 10)); pi(clamp(5, 0, 10)); pi(tob(300));
  pi(sq(sq(3))); pi(sq(a++)); pi(a); pi(useg(1)); pi(sq(x) + sq(a));
  int (*fp)(int) = sq; pi(fp(9));
  pi(nonin(sq(4)));
  return 0;
}
