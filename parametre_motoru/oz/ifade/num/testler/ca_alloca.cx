int fill(int n) {
  int* p = (int*)alloca(n * 4);
  for (int i = 0; i < n; i++) p[i] = i * 2;
  int s = 0; for (int i = 0; i < n; i++) s += p[i];
  return s;
}
int vla(int n) {
  int* a = (int*)alloca(n * 4);
  for (int i = 0; i < n; i++) a[i] = i + 1;
  long long t = 0; for (int i = 0; i < n; i++) t += a[i];
  return (int)t + n;
}
int rec(int d) { if (d == 0) return 0; int b[50]; int* c = (int*)alloca((d % 7 + 1) * 4); c[0] = d; b[0] = 1; return rec(d - 1) + c[0] + b[0] - d; }
int thr(int n) { char* q = (char*)alloca(1000); q[0] = 1; if (n == 0) throw 5; return thr(n - 1) + q[0]; }
int main() {
  pi(fill(10)); pi(vla(10));
  long long tot = 0;
  for (int k = 0; k < 20000; k++) tot += fill(100);   // her donuste alan serbest: yigin tasmaz
  pi(tot);
  pi(rec(500));
  for (int k = 0; k < 5000; k++) tot += vla(300);
  pi(tot);
  try { thr(50); } catch (int e) { pi(e); }
  for (int k = 0; k < 20000; k++) { try { thr(3); } catch (int e) { tot += e; } }
  pi(tot);
  return 0;
}
