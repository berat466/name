// cekirdek: ortuk/acik sayisal donusumler, terfi, sizeof, sabitler
void fi(int x) { pi(1000 + x); } void fl(long x) { pi(2000 + x); } void fd(double x) { pi(3000); pd(x); }
void fu(unsigned x) { pi(4000 + x); } void fb(bool x) { pi(5000 + x); } void fc(char x) { pi(6000 + x); }
int main() {
  char c = 10; short s = 20; unsigned char uc = 200; bool b = true;
  pi(c + s); pi(uc + uc); pi(b + b); pi(c * uc); pi(sizeof(c + c)); pi(sizeof(b + b)); pi(sizeof(s * s));
  pi(-c); pi(~uc); pi(!uc);
  unsigned short us = 65535; pi(us + 1); pi(us * us); pi(-us); pi(~us); pi(us << 4);
  int neg = -16; pi(neg >> 2); pi(-1 >> 1); unsigned int uh = 0xF0000000u; pi(uh >> 4); signed char sc8 = -128; pi(sc8 >> 3);
  unsigned u = 1; int i = -2;
  pi(i < u); pi(i + u == 4294967295u); pi(sizeof(i + u));
  long l = -1; unsigned long ul = 1; pi(l < ul); pi(sizeof(l + ul));
  pd(i + 0.5); pd(c / 4); pd(c / 4.0f); pi(sizeof(1.0f + 1)); pi(sizeof(1.0f + 1.0));
  float f = 16777217; pd(f); double d = 0.1f; pd(d);
  int fromD = 2.99; pi(fromD); int ng = -2.99; pi(ng);
  unsigned char w = 257; pi(w); signed char sc = 255; pi(sc); short sh = 40000; pi(sh);
  unsigned big = 4294967296ull + 5; pi(big);
  bool bb = 0.5; pi(bb); bool b3 = 7; pi(b3); int* np = 0; bool b4 = np; pi(b4);
  fi(c); fl(c); fd(c); fu(c); fb(c); fc(300); fi(true); fd(3); fd(1.5f);
  pi(static_cast<int>(3.99)); pi(static_cast<unsigned char>(300)); pi(static_cast<char>(200)); pi(static_cast<bool>(5)); pi(static_cast<unsigned>(-1)); pi(static_cast<short>(70000));
  pi((int)3.7 + (int)'a'); pi((double)1 / 4 == 0.25); pi((unsigned char)-1); pi(long(1) << 33);
  pi(0b1010); pi(0777); pi(0xdeadBEEF); pi(1'000'000); pi(sizeof(2147483648)); pi(sizeof(4294967296)); pi(0xFFFFFFFF == -1); pi(4294967295 == -1);
  pi(sizeof(char)); pi(sizeof(short)); pi(sizeof(int)); pi(sizeof(long)); pi(sizeof(float)); pi(sizeof(double)); pi(sizeof(bool)); pi(sizeof(void*)); pi(sizeof(int[10])); pi(sizeof(char[4][5]));
  pi(1 + 'a'); pi('a' + 'b'); pi(sizeof('a' + 'b'));
  return 0;
}
