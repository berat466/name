// cekirdek: islevler, ozyineleme, dongu/break/continue, kayan nokta
int fib(int n) { if (n < 2) return n; return fib(n - 1) + fib(n - 2); }
long long fact(int n) { long long r = 1; for (int i = 2; i <= n; i++) r *= i; return r; }
int gcd(int a, int b) { while (b) { int t = a % b; a = b; b = t; } return a; }
double power(double x, int n) { double r = 1; do { r *= x; n--; } while (n > 0); return r; }
int main() {
  pi(fib(15)); pi(fact(20)); pi(gcd(1071, 462)); pd(power(1.5, 5));
  int s = 0; for (int i = 0; i < 100; i++) { if (i % 3 == 0) continue; if (i > 50) break; s += i; } pi(s);
  int w = 10; while (w > 0) { w -= 3; } pi(w);
  double x = 1.0; for (int i = 0; i < 30; i++) x = (x + 2.0 / x) / 2; pd(x);
  unsigned long long h = 1469598103934665603ull; for (int i = 0; i < 8; i++) h = (h ^ (unsigned)i) * 1099511628211ull; pi(h > 0);
  return 0;
}
