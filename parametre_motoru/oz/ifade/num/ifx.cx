void hdr_params(int np) { int i = 0; while (i < np) { if (i) w(", "); w("p"); wn(i); i = i + 1; } }
void gen_dispatchers() {
  int f = 0;
  while (f < nfn) {
    if (fn_has(f, F_VIRT) && fn_vroot[f] == f) {
      int rt = fn_ret[f]; int sret = is_mem(unq(rt)) && is_ref(rt) == 0; int np = fn_np[f] + 1 + sret; int i = 0;
      int rk_ = 0 - 1; if (sret == 0 && is_void(rt) == 0) rk_ = ret_kind(rt);
      w("func vd"); wn(f); w("("); hdr_params(np); w(") {\n");
      if (rk_ < 0) pm_begin(0); else pm_begin(kt_ty[rk_]);
      if (sret) pm_add(1); pm_add(1); i = 0; while (i < fn_np[f]) { pm_add(param_kind(fn_pt[f * 8 + i])); i = i + 1; }
      w("  ld dI, p"); wn(sret); w(", 0\n  mov kI, 0\n  eq cB, kI, kI\n  mov mI, -1\n"); pm_add(0); pm_add(0); pm_add(3); pm_add(0);
      int c = 0; int lab = 0; int usedr = 0;
      while (c < ncl) {
        if (cl_def[c] && cl_bi[c] == 0 && derived_from(c, fn_cls[f])) {
          int fin = final_overrider(c, f);
          if (fn_has(fin, F_PURE) == 0) {
            fn_used[fin] = 1; w("  mov kI, "); wn(cl_id[c]); w("\n  eq cB, dI, kI\n  jz cB, _n"); wn(lab); wc(10);
            if (rk_ >= 0) { if (usedr == 0) pm_add(rk_); w("  call rX, f"); } else w("  call f");
            wn(fin); i = 0; while (i < np) { w(", p"); wn(i); i = i + 1; } wc(10); note_win(np);
            if (rk_ >= 0) w("  ret rX\n"); else w("  ret mI\n");
            w("_n"); wn(lab); w(":\n"); lab = lab + 1; usedr = 1;
          }
        }
        c = c + 1;
      }
      w("  ld tI, mI, 0\n"); pm_add(0);
      if (rk_ >= 0 && usedr == 0) die("E_DESTEK", "sanal islevin hicbir gecersiz kilicisi yok");
      if (rk_ >= 0) w("  ret rX\n"); else w("  ret mI\n");
      w("}\n"); pm_end();
    }
    f = f + 1;
  }
  if (corun_used) {
    int q = 0;
    w("func corun(p0) {\n"); pm_begin(kt_ty[0]); pm_add(1);
    w("  ld iI, p0, 2\n  mov kI, 0\n  eq cB, iI, kI\n"); pm_add(0); pm_add(0); pm_add(3); int first = 1; int lab = 0;
    while (q < nfn) { if (fn_co[q] && fn_body_node(q) >= 0) { w("  mov kI, "); wn(q + 1); w("\n  eq cB, iI, kI\n  jz cB, _c"); wn(lab); w("\n  call rI, fc"); wn(q); w(", p0\n  ret rI\n_c"); wn(lab); w(":\n"); if (first) { pm_add(0); first = 0; } lab = lab + 1; } q = q + 1; }
    w("  mov zI, 0\n  ret zI\n}\n"); pm_add(0); note_win(1); pm_end();
  }
  int k = 0;
  while (k < nisa) {
    int d = isa_need[k]; w("func isa"); wn(d); w("(p0) {\n"); pm_begin(kt_ty[0]); pm_add(0);
    w("  mov zI, 0\n  mov oI, 1\n  mov kI, 0\n  eq cB, kI, kI\n"); pm_add(0); pm_add(0); pm_add(0); pm_add(3); int c = 0;
    while (c < ncl) { if (cl_def[c] && derived_from(c, d)) { w("  mov kI, "); wn(cl_id[c]); w("\n  eq cB, p0, kI\n  jnz cB, _yes\n"); } c = c + 1; }
    w("  ret zI\n_yes:\n  ret oI\n}\n"); pm_end(); k = k + 1;
  }
  if (tiname_used) {
    w("func tiname(p0) {\n"); pm_begin(kt_ty[1]); pm_add(0); int c = 0; int sn = 0;
    w("  mov kI, 0\n  eq cB, kI, kI\n  mov rU, __sp\n  mov zU, 0\n"); pm_add(0); pm_add(3); pm_add(1); pm_add(1);
    while (c < ncl) { if (cl_def[c] && cl_bi[c] == 0) { int nm = mangle(clsty(c)); str_node[nstrn] = 0 - 1 - nm; nstrn = nstrn + 1; w("  mov kI, "); wn(cl_id[c]); w("\n  eq cB, p0, kI\n  jz cB, _nx"); wn(cl_id[c]); w("\n  mov rU, s"); wn(nstrn - 1); w("\n  ret rU\n_nx"); wn(cl_id[c]); w(":\n"); } c = c + 1; }
    int q = 0; while (q < nti_seen) { int id = ti_seen[q]; int t = ti_types[id % 600]; if (id >= 1000) { int nm = mangle(t); str_node[nstrn] = 0 - 1 - nm; nstrn = nstrn + 1; w("  mov kI, "); wn(id); w("\n  eq cB, p0, kI\n  jz cB, _ny"); wn(id); w("\n  mov rU, s"); wn(nstrn - 1); w("\n  ret rU\n_ny"); wn(id); w(":\n"); } q = q + 1; }
    w("  ret zU\n}\n"); pm_end();
  }
}
