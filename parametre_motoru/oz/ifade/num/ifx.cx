void finish_defaulted(int ci) {   // layout sonrasi: <=> donus turunu cikar, ortuk == ekle
  int f = 0; int hasEq = 0; int defCmp = 0 - 1; int n0 = nfn;
  while (f < n0) { if (fn_cls[f] == ci && fn_name[f] == N_EQ) hasEq = 1; if (fn_cls[f] == ci && fn_name[f] == N_SS && fn_has(f, F_DEFAULT)) defCmp = f; f = f + 1; }
  f = 0;
  while (f < n0) {
    if (fn_cls[f] == ci && fn_has(f, F_DEFAULT)) {
      int p = fn_pt[f * 8]; if (fn_np[f] != 1 || is_ref(p) == 0 || tcv[te[p]] == 0 || unq(te[p]) != clsty(ci) || fn_has(f, F_CONST) == 0) die("E_DEFAULT", "varsayilan karsilastirma 'const S&' parametreli const uye islev olmali");
