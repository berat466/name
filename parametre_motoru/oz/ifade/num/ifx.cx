  if (tovoid) { if (cl_poly[srcc] == 0) die("E_DYNCAST", "dynamic_cast<void*> polimorfik sinif gerektirir"); V o = objaddr; o.ty = unq(T); o.cat = 0; return o; }
  int dc = tcl[unq(tgtT)];
  if (derived_from(srcc, dc)) { if (ref) { V o = v; o.ty = tgtT; if (tk[T] == Y_RREF) o.cat = 2; return o; } V o = objaddr; o.ty = unq(T); o.cat = 0; return o; }
  int k = 0; int found = 0; while (k < nisa) { if (isa_need[k] == dc) found = 1; k = k + 1; } if (found == 0) { isa_need[nisa] = dc; nisa = nisa + 1; }
  long long id = newreg(); long long c = newreg(); int ok = newlab();
  if (ref) {
    may_throw = 1;
    e_ld(id, 0, objaddr, 0); setk(c, 0); w("  call "); wr(c); w(", isa"); wn(dc); w(", "); wr(id); wc(10); note_win(1); e_jcc("jnz", mkv(0, 0, c), ok); throw_named("std::bad_cast"); wl(ok); w(":\n");
    V o = v; o.ty = tgtT; o.cat = 1; if (tk[T] == Y_RREF) o.cat = 2; o.vp = 1; return o;
  }
  long long res = newreg(); int end = newlab();
  { long long z = e_movi(1, 0); e_mov(res, 1, mkv(0, 0, z)); }
  e_jcc("jz", objaddr, end); e_ld(id, 0, objaddr, 0); setk(c, 0); w("  call "); wr(c); w(", isa"); wn(dc); w(", "); wr(id); wc(10); note_win(1); e_jcc("jz", mkv(0, 0, c), end); e_mov(res, 1, objaddr); wl(end); w(":\n");
  V o = mkv(unq(T), 0, res); merge_eff(o, base); return o;
}
V c_style_cast(V v, int T) {   // C tipi donusum: const_cast, static_cast, reinterpret_cast sirasi (onceden kosullarla secilir)
  if (is_ref(T)) {
    int tu = unq(te[T]); int au = unq(v.ty);
    if (au == tu && tcv[v.ty] != tcv[te[T]]) return const_cast_(v, T);
    if (au == tu || (is_cls(au) && is_cls(tu) && (derived_from(tcl[au], tcl[tu]) || derived_from(tcl[tu], tcl[au])))) return static_cast_(v, T);
    return reinterpret_cast_(v, T);
  }
  if (is_ptr(T)) {
    V r = rval(v);
    if (is_ptr(r.ty)) {
      int fe = te[r.ty]; int tee = te[T];
      if (unq(fe) == unq(tee) && tcv[fe] != tcv[tee]) return const_cast_(r, T);
      if (unq(fe) == unq(tee) || is_void(fe) || is_void(tee) || (is_cls(fe) && is_cls(tee) && (derived_from(tcl[fe], tcl[tee]) || derived_from(tcl[tee], tcl[fe])))) return static_cast_(r, T);
      return reinterpret_cast_(r, T);
    }
    if (is_int(r.ty) && r.ci && r.cv == 0) return static_cast_(r, T);
    if (tk[r.ty] == Y_NULLPTR) return static_cast_(r, T);
    return reinterpret_cast_(r, T);
  }
  if (is_int(T) && tk[T] != Y_BOOL) { V r = rval(v); if (is_ptr(r.ty)) return reinterpret_cast_(r, T); }
  return static_cast_(v, T);
}
V gen_cast(int n) {
  curline = nk_line[n]; int T = typeof_(kid(n, 0));
  if (tk[T] == Y_AUTO) die("E_TYPE", "auto donusum hedefi olamaz");
  V v = gen(kid(n, 1)); int s = nk_s1[n];
  if (seqc(s, "static_cast")) return static_cast_(v, T);
  if (seqc(s, "dynamic_cast")) return dynamic_cast_(v, T);
  if (seqc(s, "const_cast")) return const_cast_(v, T);
  if (seqc(s, "reinterpret_cast")) return reinterpret_cast_(v, T);
  // C tipi: once static, olmazsa const_cast / reinterpret_cast (hata tuzagi ile degil: on-deneme)
  return c_style_cast(v, T);
}
// ---- typeid / sizeof / noexcept / UDL ----
int type_name_buf = 0;
void mangle_into(int t, int pos_unused);
char mgb[300]; int mgn = 0;
void mg_c(const char* s) { while (*s) { mgb[mgn] = *s; mgn = mgn + 1; s++; } }
void mg_n(long long v) { if (v >= 10) mg_n(v / 10); mgb[mgn] = '0' + (v % 10); mgn = mgn + 1; }
void mangle_rec(int t) {
  if (tcv[t]) mg_c("K");
  int k = tk[t];
  if (k == Y_VOID) mg_c("v"); else if (k == 1) mg_c("b"); else if (k == 2) mg_c("c"); else if (k == 3) mg_c("a"); else if (k == 4) mg_c("h"); else if (k == 5) mg_c("s"); else if (k == 6) mg_c("t");
  else if (k == 7) mg_c("i"); else if (k == 8) mg_c("j"); else if (k == 9) mg_c("l"); else if (k == 10) mg_c("m"); else if (k == 11) mg_c("x"); else if (k == 12) mg_c("y"); else if (k == 13) mg_c("f");
  else if (k == 14) mg_c("d"); else if (k == 15) mg_c("e"); else if (k == 24) mg_c("g"); else if (k == 16) mg_c("Dn");
  else if (k == Y_PTR) { mg_c("P"); mangle_rec(te[t]); }
  else if (k == Y_ARR) { mg_c("A"); mg_n(tn[t]); mg_c("_"); mangle_rec(te[t]); }
  else if (k == Y_CLASS) { int nm = cl_name[tcl[t]]; mg_n(s_len[nm]); int i = 0; while (i < s_len[nm]) { mgb[mgn] = chars[s_off[nm] + i]; mgn = mgn + 1; i = i + 1; } }
}
int mangle(int t) { mgn = 0; mangle_rec(t); mgb[mgn] = 0; return intern_n(mgb, mgn); }
V typeid_v(int id) {
  int ti = find_class(intern_c("std::type_info")); V t = tempobj(withc(clsty(ti), 1)); e_sti(id, t, 0); t.cat = 1; return t;
}
V gen_typeid(int n) {
  curline = nk_line[n];
  if (nk_k[n] == N_TYPEID_T) { int t = typeof_(kid(n, 0)); int id = type_id_of(t); note_typeid(id, unq(deref(t))); return typeid_v(id); }
  int sv = may_throw; dry = dry + 1; V probe = gen(kid(n, 0)); dry = dry - 1; may_throw = sv;
  int pt = unq(probe.ty);
  if (is_cls(pt) && cl_poly[tcl[pt]] && probe.cat != 0) {
    tid_node = kid(n, 0); V o = gen(kid(n, 0)); tid_node = 0 - 1; may_throw = 1; long long id = newreg(); e_ld(id, 0, o, 0);
    int ti = find_class(intern_c("std::type_info")); V t = tempobj(withc(clsty(ti), 1)); e_st(mkv(0, 0, id), t, 0); t.cat = 1; return t;
  }
  int id = type_id_of(probe.ty); note_typeid(id, unq(deref(probe.ty))); return typeid_v(id);
}
V gen_sizeof(int n) {
  curline = nk_line[n]; int t;
  if (nk_k[n] == N_SIZEOF_E) { int sv = may_throw; dry = dry + 1; V v = gen(kid(n, 0)); dry = dry - 1; may_throw = sv; if (is_void(v.ty)) die("E_SIZEOF", "void ifadenin boyutu alinamaz"); t = v.ty; }
  else t = typeof_(kid(n, 0));
  t = deref(t);
  if (is_void(t) || complete_obj(t) == 0) die("E_SIZEOF", "tamamlanmamis/void turun boyutu alinamaz");
  if (is_arr(t) && tn[t] < 0) die("E_SIZEOF", "boyutsuz dizi");
  long long val = size_of(t); if (nk_k[n] == N_ALIGNOF) val = align_of(t);
  return imm(mkt(Y_ULONG, 0 - 1, 0), val);
}
V gen_udl(int n) {
  curline = nk_line[n]; int kind = nk_k[n]; int suf = nk_s2[n];
  char nb[100]; int k = 0; const char* pre = "operator\"\""; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (j < s_len[suf]) { nb[k] = chars[s_off[suf] + j]; k = k + 1; j = j + 1; } nb[k] = 0;
  int nm = intern_c(nb); V args[2]; int na; int want = 0;
  if (kind == N_INT) { na = 1; want = mkt(Y_ULLONG, 0 - 1, 0); args[0] = imm(want, nk_i[n]); }
  else if (kind == N_FLT) { na = 1; want = ldty(); args[0] = ld_const(nk_i[n], nk_d[n], 0); }
  else if (kind == N_CHR) { na = 1; want = mkt(Y_CHAR, 0 - 1, 0); args[0] = imm(want, fold(nk_i[n], want)); }
  else {
    na = 2; str_node[nstrn] = n; nstrn = nstrn + 1; long long p = newreg(); setk(p, 1); w("  mov "); wr(p); w(", s"); wn(nstrn - 1); wc(10);
    args[0] = mkv(ptrto(withc(mkt(Y_CHAR, 0 - 1, 0), 1)), 0, p); args[1] = imm(mkt(Y_ULONG, 0 - 1, 0), slen(nk_s1[n]));
  }
  int found = 0 - 1; int f = 0; int cnt = 0;
  while (f < nfn) {
    if (fn_cls[f] < 0 && fn_name[f] == nm && fn_np[f] == na) {
      int ok = 0;
      if (kind == N_STR) ok = is_ptr(fn_pt[f * 8]) && unq(fn_pt[f * 8 + 1]) == mkt(Y_ULONG, 0 - 1, 0); else ok = unq(fn_pt[f * 8]) == want;
      if (ok) { found = f; cnt = cnt + 1; }
    }
    f = f + 1;
  }
  if (cnt == 0) die("E_UDL", "uygun kullanici tanimli sabit isleci yok");
  if (cnt > 1) die("E_AMBIG", "birden fazla uygun sabit isleci");
  return callfn(found, 0, args, na, 0);
}
// ============================ LAMBDA (Bolum 04) ============================
// Her lambda ifadesi bir KAPANIS SINIFI uretir: yakalamalar alanlar (ad = yakalanan ad), operator() uye islevi (const; mutable ise degil), govde lambda dugumunun kendisidir
// (dugum {donus, parametreler, govde, yakalamalar...} -> N_FUNC ile ayni ilk 3 cocuk). Sinif dugum basina bir kez uretilir (kuru/gercek gecis ve tekrarli uretim ayni sinifi kullanir).
int lam_cnt = 0; int lam_cls[NN]; int scan_cnt = 0; int scan_nm[64]; int scan_this = 0;
void stmt(int n);
int deduce_lambda_ret(int n, int np, int* pt, int ci);
void scan_names(int n) {
  int k = nk_k[n];
  if (k == N_THIS) scan_this = 1;
  if (k == N_ID) { int nm = nk_s1[n]; int i = 0; int has = 0; while (i < scan_cnt) { if (scan_nm[i] == nm) has = 1; i = i + 1; } if (has == 0 && scan_cnt < 64) { scan_nm[scan_cnt] = nm; scan_cnt = scan_cnt + 1; } }
  int i2 = 0; while (i2 < nk_n[n]) { scan_names(kid(n, i2)); i2 = i2 + 1; }
}
int add_lambda_fn(int n, int np, int* pt, int ret, int cls, int fl, int nm) {
  int f = nfn; if (f >= NF) die("E_SINIR", "cok fazla islev");
  fn_name[f] = nm; fn_cls[f] = cls; fn_node[f] = n; fn_fl[f] = fl; fn_bi[f] = 0; fn_vroot[f] = 0 - 1; fn_used[f] = 1; fn_line[f] = nk_line[n]; fn_np[f] = np; fn_va[f] = 0; fn_ret[f] = ret; fn_co[f] = 0;
  int params = kid(n, 1); int i = 0; fn_ndef[f] = 0;
  while (i < np) { fn_pt[f * 8 + i] = pt[i]; int pn_ = kid(params, i); int dn = 0 - 1; if (nk_n[pn_] > 1) { dn = kid(pn_, 1); fn_ndef[f] = fn_ndef[f] + 1; } fn_pdef[f * 8 + i] = dn; i = i + 1; }
  nfn = nfn + 1; return f;
}
int lam_name(const char* pre) {
  int k = 0; while (pre[k]) { tmpb[k] = pre[k]; k = k + 1; }
  int v = lam_cnt; int d = 1; while (v / (d * 10) > 0) d = d * 10;
  while (d > 0) { tmpb[k] = '0' + (v / d) % 10; k = k + 1; d = d / 10; }
  tmpb[k] = 0; return intern_n(tmpb, k);
}
int lam_param_type(int pnode) { int P = typeof_(kid(pnode, 0)); if (is_arr(P)) P = ptrto(te[P]); if (is_ref(P) == 0 && tk[P] != Y_AUTO) P = unq(P); return P; }
int lam_is_auto(int P) { return tk[P] == Y_AUTO || (is_ref(P) && tk[te[P]] == Y_AUTO); }
int lam_flags(int n) { int fl = F_CONST; if (nk_i[n] & 1) fl = 0; if (nk_i[n] & 2) fl = fl | F_NOEX; return fl; }
int create_closure(int n) {
  int ci = newclass(lam_name("__lambda")); int fname = lam_name("__lamf"); lam_cnt = lam_cnt + 1;
  cl_f0[ci] = nfl; cl_nf[ci] = 0; lam_cls[n] = ci + 1; cl_lam[ci] = n + 1;
  int params = kid(n, 1); int np = nk_n[params]; if (np > 8) die("E_SINIR", "cok fazla parametre");
  int ncap = 0; int cmode[64]; int csrc[64]; int cnm[64]; int implicit_this = 0;
  int i = 3;
  while (i < nk_n[n]) {   // acik yakalamalar
    int c = kid(n, i); i = i + 1; int mode = nk_j[c]; int nm = nk_s1[c];
    if (mode == 3) die("E_DESTEK", "[*this] yakalamasi desteklenmiyor");
    if (ncap >= 60) die("E_SINIR", "cok fazla yakalama");
    int q = 0; while (q < ncap) { if (cnm[q] == nm) die("E_REDECL", "yakalama yinelendi"); q = q + 1; }
    if (mode == 2) { cmode[ncap] = 2; cnm[ncap] = N_LTHIS; csrc[ncap] = 0 - 1; }
    else {
      cnm[ncap] = nm; cmode[ncap] = mode;
      if (nk_i[c] == 1) csrc[ncap] = kid(c, 0); else csrc[ncap] = mknode(N_ID, 0, nm, nk_line[n], 0, 0, 0, 0);
    }
    ncap = ncap + 1;
  }
  int dm = nk_j[n];
  if (dm != 0 || 1) {   // govdeyi tara: ortuk yakalamalar (varsayilan yakalama) ve this kullanimi
    scan_cnt = 0; scan_this = 0; scan_names(kid(n, 2));
    int q = 0;
    while (q < scan_cnt) {
      int nm = scan_nm[q]; q = q + 1;
      int dupl = 0; int z = 0; while (z < ncap) { if (cnm[z] == nm) dupl = 1; z = z + 1; }
      z = 0; while (z < np) { if (nk_s1[kid(params, z)] == nm) dupl = 1; z = z + 1; }
      if (dupl || dm == 0) continue;
      int vi = findvar(nm);
      if (vi >= 0 && nm != N_THISV) { if (ncap >= 60) die("E_SINIR", "cok fazla yakalama"); cnm[ncap] = nm; cmode[ncap] = dm == 2; csrc[ncap] = mknode(N_ID, 0, nm, nk_line[n], 0, 0, 0, 0); ncap = ncap + 1; }
      else if (vi < 0 && cur_cls >= 0 && find_field(cur_cls, nm) >= 0) {
        if (cl_lam[cur_cls] != 0) { if (ncap >= 60) die("E_SINIR", "cok fazla yakalama"); cnm[ncap] = nm; cmode[ncap] = dm == 2; csrc[ncap] = mknode(N_ID, 0, nm, nk_line[n], 0, 0, 0, 0); ncap = ncap + 1; }
        else implicit_this = 1;
      }
      else if (vi < 0 && cur_cls >= 0 && cl_enc[cur_cls] >= 0 && find_field(cl_enc[cur_cls], nm) >= 0) implicit_this = 1;
    }
    if (dm != 0 && scan_this) implicit_this = 1;
    if (implicit_this) { int has = 0; int z = 0; while (z < ncap) { if (cmode[z] == 2) has = 1; z = z + 1; } if (has == 0 && cur_cls >= 0) { cmode[ncap] = 2; cnm[ncap] = N_LTHIS; csrc[ncap] = 0 - 1; ncap = ncap + 1; } }
  }
  i = 0;
  while (i < ncap) {   // alanlar
    int T;
    if (cmode[i] == 2) { int thv = findvar(N_THISV); if (thv < 0) die("E_THIS", "[this] yakalamasi uye islev disinda"); T = vty[thv]; cl_enc[ci] = cur_cls; if (cl_lam[cur_cls] != 0 && cl_enc[cur_cls] >= 0) cl_enc[ci] = cl_enc[cur_cls]; }
    else {
      int sv = may_throw; dry = dry + 1; V pv = gen(csrc[i]); dry = dry - 1; may_throw = sv;
      if (cmode[i] == 1) { if (pv.cat != 1) die("E_CAPTURE", "basvuru yakalamasi lvalue gerektirir"); T = ptrto(pv.ty); }
      else { T = unq(pv.ty); if (is_arr(T)) T = ptrto(te[T]); if (is_void(T)) die("E_TYPE", "void yakalama"); }
    }
    fl_name[nfl] = cnm[i]; fl_ty[nfl] = T; fl_woff[nfl] = 0; fl_boff[nfl] = 0; fl_ref[nfl] = cmode[i] == 1; fl_srcn[nfl] = csrc[i]; fl_kind[nfl] = cmode[i]; nfl = nfl + 1; cl_nf[ci] = cl_nf[ci] + 1; i = i + 1;
  }
  layout_class(ci);
  int pt[8]; int isgen = 0; i = 0;
  while (i < np) { int P = lam_param_type(kid(params, i)); if (lam_is_auto(P)) isgen = 1; pt[i] = P; i = i + 1; }
  if (isgen) { cl_lamgen[ci] = 1; return ci; }
  int ret; if (nk_k[kid(n, 0)] != N_NONE) ret = typeof_(kid(n, 0)); else ret = deduce_lambda_ret(n, np, pt, ci);
  add_lambda_fn(n, np, pt, ret, ci, lam_flags(n), N_CALLOP);
  if (ncap == 0) cl_lamfree[ci] = add_lambda_fn(n, np, pt, ret, 0 - 1, lam_flags(n) & F_NOEX, fname);
  return ci;
}
V gen_lambda(int n) {
  curline = nk_line[n];
  int ci; if (lam_cls[n] == 0) ci = create_closure(n); else ci = lam_cls[n] - 1;
  V obj = tempobj(clsty(ci));
  int fi = cl_f0[ci]; int e = fi + cl_nf[ci];
  while (fi < e) {
    long long woff = fl_woff[fi]; int fty = fl_ty[fi]; int kd = fl_kind[fi];
    long long fa = obj.reg; if (woff != 0) fa = e_addi(obj, woff); V faddr = mkv(0, 1, fa);
    if (kd == 2) { V th = this_value(); e_st(th, faddr, 0); }
    else if (kd == 1) { V v = gen(fl_srcn[fi]); if (v.cat != 1) die("E_CAPTURE", "basvuru yakalamasi lvalue gerektirir"); no_bytelv(v); V vm = mat(v); e_st(mkv(0, 0, vm.reg), faddr, 0); }
    else {
      V v = gen(fl_srcn[fi]);
      if (is_mem(unq(fty))) { V c = to_mem_value(v, fty); V dst = mkv(fty, 1, fa); copy_n(dst, c, 0, words_of(fty)); if (is_cls(unq(fty)) && cl_poly[tcl[unq(fty)]]) set_vptr(dst, tcl[unq(fty)]); }
      else if (is_arr(fty) == 0) { V sc = to_scalar(v, fty, 0); e_st(mat(sc), faddr, 0); }
    }
    fi = fi + 1;
  }
  return obj;
}
int lamgi_n[256]; int lamgi_pt[256 * 8]; int lamgi_f[256]; int nlamgi = 0;
int lam_inst_types(int ci, V* av, int na, int* pt) {
  int n = cl_lam[ci] - 1; int params = kid(n, 1); int np = nk_n[params];
  if (na != np) die("E_NOVIABLE", "genel lambda: arguman sayisi parametre sayisina esit olmali");
  int i = 0;
  while (i < np) {
    int P = lam_param_type(kid(params, i));
    if (tk[P] == Y_AUTO) { int T = unq(av[i].ty); if (is_arr(T)) T = ptrto(te[T]); if (is_void(T)) die("E_TYPE", "void arguman"); pt[i] = T; }
    else if (is_ref(P) && tk[te[P]] == Y_AUTO) {
      int c = tcv[te[P]]; int T = unq(av[i].ty); int cv = c;
      if (tk[P] == Y_REF) pt[i] = lref(withc(T, cv));
      else { if (av[i].cat == 1 && c == 0) { pt[i] = lref(withc(T, tcv[av[i].ty])); } else if (av[i].cat == 1) pt[i] = lref(withc(T, 1)); else pt[i] = rref(withc(T, cv)); }
    }
    else pt[i] = P;
    i = i + 1;
  }
  return np;
}
int lam_instantiate(int ci, V* av, int na) {
  int n = cl_lam[ci] - 1; int pt[8]; int np = lam_inst_types(ci, av, na, pt);
  int i = 0; while (i < nlamgi) { if (lamgi_n[i] == n) { int k = 0; int same = 1; while (k < np) { if (lamgi_pt[i * 8 + k] != pt[k]) same = 0; k = k + 1; } if (same) return lamgi_f[i]; } i = i + 1; }
  if (nlamgi >= 256) die("E_SINIR", "cok fazla genel lambda ornegi");
  int ret; if (nk_k[kid(n, 0)] != N_NONE) ret = typeof_(kid(n, 0)); else ret = deduce_lambda_ret(n, np, pt, ci);
  int f = add_lambda_fn(n, np, pt, ret, ci, lam_flags(n), N_CALLOP);
  lamgi_n[nlamgi] = n; lamgi_f[nlamgi] = f; i = 0; while (i < np) { lamgi_pt[nlamgi * 8 + i] = pt[i]; i = i + 1; } nlamgi = nlamgi + 1;
  return f;
}
int lamfi_n[128]; int lamfi_f[128]; int lamfi_t[128]; int nlamfi = 0;
V lam_to_fnptr(V v, int to) {
  int ci = tcl[unq(v.ty)]; int n = cl_lam[ci] - 1; int want = unq(te[to]);
  if (cl_enc[ci] >= 0) die("E_CONV", "yakalamali lambda islev isaretcisine donusturulemez");
  int f = cl_lamfree[ci];
  if (cl_lamgen[ci]) {   // genel lambda: hedef imza turleriyle ornekle
    int sg = fn_sig(want); int np = sig_np[sg]; int i = 0; while (i < nlamfi) { if (lamfi_n[i] == n && lamfi_t[i] == want) { f = lamfi_f[i]; } i = i + 1; }
    if (f < 0 || cl_lamfree[ci] < 0) {
      int pt[8]; i = 0; while (i < np) { pt[i] = sig_pt[sg * 8 + i]; i = i + 1; }
      int ret = te[want]; int ff = add_lambda_fn(n, np, pt, ret, 0 - 1, lam_flags(n) & F_NOEX, lam_name("__lamf"));
      if (nlamfi < 128) { lamfi_n[nlamfi] = n; lamfi_f[nlamfi] = ff; lamfi_t[nlamfi] = want; nlamfi = nlamfi + 1; } lam_cnt = lam_cnt + 1; f = ff;
    }
  }
  if (f < 0) die("E_CONV", "bu lambda islev isaretcisine donusturulemez");
  int ft = fn_type_of(f);
  if (!(ft == want || (te[ft] == te[want] && fn_sig(ft) == fn_sig(want) && tcl[ft] == tcl[want] && fn_ne(ft) >= fn_ne(want)))) die("E_CONV", "lambda imzasi islev isaretcisi turuyle uyusmuyor");
  return fnaddr(f);
}
// Bolum 04.032: alloca / degisken boyutlu yigin nesnesi -- __sp'nin ustune dinamik alan; islev donusunde emit_ret '__sp = fp' ile kendiliginden serbest birakilir (istisna yayilimi dahil: her cerceve normal doner)
int has_alloca = 0;
V emit_alloca(V cnt) {
  cnt = rval(cnt); if (is_int(unq(cnt.ty)) == 0) die("E_TYPE", "alloca boyutu tamsayi olmali");
  V c = to_scalar(cnt, mkt(Y_LONG, 0 - 1, 0), 0); c = mat_k(c, 0);
  long long z = e_movi(0, 0); long long neg = newreg(); ins3("lt", neg, c, mkv(0, 0, z)); int okn = newlab(); e_jcc("jz", mkv(0, 0, neg), okn); trapnow(); wl(okn); w(":\n");
  long long one = e_movi(0, 1); long long small = newreg(); ins3("lt", small, c, mkv(0, 0, one)); long long w1 = newreg(); setk(w1, 0); ins3("add", w1, c, mkv(0, 0, small));   // en az 1 sozcuk
  long long spa = newreg(); setk(spa, 1); w("  mov "); wr(spa); w(", __sp\n"); long long cur = newreg(); e_ld(cur, 1, mkv(0, 0, spa), 0);
  long long nw = newreg(); setk(nw, 1); ins3("add", nw, mkv(0, 0, cur), mkv(0, 0, w1));
  long long ovf = newreg(); ins3("ltu", ovf, mkv(0, 0, nw), mkv(0, 0, cur)); int ok1 = newlab(); e_jcc("jz", mkv(0, 0, ovf), ok1); trapnow(); wl(ok1); w(":\n");
  long long lma = newreg(); setk(lma, 1); w("  mov "); wr(lma); w(", __lim\n"); long long lim = newreg(); e_ld(lim, 1, mkv(0, 0, lma), 0);
  long long okc = newreg(); ins3("leu", okc, mkv(0, 0, nw), mkv(0, 0, lim)); int ok2 = newlab(); e_jcc("jnz", mkv(0, 0, okc), ok2); trapnow(); wl(ok2); w(":\n");
  e_st(mkv(0, 0, nw), mkv(0, 0, spa), 0); has_alloca = 1;
  V r = mkv(ptrto(mkt(Y_VOID, 0 - 1, 0)), 0, cur); return r;
}
V gen_vastart(int n) {
  V ap = gen(kid(n, 0)); if (is_cls(unq(ap.ty)) == 0 || cl_bi[tcl[unq(ap.ty)]] != 7) die("E_VARARGS", "va_start: va_list gerekli");
  int vp = findvar(N_VAP); int vn = findvar(N_VAN); if (vp < 0 || vn < 0) die("E_VARARGS", "va_start yalniz degisken sayili islevde kullanilabilir");
  V a1 = var_ref(vp); V p1 = rval(a1); V a2 = var_ref(vn); V c1 = rval(a2);
  e_st(p1, ap, 0); e_st(c1, ap, 1); return novalue();
}
V gen_vaarg(int n) {
  V ap = gen(kid(n, 0)); if (is_cls(unq(ap.ty)) == 0 || cl_bi[tcl[unq(ap.ty)]] != 7) die("E_VARARGS", "va_arg: va_list gerekli");
  int T = unq(typeof_(kid(n, 1))); if (is_sc(T) == 0 || is_ld(T)) die("E_VARARGS", "va_arg: skaler tur gerekli");
  long long rem = newreg(); e_ld(rem, 0, ap, 1); int okl = newlab(); e_jcc("jnz", mkv(0, 0, rem), okl); trapnow(); wl(okl); w(":\n");
  long long cur = newreg(); e_ld(cur, 1, ap, 0);
  long long val = newreg(); e_ld(val, kind_for(T), mkv(0, 0, cur), 0);
  long long nc = e_addi(mkv(0, 0, cur), 1); e_st(mkv(0, 0, nc), ap, 0);
  long long nr = newreg(); ins3("sub", nr, mkv(0, 0, rem), imm(0, 1)); e_st(mkv(0, 0, nr), ap, 1);
  V r = mkv(T, 0, val); return norm(r, T);
}
V gen(int n) {
  int k = nk_k[n]; curline = nk_line[n];
  if (k == N_INT) { if (nk_s2[n] >= 0) return gen_udl(n); V v = imm(mkt(nk_j[n], 0 - 1, 0), nk_i[n]); if (nk_i[n] == 0) v.nl = 1; return v; }
  if (k == N_CHR) { if (nk_s2[n] >= 0) return gen_udl(n); return imm(mkt(Y_CHAR, 0 - 1, 0), fold(nk_i[n], mkt(Y_CHAR, 0 - 1, 0))); }
  if (k == N_BOOL) return imm(bool_t(), nk_i[n]);
  if (k == N_NULLPTR) return imm(mkt(Y_NULLPTR, 0 - 1, 0), 0);
  if (k == N_FLT) {
    if (nk_s2[n] >= 0) return gen_udl(n);
    int t = mkt(nk_j[n], 0 - 1, 0);
    if (is_ld(t)) return ld_const(nk_i[n], nk_d[n], wfmt(t));
    V f = fconst(t, nk_d[n]); return norm(f, t);
  }
  if (k == N_STR) {
    if (nk_s2[n] >= 0) return gen_udl(n);
    str_node[nstrn] = n; nstrn = nstrn + 1; V v = mkv(arrof(withc(mkt(Y_CHAR, 0 - 1, 0), 1), slen(nk_s1[n]) + 1), 1, newreg()); setk(v.reg, 1); w("  mov "); wr(v.reg); w(", s"); wn(nstrn - 1); wc(10); return v;
  }
  if (k == N_THIS) { if (cur_cls >= 0 && cl_enc[cur_cls] >= 0) { int tf = find_field(cur_cls, N_LTHIS); V th0 = this_value(); long long tw = fq_woff; int tty = fq_ty; long long ta = th0.reg; if (tw != 0) ta = e_addi(th0, tw); long long tp = newreg(); e_ld(tp, 1, mkv(0, 0, ta), 0); return mkv(tty, 0, tp); } return this_value(); }
  if (k == N_ID) return gen_id(n);
  if (k == N_UNARY) return gen_unary(n);
  if (k == N_BINARY) return gen_binary(n);
  if (k == N_ASSIGN) return gen_assign(n);
  if (k == N_PREINC || k == N_POSTINC) return gen_incdec(n);
  if (k == N_COND) return gen_cond(n);
  if (k == N_COMMA) { V l = gen(kid(n, 0)); V r = gen(kid(n, 1)); int i = 0; V r2 = r; r2.ne = 0; while (i < l.ne) { add_eff(r2, l.ek[i], l.er[i]); i = i + 1; } i = 0; while (i < r.ne) { add_eff(r2, r.ek[i], r.er[i]); i = i + 1; } return r2; }
  if (k == N_LAMBDA) return gen_lambda(n);
  if (k == N_VASTART) return gen_vastart(n);
  if (k == N_ALLOCA) return emit_alloca(gen(kid(n, 0)));
  if (k == N_COAWAIT) return gen_coawait_use(n);
  if (k == N_VAARG) return gen_vaarg(n);
  if (k == N_VAEND) { gen(kid(n, 0)); return novalue(); }
  if (k == N_CALL) return gen_call(n);
  if (k == N_INDEX) return gen_index(n);
  if (k == N_MEMBER || k == N_ARROW) return gen_member(n);
  if (k == N_SIZEOF_E || k == N_SIZEOF_T || k == N_ALIGNOF) return gen_sizeof(n);
  if (k == N_NOEXCEPT) { int sv = may_throw; may_throw = 0; dry = dry + 1; gen(kid(n, 0)); dry = dry - 1; int thr = may_throw; may_throw = sv; return imm(bool_t(), thr == 0); }
  if (k == N_TYPEID_E || k == N_TYPEID_T) return gen_typeid(n);
  if (k == N_CAST) return gen_cast(n);
  if (k == N_FCAST) {
    int T = typeof_(kid(n, 0)); if (tk[T] == Y_AUTO) die("E_TYPE", "auto islevsel donusum hedefi olamaz");
    if (nk_i[n] == 1) {
      if (is_cls(T)) { V t = tempobj(unq(T)); init_obj(t, unq(T), kid(n, 1), 3); return t; }
      if (is_sc(T) == 0) die("E_TYPE", "bu tur {..} ile olusturulamaz");
      int off = slot(1); V ad = slotaddr(off); init_obj(ad, unq(T), kid(n, 1), 3); V v = mkv(unq(T), 0, newreg()); e_ld(v.reg, kind_for(unq(T)), ad, 0); return v;
    }
    if (nk_n[n] < 2) {
      if (is_cls(T)) { V t = tempobj(unq(T)); zero_n(t, cl_words[tcl[T]]); set_vptr(t, tcl[T]); return t; }
      if (is_void(T)) return novalue();
      if (is_flt(T)) return fconst(unq(T), 0);
      return imm(unq(T), 0);
    }
    V v = gen(kid(n, 1)); return c_style_cast(v, T);
  }
  die("E_INTERNAL", "ifade dugumu bekleniyordu"); return novalue();
}
// ============================ BASLATMA ============================
int final_overrider(int k_, int root) {
  int c = k_;
  while (c >= 0) {
    int m = 0;
    while (m < nfn) {
      if (fn_cls[m] == c && fn_has(m, F_VIRT) && fn_vroot[m] == fn_vroot[root] && fn_name[m] == fn_name[root]) {
        int same = fn_np[m] == fn_np[root]; int i = 0; while (same && i < fn_np[m]) { if (fn_pt[m * 8 + i] != fn_pt[root * 8 + i]) same = 0; i = i + 1; }
        if (same && (fn_has(m, F_CONST) == fn_has(root, F_CONST))) return m;
      }
      m = m + 1;
    }
    c = cl_base[c];
  }
  return root;
}
int is_abstract(int ci) {
  int c = ci;
  while (c >= 0) {
    int m = 0;
    while (m < nfn) { if (fn_cls[m] == c && fn_has(m, F_PURE)) { int fin = final_overrider(ci, m); if (fn_has(fin, F_PURE)) return 1; } m = m + 1; }
    c = cl_base[c];
  }
  return 0;
}
void fill_default(V addr, int t) {
  if (is_cls(t)) {
    int ci = tcl[t]; set_vptr(addr, ci);
    int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
    while (i < e) { int ft = unq(fl_ty[i]); if (is_cls(ft) || is_arr(ft)) { if (fl_woff[i] >= 0) { long long fa = e_addi(addr, fl_woff[i]); fill_default(mkv(0, 0, fa), ft); } } i = i + 1; }
  } else if (is_arr(t) && is_cls(unq(te[t])) && cl_poly[tcl[unq(te[t])]]) {
    long long wd = words_of(te[t]); long long i = 0;
    while (i < tn[t]) { long long fa = e_addi(addr, i * wd); fill_default(mkv(0, 0, fa), unq(te[t])); i = i + 1; }
  }
}
int frank(int t) { if (tk[t] == Y_FLOAT) return 1; if (tk[t] == Y_DOUBLE) return 2; if (tk[t] == Y_LDOUBLE) return 3; return 4; }   // kayan nokta duyarliligi sirasi: float < double < long double(f80) < __float128
void check_narrow(V& v, int to) {
  int f = unq(v.ty); to = unq(to);
  if (is_arith(f) == 0 || is_arith(to) == 0) return;
  int narrow = 0;
  int ff = is_flt(f) || is_ld(f); int tf = is_flt(to) || is_ld(to);
  if (ff && is_int(to)) narrow = 1;
  else if (is_int(f) && tf) narrow = v.ci == 0;
  else if (ff && tf) narrow = frank(to) < frank(f);
  else if (is_int(f) && is_int(to) && tk[to] != Y_BOOL) {
    int fs = sg_of(f); int ts = sg_of(to); int fb = bits_of(f); int tb = bits_of(to);
    int fits = (fs == ts && tb >= fb) || (fs == 0 && ts == 1 && tb > fb);
    if (fits == 0) {
      if (v.ci) { long long c = v.cv; int inr; if (ts) inr = tb == 64 || (c >= 0 - (1LL << (tb - 1)) && c < (1LL << (tb - 1))); else inr = c >= 0 && (tb == 64 || c < (1LL << tb)); if (fs == 0 && fb == 64 && c < 0) inr = tb == 64 && ts == 0; narrow = inr == 0; }
      else narrow = 1;
    }
  }
  else if (is_int(f) && tk[to] == Y_BOOL) narrow = (v.ci && (v.cv == 0 || v.cv == 1)) == 0;
  if (narrow) die("E_NARROW", "daraltici donusum {..} icinde yasak");
}
V addr_plus(V addr, long long woff) { if (woff == 0) return addr; long long r = e_addi(addr, woff); return mkv(0, 1, r); }
void init_obj(V addr, int T, int init, int style) {
  T = unq(T); int brace = style == 3;
  if (is_cls(T)) {
    int ci = tcl[T];
    if (is_abstract(ci)) die("E_ABSTRACT", "soyut sinif ornegi olusturulamaz");
    if (init < 0 || (nk_k[init] == N_INITLIST && nk_n[init] == 0 && style != 2)) { zero_n(addr, cl_words[ci]); fill_default(addr, T); return; }
    if (nk_k[init] == N_INITLIST) {
      if (cl_bi[ci]) die("E_INIT", "bu sinif {..} ile baslatilamaz");
      if (style == 2 && nk_n[init] == 1) { init_obj(addr, T, kid(init, 0), 1); return; }
      if (cl_poly[ci]) die("E_INIT", "sinif kume (aggregate) degil: sanal islevi var");
      zero_n(addr, cl_words[ci]); int idx = 0;
      if (cl_base[ci] >= 0 && idx < nk_n[init]) {
        int bt = clsty(cl_base[ci]);
        if (nk_k[kid(init, idx)] == N_INITLIST) { init_obj(addr, bt, kid(init, idx), 3); idx = idx + 1; }
        else { dry = dry + 1; V probe = gen(kid(init, idx)); dry = dry - 1; if (is_cls(unq(probe.ty)) && derived_from(tcl[unq(probe.ty)], cl_base[ci])) { V v = gen(kid(init, idx)); copy_n(addr, v, 0, cl_words[cl_base[ci]]); idx = idx + 1; } }
      }
      int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
      while (i < e && idx < nk_n[init]) { V fa = addr_plus(addr, fl_woff[i]); init_obj(fa, unq(fl_ty[i]), kid(init, idx), 3); idx = idx + 1; i = i + 1; }
      if (idx < nk_n[init]) die("E_INIT", "ilklendirici listesinde fazla eleman");
      fill_default(addr, T); return;
    }
    V v = gen(init);
    if (brace && is_cls(unq(v.ty)) == 0) die("E_INIT", "sinif nesnesi bu degerle {..} ile baslatilamaz");
    V s = to_class_value(v, T);
    if (cl_bi[ci] != 0 && cl_bi[ci] < 7) copy_n(addr, s, 0, 1); else copy_obj(addr, s, ci, 1);
    return;
  }
  if (is_arr(T)) {
    int et = unq(te[T]); long long cnt = tn[T]; long long wd = words_of(et);
    if (init >= 0 && nk_k[init] == N_STR && tk[et] == Y_CHAR) {
      int sid = nk_s1[init]; if (slen(sid) + 1 > cnt) die("E_INIT", "dize sabiti diziye sigmiyor"); zero_n(addr, cnt);
      int i = 0; while (i < slen(sid)) { e_sti(chars[soff(sid) + i], addr, i); i = i + 1; } return;
    }
    if (init < 0) { fill_default(addr, T); return; }
    if (nk_k[init] != N_INITLIST) die("E_INIT", "dizi {..} listesiyle baslatilmali");
    if (nk_n[init] > cnt) die("E_INIT", "ilklendirici listesinde fazla eleman");
    zero_n(addr, cnt * wd);
    int i = 0; while (i < nk_n[init]) { V ea = addr_plus(addr, i * wd); init_obj(ea, et, kid(init, i), 3); i = i + 1; }
    fill_default(addr, T); return;
  }
  if (init < 0) return;
  int e = init;
  if (nk_k[init] == N_INITLIST) {
    if (nk_n[init] > 1) die("E_INIT", "skaler tek degerle ilklendirilir");
    if (nk_n[init] == 0) { zero_n(addr, words_of(T)); return; }
    e = kid(init, 0);
  }
  V v = gen(e);
  if (brace) { V r = v; if (is_cls(unq(v.ty)) == 0) r = rval(v); check_narrow(r, T); }
  V s = to_scalar(v, T, 0); if (is_ld(T)) { ld_copy(addr, s); return; }
  e_st(mat(s), addr, 0);
}
// ============================ BILDIRIMLER / DEYIMLER ============================
int deduce_auto(int T, V& probe, int lvinit) {
  if (tk[T] == Y_AUTO) {
    int base = unq(probe.ty); if (is_arr(probe.ty)) base = ptrto(te[probe.ty]);
    if (is_void(base)) die("E_TYPE", "auto void'den cikarilamaz");
    if (tcv[T]) return withc(base, 1); return base;
  }
  if (is_ref(T) && tk[te[T]] == Y_AUTO) {
    int c = tcv[te[T]]; int bt = probe.ty;
    if (tk[T] == Y_REF) { if (lvinit == 0 && c == 0 && tcv[bt] == 0) die("E_BIND", "auto& rvalue'ya baglanamaz"); int r = bt; if (c) r = withc(bt, 1); return lref(r); }
    if (lvinit) { int r = probe.ty; if (c) r = withc(r, 1); return lref(r); }
    int r = unq(probe.ty); if (c) r = withc(r, 1); return rref(r);
  }
  return T;
}
int pm_cnt = 0; int pm_ret[3200]; int pm_start[3200]; int pm_len[3200]; int pm_dat[600000]; int pm_nd = 0; int cur_ret_kind = 0 - 1; int pm_open = 0;
void pm_begin(int ret_tid) { if (dry) return; pm_ret[pm_cnt] = ret_tid; pm_start[pm_cnt] = pm_nd; pm_len[pm_cnt] = 0; pm_open = 1; }
void pm_add(int kind) { if (dry) return; if (pm_nd >= 600000) die("E_SINIR", "PMT1 cok buyuk"); pm_dat[pm_nd] = kt_ty[kind]; pm_nd = pm_nd + 1; pm_len[pm_cnt] = pm_len[pm_cnt] + 1; }
int win_max = 0;
void note_win(int n) { if (n < 1) n = 1; if (n > win_max) win_max = n; }
void pm_end() { if (dry) return; if (win_max < 1) win_max = 1; int q = 0; while (q < win_max) { if (pm_nd >= 600000) die("E_SINIR", "PMT1 cok buyuk"); pm_dat[pm_nd] = 254; pm_nd = pm_nd + 1; pm_len[pm_cnt] = pm_len[pm_cnt] + 1; q = q + 1; } win_max = 0; pm_cnt = pm_cnt + 1; pm_open = 0; }
void wname(int n, int kind) { w("r"); wn(n); wc(KLET[kind]); }
void hs_restore_to(int lvl);
void emit_ret(V v) {
  hs_restore_to(0);
  if (co_mode) { long long z1 = e_movi(0, 0 - 1); e_st(mkv(0, 0, z1), mkv(0, 0, FPID), 0); long long r0 = e_movi(0, 0); w("  ret "); wr(r0); wc(10); return; }
  long long t = newreg(); setk(t, 1); w("  mov "); wr(t); w(", __sp\n"); e_st(mkv(0, 0, FPID), mkv(0, 0, t), 0);
  if (cur_ret_kind < 0) { w("  ret _spa\n"); return; }
  V x = cast_k(mat_k(v, cur_ret_kind), cur_ret_kind); w("  ret "); wr(x.reg); wc(10);
}
void fn_prologue(int frame) {   // ortak giris: yigin cercevesi; sabit adli yazmaclar (PMT1 notunda bu sirayla)
  w("  mov _spa, __sp\n  ld fp, _spa, 0\n  addi _nsp, fp, "); wn(frame); w("\n  mov _lma, __lim\n  ld _lim, _lma, 0\n  leu _okc, _nsp, _lim\n  jnz _okc, _stk_ok\n  mov _m1, -1\n  ld _trp, _m1, 0\n_stk_ok: st _nsp, _spa, 0\n");
  pm_add(1); pm_add(1); pm_add(1); pm_add(1); pm_add(1); pm_add(3); pm_add(0); pm_add(0);
  w("  jmp _body\n");   // bildirim blogu: calismaz; yalniz yazmaclarin sirasini ve turlerini sabitler
  int i = 0; while (i < ndl) { int n = dl[i] / 16; int k = dl[i] % 16; w("  ld "); wname(n, k); w(", fp, 0\n"); pm_add(k); i = i + 1; }
  i = 0; while (i < ndp) { int pf = pair_fmt[dl_pairs[i]]; w("  "); wrt(nmw(NM_PACK80, pf)); w(" q"); wn(dl_pairs[i]); w("L, _spa, _spa\n"); pm_add(pf ? 13 : 11); pm_add(12); i = i + 1; }
  w("_body:\n");
}

// ============================ ISTISNA (throw / try / catch) ============================
// Yazilimsal yayilim: bekleyen istisna __ex (tur anahtari: sinif icin cl_id, diger turler icin 1000+tur) ve __exo (yigin disi kopya adresi) hucrelerinde;
// her cagri sonrasi __ex denetlenir, try icindeyse yakalayici dagitimina atlanir, degilse islev cerceve kaydi geri yuklenerek donulur.
// yakalanmamis (main'e ya da noexcept islevden kacan) istisna = std::terminate = TRAP. __cx/__cxo: o an islenen istisna ('throw;' icin).
void stmt(int n);
int try_lab[32]; int try_hs[32]; int try_depth = 0; int hs_off[32]; int nhs = 0;
V cell_addr(const char* nm) { long long a = newreg(); setk(a, 1); w("  mov "); wr(a); w(", "); w(nm); wc(10); return mkv(0, 0, a); }
V cell_ld(const char* nm, int kind) { V a = cell_addr(nm); long long v = newreg(); e_ld(v, kind, a, 0); return mkv(0, 0, v); }
void cell_st(const char* nm, V val) { V a = cell_addr(nm); e_st(val, a, 0); }
void hs_restore_to(int lvl) {
  if (nhs <= lvl) return;
  long long t = newreg(); e_ld(t, 0, mkv(0, 0, FPID), hs_off[lvl]); cell_st("__cx", mkv(0, 0, t));
  long long u = newreg(); e_ld(u, 1, mkv(0, 0, FPID), hs_off[lvl] + 1); cell_st("__cxo", mkv(0, 0, u));
}
int is_main_fn(int f) { return f >= 0 && fn_cls[f] < 0 && seqc(fn_name[f], "main") && fn_np[f] == 0; }
void emit_propagate() {
  if (try_depth > 0) { hs_restore_to(try_hs[try_depth - 1]); w("  jmp "); wl(try_lab[try_depth - 1]); wc(10); return; }
  if (cur_fn < 0 || fn_has(cur_fn, F_NOEX) || is_main_fn(cur_fn)) { trapnow(); return; }
  emit_ret(imm(0, 0));
}
void exc_check() {
  V e = cell_ld("__ex", 0); int ok = newlab(); e_jcc("jz", e, ok); emit_propagate(); wl(ok); w(":\n");
}
void throw_value(V v) {
  if (exc_on == 0) { trapnow(); return; }
  int T = unq(v.ty);
  if (is_arr(T)) { int pt = ptrto(te[T]); v = to_scalar(v, pt, 0); T = pt; }
  if (is_void(T)) die("E_TYPE", "void ifade firlatilamaz");
  long long wd = words_of(T); if (wd < 1) wd = 1;
  long long nr = e_movi(0, wd); long long h = newreg(); setk(h, 1); w("  alloc "); wr(h); w(", "); wr(nr); wc(10);
  V hv = mkv(T, 1, h);
  if (is_ld(T)) ld_copy(hv, v);
  else if (is_cls(T)) { if (cl_bi[tcl[T]] != 0 && cl_bi[tcl[T]] < 7) copy_n(hv, v, 0, 1); else copy_obj(hv, v, tcl[T], 1); }
  else { V sv = rval(v); e_st(sv, hv, 0); }
  long long kv = e_movi(0, type_id_of(T)); cell_st("__ex", mkv(0, 0, kv)); cell_st("__exo", mkv(0, 0, h));
  emit_propagate();
}
void throw_named(const char* nm) {
  int ci = 0 - 1; if (exc_on) ci = find_class(intern_c(nm));
  if (ci < 0) { trapnow(); return; }
  V t = tempobj(clsty(ci)); throw_value(t);
}
void gen_throw(int n) {
  curline = nk_line[n];
  if (nk_n[n] == 0) {   // throw;  -> o an islenen istisnayi yeniden firlat (yoksa terminate)
    if (exc_on == 0) { trapnow(); return; }
    V c = cell_ld("__cx", 0); int ok = newlab(); e_jcc("jnz", c, ok); trapnow(); wl(ok); w(":\n");
    V co = cell_ld("__cxo", 1); cell_st("__ex", c); cell_st("__exo", co); emit_propagate(); return;
  }
  V v = gen(kid(n, 0)); throw_value(v);
}
void gen_try(int n) {
  int base = nreg; int nh = nk_n[n] - 1; int lab = newlab(); int end = newlab(); int tr0 = reach; int tacc = 0;
  try_lab[try_depth] = lab; try_hs[try_depth] = nhs; try_depth = try_depth + 1;
  { int mark = nvars; stmt(kid(n, 0)); nvars = mark; }
  tacc = reach; try_depth = try_depth - 1; nreg = base;
  w("  jmp "); wl(end); wc(10); wl(lab); w(":\n");
  int hl[16]; if (nh > 16) die("E_SINIR", "cok fazla catch");
  V key = cell_ld("__ex", 0); int all = 0; int i = 0;
  while (i < nh) {
    int c = kid(n, i + 1); hl[i] = newlab();
    if (nk_k[kid(c, 0)] == N_NONE) { if (i != nh - 1) die("E_CATCH", "catch(...) son isleyici olmali"); w("  jmp "); wl(hl[i]); wc(10); all = 1; }
    else {
      int T = typeof_(kid(c, 0)); if (is_ref(T)) { if (tk[T] == Y_RREF) die("E_TYPE", "catch rvalue referansi gecersiz"); T = te[T]; }
      int Tb = unq(T);
      if (is_void(Tb) || is_arr(Tb)) die("E_TYPE", "catch turu gecersiz");
      if (complete_obj(Tb) == 0) die("E_TYPE", "catch turu tamamlanmamis");
      if (is_cls(Tb)) {
        int dc = tcl[Tb]; if (cl_bi[dc]) die("E_TYPE", "catch: bu sinif firlatilamaz");
        int q = 0; int found = 0; while (q < nisa) { if (isa_need[q] == dc) found = 1; q = q + 1; } if (found == 0) { isa_need[nisa] = dc; nisa = nisa + 1; }
        long long r = newreg(); setk(r, 0); w("  call "); wr(r); w(", isa"); wn(dc); w(", "); wr(key.reg); wc(10); note_win(1); e_jcc("jnz", mkv(0, 0, r), hl[i]);
      } else {
        long long kv = e_movi(0, type_id_of(Tb)); long long cb = newreg(); ins3("eq", cb, key, mkv(0, 0, kv)); e_jcc("jnz", mkv(0, 0, cb), hl[i]);
      }
    }
    i = i + 1;
  }
  if (all == 0) emit_propagate();   // eslesen yok: bir ust try'a / cagirana ilet
  i = 0;
  while (i < nh) {
    int c = kid(n, i + 1); nreg = base; wl(hl[i]); w(":\n");
    V eo = cell_ld("__exo", 1); V kk = cell_ld("__ex", 0);
    int sv = slot(2); hs_off[nhs] = sv;
    V pc = cell_ld("__cx", 0); e_st(pc, mkv(0, 0, FPID), sv); V pco = cell_ld("__cxo", 1); e_st(pco, mkv(0, 0, FPID), sv + 1);
    nhs = nhs + 1;
    cell_st("__cx", kk); cell_st("__cxo", eo); { V ea = cell_addr("__ex"); e_sti(0, ea, 0); }
    int mark = nvars; int sl = scope_lo; scope_lo = nvars;
    if (nk_k[kid(c, 0)] != N_NONE && nk_s1[c] >= 0) {
      int T = typeof_(kid(c, 0)); int off;
      if (is_ref(T)) {
        off = slot(1); e_st(eo, mkv(0, 0, FPID), off);
        vname[nvars] = nk_s1[c]; vty[nvars] = te[T]; voff[nvars] = off; vref[nvars] = 1; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1;
      } else {
        int Tb = unq(T); off = slot(words_of(Tb)); V ad = slotaddr(off); V src = mkv(Tb, 1, eo.reg);
        if (is_ld(Tb)) ld_copy(ad, src);
        else if (is_cls(Tb)) { if (cl_bi[tcl[Tb]] != 0 && cl_bi[tcl[Tb]] < 7) copy_n(ad, src, 0, 1); else copy_obj(ad, src, tcl[Tb], 1); }
        else { long long t = newreg(); e_ld(t, kind_for(Tb), src, 0); e_st(mkv(Tb, 0, t), ad, 0); }
        vname[nvars] = nk_s1[c]; vty[nvars] = T; voff[nvars] = off; vref[nvars] = 0; vci[nvars] = 0; uidn = uidn + 1; vuid[nvars] = uidn; nvars = nvars + 1;
      }
    }
    reach = tr0; stmt(kid(c, 1)); nvars = mark; scope_lo = sl; if (reach) tacc = 1;
    hs_restore_to(nhs - 1); nhs = nhs - 1;
    w("  jmp "); wl(end); wc(10);
    i = i + 1;
  }
  wl(end); w(":\n"); nreg = base; reach = tacc;
}
// islev-yerel static: gizli global + (sabit olmayan ilklendirici icin) bir-kez koruma bayragi
void declare_static_local(int vn, int T, int init, int style) {
  if (complete_obj(T) == 0) die("E_TYPE", "tamamlanmamis tur");
  int sid = nameU("__sl", vn); int gi = findgl(sid); int guard = 0 - 1;
  if (gi < 0) {
    gdef[ngl] = 1; gname[ngl] = sid; gty[ngl] = T; gnode[ngl] = vn; gci[ngl] = 0; gcinit[ngl] = 0; gflags[ngl] = nk_j[vn] | 4096; uidn = uidn + 1; guid[ngl] = uidn; gi = ngl; ngl = ngl + 1;
    int isc = 0;
    if (init < 0 && is_cls(unq(T)) == 0) isc = 1;
    if (init >= 0 && nk_k[init] != N_INITLIST && is_sc(T) && is_ld(T) == 0) {
      int sv = may_throw; dry = dry + 1; CV cv0 = cx_eval_top(init); dry = dry - 1; may_throw = sv;
      int okc = cx_fail == 0 && (cx_isi(cv0.t) || cx_isf(cv0.t)) && (cx_isi(unq(T)) || cx_isf(unq(T))); cx_fail = 0;
      if (okc) { CV c2 = cx_conv(cv0, unq(T)); gcinit[gi] = 1; if (cx_isf(unq(T))) gcib[gi] = d_to_bits(c2.d); else gcib[gi] = c2.i; isc = 1; }
    }
    if (init < 0 && is_cls(unq(T)) == 0) gcinit[gi] = 1;
    if (isc == 0) { gdef[ngl] = 1; gname[ngl] = nameU("__sg", vn); gty[ngl] = mkt(Y_INT, 0 - 1, 0); gnode[ngl] = vn; gci[ngl] = 0; gcinit[ngl] = 1; gcib[ngl] = 0; gflags[ngl] = 4096; uidn = uidn + 1; guid[ngl] = uidn; ngl = ngl + 1; guard = ngl - 1; }
  } else { if (gcinit[gi] == 0 && gcib[gi] == 0 && findgl(nameU("__sg", vn)) >= 0) guard = findgl(nameU("__sg", vn)); }
  if (guard >= 0) {   // if (!guard) { guard = 1; init }
    int base = nreg; long long a = newreg(); setk(a, 1); w("  mov "); wr(a); w(", g"); wn(guard); wc(10);
    long long gv = newreg(); e_ld(gv, 0, mkv(0, 0, a), 0); int Lend = newlab(); e_jcc("jnz", mkv(0, 0, gv), Lend);
    long long one = e_movi(0, 1); e_st(mkv(0, 0, one), mkv(0, 0, a), 0);
    long long ga = newreg(); setk(ga, 1); w("  mov "); wr(ga); w(", g"); wn(gi); wc(10); init_obj(mkv(0, 1, ga), T, init, style);
    wl(Lend); w(":\n"); nreg = base;
  }
  vname[nvars] = nk_s1[vn]; vty[nvars] = T; voff[nvars] = gi; vref[nvars] = 2; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1;
}
void declvar(int vn) {
  curline = nk_line[vn]; { int q = scope_lo; while (q < nvars) { if (vname[q] == nk_s1[vn] && nk_s1[vn] >= 0) die("E_REDECL", "degisken ayni kapsamda yeniden tanimlandi"); q = q + 1; } } int T = typeof_(kid(vn, 0)); int init = 0 - 1; if (nk_n[vn] > 1) init = kid(vn, 1); int style = nk_i[vn]; vinit[nvars] = nk_n[vn] > 1;
  int ie = init; if (init >= 0 && nk_k[init] == N_INITLIST && nk_n[init] == 1 && (tk[T] == Y_AUTO || is_ref(T))) ie = kid(init, 0);
  int hasauto = tk[T] == Y_AUTO || (is_ref(T) && tk[te[T]] == Y_AUTO);
  if (hasauto) { if (init < 0) die("E_TYPE", "auto bildirimi ilklendirici gerektirir"); int sv = may_throw; dry = dry + 1; V pb = gen(ie); dry = dry - 1; may_throw = sv; T = deduce_auto(T, pb, pb.cat == 1); }
  if (is_arr(T) && tn[T] < 0) {
    if (init < 0) die("E_TYPE", "boyutsuz dizi ilklendirici gerektirir");
    long long cnt; if (nk_k[init] == N_STR) cnt = slen(nk_s1[init]) + 1; else if (nk_k[init] == N_INITLIST) cnt = nk_n[init]; else { die("E_TYPE", "boyutsuz dizi {..} ya da dize gerektirir"); cnt = 0; }
    if (cnt == 0) die("E_TYPE", "bos dizi"); T = arrof(te[T], cnt);
  }
  if (is_void(T)) die("E_TYPE", "void turunde degisken");
  if (tk[T] == Y_AUTO) die("E_TYPE", "auto cikarilamadi");
  if ((nk_j[vn] & 1) && is_ref(T) == 0) T = withc(T, 1);   // yerel constexpr => const
  if (nk_j[vn] & 4) { if (is_ref(T)) die("E_TYPE", "static yerel referans desteklenmiyor"); declare_static_local(vn, T, init, style); return; }
  if (is_ref(T)) {
    if (init < 0) die("E_INIT", "referans ilklendirici gerektirir");
    V iv = gen(ie); V ad = bind_arg(iv, T); ad = mat(ad); int off = slot(1);
    e_st(ad, mkv(0, 0, FPID), off);
    vname[nvars] = nk_s1[vn]; vty[nvars] = te[T]; voff[nvars] = off; vref[nvars] = 1; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1; return;
  }
  if (complete_obj(T) == 0) die("E_TYPE", "tamamlanmamis tur");
  if (is_cls(unq(T)) && is_abstract(tcl[unq(T)])) die("E_ABSTRACT", "soyut sinif ornegi olusturulamaz");
  int off = slot(words_of(T)); V ad = slotaddr(off); int isci = 0; long long cvv = 0;
  if (tcv[T] && is_int(T) && ie >= 0 && nk_k[ie] != N_INITLIST) { int sv = may_throw; dry = dry + 1; V pc = gen(ie); dry = dry - 1; may_throw = sv; if (pc.ci) { isci = 1; cvv = fold(pc.cv, unq(T)); } }
  if (init >= 0 && nk_k[init] == N_INITLIST && style == 2 && is_sc(T) && nk_n[init] == 1) { init = kid(init, 0); style = 1; }
  int tnt = 0;  if (pun_on && is_ptr(T) && ie >= 0 && nk_k[ie] != N_INITLIST) { dry = dry + 1; V pt_ = gen(ie); dry = dry - 1; tnt = pt_.bp; }
  init_obj(ad, T, init, style);
  uidn = uidn + 1; if (uidn < 60000) ubp[uidn] = tnt; uidn = uidn - 1;
  vname[nvars] = nk_s1[vn]; vty[nvars] = T; voff[nvars] = off; vref[nvars] = 0; vci[nvars] = isci; vcv[nvars] = cvv; uidn = uidn + 1; vuid[nvars] = uidn; nvars = nvars + 1;
}
int scope_lo = 0;
int loop_brk[64]; int loop_cont[64]; int loop_hs[64]; int loop_kind[64]; int loop_bs[64]; int loop_cs[64]; int nloop = 0; int reach = 1; int N_SRET = 0;
int deduce_on = 0; int deduce_ty = 0 - 1; int inl_depth = 0;
void stmt_return(int n) {
  if (deduce_on) {   // lambda donus turu cikarimi (kuru gecis): ilk return'un turu; digerleri ayni olmali
    curline = nk_line[n];
    if (nk_n[n] == 0) { int vt = mkt(Y_VOID, 0 - 1, 0); if (deduce_ty < 0) deduce_ty = vt; else if (deduce_ty != vt) die("E_RETURN", "lambda donus turleri uyusmuyor"); reach = 0; return; }
    int e0 = kid(n, 0); if (nk_k[e0] == N_INITLIST) die("E_DESTEK", "lambda donus turu {..} ile cikarilamaz");
    V v0 = gen(e0); int t0; if (is_void(v0.ty)) t0 = mkt(Y_VOID, 0 - 1, 0); else { v0 = rval(v0); t0 = unq(v0.ty); }
    if (deduce_ty < 0) deduce_ty = t0; else if (deduce_ty != t0) die("E_RETURN", "lambda donus turleri uyusmuyor");
    reach = 0; return;
  }
  curline = nk_line[n]; int rt = fn_ret[cur_fn]; if (co_mode) die("E_COROUTINE", "korutinde return yerine co_return kullanilir");
  if (nk_n[n] == 0) { if (is_void(rt) == 0) die("E_RETURN", "deger donduren islevde 'return' degersiz"); emit_ret(imm(0, 0)); return; }
  int e = kid(n, 0);
  if (is_void(rt)) { if (nk_k[e] == N_INITLIST) die("E_RETURN", "void islevden deger donduruluyor"); if (nk_k[e] == N_CALL && inl_depth == 0) tc_node = e; V v = gen(e); tc_node = 0 - 1; if (tc_done) { tc_done = 0; return; } if (is_void(v.ty) == 0) die("E_RETURN", "void islevden deger donduruluyor"); emit_ret(imm(0, 0)); return; }
  if (is_ref(rt)) {
    V v = gen(e); int rr = tk[rt] == Y_RREF; int tu = unq(te[rt]);
    if (unq(v.ty) != tu && !(is_cls(unq(v.ty)) && is_cls(tu) && derived_from(tcl[unq(v.ty)], tcl[tu]))) die("E_RETURN", "referans donusu: tur uyumsuz");
    if (rr == 0 && v.cat != 1 && tcv[te[rt]] == 0) die("E_BIND", "lvalue referans rvalue'ya baglanamaz");
    if (rr && v.cat == 1) die("E_BIND", "rvalue referans lvalue'ya baglanamaz");
    if (tcv[v.ty] && tcv[te[rt]] == 0) die("E_CONST", "const nesne const olmayan referansla donduruluyor");
    V ad = v; if (v.cat == 0 && is_cls(tu) == 0) ad = tempscalar(tu, v);
    emit_ret(mat(ad)); return;
  }
  if (is_ld(unq(rt))) { V v = gen(e); V c = to_ld(v, wfmt(unq(rt))); int sv = findvar(N_SRET); V sp = rval(var_ref(sv)); ld_copy(sp, c); emit_ret(imm(0, 0)); return; }
  if (is_cls(unq(rt))) {
    V v; if (nk_k[e] == N_INITLIST) { v = tempobj(unq(rt)); init_obj(v, unq(rt), e, 3); } else v = gen(e);
    if (v.cat == 1 && cl_bi[tcl[unq(rt)]] == 9 && nk_k[e] == N_ID) v.cat = 2;   // yerel std::move_only_function donusu tasinir
    V c = to_class_value(v, unq(rt)); int sv = findvar(N_SRET); if (sv < 0) { emit_ret(imm(0, 0)); return; }
    V sp = rval(var_ref(sv));
    if (cl_bi[tcl[unq(rt)]] != 0 && cl_bi[tcl[unq(rt)]] < 7) copy_n(sp, c, 0, 1); else copy_obj(sp, c, tcl[unq(rt)], 1);
    emit_ret(imm(0, 0)); return;
  }
  V v;
  if (pun_on && nk_k[e] != N_INITLIST) { dry = dry + 1; V pb_ = gen(e); dry = dry - 1; if (pb_.bp) die("E_REINTERP", "bayt gorunumu yok: uyumsuz gosterimli isaretci donduruluyor"); }
  if (nk_k[e] == N_INITLIST) { int off = slot(1); V ad = slotaddr(off); init_obj(ad, unq(rt), e, 3); v = mkv(unq(rt), 0, newreg()); e_ld(v.reg, kind_for(unq(rt)), ad, 0); }
  else { if (nk_k[e] == N_CALL && inl_depth == 0) tc_node = e; v = gen(e); tc_node = 0 - 1; if (tc_done) { tc_done = 0; return; } }
  V s = to_scalar(v, unq(rt), 0); emit_ret(s);
}
// Bolum 04: lambda donus turu cikarimi -- govde kapsayan islev baglaminda KURU gecisle gezilir (parametreler gecici yerel degiskenler gibi tanimlanir); durum geri yuklenir.
int deduce_lambda_ret(int n, int np, int* pt, int ci) {
  int s_nvars = nvars; int s_nreg = nreg; int s_foff = foff; int s_npair = npair; int s_nloop = nloop; int s_nlb = nlb; int s_npg = npg; int s_reach = reach; int s_swn = sw_n; int s_swb = sw_base; int s_swv = sw_nv0;
  int s_ndl = ndl; int s_ndp = ndp; int s_thr = may_throw; int s_try = try_depth; int s_nhs = nhs; int s_scope = scope_lo; int s_line = curline; int s_don = deduce_on; int s_dty = deduce_ty; int s_co = co_mode; int s_nlab = nlab;
  scope_lo = nvars; int params = kid(n, 1); int i = 0;
  while (i < np) {
    int P = pt[i]; int off = slot(1); vname[nvars] = nk_s1[kid(params, i)]; voff[nvars] = off; vci[nvars] = 0; vuid[nvars] = 0;
    if (is_ref(P)) { vty[nvars] = te[P]; vref[nvars] = 1; } else if (is_mem(unq(P))) { vty[nvars] = P; vref[nvars] = 1; } else { vty[nvars] = P; vref[nvars] = 0; }
    nvars = nvars + 1; i = i + 1;
  }
  { int fq = cl_f0[ci]; int fe = fq + cl_nf[ci];   // yakalanan alanlar govdede degisken gibi gorunur (kopya: alan turu, basvuru: gosterilen tur)
    while (fq < fe) { if (fl_kind[fq] != 2) { int ft = fl_ty[fq]; if (fl_ref[fq]) ft = te[ft]; vname[nvars] = fl_name[fq]; voff[nvars] = slot(1); vci[nvars] = 0; vuid[nvars] = 0; vty[nvars] = ft; vref[nvars] = is_mem(unq(ft)); nvars = nvars + 1; } fq = fq + 1; } }
  deduce_on = 1; deduce_ty = 0 - 1; co_mode = 0; dry = dry + 1; stmt(kid(n, 2)); dry = dry - 1;
  int rt = deduce_ty; if (rt < 0) rt = mkt(Y_VOID, 0 - 1, 0);
  nvars = s_nvars; nreg = s_nreg; foff = s_foff; npair = s_npair; nloop = s_nloop; nlb = s_nlb; npg = s_npg; reach = s_reach; sw_n = s_swn; sw_base = s_swb; sw_nv0 = s_swv;
  ndl = s_ndl; ndp = s_ndp; may_throw = s_thr; try_depth = s_try; nhs = s_nhs; scope_lo = s_scope; curline = s_line; deduce_on = s_don; deduce_ty = s_dty; co_mode = s_co; nlab = s_nlab;
  return rt;
}
// ============================ DENETIM AKISI (Bolum 03) ============================
// Yardimcilar: sentetik dugum uretimi (range-for / match PMX1 dugumlerinden sayisal olarak acilir), kosul atlamasi (kisa devre), erisilebilirlik, goto/etiket, switch.
int mknode(int k, long long iv, int s1, int line, int cnt, int c0, int c1, int c2) {
  if (nnodes >= NN || nkids + 3 >= NK) die("E_SINIR", "cok fazla dugum");
  int id = nnodes; nnodes = nnodes + 1; nk_k[id] = k; nk_i[id] = iv; nk_j[id] = 0; nk_d[id] = 0; nk_s1[id] = s1; nk_s2[id] = 0 - 1; nk_line[id] = line; nk_n[id] = cnt; nk_ks[id] = nkids;
  if (cnt > 0) kids[nkids] = c0; if (cnt > 1) kids[nkids + 1] = c1; if (cnt > 2) kids[nkids + 2] = c2; nkids = nkids + cnt; return id;
}
int hid_n = 0;
int hidname(const char* pre) { int k = 0; while (pre[k]) { tmpb[k] = pre[k]; k = k + 1; } int v = hid_n; hid_n = hid_n + 1; tmpb[k] = '0' + (v / 100) % 10; tmpb[k + 1] = '0' + (v / 10) % 10; tmpb[k + 2] = '0' + v % 10; return intern_n(tmpb, k + 3); }
int autoty(int ref, int line) { int t = mknode(N_TY, Y_AUTO, 0 - 1, line, 0, 0, 0, 0); if (ref == 1) return mknode(N_TREF, 0, 0 - 1, line, 1, t, 0, 0); if (ref == 2) return mknode(N_TRREF, 0, 0 - 1, line, 1, t, 0, 0); return t; }
int mkvar(int ty, int name, int init, int line) { int v = mknode(N_VAR, 1, name, line, 2, ty, init, 0); return v; }
int mkdecls(int v, int line) { return mknode(N_DECLS, 0, 0 - 1, line, 1, v, 0, 0); }
int mkid(int name, int line) { return mknode(N_ID, 0, name, line, 0, 0, 0, 0); }
int mkbin(const char* op, int l, int r, int line) { return mknode(N_BINARY, 0, intern_c(op), line, 2, l, r, 0); }
void place(int l) { wl(l); w(":\n"); }
void jmpl(int l) { w("  jmp "); wl(l); wc(10); }
// kosul atlamasi: dogruysa tl'ye, yanlissa fl'ye gider; nxt = hemen ardindan yerlestirilecek etiket (atlama gerekmez). Donus: bit1 = dogru olabilir, bit2 = yanlis olabilir (sabit katlama)
int cj(int n, int tl, int fl, int nxt) {
  int k = nk_k[n]; curline = nk_line[n];
  if (k == N_BINARY && (seqc(nk_s1[n], "&&") || seqc(nk_s1[n], "||"))) {
    int isand = seqc(nk_s1[n], "&&");
    int sv = may_throw; dry = dry + 1; V pa = gen(kid(n, 0)); V pb = gen(kid(n, 1)); dry = dry - 1; may_throw = sv;
    if (is_cls(unq(pa.ty)) == 0 && is_cls(unq(pb.ty)) == 0) {
      int mid = newlab(); int ma; int mb;
      if (isand) {
        ma = cj(kid(n, 0), mid, fl, mid); place(mid);
        if ((ma & 1) == 0) { dry = dry + 1; int sr = reach; mb = cj(kid(n, 1), tl, fl, 0 - 1); reach = sr; dry = dry - 1; return 2; }
        mb = cj(kid(n, 1), tl, fl, nxt);
        int t = 0; if ((mb & 1) != 0) t = 1; int f = 0; if ((ma & 2) != 0 || (mb & 2) != 0) f = 2; return t | f;
      }
      ma = cj(kid(n, 0), tl, mid, mid); place(mid);
      if ((ma & 2) == 0) { dry = dry + 1; int sr = reach; mb = cj(kid(n, 1), tl, fl, 0 - 1); reach = sr; dry = dry - 1; return 1; }
      mb = cj(kid(n, 1), tl, fl, nxt);
      int t = 0; if ((ma & 1) != 0 || (mb & 1) != 0) t = 1; int f = 0; if ((mb & 2) != 0) f = 2; return t | f;
    }
  }
  if (k == N_UNARY && seqc(nk_s1[n], "!")) {
    int sv = may_throw; dry = dry + 1; V pa = gen(kid(n, 0)); dry = dry - 1; may_throw = sv;
    if (is_cls(unq(pa.ty)) == 0) { int m = cj(kid(n, 0), fl, tl, nxt); int r = 0; if ((m & 1) != 0) r = r | 2; if ((m & 2) != 0) r = r | 1; return r; }
  }
  int base = nreg; V c = cond_bool(gen(n)); nreg = base;
  if (c.ci) {
    if (c.cv != 0) { if (nxt != tl) jmpl(tl); return 1; }
    if (nxt != fl) jmpl(fl); return 2;
  }
  if (nxt == fl) e_jcc("jnz", c, tl); else if (nxt == tl) e_jcc("jz", c, fl); else { e_jcc("jnz", c, tl); jmpl(fl); }
  return 3;
}
// ---- goto / etiket: islev basina tablo; jump-over-initialization denetimi (ilklendirmeli degiskenin kapsamina atlamak yasak) ----
int lb_name[128]; int lb_id[128]; char lb_def[128]; int lb_nsn[128]; int lb_snap[128 * 64]; int lb_nhs[128]; int lb_try[128]; int nlb = 0;
int pg_lb[128]; int pg_nsn[128]; int pg_snap[128 * 64]; int pg_nhs[128]; int pg_try[128]; int npg = 0; int pg_line[128];
int snap_init(int* dst) {   // kapsamdaki ilklendirmeli degiskenlerin uid listesi (en cok 64)
  int c = 0; int i = 0; while (i < nvars && c < 64) { if (vuid[i] > 0 && vinit[i]) { dst[c] = vuid[i]; c = c + 1; } i = i + 1; } return c;
}
int in_snap(int uid, int* sn, int n) { int i = 0; while (i < n) { if (sn[i] == uid) return 1; i = i + 1; } return 0; }
void check_jump(int* gsn, int gn, int* lsn, int ln) {   // hedefte kapsamda olup kaynakta olmayan ilklendirmeli degisken var mi
  int i = 0; while (i < ln) { if (in_snap(lsn[i], gsn, gn) == 0) die("E_JUMPINIT", "atlama ilklendirmeli bir degiskenin tanimini atliyor"); i = i + 1; }
}
int find_lb(int name) { int i = 0; while (i < nlb) { if (lb_name[i] == name) return i; i = i + 1; } if (nlb >= 128) die("E_SINIR", "cok fazla etiket"); lb_name[nlb] = name; lb_id[nlb] = newlab(); lb_def[nlb] = 0; nlb = nlb + 1; return nlb - 1; }
void gen_label(int n) {
  int i = find_lb(nk_s1[n]); if (lb_def[i]) die("E_LABEL", "etiket ayni islevde iki kez tanimlandi");
  lb_def[i] = 1; lb_nhs[i] = nhs; lb_try[i] = try_depth; lb_nsn[i] = snap_init(&lb_snap[i * 64]);
  int g = 0; while (g < npg) { if (pg_lb[g] == i) { curline = pg_line[g]; if (pg_nhs[g] != nhs) die("E_GOTO", "goto islenen-istisna (catch) siniri gecemez"); if (pg_try[g] < try_depth) die("E_GOTO", "goto try blogunun icine atlayamaz"); check_jump(&pg_snap[g * 64], pg_nsn[g], &lb_snap[i * 64], lb_nsn[i]); pg_lb[g] = 0 - 1; } g = g + 1; }
  place(lb_id[i]); reach = 1;
}
void gen_goto(int n) {
  int i = find_lb(nk_s1[n]);
  if (lb_def[i]) {
    if (lb_nhs[i] != nhs) die("E_GOTO", "goto islenen-istisna (catch) siniri gecemez"); if (lb_try[i] > try_depth) die("E_GOTO", "goto try blogunun icine atlayamaz");
    int sn[64]; int c = snap_init(sn); check_jump(sn, c, &lb_snap[i * 64], lb_nsn[i]);
  } else {
    if (npg >= 128) die("E_SINIR", "cok fazla ileri goto"); pg_lb[npg] = i; pg_nhs[npg] = nhs; pg_try[npg] = try_depth; pg_line[npg] = nk_line[n]; pg_nsn[npg] = snap_init(&pg_snap[npg * 64]); npg = npg + 1;
  }
  jmpl(lb_id[i]); reach = 0;
}
void goto_end() {   // islev sonu: cozulmemis etiket
  int g = 0; while (g < npg) { if (pg_lb[g] >= 0) { curline = pg_line[g]; die("E_LABEL", "goto etiketi tanimsiz"); } g = g + 1; }
}
// ---- switch ----
int sw_node[1024]; long long sw_lo[1024]; long long sw_hi[1024]; int sw_lab[1024]; char sw_def[1024]; int sw_n = 0; int sw_base = 0; int sw_nv0 = 0; int sw_ord[1024]; int sw_T = 0; int sw_nsw = 0; int sw_deflab = 0 - 1;
void sw_collect(int n) {   // govde icinde (ic switch'e girmeden) case/default topla
  int k = nk_k[n];
  if (k == N_SWITCH) return;
  if (k == N_CASE || k == N_DEFAULT) {
    if (sw_n >= 1024) die("E_SINIR", "cok fazla case");
    sw_node[sw_n] = n; sw_lab[sw_n] = newlab(); sw_def[sw_n] = k == N_DEFAULT;
    if (k == N_CASE) {
      long long lo = fold(ceval(kid(n, 0)), sw_T); long long hi = lo; if (nk_n[n] > 1) hi = fold(ceval(kid(n, 1)), sw_T);
      curline = nk_line[n];
      if (lo != ceval(kid(n, 0)) || (nk_n[n] > 1 && hi != ceval(kid(n, 1)))) die("E_CASE", "case degeri kosul turune sigmiyor (daraltma)");
      int u = uns64(sw_T) || tk[sw_T] == Y_UINT || tk[sw_T] == Y_ULONG;
      if (hi < lo && u == 0) die("E_CASE", "case araligi ters"); if (u && (hi > lo) == 0 && hi != lo) die("E_CASE", "case araligi ters");
      sw_lo[sw_n] = lo; sw_hi[sw_n] = hi;
    }
    sw_n = sw_n + 1; return;
  }
  if (k == N_BLOCK || k == N_IF || k == N_WHILE || k == N_DO || k == N_FOR || k == N_TRY || k == N_CATCH || k == N_RANGEFOR || k == N_LABEL) { int i = 0; while (i < nk_n[n]) { sw_collect(kid(n, i)); i = i + 1; } }
}
V sw_c;
void sw_leafchain(int lo, int hi, int deflab) {   // sirali ord[lo..hi) icin dogrusal karsilastirma
  int i = lo; int T = sw_T;
  while (i < hi) {
    int e = sw_ord[i]; V cc = sw_c;
    if (sw_lo[e] == sw_hi[e]) { V t = binop("==", cc, imm(T, sw_lo[e])); e_jcc("jnz", t, sw_lab[e]); }
    else { int skip = newlab(); V t1 = binop(">=", cc, imm(T, sw_lo[e])); e_jcc("jz", t1, skip); V t2 = binop("<=", cc, imm(T, sw_hi[e])); e_jcc("jnz", t2, sw_lab[e]); place(skip); }
    i = i + 1;
  }
  jmpl(deflab);
}
void sw_bsearch(int lo, int hi, int deflab) {
  if (hi - lo <= 3) { sw_leafchain(lo, hi, deflab); return; }
  int m = lo + (hi - lo) / 2; int left = newlab(); V t = binop("<", sw_c, imm(sw_T, sw_lo[sw_ord[m]])); e_jcc("jnz", t, left);
  sw_bsearch(m, hi, deflab); place(left); sw_bsearch(lo, m, deflab);
}
int use_jtab = 0;
void sw_table(int cnt, long long mn, long long mx, int deflab) {   // atlama tablosu: idx = c - mn ; jtab idx, N (dizin disi -> merdivenin ardi = default) + N adet ileri 'jmp' merdiveni
  int T = sw_T; long long span = mx - mn + 1;
  V idx = binop("-", sw_c, imm(T, mn));
  V ix = to_scalar(idx, mkt(Y_LONG, 0 - 1, 0), 0); V ixm = mat(ix); V ixc = cast_k(ixm, 0);
  w("  jtab "); wr(ixc.reg); w(", "); wn(span); wc(10);
  long long v = mn; while (v <= mx) {
    int tgt = deflab; int j = 0; while (j < cnt) { int e = sw_ord[j]; if (v >= sw_lo[e] && v <= sw_hi[e]) tgt = sw_lab[e]; j = j + 1; }
    jmpl(tgt); v = v + 1;
  }
  jmpl(deflab);
}
void gen_switch(int n) {
  curline = nk_line[n]; int base = nreg; int r0 = reach;
  V c = gen(kid(n, 0)); if (is_cls(unq(c.ty))) c = unwrap_conv(c); c = rval(c);
  if (is_int(c.ty) == 0) die("E_TYPE", "switch kosulu tamsayi olmali");
  int T = promote(c.ty); if (tk[T] == Y_BOOL) T = mkt(Y_INT, 0 - 1, 0); c = convert_arith(c, T); c = mat(c); nreg = nreg;
  int sT = sw_T; int sb = sw_base; int sn0 = sw_n; int sdef = sw_deflab; int snv = sw_nv0;
  sw_T = T; sw_base = sw_n;
  sw_collect(kid(n, 1));
  int cnt = 0; int defi = 0 - 1; int i = sw_base;
  while (i < sw_n) {
    if (sw_def[i]) { if (defi >= 0) { curline = nk_line[sw_node[i]]; die("E_CASE", "birden fazla default"); } defi = i; }
    else { sw_ord[cnt] = i; cnt = cnt + 1; }
    i = i + 1;
  }
  // siralama (insertion) ve cakisma denetimi
  i = 1; while (i < cnt) { int e = sw_ord[i]; int j = i - 1; while (j >= 0 && sw_lo[sw_ord[j]] > sw_lo[e]) { sw_ord[j + 1] = sw_ord[j]; j = j - 1; } sw_ord[j + 1] = e; i = i + 1; }
  i = 1; while (i < cnt) { if (sw_lo[sw_ord[i]] <= sw_hi[sw_ord[i - 1]]) { curline = nk_line[sw_node[sw_ord[i]]]; die("E_CASE", "yinelenen ya da cakisan case degeri"); } i = i + 1; }
  int end = newlab(); int deflab = end; if (defi >= 0) deflab = sw_lab[defi];
  sw_c = c;
  int dense = 0; long long mn = 0; long long mx = 0;
  if (cnt > 0) { mn = sw_lo[sw_ord[0]]; mx = sw_hi[sw_ord[cnt - 1]]; long long vals = 0; i = 0; while (i < cnt) { vals = vals + (sw_hi[sw_ord[i]] - sw_lo[sw_ord[i]] + 1); i = i + 1; }
    if (use_jtab && cnt >= 4 && mx - mn >= 0 && mx - mn < 1024 && (mx - mn + 1) <= 3 * vals) dense = 1; }
  if (cnt == 0) jmpl(deflab);
  else if (dense) sw_table(cnt, mn, mx, deflab);
  else sw_bsearch(0, cnt, deflab);
  nreg = base;
  loop_hs[nloop] = nhs; loop_brk[nloop] = end; loop_cont[nloop] = 0 - 1; loop_kind[nloop] = 1; loop_bs[nloop] = 0; loop_cs[nloop] = 0; nloop = nloop + 1;
  int mark = nvars; int sl = scope_lo; sw_nv0 = nvars; int bodyfall = 1;
  reach = 0; stmt(kid(n, 1)); bodyfall = reach; nvars = mark; scope_lo = sl;
  nloop = nloop - 1; place(end);
  reach = 0; if (r0) { if (defi < 0) reach = 1; if (loop_bs[nloop]) reach = 1; if (bodyfall) reach = 1; }
  sw_n = sn0; sw_T = sT; sw_base = sb; sw_deflab = sdef; sw_nv0 = snv; nreg = base;
}
void gen_case_label(int n) {
  int i = sw_base; int f = 0 - 1; while (i < sw_n) { if (sw_node[i] == n) f = i; i = i + 1; }
  if (f < 0) { curline = nk_line[n]; die("E_CASE", "case/default switch disinda"); }
  int j = sw_nv0; while (j < nvars) { if (vinit[j]) { curline = nk_line[n]; die("E_JUMPINIT", "case etiketi ilklendirmeli bir degiskenin tanimini atliyor"); } j = j + 1; }
  place(sw_lab[f]); reach = 1;
}
// ---- range-for: sentetik PMX1 dugumleriyle acilir:  { auto&& R = aralik; auto B = begin; auto E = end; for (; B != E; ++B) { dekl = *B; govde } }
void gen_rangefor(int n) {
  int line = nk_line[n]; int decls = kid(n, 0); int rng = kid(n, 1); int body = kid(n, 2); int uv = kid(decls, 0);
  int sv = may_throw; dry = dry + 1; V rv = gen(rng); dry = dry - 1; may_throw = sv; int rt = unq(deref(rv.ty));
  int R = hidname("__rng"); int B = hidname("__bg"); int E = hidname("__en");
  int d1 = mkdecls(mkvar(autoty(2, line), R, rng, line), line);
  int bexp; int eexp;
  if (is_arr(rt)) {
    if (tn[rt] <= 0) die("E_TYPE", "range-for: boyutsuz dizi");
    int cntn = mknode(N_INT, tn[rt], 0 - 1, line, 0, 0, 0, 0); nk_j[cntn] = mkt(Y_LONG, 0 - 1, 0);
    bexp = mkid(R, line); eexp = mkbin("+", mkid(R, line), cntn, line);
  } else if (is_cls(rt) && cl_bi[tcl[rt]] == 5) {
    int cnd = mknode(N_CALL, 0, 0 - 1, line, 1, mknode(N_MEMBER, 0, intern_c("next"), line, 1, mkid(R, line), 0, 0), 0, 0);
    int vcall = mknode(N_CALL, 0, 0 - 1, line, 1, mknode(N_MEMBER, 0, intern_c("value"), line, 1, mkid(R, line), 0, 0), 0, 0);
    int uvar2 = mknode(N_VAR, 1, nk_s1[uv], line, 2, kid(uv, 0), vcall, 0);
    int inner2 = mknode(N_BLOCK, 0, 0 - 1, line, 2, mkdecls(uvar2, line), body, 0);
    int wh = mknode(N_WHILE, 0, 0 - 1, line, 2, cnd, inner2, 0);
    stmt(mknode(N_BLOCK, 0, 0 - 1, line, 2, d1, wh, 0)); return;
  } else if (is_cls(rt)) {
    methods_named(tcl[rt], intern_c("begin"));
    if (nmeth_cand > 0) {
      bexp = mknode(N_CALL, 0, 0 - 1, line, 1, mknode(N_MEMBER, 0, intern_c("begin"), line, 1, mkid(R, line), 0, 0), 0, 0);
      eexp = mknode(N_CALL, 0, 0 - 1, line, 1, mknode(N_MEMBER, 0, intern_c("end"), line, 1, mkid(R, line), 0, 0), 0, 0);
    } else {
      bexp = mknode(N_CALL, 0, 0 - 1, line, 2, mkid(intern_c("begin"), line), mkid(R, line), 0);
      eexp = mknode(N_CALL, 0, 0 - 1, line, 2, mkid(intern_c("end"), line), mkid(R, line), 0);
    }
  } else { die("E_TYPE", "range-for: dizi ya da begin()/end() olan sinif bekleniyor"); bexp = 0; eexp = 0; }
  int d2 = mkdecls(mkvar(autoty(0, line), B, bexp, line), line); int d3 = mkdecls(mkvar(autoty(0, line), E, eexp, line), line);
  int deref_ = mknode(N_UNARY, 0, intern_c("*"), line, 1, mkid(B, line), 0, 0);
  int uvar = mknode(N_VAR, 1, nk_s1[uv], line, 2, kid(uv, 0), deref_, 0);
  int inner = mknode(N_BLOCK, 0, 0 - 1, line, 2, mkdecls(uvar, line), body, 0);
  int cond = mkbin("!=", mkid(B, line), mkid(E, line), line);
  int inc = mknode(N_PREINC, 0, intern_c("++"), line, 1, mkid(B, line), 0, 0);
  int none1 = mknode(N_NONE, 0, 0 - 1, line, 0, 0, 0, 0);
  int fr = mknode(N_FOR, 0, 0 - 1, line, 3, none1, cond, inc); kids[nkids] = inner; nkids = nkids + 1; nk_n[fr] = 4;
  int whole = mknode(N_BLOCK, 0, 0 - 1, line, 3, d1, d2, d3); kids[nkids] = fr; nkids = nkids + 1; nk_n[whole] = 4;
  stmt(whole);
}
// ---- desen eslestirme (__match): sentetik dugumlerle ----
int pat_test(int pn, int subj, int fl) {
  int k = nk_k[pn]; int line = nk_line[pn];
  if (k == N_PWILD) return 0;
  if (k == N_PCONST) { int ok = newlab(); cj(mkbin("==", subj, kid(pn, 0), line), ok, fl, ok); place(ok); return 0; }
  if (k == N_PRANGE) { int ok = newlab(); int cnd = mkbin("&&", mkbin(">=", subj, kid(pn, 0), line), mkbin("<=", subj, kid(pn, 1), line), line); cj(cnd, ok, fl, ok); place(ok); return 0; }
  if (k == N_PBIND) { declvar(mkvar(kid(pn, 0), nk_s1[pn], subj, line)); return 0; }
  if (k == N_PALT) {
    int ok = newlab(); int i = 0;
    while (i < nk_n[pn]) { int alt = kid(pn, i); if (nk_k[alt] == N_PBIND) die("E_PATTERN", "desen secenekleri baglama iceremez");
      if (i < nk_n[pn] - 1) { int nf = newlab(); pat_test(alt, subj, nf); jmpl(ok); place(nf); } else pat_test(alt, subj, fl); i = i + 1; }
    place(ok); return 0;
  }
  if (k == N_PSTRUCT) {
    int sv = may_throw; dry = dry + 1; V sv_ = gen(subj); dry = dry - 1; may_throw = sv; int ct = unq(deref(sv_.ty));
    if (is_cls(ct) == 0) die("E_PATTERN", "yapi deseni sinif nesnesi gerektirir");
    int ci = tcl[ct]; if (nk_n[pn] != cl_nf[ci]) die("E_PATTERN", "yapi deseni alan sayisiyla uyusmuyor");
    int i = 0; while (i < nk_n[pn]) { int fld = cl_f0[ci] + i; int mem = mknode(N_MEMBER, 0, fl_name[fld], line, 1, subj, 0, 0); pat_test(kid(pn, i), mem, fl); i = i + 1; }
    return 0;
  }
  die("E_PATTERN", "bilinmeyen desen"); return 0;
}
void gen_match(int n) {
  int line = nk_line[n]; int r0 = reach; int M = hidname("__mt"); int mark = nvars;
  declvar(mkvar(autoty(0, line), M, kid(n, 0), line));
  int end = newlab(); int any = 0; int i = 1; int allr = 0;
  while (i < nk_n[n]) {
    int arm = kid(n, i); int nx = newlab(); int m2 = nvars; reach = r0;
    pat_test(kid(arm, 0), mkid(M, line), nx);
    if (nk_k[kid(arm, 1)] != N_NONE) { int okg = newlab(); cj(kid(arm, 1), okg, nx, okg); place(okg); }
    stmt(kid(arm, 2)); if (reach) allr = 1; jmpl(end); nvars = m2; place(nx); i = i + 1;
  }
  place(end); reach = r0; if (allr) reach = r0; nvars = mark;
}
void stmt(int n) {
  int k = nk_k[n]; int base = nreg; curline = nk_line[n];
  if (k == N_EMPTY) return;
  if (k == N_BLOCK) { int mark = nvars; int sl = scope_lo; scope_lo = nvars; int i = 0; while (i < nk_n[n]) { stmt(kid(n, i)); i = i + 1; } nvars = mark; scope_lo = sl; return; }
  if (co_mode && (k == N_DECLS || k == N_EXPRSTMT)) { nhoist = 0; hoist_co(n); nreg = base; }
  if (k == N_DECLS) { int i = 0; while (i < nk_n[n]) { declvar(kid(n, i)); nreg = base; i = i + 1; } return; }
  if (k == N_EXPRSTMT) { gen(kid(n, 0)); nreg = base; return; }
  if (k == N_IF) {
    int r0 = reach; int hasel = nk_n[n] > 2; int mark = nvars;
    if (nk_i[n] == 1) {   // if constexpr: kosul sabit; secilmeyen dal denetlenir (dry) ama uretilmez
      int sv = may_throw; dry = dry + 1; V cc_ = gen(kid(n, 0)); dry = dry - 1; may_throw = sv;
      if (cc_.ci == 0) die("E_CONSTEXPR", "if constexpr kosulu sabit ifade olmali");
      int taken = 2; if (cc_.cv != 0) taken = 1;
      int th = kid(n, 1); int el = 0 - 1; if (hasel) el = kid(n, 2);
      if (taken == 1) { stmt(th); nvars = mark; int rr = reach; if (el >= 0) { dry = dry + 1; reach = r0; stmt(el); dry = dry - 1; nvars = mark; } reach = rr; }
      else { dry = dry + 1; stmt(th); dry = dry - 1; nvars = mark; reach = r0; if (el >= 0) { stmt(el); nvars = mark; } }
      return;
    }
    int tl = newlab(); int fl = newlab(); int end = newlab();
    int m = cj(kid(n, 0), tl, fl, tl); nreg = base; place(tl);
    reach = 0; if (r0 && (m & 1)) reach = 1;
    stmt(kid(n, 1)); nvars = mark; int r1 = reach;
    if (hasel) { jmpl(end); place(fl); reach = 0; if (r0 && (m & 2)) reach = 1; stmt(kid(n, 2)); nvars = mark; int r2 = reach; place(end); reach = 0; if (r1 || r2) reach = 1; }
    else { place(fl); reach = 0; if (r1 || (r0 && (m & 2))) reach = 1; }
    return;
  }
  if (k == N_WHILE) {
    int r0 = reach; int top = newlab(); int end = newlab(); int bl = newlab(); place(top);
    int m = cj(kid(n, 0), bl, end, bl); nreg = base; place(bl);
    loop_hs[nloop] = nhs; loop_brk[nloop] = end; loop_cont[nloop] = top; loop_kind[nloop] = 0; loop_bs[nloop] = 0; loop_cs[nloop] = 0; nloop = nloop + 1;
    reach = 0; if (r0 && (m & 1)) reach = 1;
    int mark = nvars; stmt(kid(n, 1)); nvars = mark; nloop = nloop - 1;
    jmpl(top); place(end); reach = 0; if (r0 && ((m & 2) || loop_bs[nloop])) reach = 1; return;
  }
  if (k == N_DO) {
    int r0 = reach; int top = newlab(); int cont = newlab(); int end = newlab(); place(top);
    loop_hs[nloop] = nhs; loop_brk[nloop] = end; loop_cont[nloop] = cont; loop_kind[nloop] = 0; loop_bs[nloop] = 0; loop_cs[nloop] = 0; nloop = nloop + 1;
    int mark = nvars; stmt(kid(n, 0)); nvars = mark; nloop = nloop - 1;
    place(cont); if (loop_cs[nloop]) reach = 1; int rc = reach;
    int m = cj(kid(n, 1), top, end, end); nreg = base; place(end);
    reach = 0; if (r0 && (loop_bs[nloop] || (rc && (m & 2)))) reach = 1; return;
  }
  if (k == N_FOR) {
    int r0 = reach; int mark = nvars; int sl = scope_lo; scope_lo = nvars; if (nk_k[kid(n, 0)] != N_NONE) stmt(kid(n, 0));
    int top = newlab(); int cont = newlab(); int end = newlab(); place(top); int base2 = nreg; int m = 1;
    if (nk_k[kid(n, 1)] != N_NONE) { int bl = newlab(); m = cj(kid(n, 1), bl, end, bl); nreg = base2; place(bl); }
    loop_hs[nloop] = nhs; loop_brk[nloop] = end; loop_cont[nloop] = cont; loop_kind[nloop] = 0; loop_bs[nloop] = 0; loop_cs[nloop] = 0; nloop = nloop + 1;
    reach = 0; if (r0 && (m & 1)) reach = 1;
    int m2 = nvars; stmt(kid(n, 3)); nvars = m2; nloop = nloop - 1;
    place(cont); if (loop_cs[nloop]) reach = 1; if (nk_k[kid(n, 2)] != N_NONE) { gen(kid(n, 2)); nreg = base2; }
    jmpl(top); place(end); reach = 0; if (r0 && ((m & 2) || loop_bs[nloop])) reach = 1; nvars = mark; scope_lo = sl; return;
  }
  if (k == N_RANGEFOR) { gen_rangefor(n); return; }
  if (k == N_SWITCH) { gen_switch(n); return; }
  if (k == N_CASE || k == N_DEFAULT) { gen_case_label(n); return; }
  if (k == N_LABEL) { gen_label(n); return; }
  if (k == N_GOTO) { gen_goto(n); return; }
  if (k == N_MATCH) { gen_match(n); return; }
  if (k == N_COYIELD || k == N_CORETURN || k == N_COAWAIT) { gen_coro(n); nreg = base; return; }
  if (k == N_THROW) { gen_throw(n); nreg = base; reach = 0; return; }
  if (k == N_TRY) { gen_try(n); return; }
  if (k == N_STATASSERT) { static_assert_check(n); return; }
  if (k == N_RETURN) { stmt_return(n); nreg = base; reach = 0; return; }
  if (k == N_BREAK) { if (nloop == 0) die("E_STMT", "'break' dongu ya da switch disinda"); loop_bs[nloop - 1] = 1; hs_restore_to(loop_hs[nloop - 1]); jmpl(loop_brk[nloop - 1]); reach = 0; return; }
  if (k == N_CONTINUE) {
    int lc = nloop - 1; while (lc >= 0 && loop_kind[lc] == 1) lc = lc - 1;
    if (lc < 0) die("E_STMT", "'continue' dongu disinda"); loop_cs[lc] = 1; hs_restore_to(loop_hs[lc]); jmpl(loop_cont[lc]); reach = 0; return;
  }
  die("E_INTERNAL", "deyim bekleniyordu");
}
int co_pure_lv(int e) { int k = nk_k[e]; if (k == N_ID) return 1; if (k == N_MEMBER || k == N_ARROW) return co_pure_lv(kid(e, 0)); return 0; }
// co_await: oznel awaiter protokolu (await_ready / await_suspend(tutamac) / await_resume) -- awaiter nesnesi cerceve yuvasinda tutulur (askida kalir)
V gen_coawait_core(int n) {
  if (co_mode == 0) die("E_COROUTINE", "co_await yalniz korutin icinde kullanilabilir");
  curline = nk_line[n];
  V a = gen(kid(n, 0));
  if (is_cls(unq(a.ty)) == 0 || cl_bi[tcl[unq(a.ty)]] != 0) {   // yerlesik tur: duz askiya alma (std::generator korutini), sonuc yok
    co_k = co_k + 1; e_sti(co_k, mkv(0, 0, FPID), 0); long long two = e_movi(0, 2); w("  ret "); wr(two); wc(10); place(co_lab0 + co_k - 1); reach = 1; return novalue();
  }
  int T = unq(a.ty); int ci = tcl[T];
  methods_named(ci, intern_c("await_ready")); if (nmeth_cand == 0) die("E_COROUTINE", "awaiter await_ready() tanimlamali"); int m_ready = meth_cand[0];
  methods_named(ci, intern_c("await_suspend")); if (nmeth_cand == 0) die("E_COROUTINE", "awaiter await_suspend() tanimlamali"); int m_susp = meth_cand[0];
  methods_named(ci, intern_c("await_resume")); if (nmeth_cand == 0) die("E_COROUTINE", "awaiter await_resume() tanimlamali"); int m_res = meth_cand[0];
  if (fn_np[m_susp] != 1) die("E_COROUTINE", "await_suspend(std::coroutine_handle<>) tek parametre almali");
  int lv = a.cat == 1 && co_pure_lv(kid(n, 0));   // sol deger awaiter: nesnenin kendisi kullanilir (askidan donuste ifade yeniden degerlendirilir); aksi halde cerceve yuvasina kopyalanir
  int off = 0; V sa = a;
  if (lv == 0) { off = slot(cl_words[ci]); sa = slotaddr(off); V c = to_mem_value(a, T); V dst = mkv(T, 1, sa.reg); copy_n(dst, c, 0, cl_words[ci]); }
  V self = mkv(T, 1, sa.reg); self.vp = 1;
  V rd = callfn(m_ready, &self, 0, 0, 0); rd = to_scalar(rval(rd), bool_t(), 0);
  int Lready = newlab(); e_jcc("jnz", rd, Lready);
  co_k = co_k + 1; int kk = co_k; e_sti(kk, mkv(0, 0, FPID), 0);
  int P0 = fn_pt[m_susp * 8]; if (is_cls(unq(P0)) == 0) die("E_COROUTINE", "await_suspend parametresi tutamac sinifi olmali");
  V hv = tempobj(unq(P0)); e_st(mkv(0, 0, FPID), mkv(0, 0, hv.reg), 0);
  V hargs[1]; hargs[0] = hv;
  int rt = fn_ret[m_susp]; V sr = callfn(m_susp, &self, hargs, 1, 0);
  if (is_void(rt) == 0 && is_cls(unq(rt)) == 0) { V sb = to_scalar(rval(sr), bool_t(), 0); e_jcc("jz", sb, Lready); }   // bool: false -> askiya alma, devam
  else if (is_cls(unq(rt))) {   // simetrik aktarim: donen tutamac ayni anda devam ettirilir
    long long hf = newreg(); e_ld(hf, 1, mkv(0, 0, sr.reg), 0); int skip = newlab(); e_jcc("jz", mkv(0, 0, hf), skip);
    long long rr = newreg(); setk(rr, 0); w("  call "); wr(rr); w(", corun, "); wr(hf); wc(10); note_win(1); may_throw = 1; if (exc_on) exc_check(); place(skip);
  }
  long long two = e_movi(0, 2); w("  ret "); wr(two); wc(10);
  place(co_lab0 + kk - 1); place(Lready); reach = 1;
  V self2; if (lv) { V a2 = gen(kid(n, 0)); self2 = mkv(T, 1, a2.reg); self2.vp = 1; } else { V sa2 = slotaddr(off); self2 = mkv(T, 1, sa2.reg); self2.vp = 1; }
  return callfn(m_res, &self2, 0, 0, 0);
}
// deyim/bildirim icindeki co_await'leri degerlendirme sirasiyla onceden yapar; sonuc gizli yerel degiskene konur (askidan donuste yazmac gecerli olmaz)
void hoist_co(int n) {
  int i = 0; if (nk_k[n] == N_LAMBDA) return;
  while (i < nk_n[n]) { hoist_co(kid(n, i)); i = i + 1; }
  if (nk_k[n] == N_COAWAIT && co_mode) {
    if (nhoist >= 64) die("E_SINIR", "cok fazla co_await ifadesi");
    V r = gen_coawait_core(n); int nm = nameU("__co", n);
    hoist_node[nhoist] = n; hoist_void[nhoist] = is_void(r.ty); nhoist = nhoist + 1;
    if (is_void(r.ty) == 0) {
      if (is_sc(unq(r.ty)) == 0 || words_of(unq(r.ty)) != 1 || is_ld(unq(r.ty))) die("E_COROUTINE", "co_await sonucu tek sozcuklu skaler olmali");
      int T = unq(r.ty); r = rval(r); int off = slot(1); e_st(mat(r), slotaddr(off), 0);
      vname[nvars] = nm; vty[nvars] = T; voff[nvars] = off; vref[nvars] = 0; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1;
    }
  }
}
V gen_coawait_use(int n) {   // ifade icinde co_await: onceden yapilmis olmali
  int i = 0; while (i < nhoist) { if (hoist_node[i] == n) { if (hoist_void[i]) return novalue(); return var_ref(findvar(nameU("__co", n))); } i = i + 1; }
  die("E_COROUTINE", "co_await ifadesi yalniz ifade deyimi ya da bildirim ilklendiricisi icinde kullanilabilir"); return novalue();
}
void gen_coro(int n) {
  int k = nk_k[n]; if (co_mode == 0) die("E_COROUTINE", "korutin yalniz std::generator ya da promise_type'li sinif donduren islevlerde kullanilir");
  if (fn_co[co_cur] == 2) {   // promise'li korutin
    if (k == N_CORETURN) {
      if (nk_n[n] > 0) { int c0 = kid(n, 0); stmt(exprstmt(pro_call("return_value", 1, c0))); }
      else if (has_pro_method(co_cur, "return_void")) stmt(exprstmt(pro_call("return_void", 0, 0)));
      stmt(mk0(N_GOTO, 0, N_COFINAL)); reach = 0; return;
    }
    if (k == N_COYIELD) { int aw = mk1(N_COAWAIT, 0, 0 - 1, pro_call("yield_value", 1, kid(n, 0))); gen_coawait_core(aw); return; }
    gen_coawait_core(n); return;
  }
  if (k == N_CORETURN) { if (nk_n[n] > 0) die("E_COROUTINE", "std::generator korutininde co_return deger tasiyamaz"); emit_ret(imm(0, 0)); reach = 0; return; }
  int T = co_elem(co_cur);
  if (k == N_COYIELD) { V v = to_scalar(gen(kid(n, 0)), T, 0); e_st(mat(v), mkv(0, 0, FPID), 1); }
  else { gen_coawait_core(n); return; }
  co_k = co_k + 1; e_sti(co_k, mkv(0, 0, FPID), 0); long long one = e_movi(0, k == N_COYIELD ? 1 : 2); w("  ret "); wr(one); wc(10); place(co_lab0 + co_k - 1); reach = 1;
}
// ============================ VARSAYILAN KARSILASTIRMA (= default) ============================
int cmp_kind(int t) {
  t = unq(t);
  if (is_flt(t)) return 3; if (is_int(t) || is_ptr(t)) return 1;
  if (is_cls(t)) {
    methods_named(tcl[t], N_SS);
    if (nmeth_cand > 0) { int m = meth_cand[0]; if (is_ord(fn_ret[m])) return cl_bi[tcl[unq(deref(fn_ret[m]))]]; }
    die("E_DEFAULT", "uye sinifi icin <=> tanimli degil: varsayilan karsilastirma silinmis");
  }
  die("E_DEFAULT", "bu uye turu karsilastirilamaz"); return 1;
}
V member_view(int ci_cls, V th, int i_field) { return th; }
void default_members(int ci, int* tys, long long* woffs, int* nm) {
  int n = 0;
  if (cl_base[ci] >= 0) { tys[n] = clsty(cl_base[ci]); woffs[n] = 0; n = n + 1; }
  int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
  while (i < e) { if (is_arr(fl_ty[i])) die("E_DEFAULT", "dizi uyeli varsayilan karsilastirma desteklenmiyor"); tys[n] = fl_ty[i]; woffs[n] = fl_woff[i]; n = n + 1; i = i + 1; }
  *nm = n;
}
int default_cmp_kind(int ci) {
  int tys[64]; long long wo[64]; int n; default_members(ci, tys, wo, &n); int kind = 1; int i = 0;
  while (i < n) { int k = cmp_kind(tys[i]); if (k > kind) kind = k; i = i + 1; }
  return kind;
}
int N_ONAME = 0;
void default_body(int fi) {
  int ci = fn_cls[fi]; V th = this_value(); th = mat(th); int vo = findvar(N_ONAME); V ov = var_ref(vo); ov = mat(ov);
  int tys[64]; long long wo[64]; int n; default_members(ci, tys, wo, &n);
  int iseq = fn_name[fi] == N_EQ; int i = 0;
  if (iseq) {
    long long res = newreg(); int fl_ = newlab(); int end = newlab();
    while (i < n) {
      V A = mkv(tys[i], 1, th.reg); V B = mkv(tys[i], 1, ov.reg);
      if (wo[i] != 0) { A = addr_plus(th, wo[i]); A.ty = tys[i]; B = addr_plus(ov, wo[i]); B.ty = tys[i]; }
      V r;
      if (is_cls(unq(tys[i]))) { V ops[2]; ops[0] = A; ops[1] = B; r = user_op(N_EQ, ops, 2, 1); if (r.ty < 0) die("E_DEFAULT", "uye sinifi icin == tanimli degil"); }
      else r = binop("==", rval(A), rval(B));
      V b = cond_bool(r); e_jcc("jz", b, fl_); i = i + 1;
    }
    setk(res, 3); w("  mov "); wr(res); w(", 1\n  jmp "); wl(end); wc(10); wl(fl_); w(":\n  mov "); wr(res); w(", 0\n"); wl(end); w(":\n");
    emit_ret(mkv(bool_t(), 0, res)); return;
  }
  int rt = unq(fn_ret[fi]);
  while (i < n) {
    V A = mkv(tys[i], 1, th.reg); V B = mkv(tys[i], 1, ov.reg);
    if (wo[i] != 0) { A = addr_plus(th, wo[i]); A.ty = tys[i]; B = addr_plus(ov, wo[i]); B.ty = tys[i]; }
    V o;
    if (is_cls(unq(tys[i]))) { V ops[2]; ops[0] = A; ops[1] = B; o = user_op(N_SS, ops, 2, 0); if (o.ty < 0) die("E_DEFAULT", "uye sinifi icin <=> tanimli degil"); }
    else o = builtin_spaceship(rval(A), rval(B));
    V z = ord_cmp_zero("!=", o); int nx = newlab(); e_jcc("jz", z, nx);
    V c = to_class_value(o, rt); int sv = findvar(N_SRET); V sp = rval(var_ref(sv)); copy_n(sp, c, 0, 1); emit_ret(imm(0, 0)); wl(nx); w(":\n");
    i = i + 1;
  }
  int kind = cl_bi[tcl[rt]]; V eq = ord_obj(kind, imm(0, 0)); V c = to_class_value(eq, rt); int sv = findvar(N_SRET); V sp = rval(var_ref(sv)); copy_n(sp, c, 0, 1); emit_ret(imm(0, 0));
}
// ============================ ISLEV GOVDESI ============================
int fn_body_node(int fi) { int fnode = fn_node[fi]; if (nk_n[fnode] > 2) return kid(fnode, 2); return 0 - 1; }
int has_co(int n) { int k = nk_k[n]; if (k == N_COYIELD || k == N_COAWAIT || k == N_CORETURN) return 1; int i = 0; while (i < nk_n[n]) { if (has_co(kid(n, i))) return 1; i = i + 1; } return 0; }
int count_co(int n) { int k = nk_k[n]; int c = 0; if (k == N_COYIELD || k == N_COAWAIT) c = 1; int i = 0; while (i < nk_n[n]) { c = c + count_co(kid(n, i)); i = i + 1; } return c; }
int fn_pc[1700]; int co_wrapn[1700]; int co_fw[1700]; int co_creator = 0; int N_PROMISE = 0; int N_COFINAL = 0;
int hoist_node[64]; int hoist_void[64]; int nhoist = 0;
int intern_cat(int sid, const char* suf) { int k = 0; int i = 0; while (i < s_len[sid] && k < 200) { tmpb[k] = chars[s_off[sid] + i]; k = k + 1; i = i + 1; } int j = 0; while (suf[j] && k < 220) { tmpb[k] = suf[j]; k = k + 1; j = j + 1; } tmpb[k] = 0; return intern_n(tmpb, k); }
int pro_call(const char* meth, int narg, int a0) {   // __promise.meth(a0)
  int idn = mk0(N_ID, 0, N_PROMISE); int mem = mk1(N_MEMBER, 0, intern_c(meth), idn);
  int ca[2]; ca[0] = mem; ca[1] = a0; return mkn(N_CALL, 0, 0 - 1, curline, narg + 1, ca);
}
int has_pro_method(int fi, const char* meth) { methods_named(fn_pc[fi], intern_c(meth)); return nmeth_cand > 0; }
int exprstmt(int e) { return mk1(N_EXPRSTMT, 0, 0 - 1, e); }
// promise'li korutin govdesi (Bolum 04.033):  { co_await promise.initial_suspend(); try { govde; promise.return_void(); } catch (...) { promise.unhandled_exception(); }  __cofinal: __co_mark(); co_await promise.final_suspend(); }
int co_wrap_body(int fi) {
  if (co_wrapn[fi] > 0) return co_wrapn[fi] - 1;
  curline = nk_line[fn_node[fi]]; int body = kid(fn_node[fi], 2);
  int init = exprstmt(mk1(N_COAWAIT, 0, 0 - 1, pro_call("initial_suspend", 0, 0)));
  int inner[2]; int ni = 1; inner[0] = body;
  if (has_pro_method(fi, "return_void")) { inner[1] = exprstmt(pro_call("return_void", 0, 0)); ni = 2; }
  int tb = mkn(N_BLOCK, 0, 0 - 1, curline, ni, inner);
  int mid = tb;
  if (has_pro_method(fi, "unhandled_exception")) {
    int cb[1]; cb[0] = exprstmt(pro_call("unhandled_exception", 0, 0)); int cblk = mkn(N_BLOCK, 0, 0 - 1, curline, 1, cb);
    int cc[2]; cc[0] = mk0(N_NONE, 0, 0 - 1); cc[1] = cblk; int ct = mkn(N_CATCH, 0, 0 - 1, curline, 2, cc);
    int tk_[2]; tk_[0] = tb; tk_[1] = ct; mid = mkn(N_TRY, 0, 0 - 1, curline, 2, tk_);
  }
  int mark = exprstmt(mk1(N_CALL, 0, 0 - 1, mk0(N_ID, 0, intern_c("__co_mark"))));
  int fin = exprstmt(mk1(N_COAWAIT, 0, 0 - 1, pro_call("final_suspend", 0, 0)));
  int st[5]; st[0] = init; st[1] = mid; st[2] = mk0(N_LABEL, 0, N_COFINAL); st[3] = mark; st[4] = fin;
  int w = mkn(N_BLOCK, 0, 0 - 1, curline, 5, st); co_wrapn[fi] = w + 1; return w;
}
int co_body_node(int fi) { if (fn_co[fi] == 2) return co_wrap_body(fi); return kid(fn_node[fi], 2); }
int co_total(int fi) { return count_co(co_body_node(fi)); }
int co_elem(int fi) { return mkt(cl_gen[tcl[unq(fn_ret[fi])]], 0 - 1, 0); }
void emit_co_creator(int fi, int frame) {   // korutin yaratici: cerceve ayirir (alloc), durum/govde kimligi/parametreleri cerceveye yazar, tutamagi sret'e koyar
  int np = fn_np[fi]; int i = 0;
  w("func f"); wn(fi); w("("); i = 0; while (i <= np) { if (i) w(", "); w("p"); wn(i); i = i + 1; } w(") {\n");
  pm_begin(0); pm_add(1); i = 0; while (i < np) { pm_add(param_kind(fn_pt[fi * 8 + i])); i = i + 1; }
  w("  mov nI, "); wn(frame < 3 ? 3 : frame); w("\n  alloc fU, nI\n  mov zI, 0\n  st zI, fU, 0\n  mov cI, "); wn(fi + 1); w("\n  st cI, fU, 2\n");
  i = 0; while (i < np) { w("  st p"); wn(i + 1); w(", fU, "); wn(3 + i); wc(10); i = i + 1; }
  w("  st fU, p0, 0\n  ret fU\n}\n"); pm_add(0); pm_add(1); pm_add(0); pm_add(0); pm_end();
}
// promise'li korutin yaratici (Bolum 04.033): cerceve ayir, basliklari/parametreleri yaz, promise'i ilkle, get_return_object() sonucunu dondur, ilk adimi (initial_suspend'e kadar) calistir
void co_creator_body(int fi) {
  int pc = fn_pc[fi]; int np = fn_np[fi]; int rt = fn_ret[fi]; int pw = cl_words[pc]; if (pw < 1) pw = 1; int params = kid(fn_node[fi], 1);
  int fw = co_fw[fi]; if (fw < 12) fw = 12;
  long long nw = e_movi(0, fw); long long fr = newreg(); setk(fr, 1); w("  alloc "); wr(fr); w(", "); wr(nw); wc(10);
  V frv = mkv(0, 0, fr);
  e_sti(0, frv, 0); e_sti(fi + 1, frv, 2); e_sti(0, frv, 3);
  int i = 0; while (i < np) { int vi = findvar(nk_s1[kid(params, i)]); V pv = rval(var_ref(vi)); e_st(mat(pv), frv, 8 + pw + i); i = i + 1; }
  long long pa = e_addi(frv, 8); init_obj(mkv(0, 1, pa), clsty(pc), 0 - 1, 0);
  methods_named(pc, intern_c("get_return_object")); if (nmeth_cand == 0) die("E_COROUTINE", "promise_type::get_return_object() yok"); int gm = meth_cand[0];
  V self = mkv(clsty(pc), 1, pa); self.vp = 1;
  V ro = callfn(gm, &self, 0, 0, 0);
  int svi = findvar(N_SRET); V sp = rval(var_ref(svi)); V c = to_class_value(ro, unq(rt)); copy_obj(sp, c, tcl[unq(rt)], 1);
  corun_used = 1; long long rr = newreg(); setk(rr, 0); w("  call "); wr(rr); w(", corun, "); wr(fr); wc(10); note_win(1); may_throw = 1; if (exc_on) exc_check();
}
int body_pass(int fi, int real, int frame) {
  int fnode = fn_node[fi]; int params = kid(fnode, 1);
  int saved_lab = nlab; long long saved_dat = ndat; int saved_s = nstrn;
  if (real == 0) has_alloca = 0; nvars = 0; nreg = 0; npair = 0; foff = 0; nloop = 0; scope_lo = 0; try_depth = 0; nhs = 0; cur_fn = fi; cur_cls = fn_cls[fi]; may_throw = 0; curline = nk_line[fnode];
  int rt = fn_ret[fi]; int sret = is_mem(unq(rt)) && is_ref(rt) == 0; int np = fn_np[fi];
