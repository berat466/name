    if (tk[T] == Y_REF && v.cat != 1 && tcv[tgtT] == 0) die("E_LVALUE", "dynamic_cast<T&>: lvalue gerekli");
    srcc = tcl[unq(v.ty)]; objaddr = v; if (tcv[v.ty] && tcv[tgtT] == 0) die("E_CONSTCAST", "dynamic_cast const'i kaldiramaz");
