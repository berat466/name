      if (r.ci && r.cv == 0) { V z = imm(T, 0); return z; }
      V o = mkv(T, 0, newreg()); w("  sar "); wr(o.reg); w(", "); opr(r); w(", 3\n"); merge_eff(o, r); return o;
    }
    die("E_REINTERP", "reinterpret_cast gecersiz");
  }
  if (is_int(T) && is_ptr(r.ty)) {
    if (tk[T] == Y_BOOL || size_of(T) != 8) die("E_REINTERP", "isaretciden tamsayiya yalniz 64 bit tamsayi");
    V o = mkv(T, 0, newreg()); w("  shl "); wr(o.reg); w(", "); opr(r); w(", 3\n"); merge_eff(o, r); return o;
  }
  die("E_REINTERP", "reinterpret_cast gecersiz"); return v;
