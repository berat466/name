  int pt = unq(probe.ty);
  if (is_cls(pt) && cl_poly[tcl[pt]] && probe.cat != 0) {
    V o = gen(kid(n, 0)); may_throw = 1; long long id = newreg(); w("  ld "); wr(id); w(", "); opr(o); w(", 0\n");
    int ti = find_class(intern_c("std::type_info")); V t = tempobj(withc(clsty(ti), 1)); w("  st "); wr(id); w(", "); opr(t); w(", 0\n"); t.cat = 1; return t;
  }
  int id = type_id_of(probe.ty); note_typeid(id, unq(deref(probe.ty))); return typeid_v(id);
}
V gen_sizeof(int n) {
  curline = nk_line[n]; int t;
  if (nk_k[n] == N_SIZEOF_E) { int sv = may_throw; dry = dry + 1; V v = gen(kid(n, 0)); dry = dry - 1; may_throw = sv; if (is_void(v.ty)) die("E_SIZEOF", "void ifadenin boyutu alinamaz"); t = v.ty; }
  else t = typeof_(kid(n, 0));
  t = deref(t);
  if (is_void(t) || complete_obj(t) == 0) die("E_SIZEOF", "tamamlanmamis/void turun boyutu alinamaz");
  if (is_arr(t) && tn[t] < 0) die("E_SIZEOF", "boyutsuz dizi");
  long long val = size_of(t); if (nk_k[n] == N_ALIGNOF) val = align_of(t);
  return imm(mkt(Y_ULONG, 0 - 1, 0), val);
}
V gen_udl(int n) {
  curline = nk_line[n]; int kind = nk_k[n]; int suf = nk_s2[n];
  char nb[100]; int k = 0; const char* pre = "operator\"\""; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (j < s_len[suf]) { nb[k] = chars[s_off[suf] + j]; k = k + 1; j = j + 1; } nb[k] = 0;
  int nm = intern_c(nb); V args[2]; int na; int want = 0;
  if (kind == N_INT) { na = 1; want = mkt(Y_ULLONG, 0 - 1, 0); args[0] = imm(want, nk_i[n]); }
  else if (kind == N_FLT) { na = 1; want = ldty(); args[0] = ld_const(nk_i[n], nk_d[n]); }
  else if (kind == N_CHR) { na = 1; want = mkt(Y_CHAR, 0 - 1, 0); args[0] = imm(want, fold(nk_i[n], want)); }
  else {
    na = 2; str_node[nstrn] = n; nstrn = nstrn + 1; long long p = newreg(); w("  mov "); wr(p); w(", s"); wn(nstrn - 1); wc(10);
    args[0] = mkv(ptrto(withc(mkt(Y_CHAR, 0 - 1, 0), 1)), 0, p); args[1] = imm(mkt(Y_ULONG, 0 - 1, 0), slen(nk_s1[n]));
  }
  int found = 0 - 1; int f = 0; int cnt = 0;
  while (f < nfn) {
    if (fn_cls[f] < 0 && fn_name[f] == nm && fn_np[f] == na) {
      int ok = 0;
      if (kind == N_STR) ok = is_ptr(fn_pt[f * 8]) && unq(fn_pt[f * 8 + 1]) == mkt(Y_ULONG, 0 - 1, 0); else ok = unq(fn_pt[f * 8]) == want;
      if (ok) { found = f; cnt = cnt + 1; }
    }
    f = f + 1;
  }
  if (cnt == 0) die("E_UDL", "uygun kullanici tanimli sabit isleci yok");
  if (cnt > 1) die("E_AMBIG", "birden fazla uygun sabit isleci");
  return callfn(found, 0, args, na, 0);
}
V gen(int n) {
  int k = nk_k[n]; curline = nk_line[n];
  if (k == N_INT) { if (nk_s2[n] >= 0) return gen_udl(n); V v = imm(mkt(nk_j[n], 0 - 1, 0), nk_i[n]); if (nk_i[n] == 0) v.nl = 1; return v; }
  if (k == N_CHR) { if (nk_s2[n] >= 0) return gen_udl(n); return imm(mkt(Y_CHAR, 0 - 1, 0), fold(nk_i[n], mkt(Y_CHAR, 0 - 1, 0))); }
  if (k == N_BOOL) return imm(bool_t(), nk_i[n]);
  if (k == N_NULLPTR) return imm(mkt(Y_NULLPTR, 0 - 1, 0), 0);
  if (k == N_FLT) {
    if (nk_s2[n] >= 0) return gen_udl(n);
    int t = mkt(nk_j[n], 0 - 1, 0);
    if (tk[t] == Y_LDOUBLE) return ld_const(nk_i[n], nk_d[n]);
    V f = fconst(t, nk_d[n]); return norm(f, t);
  }
  if (k == N_STR) {
    if (nk_s2[n] >= 0) return gen_udl(n);
    str_node[nstrn] = n; nstrn = nstrn + 1; V v = mkv(arrof(withc(mkt(Y_CHAR, 0 - 1, 0), 1), slen(nk_s1[n]) + 1), 1, newreg()); w("  mov "); wr(v.reg); w(", s"); wn(nstrn - 1); wc(10); return v;
  }
  if (k == N_THIS) return this_value();
  if (k == N_ID) return gen_id(n);
  if (k == N_UNARY) return gen_unary(n);
  if (k == N_BINARY) return gen_binary(n);
  if (k == N_ASSIGN) return gen_assign(n);
  if (k == N_PREINC || k == N_POSTINC) return gen_incdec(n);
  if (k == N_COND) return gen_cond(n);
  if (k == N_COMMA) { V l = gen(kid(n, 0)); V r = gen(kid(n, 1)); int i = 0; V r2 = r; r2.ne = 0; while (i < l.ne) { add_eff(r2, l.ek[i], l.er[i]); i = i + 1; } i = 0; while (i < r.ne) { add_eff(r2, r.ek[i], r.er[i]); i = i + 1; } return r2; }
  if (k == N_CALL) return gen_call(n);
  if (k == N_INDEX) return gen_index(n);
  if (k == N_MEMBER || k == N_ARROW) return gen_member(n);
  if (k == N_SIZEOF_E || k == N_SIZEOF_T || k == N_ALIGNOF) return gen_sizeof(n);
  if (k == N_NOEXCEPT) { int sv = may_throw; may_throw = 0; dry = dry + 1; gen(kid(n, 0)); dry = dry - 1; int thr = may_throw; may_throw = sv; return imm(bool_t(), thr == 0); }
  if (k == N_TYPEID_E || k == N_TYPEID_T) return gen_typeid(n);
  if (k == N_CAST) return gen_cast(n);
  if (k == N_FCAST) {
    int T = typeof_(kid(n, 0)); if (tk[T] == Y_AUTO) die("E_TYPE", "auto islevsel donusum hedefi olamaz");
    if (nk_i[n] == 1) {
      if (is_cls(T)) { V t = tempobj(unq(T)); init_obj(t, unq(T), kid(n, 1), 3); return t; }
      if (is_sc(T) == 0) die("E_TYPE", "bu tur {..} ile olusturulamaz");
      int off = slot(1); V ad = slotaddr(off); init_obj(ad, unq(T), kid(n, 1), 3); V v = mkv(unq(T), 0, newreg()); w("  ld "); wr(v.reg); w(", "); opr(ad); w(", 0\n"); return v;
    }
    if (nk_n[n] < 2) {
      if (is_cls(T)) { V t = tempobj(unq(T)); zero_n(t, cl_words[tcl[T]]); set_vptr(t, tcl[T]); return t; }
      if (is_void(T)) return novalue();
      if (is_flt(T)) return fconst(unq(T), 0);
      return imm(unq(T), 0);
    }
    V v = gen(kid(n, 1)); return c_style_cast(v, T);
  }
  die("E_INTERNAL", "ifade dugumu bekleniyordu"); return novalue();
}
// ============================ BASLATMA ============================
int final_overrider(int k_, int root) {
  int c = k_;
  while (c >= 0) {
    int m = 0;
    while (m < nfn) {
      if (fn_cls[m] == c && fn_has(m, F_VIRT) && fn_vroot[m] == fn_vroot[root] && fn_name[m] == fn_name[root]) {
        int same = fn_np[m] == fn_np[root]; int i = 0; while (same && i < fn_np[m]) { if (fn_pt[m * 8 + i] != fn_pt[root * 8 + i]) same = 0; i = i + 1; }
        if (same && (fn_has(m, F_CONST) == fn_has(root, F_CONST))) return m;
      }
      m = m + 1;
    }
    c = cl_base[c];
  }
  return root;
}
int is_abstract(int ci) {
  int c = ci;
  while (c >= 0) {
    int m = 0;
    while (m < nfn) { if (fn_cls[m] == c && fn_has(m, F_PURE)) { int fin = final_overrider(ci, m); if (fn_has(fin, F_PURE)) return 1; } m = m + 1; }
    c = cl_base[c];
  }
  return 0;
}
void fill_default(V addr, int t) {
  if (is_cls(t)) {
    int ci = tcl[t]; set_vptr(addr, ci);
    int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
    while (i < e) { int ft = unq(fl_ty[i]); if (is_cls(ft) || is_arr(ft)) { if (fl_woff[i] >= 0) { long long fa = newreg(); w("  add "); wr(fa); w(", "); opr(addr); w(", "); wn(fl_woff[i]); wc(10); fill_default(mkv(0, 0, fa), ft); } } i = i + 1; }
  } else if (is_arr(t) && is_cls(unq(te[t])) && cl_poly[tcl[unq(te[t])]]) {
    long long wd = words_of(te[t]); long long i = 0;
    while (i < tn[t]) { long long fa = newreg(); w("  add "); wr(fa); w(", "); opr(addr); w(", "); wn(i * wd); wc(10); fill_default(mkv(0, 0, fa), unq(te[t])); i = i + 1; }
  }
}
void check_narrow(V& v, int to) {
  int f = unq(v.ty); to = unq(to);
  if (is_arith(f) == 0 || is_arith(to) == 0) return;
  int narrow = 0;
  if (is_flt(f) && is_int(to)) narrow = 1;
  else if (is_int(f) && is_flt(to)) narrow = v.ci == 0;
  else if (is_flt(f) && is_flt(to)) narrow = tk[to] == Y_FLOAT && tk[f] != Y_FLOAT;
  else if (is_int(f) && is_int(to) && tk[to] != Y_BOOL) {
    int fs = sg_of(f); int ts = sg_of(to); int fb = bits_of(f); int tb = bits_of(to);
    int fits = (fs == ts && tb >= fb) || (fs == 0 && ts == 1 && tb > fb);
    if (fits == 0) {
      if (v.ci) { long long c = v.cv; int inr; if (ts) inr = tb == 64 || (c >= 0 - (1LL << (tb - 1)) && c < (1LL << (tb - 1))); else inr = c >= 0 && (tb == 64 || c < (1LL << tb)); if (fs == 0 && fb == 64 && c < 0) inr = tb == 64 && ts == 0; narrow = inr == 0; }
      else narrow = 1;
    }
  }
  else if (is_int(f) && tk[to] == Y_BOOL) narrow = (v.ci && (v.cv == 0 || v.cv == 1)) == 0;
  if (narrow) die("E_NARROW", "daraltici donusum {..} icinde yasak");
}
V addr_plus(V addr, long long woff) { if (woff == 0) return addr; long long r = newreg(); w("  add "); wr(r); w(", "); opr(addr); w(", "); wn(woff); wc(10); return mkv(0, 1, r); }
void init_obj(V addr, int T, int init, int style) {
  T = unq(T); int brace = style == 3;
  if (is_cls(T)) {
    int ci = tcl[T];
    if (is_abstract(ci)) die("E_ABSTRACT", "soyut sinif ornegi olusturulamaz");
    if (init < 0 || (nk_k[init] == N_INITLIST && nk_n[init] == 0 && style != 2)) { zero_n(addr, cl_words[ci]); fill_default(addr, T); return; }
    if (nk_k[init] == N_INITLIST) {
      if (cl_bi[ci]) die("E_INIT", "bu sinif {..} ile baslatilamaz");
      if (style == 2 && nk_n[init] == 1) { init_obj(addr, T, kid(init, 0), 1); return; }
      if (cl_poly[ci]) die("E_INIT", "sinif kume (aggregate) degil: sanal islevi var");
      zero_n(addr, cl_words[ci]); int idx = 0;
      if (cl_base[ci] >= 0 && idx < nk_n[init]) {
        int bt = clsty(cl_base[ci]);
        if (nk_k[kid(init, idx)] == N_INITLIST) { init_obj(addr, bt, kid(init, idx), 3); idx = idx + 1; }
        else { dry = dry + 1; V probe = gen(kid(init, idx)); dry = dry - 1; if (is_cls(unq(probe.ty)) && derived_from(tcl[unq(probe.ty)], cl_base[ci])) { V v = gen(kid(init, idx)); copy_n(addr, v, 0, cl_words[cl_base[ci]]); idx = idx + 1; } }
      }
      int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
      while (i < e && idx < nk_n[init]) { V fa = addr_plus(addr, fl_woff[i]); init_obj(fa, unq(fl_ty[i]), kid(init, idx), 3); idx = idx + 1; i = i + 1; }
      if (idx < nk_n[init]) die("E_INIT", "ilklendirici listesinde fazla eleman");
      fill_default(addr, T); return;
    }
    V v = gen(init);
    if (brace && is_cls(unq(v.ty)) == 0) die("E_INIT", "sinif nesnesi bu degerle {..} ile baslatilamaz");
    V s = to_class_value(v, T);
    if (cl_bi[ci]) copy_n(addr, s, 0, 1); else copy_obj(addr, s, ci, 1);
    return;
  }
  if (is_arr(T)) {
    int et = unq(te[T]); long long cnt = tn[T]; long long wd = words_of(et);
    if (init >= 0 && nk_k[init] == N_STR && tk[et] == Y_CHAR) {
      int sid = nk_s1[init]; if (slen(sid) + 1 > cnt) die("E_INIT", "dize sabiti diziye sigmiyor"); zero_n(addr, cnt);
      int i = 0; while (i < slen(sid)) { w("  st "); wn(chars[soff(sid) + i]); w(", "); opr(addr); w(", "); wn(i); wc(10); i = i + 1; } return;
    }
    if (init < 0) { fill_default(addr, T); return; }
    if (nk_k[init] != N_INITLIST) die("E_INIT", "dizi {..} listesiyle baslatilmali");
    if (nk_n[init] > cnt) die("E_INIT", "ilklendirici listesinde fazla eleman");
    zero_n(addr, cnt * wd);
    int i = 0; while (i < nk_n[init]) { V ea = addr_plus(addr, i * wd); init_obj(ea, et, kid(init, i), 3); i = i + 1; }
    fill_default(addr, T); return;
  }
  if (init < 0) return;
  int e = init;
  if (nk_k[init] == N_INITLIST) {
    if (nk_n[init] > 1) die("E_INIT", "skaler tek degerle ilklendirilir");
    if (nk_n[init] == 0) { zero_n(addr, words_of(T)); return; }
    e = kid(init, 0);
  }
  V v = gen(e);
  if (brace) { V r = v; if (is_cls(unq(v.ty)) == 0) r = rval(v); check_narrow(r, T); }
  V s = to_scalar(v, T, 0); if (is_ld(T)) { ld_copy(addr, s); return; }
  V ms = mat(s); w("  st "); opr(ms); w(", "); opr(addr); w(", 0\n");
}
// ============================ BILDIRIMLER / DEYIMLER ============================
int deduce_auto(int T, V& probe, int lvinit) {
  if (tk[T] == Y_AUTO) {
    int base = unq(probe.ty); if (is_arr(probe.ty)) base = ptrto(te[probe.ty]);
    if (is_void(base)) die("E_TYPE", "auto void'den cikarilamaz");
    if (tcv[T]) return withc(base, 1); return base;
  }
  if (is_ref(T) && tk[te[T]] == Y_AUTO) {
    int c = tcv[te[T]]; int bt = probe.ty;
    if (tk[T] == Y_REF) { if (lvinit == 0 && c == 0 && tcv[bt] == 0) die("E_BIND", "auto& rvalue'ya baglanamaz"); int r = bt; if (c) r = withc(bt, 1); return lref(r); }
    if (lvinit) { int r = probe.ty; if (c) r = withc(r, 1); return lref(r); }
    int r = unq(probe.ty); if (c) r = withc(r, 1); return rref(r);
  }
  return T;
}
void emit_ret(V v) { long long t = newreg(); w("  mov "); wr(t); w(", __sp\n  st fp, "); wr(t); w(", 0\n  ret "); opr(v); wc(10); }
void declvar(int vn) {
  curline = nk_line[vn]; { int q = scope_lo; while (q < nvars) { if (vname[q] == nk_s1[vn] && nk_s1[vn] >= 0) die("E_REDECL", "degisken ayni kapsamda yeniden tanimlandi"); q = q + 1; } } int T = typeof_(kid(vn, 0)); int init = 0 - 1; if (nk_n[vn] > 1) init = kid(vn, 1); int style = nk_i[vn];
  int ie = init; if (init >= 0 && nk_k[init] == N_INITLIST && nk_n[init] == 1 && (tk[T] == Y_AUTO || is_ref(T))) ie = kid(init, 0);
  int hasauto = tk[T] == Y_AUTO || (is_ref(T) && tk[te[T]] == Y_AUTO);
  if (hasauto) { if (init < 0) die("E_TYPE", "auto bildirimi ilklendirici gerektirir"); int sv = may_throw; dry = dry + 1; V pb = gen(ie); dry = dry - 1; may_throw = sv; T = deduce_auto(T, pb, pb.cat == 1); }
  if (is_arr(T) && tn[T] < 0) {
    if (init < 0) die("E_TYPE", "boyutsuz dizi ilklendirici gerektirir");
    long long cnt; if (nk_k[init] == N_STR) cnt = slen(nk_s1[init]) + 1; else if (nk_k[init] == N_INITLIST) cnt = nk_n[init]; else { die("E_TYPE", "boyutsuz dizi {..} ya da dize gerektirir"); cnt = 0; }
    if (cnt == 0) die("E_TYPE", "bos dizi"); T = arrof(te[T], cnt);
  }
  if (is_void(T)) die("E_TYPE", "void turunde degisken");
  if (tk[T] == Y_AUTO) die("E_TYPE", "auto cikarilamadi");
  if (is_ref(T)) {
    if (init < 0) die("E_INIT", "referans ilklendirici gerektirir");
    V iv = gen(ie); V ad = bind_arg(iv, T); ad = mat(ad); int off = slot(1);
    w("  st "); opr(ad); w(", fp, "); wn(off); wc(10);
    vname[nvars] = nk_s1[vn]; vty[nvars] = te[T]; voff[nvars] = off; vref[nvars] = 1; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1; return;
  }
  if (complete_obj(T) == 0) die("E_TYPE", "tamamlanmamis tur");
  if (is_cls(unq(T)) && is_abstract(tcl[unq(T)])) die("E_ABSTRACT", "soyut sinif ornegi olusturulamaz");
  int off = slot(words_of(T)); V ad = slotaddr(off); int isci = 0; long long cvv = 0;
  if (tcv[T] && is_int(T) && ie >= 0 && nk_k[ie] != N_INITLIST) { int sv = may_throw; dry = dry + 1; V pc = gen(ie); dry = dry - 1; may_throw = sv; if (pc.ci) { isci = 1; cvv = fold(pc.cv, unq(T)); } }
  if (init >= 0 && nk_k[init] == N_INITLIST && style == 2 && is_sc(T) && nk_n[init] == 1) { init = kid(init, 0); style = 1; }
  init_obj(ad, T, init, style);
  vname[nvars] = nk_s1[vn]; vty[nvars] = T; voff[nvars] = off; vref[nvars] = 0; vci[nvars] = isci; vcv[nvars] = cvv; uidn = uidn + 1; vuid[nvars] = uidn; nvars = nvars + 1;
}
int scope_lo = 0;
int loop_brk[64]; int loop_cont[64]; int nloop = 0; int N_SRET = 0;
void stmt_return(int n) {
  curline = nk_line[n]; int rt = fn_ret[cur_fn];
  if (nk_n[n] == 0) { if (is_void(rt) == 0) die("E_RETURN", "deger donduren islevde 'return' degersiz"); emit_ret(imm(0, 0)); return; }
  int e = kid(n, 0);
  if (is_void(rt)) { if (nk_k[e] == N_INITLIST) die("E_RETURN", "void islevden deger donduruluyor"); V v = gen(e); if (is_void(v.ty) == 0) die("E_RETURN", "void islevden deger donduruluyor"); emit_ret(imm(0, 0)); return; }
  if (is_ref(rt)) {
    V v = gen(e); int rr = tk[rt] == Y_RREF; int tu = unq(te[rt]);
    if (unq(v.ty) != tu && !(is_cls(unq(v.ty)) && is_cls(tu) && derived_from(tcl[unq(v.ty)], tcl[tu]))) die("E_RETURN", "referans donusu: tur uyumsuz");
    if (rr == 0 && v.cat != 1 && tcv[te[rt]] == 0) die("E_BIND", "lvalue referans rvalue'ya baglanamaz");
    if (rr && v.cat == 1) die("E_BIND", "rvalue referans lvalue'ya baglanamaz");
    if (tcv[v.ty] && tcv[te[rt]] == 0) die("E_CONST", "const nesne const olmayan referansla donduruluyor");
    V ad = v; if (v.cat == 0 && is_cls(tu) == 0) ad = tempscalar(tu, v);
    emit_ret(mat(ad)); return;
  }
  if (is_ld(unq(rt))) { V v = gen(e); V c = to_ld(v); int sv = findvar(N_SRET); V sp = rval(var_ref(sv)); ld_copy(sp, c); emit_ret(imm(0, 0)); return; }
  if (is_cls(unq(rt))) {
    V v; if (nk_k[e] == N_INITLIST) { v = tempobj(unq(rt)); init_obj(v, unq(rt), e, 3); } else v = gen(e);
    V c = to_class_value(v, unq(rt)); int sv = findvar(N_SRET); if (sv < 0) { emit_ret(imm(0, 0)); return; }
    V sp = rval(var_ref(sv));
    if (cl_bi[tcl[unq(rt)]]) copy_n(sp, c, 0, 1); else copy_obj(sp, c, tcl[unq(rt)], 1);
    emit_ret(imm(0, 0)); return;
  }
  V v;
  if (nk_k[e] == N_INITLIST) { int off = slot(1); V ad = slotaddr(off); init_obj(ad, unq(rt), e, 3); v = mkv(unq(rt), 0, newreg()); w("  ld "); wr(v.reg); w(", "); opr(ad); w(", 0\n"); }
  else v = gen(e);
  V s = to_scalar(v, unq(rt), 0); emit_ret(s);
}
void stmt(int n) {
  int k = nk_k[n]; int base = nreg; curline = nk_line[n];
  if (k == N_EMPTY) return;
  if (k == N_BLOCK) { int mark = nvars; int sl = scope_lo; scope_lo = nvars; int i = 0; while (i < nk_n[n]) { stmt(kid(n, i)); i = i + 1; } nvars = mark; scope_lo = sl; return; }
  if (k == N_DECLS) { int i = 0; while (i < nk_n[n]) { declvar(kid(n, i)); nreg = base; i = i + 1; } return; }
  if (k == N_EXPRSTMT) { gen(kid(n, 0)); nreg = base; return; }
  if (k == N_IF) {
    V c = cond_bool(gen(kid(n, 0))); int els = newlab(); int end = newlab();
    w("  jz "); opr(c); w(", "); wl(els); wc(10); nreg = base;
    int mark = nvars; stmt(kid(n, 1)); nvars = mark;
    if (nk_n[n] > 2) { w("  jmp "); wl(end); wc(10); wl(els); w(":\n"); stmt(kid(n, 2)); nvars = mark; wl(end); w(":\n"); } else { wl(els); w(":\n"); }
    return;
  }
  if (k == N_WHILE) {
    int top = newlab(); int end = newlab(); wl(top); w(":\n");
    V c = cond_bool(gen(kid(n, 0))); w("  jz "); opr(c); w(", "); wl(end); wc(10); nreg = base;
    loop_brk[nloop] = end; loop_cont[nloop] = top; nloop = nloop + 1; int mark = nvars; stmt(kid(n, 1)); nvars = mark; nloop = nloop - 1;
    w("  jmp "); wl(top); wc(10); wl(end); w(":\n"); return;
  }
  if (k == N_DO) {
    int top = newlab(); int cont = newlab(); int end = newlab(); wl(top); w(":\n");
    loop_brk[nloop] = end; loop_cont[nloop] = cont; nloop = nloop + 1; int mark = nvars; stmt(kid(n, 0)); nvars = mark; nloop = nloop - 1;
    wl(cont); w(":\n"); V c = cond_bool(gen(kid(n, 1))); w("  jnz "); opr(c); w(", "); wl(top); wc(10); nreg = base; wl(end); w(":\n"); return;
  }
  if (k == N_FOR) {
    int mark = nvars; int sl = scope_lo; scope_lo = nvars; if (nk_k[kid(n, 0)] != N_NONE) stmt(kid(n, 0));
    int top = newlab(); int cont = newlab(); int end = newlab(); wl(top); w(":\n"); int base2 = nreg;
    if (nk_k[kid(n, 1)] != N_NONE) { V c = cond_bool(gen(kid(n, 1))); w("  jz "); opr(c); w(", "); wl(end); wc(10); nreg = base2; }
    loop_brk[nloop] = end; loop_cont[nloop] = cont; nloop = nloop + 1; int m2 = nvars; stmt(kid(n, 3)); nvars = m2; nloop = nloop - 1;
    wl(cont); w(":\n"); if (nk_k[kid(n, 2)] != N_NONE) { gen(kid(n, 2)); nreg = base2; }
    w("  jmp "); wl(top); wc(10); wl(end); w(":\n"); nvars = mark; scope_lo = sl; return;
  }
  if (k == N_RETURN) { stmt_return(n); nreg = base; return; }
  if (k == N_BREAK) { if (nloop == 0) die("E_STMT", "'break' dongu disinda"); w("  jmp "); wl(loop_brk[nloop - 1]); wc(10); return; }
  if (k == N_CONTINUE) { if (nloop == 0) die("E_STMT", "'continue' dongu disinda"); w("  jmp "); wl(loop_cont[nloop - 1]); wc(10); return; }
  die("E_INTERNAL", "deyim bekleniyordu");
}
// ============================ VARSAYILAN KARSILASTIRMA (= default) ============================
int cmp_kind(int t) {
  t = unq(t);
  if (is_flt(t)) return 3; if (is_int(t) || is_ptr(t)) return 1;
  if (is_cls(t)) {
    methods_named(tcl[t], N_SS);
    if (nmeth_cand > 0) { int m = meth_cand[0]; if (is_ord(fn_ret[m])) return cl_bi[tcl[unq(deref(fn_ret[m]))]]; }
    die("E_DEFAULT", "uye sinifi icin <=> tanimli degil: varsayilan karsilastirma silinmis");
  }
  die("E_DEFAULT", "bu uye turu karsilastirilamaz"); return 1;
}
V member_view(int ci_cls, V th, int i_field) { return th; }
void default_members(int ci, int* tys, long long* woffs, int* nm) {
  int n = 0;
  if (cl_base[ci] >= 0) { tys[n] = clsty(cl_base[ci]); woffs[n] = 0; n = n + 1; }
  int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
  while (i < e) { if (is_arr(fl_ty[i])) die("E_DEFAULT", "dizi uyeli varsayilan karsilastirma desteklenmiyor"); tys[n] = fl_ty[i]; woffs[n] = fl_woff[i]; n = n + 1; i = i + 1; }
  *nm = n;
}
int default_cmp_kind(int ci) {
  int tys[64]; long long wo[64]; int n; default_members(ci, tys, wo, &n); int kind = 1; int i = 0;
  while (i < n) { int k = cmp_kind(tys[i]); if (k > kind) kind = k; i = i + 1; }
  return kind;
}
int N_ONAME = 0;
void default_body(int fi) {
  int ci = fn_cls[fi]; V th = this_value(); th = mat(th); int vo = findvar(N_ONAME); V ov = var_ref(vo); ov = mat(ov);
  int tys[64]; long long wo[64]; int n; default_members(ci, tys, wo, &n);
  int iseq = fn_name[fi] == N_EQ; int i = 0;
  if (iseq) {
    long long res = newreg(); int fl_ = newlab(); int end = newlab();
    while (i < n) {
      V A = mkv(tys[i], 1, th.reg); V B = mkv(tys[i], 1, ov.reg);
      if (wo[i] != 0) { A = addr_plus(th, wo[i]); A.ty = tys[i]; B = addr_plus(ov, wo[i]); B.ty = tys[i]; }
      V r;
      if (is_cls(unq(tys[i]))) { V ops[2]; ops[0] = A; ops[1] = B; r = user_op(N_EQ, ops, 2, 1); if (r.ty < 0) die("E_DEFAULT", "uye sinifi icin == tanimli degil"); }
      else r = binop("==", rval(A), rval(B));
      V b = cond_bool(r); w("  jz "); opr(b); w(", "); wl(fl_); wc(10); i = i + 1;
    }
    w("  mov "); wr(res); w(", 1\n  jmp "); wl(end); wc(10); wl(fl_); w(":\n  mov "); wr(res); w(", 0\n"); wl(end); w(":\n");
    emit_ret(mkv(0, 0, res)); return;
  }
  int rt = unq(fn_ret[fi]);
  while (i < n) {
    V A = mkv(tys[i], 1, th.reg); V B = mkv(tys[i], 1, ov.reg);
    if (wo[i] != 0) { A = addr_plus(th, wo[i]); A.ty = tys[i]; B = addr_plus(ov, wo[i]); B.ty = tys[i]; }
    V o;
    if (is_cls(unq(tys[i]))) { V ops[2]; ops[0] = A; ops[1] = B; o = user_op(N_SS, ops, 2, 0); if (o.ty < 0) die("E_DEFAULT", "uye sinifi icin <=> tanimli degil"); }
    else o = builtin_spaceship(rval(A), rval(B));
    V z = ord_cmp_zero("!=", o); int nx = newlab(); w("  jz "); opr(z); w(", "); wl(nx); wc(10);
    V c = to_class_value(o, rt); int sv = findvar(N_SRET); V sp = rval(var_ref(sv)); copy_n(sp, c, 0, 1); emit_ret(imm(0, 0)); wl(nx); w(":\n");
    i = i + 1;
  }
  int kind = cl_bi[tcl[rt]]; V eq = ord_obj(kind, imm(0, 0)); V c = to_class_value(eq, rt); int sv = findvar(N_SRET); V sp = rval(var_ref(sv)); copy_n(sp, c, 0, 1); emit_ret(imm(0, 0));
}
// ============================ ISLEV GOVDESI ============================
int fn_body_node(int fi) { int fnode = fn_node[fi]; if (nk_n[fnode] > 2) return kid(fnode, 2); return 0 - 1; }
int body_pass(int fi, int real, int frame) {
  int fnode = fn_node[fi]; int params = kid(fnode, 1);
  int saved_lab = nlab; long long saved_dat = ndat; int saved_s = nstrn;
  nvars = 0; nreg = 0; npair = 0; foff = 0; nloop = 0; scope_lo = 0; cur_fn = fi; cur_cls = fn_cls[fi]; may_throw = 0; curline = nk_line[fnode];
  int rt = fn_ret[fi]; int sret = is_mem(unq(rt)) && is_ref(rt) == 0; int np = fn_np[fi];
  int total = np + sret + (fn_cls[fi] >= 0); int pi_ = 0;
  if (real) {
    w("func f"); wn(fi); w("(");
    int i = 0; while (i < total) { if (i) w(", "); w("p"); wn(i); i = i + 1; }
    w(") {\n  mov _spa, __sp\n  ld fp, _spa, 0\n  add _nsp, fp, "); wn(frame); w("\n  mov _lma, __lim\n  ld _lim, _lma, 0\n  leu _okc, _nsp, _lim\n  jnz _okc, _stk_ok\n  ld _trp, -1, 0\n_stk_ok: st _nsp, _spa, 0\n");
  }
  if (sret) { int off = slot(1); if (real) { w("  st p"); wn(pi_); w(", fp, "); wn(off); wc(10); } pi_ = pi_ + 1; vname[nvars] = N_SRET; vty[nvars] = ptrto(unq(rt)); voff[nvars] = off; vref[nvars] = 0; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1; }
  if (fn_cls[fi] >= 0) {
    int off = slot(1); if (real) { w("  st p"); wn(pi_); w(", fp, "); wn(off); wc(10); } pi_ = pi_ + 1;
    int ct = clsty(fn_cls[fi]); if (fn_has(fi, F_CONST)) ct = withc(ct, 1);
    vname[nvars] = N_THISV; vty[nvars] = ptrto(ct); voff[nvars] = off; vref[nvars] = 0; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1;
  }
  int i = 0;
  while (i < np) {
    int pt = fn_pt[fi * 8 + i]; int off = slot(1); int nm = 0 - 1; if (nk_n[params] > i) nm = nk_s1[kid(params, i)];
    if (fn_has(fi, F_DEFAULT)) nm = N_ONAME;
    if (real) { w("  st p"); wn(pi_); w(", fp, "); wn(off); wc(10); } pi_ = pi_ + 1;
    vname[nvars] = nm; voff[nvars] = off; vci[nvars] = 0; vuid[nvars] = 0;
    if (is_ref(pt)) { vty[nvars] = te[pt]; vref[nvars] = 1; } else if (is_mem(unq(pt))) { vty[nvars] = pt; vref[nvars] = 1; } else { vty[nvars] = pt; vref[nvars] = 0; }
    nvars = nvars + 1; i = i + 1;
  }
  if (fn_has(fi, F_DEFAULT)) default_body(fi);
  else stmt(fn_body_node(fi));
  if (real) { emit_ret(imm(0, 0)); w("}\n"); }
  int used = foff; if (used < 1) used = 1;
  if (real == 0) { nlab = saved_lab; ndat = saved_dat; nstrn = saved_s; }
  return used;
}
// ============================ BILDIRIM ASAMASI ============================
int same_params(int a, int b) { if (fn_np[a] != fn_np[b]) return 0; int i = 0; while (i < fn_np[a]) { if (fn_pt[a * 8 + i] != fn_pt[b * 8 + i]) return 0; i = i + 1; } return 1; }
int declare_func(int node, int cls) {
  curline = nk_line[node]; int f = nfn; if (nfn >= NF) die("E_SINIR", "cok fazla islev");
  fn_name[f] = nk_s1[node]; fn_cls[f] = cls; fn_node[f] = node; fn_fl[f] = nk_i[node]; fn_bi[f] = 0; fn_vroot[f] = 0 - 1; fn_used[f] = 0; fn_line[f] = nk_line[node];
  int params = kid(node, 1); int np = nk_n[params]; if (np > 8) die("E_SINIR", "cok fazla parametre"); fn_np[f] = np;
  fn_ret[f] = typeof_(kid(node, 0));
  int i = 0;
  while (i < np) {
    int pt = typeof_(kid(kid(params, i), 0)); if (is_arr(pt)) pt = ptrto(te[pt]);
    if (is_void(pt)) die("E_TYPE", "void parametre");
    if (is_ref(pt) == 0) pt = unq(pt);
    fn_pt[f * 8 + i] = pt; i = i + 1;
  }
  if (fn_name[f] == N_CONV && np != 0) die("E_OP", "donusum islecinin parametresi olamaz");
  if (cls < 0 && fn_has(f, F_CONST)) die("E_OP", "uye olmayan islev const olamaz");
  int nm = fn_name[f];
  if (cls < 0 && s_len[nm] > 8 && chars[s_off[nm]] == 'o' && chars[s_off[nm] + 1] == 'p' && chars[s_off[nm] + 8] != '"' && nm != N_CONV) {
    int hascls = 0; int k = 0; while (k < np) { if (is_cls(unq(deref(fn_pt[f * 8 + k])))) hascls = 1; k = k + 1; }
    if (hascls == 0) die("E_OP", "operator en az bir sinif turlu parametre gerektirir");
  }
  if (cls < 0 && s_len[nm] > 10 && chars[s_off[nm]] == 'o' && chars[s_off[nm] + 8] == '"') {   // UDL
    int ok = 0;
    if (np == 1 && (unq(fn_pt[f * 8]) == mkt(Y_ULLONG, 0 - 1, 0) || unq(fn_pt[f * 8]) == mkt(Y_LDOUBLE, 0 - 1, 0) || unq(fn_pt[f * 8]) == mkt(Y_CHAR, 0 - 1, 0))) ok = 1;
    if (np == 2 && is_ptr(fn_pt[f * 8]) && unq(fn_pt[f * 8 + 1]) == mkt(Y_ULONG, 0 - 1, 0)) ok = 1;
    if (ok == 0) die("E_UDL", "gecersiz literal operator parametre listesi");
  }
  if (cls >= 0) {   // yeniden bildirim
    int m = 0; while (m < nfn) { if (fn_cls[m] == cls && fn_name[m] == fn_name[f] && same_params(m, f) && fn_has(m, F_CONST) == fn_has(f, F_CONST) && (fn_name[f] != N_CONV || fn_ret[m] == fn_ret[f])) die("E_REDECL", "uye islev yeniden tanimlandi"); m = m + 1; }
  } else {
    int m = 0;
    while (m < nfn) {
      if (fn_cls[m] < 0 && fn_name[m] == fn_name[f] && same_params(m, f)) {
        int hb = nk_n[fn_node[m]] > 2; int nb = nk_n[node] > 2;
        if (hb && nb) die("E_REDEF", "islev iki kez tanimlandi");
        if (nb) fn_node[m] = node;
        return m;
      }
      m = m + 1;
    }
  }
  if (seqc(fn_name[f], "__puti")) fn_bi[f] = 1; if (seqc(fn_name[f], "__putc")) fn_bi[f] = 2; if (seqc(fn_name[f], "__putf")) fn_bi[f] = 3; if (seqc(fn_name[f], "__getc")) fn_bi[f] = 4; if (seqc(fn_name[f], "pl") && nk_n[node] < 3) fn_bi[f] = 5;
  if (cls >= 0) {
    int c = cl_base[cls]; int found = 0;
    while (c >= 0 && found == 0) {
      int m = 0;
      while (m < nfn && found == 0) {
        if (fn_cls[m] == c && fn_has(m, F_VIRT) && fn_name[m] == fn_name[f] && same_params(m, f) && fn_has(m, F_CONST) == fn_has(f, F_CONST)) {
          if (fn_ret[m] != fn_ret[f] && tk[fn_ret[f]] != Y_AUTO) die("E_OVERRIDE", "gecersiz kilan islev farkli donus turu");
          fn_fl[f] = fn_fl[f] | F_VIRT; fn_vroot[f] = fn_vroot[m]; found = 1;
        }
        m = m + 1;
      }
      c = cl_base[c];
    }
    if (fn_has(f, F_OVR) && !(fn_has(f, F_VIRT) && fn_vroot[f] >= 0)) die("E_OVERRIDE", "'override' ama tabanda eslesen sanal islev yok");
    if (fn_has(f, F_VIRT)) { cl_poly[cls] = 1; if (fn_vroot[f] < 0) fn_vroot[f] = f; }
    if (fn_has(f, F_PURE) && fn_has(f, F_VIRT) == 0) die("E_OVERRIDE", "saf belirtici yalniz sanal islevde");
    if (fn_has(f, F_DEFAULT) && fn_name[f] != N_SS && fn_name[f] != N_EQ) die("E_DEFAULT", "yalniz karsilastirma operatorleri = default olabilir");
  } else if (fn_has(f, F_VIRT)) die("E_OVERRIDE", "'virtual' yalniz uye islevde");
  nfn = nfn + 1; return f;
}
void finish_defaulted(int ci) {   // layout sonrasi: <=> donus turunu cikar, ortuk == ekle
  int f = 0; int hasEq = 0; int defCmp = 0 - 1; int n0 = nfn;
  while (f < n0) { if (fn_cls[f] == ci && fn_name[f] == N_EQ) hasEq = 1; if (fn_cls[f] == ci && fn_name[f] == N_SS && fn_has(f, F_DEFAULT)) defCmp = f; f = f + 1; }
  f = 0;
  while (f < n0) {
    if (fn_cls[f] == ci && fn_has(f, F_DEFAULT)) {
      int p = fn_pt[f * 8]; if (fn_np[f] != 1 || is_ref(p) == 0 || tcv[te[p]] == 0 || unq(te[p]) != clsty(ci) || fn_has(f, F_CONST) == 0) die("E_DEFAULT", "varsayilan karsilastirma 'const S&' parametreli const uye islev olmali");
      if (fn_name[f] == N_EQ) fn_ret[f] = bool_t();
      else {
        int kind = default_cmp_kind(ci); int ocls = find_class(intern_c(kind == 1 ? "std::strong_ordering" : kind == 2 ? "std::weak_ordering" : "std::partial_ordering"));
        if (tk[fn_ret[f]] == Y_AUTO) fn_ret[f] = clsty(ocls);
        else { if (is_ord(fn_ret[f]) == 0 || cl_bi[tcl[unq(fn_ret[f])]] < kind) die("E_DEFAULT", "bildirilen donus turu uyelerin ortak karsilastirma kategorisini karsilamiyor"); }
      }
    }
    f = f + 1;
  }
  if (defCmp >= 0 && hasEq == 0) {   // ortuk varsayilan ==
    int e = nfn; fn_name[e] = N_EQ; fn_cls[e] = ci; fn_node[e] = fn_node[defCmp]; fn_fl[e] = F_CONST | F_DEFAULT; fn_bi[e] = 0; fn_vroot[e] = 0 - 1; fn_used[e] = 0; fn_line[e] = fn_line[defCmp];
    fn_np[e] = 1; fn_pt[e * 8] = fn_pt[defCmp * 8]; fn_ret[e] = bool_t(); nfn = nfn + 1;
  }
}
void declare_class(int node) {
  curline = nk_line[node]; int nm = nk_s1[node]; int ci = find_class(nm);
  if (nk_j[node] == 1) { if (ci < 0) newclass(nm); return; }
  if (ci >= 0) { if (cl_def[ci]) die("E_REDEF", "sinif iki kez tanimlandi"); } else ci = newclass(nm);
  if (nk_s2[node] >= 0) { int b = find_class(nk_s2[node]); if (b < 0 || cl_def[b] == 0) die("E_SINIF", "taban sinif tanimli degil"); cl_base[ci] = b; }
  cl_f0[ci] = nfl; cl_nf[ci] = 0;
  int i = 0; while (i < nk_n[node]) {
    int m = kid(node, i); i = i + 1;
    if (nk_k[m] == N_VAR) {
      int ft = typeof_(kid(m, 0)); if (nk_n[m] > 1) die("E_SINIF", "sinif ici uye ilklendiricisi desteklenmiyor");
      if (tk[ft] == Y_AUTO) die("E_TYPE", "uye auto olamaz"); if (is_arr(ft) && tn[ft] < 0) die("E_TYPE", "boyutsuz dizi uye");
      int j = cl_f0[ci]; while (j < nfl) { if (fl_name[j] == nk_s1[m]) die("E_REDECL", "uye yeniden tanimlandi"); j = j + 1; }
      fl_name[nfl] = nk_s1[m]; fl_ty[nfl] = ft; fl_woff[nfl] = 0; fl_boff[nfl] = 0; nfl = nfl + 1; cl_nf[ci] = cl_nf[ci] + 1;
    }
  }
  i = 0; while (i < nk_n[node]) { int m = kid(node, i); i = i + 1; if (nk_k[m] == N_FUNC) declare_func(m, ci); }
  layout_class(ci); finish_defaulted(ci);
}
void declare_global(int vn) {
  curline = nk_line[vn]; int T = typeof_(kid(vn, 0)); int init = 0 - 1; if (nk_n[vn] > 1) init = kid(vn, 1);
  if (tk[T] == Y_AUTO) die("E_TYPE", "global auto desteklenmiyor"); if (is_ref(T)) die("E_TYPE", "global referans desteklenmiyor");
  if (is_arr(T) && tn[T] < 0) {
    if (init >= 0 && nk_k[init] == N_INITLIST) T = arrof(te[T], nk_n[init]); else if (init >= 0 && nk_k[init] == N_STR) T = arrof(te[T], slen(nk_s1[init]) + 1); else die("E_TYPE", "boyutsuz global dizi");
  }
  if (complete_obj(T) == 0) die("E_TYPE", "tamamlanmamis tur");
  if (findgl(nk_s1[vn]) >= 0) die("E_REDECL", "global yeniden tanimlandi");
  gname[ngl] = nk_s1[vn]; gty[ngl] = T; gnode[ngl] = vn; gci[ngl] = 0; uidn = uidn + 1; guid[ngl] = uidn;
  if (tcv[T] && is_int(T) && init >= 0 && nk_k[init] != N_INITLIST) { dry = dry + 1; V pc = gen(init); dry = dry - 1; if (pc.ci) { gci[ngl] = 1; gcv[ngl] = fold(pc.cv, unq(T)); } }
  ngl = ngl + 1;
}
int init_pass(int real, int frame) {
  int saved_lab = nlab; long long saved_dat = ndat; int saved_s = nstrn;
  nvars = 0; nreg = 0; npair = 0; foff = 0; nloop = 0; cur_cls = 0 - 1; cur_fn = 0 - 1;
  if (real) w("func __init() {\n  mov _spa, __sp\n  ld fp, _spa, 0\n  add _nsp, fp, "), wn(frame), w("\n  mov _lma, __lim\n  ld _lim, _lma, 0\n  leu _okc, _nsp, _lim\n  jnz _okc, _stk_ok\n  ld _trp, -1, 0\n_stk_ok: st _nsp, _spa, 0\n");
  int i = 0;
  while (i < ngl) {
    int f = gnode[i]; int init = 0 - 1; if (nk_n[f] > 1) init = kid(f, 1); curline = nk_line[f];
    if (init >= 0 || is_cls(unq(gty[i])) || is_arr(gty[i])) { int base = nreg; long long a = newreg(); w("  mov "); wr(a); w(", g"); wn(i); wc(10); init_obj(mkv(0, 1, a), gty[i], init, nk_i[f]); nreg = base; }
    i = i + 1;
  }
  if (real) { emit_ret(imm(0, 0)); w("}\n"); }
  int used = foff; if (used < 1) used = 1;
  if (real == 0) { nlab = saved_lab; ndat = saved_dat; nstrn = saved_s; }
  return used;
}
// ============================ ANA PROGRAM ============================
void gen_dispatchers() {
  int f = 0;
  while (f < nfn) {
    if (fn_has(f, F_VIRT) && fn_vroot[f] == f) {
      int rt = fn_ret[f]; int sret = is_mem(unq(rt)) && is_ref(rt) == 0; int np = fn_np[f] + 1 + sret; int i = 0;
      w("func vd"); wn(f); w("("); while (i < np) { if (i) w(", "); w("p"); wn(i); i = i + 1; } w(") {\n  ld _id, p"); wn(sret); w(", 0\n");
      int c = 0; int lab = 0;
      while (c < ncl) {
