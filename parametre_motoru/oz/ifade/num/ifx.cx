      methods_named(ci, intern_n(&chars[s_off[nm] + cut + 1], p - cut - 1));
      if (nmeth_cand >= 1) { int f = meth_cand[0]; if (nmeth_cand > 1) die("E_NOVIABLE", "asiri yuklenmis uye islevin adresi: tek aday gerekli"); V mfp = fnaddr(f); mfp.ovn = 0 - 2; return mfp; }
    }
    die("E_UNDECL", "bilinmeyen niteleyici ad");
  }
  int vi = findvar(nm);
  if (vi >= 0) return var_ref(vi);
  if (cur_cls >= 0) {
    int oc = find_field(cur_cls, nm);
    if (oc >= 0) {
      V th = this_value(); long long woff = fq_woff; int fty = fq_ty; int fidx = fq_idx;
      V r = mkv(fty, 1, 0); r.vp = 1;
      if (woff != 0) { r.reg = e_addi(th, woff); } else r.reg = th.reg;
      if (fl_ref[fidx]) { long long pr = newreg(); e_ld(pr, 1, r, 0); V rr = mkv(te[fty], 1, pr); rr.vp = 1; return rr; }   // basvuru yakalama: alan degiskenin adresini tasir
      int thv = findvar(N_THISV); if (tcv[te[vty[thv]]]) r.ty = withc(fty, 1);
      return r;
    }
    if (cl_enc[cur_cls] >= 0) {   // [this] yakalayan lambda: kapsayan sinifin uyeleri
      int tf = find_field(cur_cls, N_LTHIS);
      if (tf >= 0) {
        V th0 = this_value(); long long tw = fq_woff; int tty = fq_ty; long long ta = th0.reg; if (tw != 0) ta = e_addi(th0, tw);
        long long tp = newreg(); e_ld(tp, 1, mkv(0, 0, ta), 0);
        int oc2 = find_field(cl_enc[cur_cls], nm);
        if (oc2 >= 0) { long long w2 = fq_woff; int f2 = fq_ty; V r2 = mkv(f2, 1, tp); r2.vp = 1; if (w2 != 0) r2.reg = e_addi(mkv(0, 0, tp), w2); if (tcv[te[tty]]) r2.ty = withc(f2, 1); return r2; }
      }
    }
  }
  int gi = findgl(nm);
  if (gi >= 0) { gused[gi] = 1; long long gr = newreg(); setk(gr, 1); w("  mov "); wr(gr); w(", g"); wn(gi); wc(10); V g = mkv(gty[gi], 1, gr); g.key = guid[gi] * 1000 + 1; if (gci[gi]) { g.ci = 1; g.cv = gcv[gi]; } return g; }
  { int nf_ = 0; int f1_ = 0 - 1; int f = 0; while (f < nfn) { if (fn_cls[f] < 0 && fn_name[f] == nm && fn_bi[f] == 0) { nf_ = nf_ + 1; if (f1_ < 0) f1_ = f; } f = f + 1; }
    if (nf_ > 0) { V fp = fnaddr(f1_); if (nf_ > 1) fp.ovn = nm; else fp.ovn = nm; return fp; } }
  { int mi = 0; const char* pre = "tanimsiz ad: "; while (pre[mi]) { tmpb[mi] = pre[mi]; mi = mi + 1; } int ni = 0; while (ni < s_len[nm] && mi < 200) { tmpb[mi] = chars[s_off[nm] + ni]; mi = mi + 1; ni = ni + 1; } tmpb[mi] = 0; die("E_UNDECL", tmpb); } return novalue();
}
V gen_member(int n) {
  int arrow = nk_k[n] == N_ARROW; curline = nk_line[n]; V o = gen(kid(n, 0));
  if (arrow) {
    if (is_cls(unq(o.ty))) { V ops[1]; ops[0] = o; V u = user_op(N_ARW, ops, 1, 0); if (u.ty >= 0) o = u; }
    o = rval(o); if (is_ptr(o.ty) == 0 || is_cls(unq(te[o.ty])) == 0) die("E_TYPE", "'->' sinif isaretcisi gerektirir");
    nullchk(o); V l = mkv(te[o.ty], 1, o.reg); l.vp = 1; if (o.reg < 0) { l = mat(o); l.ty = te[o.ty]; l.cat = 1; l.vp = 1; } l.ne = o.ne; int k = 0; while (k < o.ne) { l.ek[k] = o.ek[k]; l.er[k] = o.er[k]; k = k + 1; } o = l;
  }
  int clsT = unq(o.ty); if (is_cls(clsT) == 0) die("E_TYPE", "'.' sinif nesnesi gerektirir");
  int oc = find_field(tcl[clsT], nk_s1[n]); if (oc < 0) die("E_UNDECL", "sinifta boyle bir uye yok");
  long long woff = fq_woff; int fty = fq_ty;
  V r = mkv(fty, 1, 0); if (tcv[o.ty]) r.ty = withc(fty, 1); r.cat = 1; if (o.cat != 1) r.cat = 2; r.vp = o.vp; r.ne = o.ne; int k = 0; while (k < o.ne) { r.ek[k] = o.ek[k]; r.er[k] = o.er[k]; k = k + 1; }
  if (woff != 0) { r.reg = e_addi(o, woff); } else r.reg = o.reg;
  if (o.key != 0) r.key = o.key + nk_s1[n] * 7 + 3;
  return r;
}
V gen_index(int n) {
  curline = nk_line[n]; V b = gen(kid(n, 0)); V i = gen(kid(n, 1));
  if (is_cls(unq(b.ty))) { V ops[2]; ops[0] = b; ops[1] = i; V u = user_op(N_IDX, ops, 2, 0); if (u.ty >= 0) return u; b = unwrap_conv(b); }
  if (is_cls(unq(i.ty))) i = unwrap_conv(i);
  int barr = is_arr(b.ty);
  V bp = rval(b); i = rval(i);
  if (is_ptr(bp.ty) == 0 && is_ptr(i.ty)) { V x = bp; bp = i; i = x; barr = 0; }
  if (is_ptr(bp.ty) == 0) die("E_TYPE", "dizi/isaretci olmayan ifade indekslenemez");
  if (is_int(i.ty) == 0) die("E_TYPE", "dizi indeksi tamsayi olmali");
  int et = te[bp.ty]; if (complete_obj(et) == 0) die("E_PTRARITH", "tamamlanmamis turde eleman indekslenemez");
  if (barr == 0) nullchk(bp);
  if (bp.bp) return byte_lv(bp, i, et);
  i = convert_arith(i, mkt(Y_LONG, 0 - 1, 0));
  if (barr) {
    long long cnt = tn[b.ty];
    if (i.ci && (i.cv < 0 || i.cv >= cnt)) die("E_BOUNDS", "sabit dizi indeksi sinir disi");
    if (i.ci == 0) { long long c = newreg(); int ok = newlab(); ins3("ltu", c, i, imm(0, cnt)); e_jcc("jnz", mkv(0, 0, c), ok); trapnow(); wl(ok); w(":\n"); }
  }
  long long wd = words_of(et); V off = i;
  if (wd != 1) { long long t1 = newreg(); ins3("mul", t1, mat(i), imm(i.ty, wd)); off = mkv(i.ty, 0, t1); }
  long long d = newreg(); ins3("add", d, mat(bp), off);
  V r = mkv(et, 1, d); r.vp = 1; if (barr && tcv[b.ty]) r.ty = withc(et, 1); merge_eff(r, b); merge_eff(r, i); return r;
}
// ============================ IFADELER ============================
V unwrap_conv(V v) {   // sinif -> skaler (yerlesik operator icin): tek acik olmayan donusum
  conv_funcs_of(tcl[unq(v.ty)]); int cs[32]; int nc = 0; int i = 0;
  while (i < nconv) { int m = conv_cands[i]; if (fn_has(m, F_EXPL) == 0 && is_sc(unq(deref(fn_ret[m])))) { cs[nc] = m; nc = nc + 1; } i = i + 1; }
  if (nc == 0) die("E_NOVIABLE", "operator icin uygun operand yok (kullanici donusumu yok)");
  if (nc > 1) die("E_AMBIG", "belirsiz kullanici donusumu");
  V r = callfn(cs[0], &v, 0, 0, 0); return rval(r);
}
void need_modifiable(V& v) {
  if (v.cat != 1) die("E_LVALUE", "sol operand degistirilebilir lvalue olmali");
  if (tcv[v.ty]) die("E_CONST", "const nesneye atama");
  if (is_arr(v.ty)) die("E_LVALUE", "diziye atanamaz");
}
V store(V lv, V val) {
  if (is_ld(lv.ty)) { ld_copy(lv, val); V r0 = lv; merge_eff(r0, val); add_eff(r0, lv.key, 2); return r0; }
  e_st(mat(val), lv, 0);
  V r = lv; merge_eff(r, val); add_eff(r, lv.key, 2); r.ci = 0; return r;
}
V gen_logical(int n, int isand) {
  V a = cond_bool(gen(kid(n, 0)));
  if (a.ci) {   // sabit sol operand: sag operand degerlendirilmez (yalniz tur denetimi icin dry)
    if (isand && a.cv == 0) { int sv = may_throw; dry = dry + 1; gen(kid(n, 1)); dry = dry - 1; may_throw = sv; V z = imm(bool_t(), 0); return z; }
    if (isand == 0 && a.cv != 0) { int sv = may_throw; dry = dry + 1; gen(kid(n, 1)); dry = dry - 1; may_throw = sv; V o1 = imm(bool_t(), 1); return o1; }
    V bb = cond_bool(gen(kid(n, 1))); return bb;
  }
  long long res = newreg(); int end = newlab();
  e_mov(res, 3, a); e_jcc(isand ? "jz" : "jnz", mkv(0, 0, res), end);
  V b = cond_bool(gen(kid(n, 1)));
  e_mov(res, 3, b); wl(end); w(":\n");
  V o = mkv(bool_t(), 0, res); merge_eff(o, a); merge_eff(o, b); return o;
}
int op_name(const char* t) { return intern_c(t); }
V gen_binary(int n) {
  curline = nk_line[n]; int s = nk_s1[n];
  if (seqc(s, "&&")) return gen_logical(n, 1);
  if (seqc(s, "||")) return gen_logical(n, 0);
  V L = gen(kid(n, 0)); V R = gen(kid(n, 1)); settok(s);
  char tok[64]; int ti = 0; while (tokbuf[ti]) { tok[ti] = tokbuf[ti]; ti = ti + 1; } tok[ti] = 0;
  if (streq(tok, "<<") == 0 && streq(tok, ">>") == 0) { if (unseq_bad(L, R)) die("E_UNSEQ", "ayni nesne siralanmamis iki degerlendirmede degistiriliyor/okunuyor (tanimsiz davranis)"); }
  int lc = is_cls(unq(L.ty)); int rc = is_cls(unq(R.ty));
  if (lc || rc) {
    int zl = R.nl && R.ci; int zr = L.nl && L.ci;
    if (lc && is_ord(L.ty) && zl) return ord_cmp_zero(tok, L);
    if (rc && is_ord(R.ty) && zr) { const char* sw = tok; if (streq(tok, "<")) sw = ">"; else if (streq(tok, ">")) sw = "<"; else if (streq(tok, "<=")) sw = ">="; else if (streq(tok, ">=")) sw = "<="; return ord_cmp_zero(sw, R); }
    if (lc && rc && unq(L.ty) == unq(R.ty) && (is_ord(L.ty) || cl_bi[tcl[unq(L.ty)]] == 4) && (streq(tok, "==") || streq(tok, "!="))) {
      long long p1 = newreg(); long long p2 = newreg(); long long d = newreg(); e_ld(p1, 0, L, 0); e_ld(p2, 0, R, 0);
      ins3(streq(tok, "==") ? "eq" : "ne", d, mkv(0, 0, p1), mkv(0, 0, p2)); V o = mkv(bool_t(), 0, d); merge_eff(o, L); merge_eff(o, R); return o;
    }
    V ops[2]; ops[0] = L; ops[1] = R; int nm = op_name(tok);
    int rev = streq(tok, "==") || streq(tok, "!=");
    V r = noV();
    { char nb[80]; int k = 0; const char* pre = "operator"; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (tok[j]) { nb[k] = tok[j]; k = k + 1; j = j + 1; } nb[k] = 0; nm = intern_c(nb); }
    r = user_op(nm, ops, 2, rev);
    if (r.ty >= 0) return r;
    if (streq(tok, "!=")) { V e = user_op(intern_c("operator=="), ops, 2, 1); if (e.ty >= 0) { V b = cond_bool(e); long long d = newreg(); ins3("eq", d, mat(b), imm(bool_t(), 0)); V o = mkv(bool_t(), 0, d); merge_eff(o, b); return o; } }
    if (streq(tok, "<") || streq(tok, ">") || streq(tok, "<=") || streq(tok, ">=")) {
      V sp = user_op(intern_c("operator<=>"), ops, 2, 0);
      if (sp.ty >= 0) { if (is_ord(sp.ty) == 0) die("E_TYPE", "<=> sonucu siralama turu degil"); return ord_cmp_zero(tok, sp); }
      V rv[2]; rv[0] = R; rv[1] = L; V s2 = user_op(intern_c("operator<=>"), rv, 2, 0);
      if (s2.ty >= 0) { const char* sw = "<="; if (streq(tok, "<")) sw = ">"; else if (streq(tok, ">")) sw = "<"; else if (streq(tok, "<=")) sw = ">="; return ord_cmp_zero(sw, s2); }
    }
    if (lc) L = unwrap_conv(L); if (rc) R = unwrap_conv(R);
    return binop(tok, rval(L), rval(R));
  }
  return binop(tok, L, R);
}
V gen_assign(int n) {
  curline = nk_line[n]; int s = nk_s1[n];
  if (nk_k[kid(n, 1)] == N_INITLIST) {
    V Lh = gen(kid(n, 0)); need_modifiable(Lh);
    if (is_cls(unq(Lh.ty))) { V t = tempobj(unq(Lh.ty)); init_obj(t, unq(Lh.ty), kid(n, 1), 3); int c = tcl[unq(Lh.ty)]; long long fr = 0; if (cl_poly[c]) fr = 1; copy_n(Lh, t, fr, cl_words[c]); return Lh; }
    if (is_sc(Lh.ty)) { init_obj(Lh, unq(Lh.ty), kid(n, 1), 3); return Lh; }
    die("E_TYPE", "bu hedefe {..} atanamaz");
  }
  V R = gen(kid(n, 1)); V Lv = gen(kid(n, 0));
  if (seqc(s, "=")) {
    if (is_cls(unq(Lv.ty))) {
      if (Lv.cat != 1) die("E_LVALUE", "atama: sol operand lvalue olmali");
      V ops[2]; ops[0] = Lv; ops[1] = R; V u = user_op(N_ASG, ops, 2, 0); if (u.ty >= 0) return Lv;
      if (tcv[Lv.ty]) die("E_CONST", "const nesneye atama");
      int dc = tcl[unq(Lv.ty)]; V rc = R;
      if (is_cls(unq(R.ty)) == 0 || !(tcl[unq(R.ty)] == dc || derived_from(tcl[unq(R.ty)], dc))) rc = to_class_value(R, unq(Lv.ty));
      if (cl_bi[dc] != 0 && cl_bi[dc] < 7) copy_n(Lv, rc, 0, 1); else { copy_obj(Lv, rc, dc, 0); }
      V r = Lv; merge_eff(r, R); return r;
    }
    need_modifiable(Lv);
    if (Lv.bks) {   // bayt gorunumu yazma: sozcuk oku-degistir-yaz
      V val = to_scalar(R, unq(Lv.ty), 0); long long w = newreg(); e_ld(w, 0, Lv, 0);
      long long msk = newreg(); ins3("shl", msk, imm(0, 255), mkv(0, 0, Lv.bkr)); long long inv = newreg(); ins3("xor", inv, mkv(0, 0, msk), imm(0, 0 - 1));
      long long kept = newreg(); ins3("and", kept, mkv(0, 0, w), mkv(0, 0, inv)); long long b8 = newreg(); ins3("and", b8, mat(val), imm(0, 255));
      long long sb = newreg(); ins3("shl", sb, mkv(0, 0, b8), mkv(0, 0, Lv.bkr)); long long nw = newreg(); ins3("or", nw, mkv(0, 0, kept), mkv(0, 0, sb));
      e_st(mkv(0, 0, nw), Lv, 0); V rr = Lv; return rr;
    }
    if (R.bp) { if (Lv.key % 1000 == 1 && Lv.key / 1000 > 0 && Lv.key / 1000 < 60000 && is_ptr(Lv.ty)) ubp[Lv.key / 1000] = R.bp; else die("E_REINTERP", "bayt gorunumu yok: uyumsuz gosterimli isaretci yalniz yerel degiskene atanabilir"); }
    V val = to_scalar(R, unq(Lv.ty), 0); return store(Lv, val);
  }
  settok(s); int l = 0; while (tokbuf[l]) l = l + 1; tokbuf[l - 1] = 0;
  if (is_cls(unq(Lv.ty))) {
    V ops[2]; ops[0] = Lv; ops[1] = R; char nb[80]; int k = 0; const char* pre = "operator"; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (s_off[s] + j < s_off[s] + s_len[s]) { nb[k] = chars[s_off[s] + j]; k = k + 1; j = j + 1; } nb[k] = 0;
    V u = user_op(intern_c(nb), ops, 2, 0); if (u.ty >= 0) return u; die("E_NOVIABLE", "operator bu sinif icin tanimli degil");
  }
  need_modifiable(Lv); no_bytelv(Lv);
  if (is_cls(unq(R.ty))) R = unwrap_conv(R); else R = rval(R);
  V cur; if (is_ld(Lv.ty)) { cur = rval(Lv); } else { cur = mkv(unq(Lv.ty), 0, newreg()); e_ld(cur.reg, kind_for(Lv.ty), Lv, 0); merge_eff(cur, Lv); add_eff(cur, Lv.key, 1); }
  if (is_ptr(Lv.ty) && !(streq(tokbuf, "+") || streq(tokbuf, "-"))) die("E_TYPE", "isaretciye bu islec uygulanamaz");
  char tok[64]; int ti = 0; while (tokbuf[ti]) { tok[ti] = tokbuf[ti]; ti = ti + 1; } tok[ti] = 0;
  V res = binop(tok, cur, R);
  if (tk[Lv.ty] == Y_BOOL || is_ptr(Lv.ty)) res = to_scalar(res, unq(Lv.ty), 0); else res = convert_arith(res, unq(Lv.ty));
  return store(Lv, res);
}
V gen_incdec(int n) {
  curline = nk_line[n]; int post = nk_k[n] == N_POSTINC; int inc = seqc(nk_s1[n], "++");
  V lv = gen(kid(n, 0));
  if (is_cls(unq(lv.ty))) { V ops[2]; ops[0] = lv; int no = 1; if (post) { ops[1] = imm(mkt(Y_INT, 0 - 1, 0), 0); no = 2; } V u = user_op(inc ? N_INC : N_DEC, ops, no, 0); if (u.ty >= 0) return u; die("E_NOVIABLE", "++/-- bu sinif icin tanimli degil"); }
  need_modifiable(lv); no_bytelv(lv); int t = unq(lv.ty);
  if (tk[t] == Y_BOOL) die("E_TYPE", "bool uzerinde ++/-- gecersiz");
  if (is_arith(t) == 0 && is_ptr(t) == 0) die("E_TYPE", "++/-- yalniz aritmetik/isaretci");
  V old; if (is_ld(t)) old = rval(lv); else { old = mkv(t, 0, newreg()); e_ld(old.reg, kind_for(t), lv, 0); } V nv;
  if (is_ptr(t)) nv = ptradd(old, imm(mkt(Y_INT, 0 - 1, 0), 1), inc == 0);
  else if (is_flt(t)) { V one = fconst(t, 4607182418800017408LL); nv = binop(inc ? "+" : "-", old, one); nv = convert_arith(nv, t); }
  else { V one = imm(mkt(Y_INT, 0 - 1, 0), 1); nv = binop(inc ? "+" : "-", old, one); nv = convert_arith(nv, t); }
  if (is_ld(t)) ld_copy(lv, nv); else { e_st(mat(nv), lv, 0); }
  V res;
  if (post) { res = old; res.cat = 0; res.ne = 0; merge_eff(res, lv); add_eff(res, lv.key, 2); res.key = 0; }
  else { res = lv; add_eff(res, lv.key, 2); }
  return res;
}
V gen_unary(int n) {
  curline = nk_line[n]; int s = nk_s1[n]; V v = gen(kid(n, 0));
  if (seqc(s, "+") && is_cls(unq(v.ty)) && cl_lam[tcl[unq(v.ty)]] != 0 && cl_lamfree[tcl[unq(v.ty)]] >= 0) { int ft = fn_type_of(cl_lamfree[tcl[unq(v.ty)]]); return lam_to_fnptr(v, ptrto(ft)); }
  if (seqc(s, "&")) {
    if (is_cls(unq(v.ty))) { V ops[1]; ops[0] = v; V u = user_op(N_ADDR, ops, 1, 0); if (u.ty >= 0) return u; }
    if ((v.ovn >= 0 || v.ovn == 0 - 2) && v.cat == 0 && is_ptr(v.ty) && is_fn(unq(te[v.ty]))) return v;   // &islev, &S::uye
    if (v.cat != 1) die("E_ADDR", "adresi alinamaz: lvalue gerekli");
    no_bytelv(v);
    V r = mkv(ptrto(v.ty), 0, v.reg); merge_eff(r, v); return r;
  }
  if (seqc(s, "*")) {
    if (is_cls(unq(v.ty))) { V ops[1]; ops[0] = v; V u = user_op(N_DEREF, ops, 1, 0); if (u.ty >= 0) return u; v = unwrap_conv(v); }
    v = rval(v); if (is_ptr(v.ty) == 0) die("E_TYPE", "'*' isaretci gerektirir");
    if (is_fn(unq(te[v.ty]))) return v;   // *islev_isaretcisi = islev gostericisi (yeniden isaretciye indirgenir)
    if (is_void(te[v.ty])) die("E_TYPE", "void isaretcisi dolayli erisilemez");
    if (n == tid_node && exc_on) nullchk_exc(v, "std::bad_typeid"); else nullchk(v);
    if (v.bp) return byte_lv(v, imm(mkt(Y_INT, 0 - 1, 0), 0), te[v.ty]);
    V m = mat(v); V r = mkv(te[v.ty], 1, m.reg); r.vp = 1; merge_eff(r, v); return r;
  }
  if (is_cls(unq(v.ty))) {
    V ops[1]; ops[0] = v; char nb[80]; int k = 0; const char* pre = "operator"; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (j < s_len[s]) { nb[k] = chars[s_off[s] + j]; k = k + 1; j = j + 1; } nb[k] = 0;
    V u = user_op(intern_c(nb), ops, 1, 0); if (u.ty >= 0) return u;
    if (seqc(s, "!")) { V b = cond_bool(v); long long d = newreg(); ins3("eq", d, mat(b), imm(bool_t(), 0)); V o = mkv(bool_t(), 0, d); merge_eff(o, b); return o; }
    v = unwrap_conv(v);
  }
  v = rval(v);
  if (seqc(s, "!")) { V b = cond_bool(v); if (b.ci) { V o = imm(bool_t(), b.cv == 0); o.ne = b.ne; return o; } long long d = newreg(); ins3("eq", d, mat(b), imm(bool_t(), 0)); V o = mkv(bool_t(), 0, d); merge_eff(o, v); return o; }
  if (is_arith(v.ty) == 0) die("E_TYPE", "tekli islec aritmetik operand gerektirir");
  if (seqc(s, "+")) { if (is_int(v.ty)) return convert_arith(v, promote(v.ty)); return v; }
  if (seqc(s, "-")) {
    if (is_ld(v.ty)) { int nf = wfmt(v.ty); long long p = ld_load(v); long long d = newreg2f(nf); ins2t(nmw(NM_NEG80, nf), d, mkv(0, 0, p)); V o = ld_new(d); merge_eff(o, v); return o; }
    if (is_flt(v.ty)) { long long d = newreg(); ins2t(names[NM_FNEG], d, v); return mkv(v.ty, 0, d); }
    int t = promote(v.ty); v = convert_arith(v, t);
    if (v.ci) { V o = imm(t, fold(0 - v.cv, t)); o.ne = v.ne; return o; }
    long long d = newreg(); ins2t(names[NM_NEG], d, mat(v)); V o = norm(mkv(t, 0, d), t); merge_eff(o, v); return o;
  }
  if (seqc(s, "~")) {
    if (is_int(v.ty) == 0) die("E_TYPE", "'~' tamsayi gerektirir");
    int t = promote(v.ty); v = convert_arith(v, t);
    if (v.ci) { V o = imm(t, fold(~v.cv, t)); o.ne = v.ne; return o; }
    long long d = newreg(); ins2t(names[NM_NOT], d, mat(v)); V o = norm(mkv(t, 0, d), t); merge_eff(o, v); return o;
  }
  die("E_OP", "bilinmeyen tekli islec"); return v;
}
V gen_cond(int n) {
  curline = nk_line[n]; V c = cond_bool(gen(kid(n, 0)));
  int save_throw = may_throw;
  dry = dry + 1; V a0 = gen(kid(n, 1)); V b0 = gen(kid(n, 2)); dry = dry - 1; may_throw = save_throw;
  int at = unq(a0.ty); int bt = unq(b0.ty); long long res = newreg(); int els = newlab(); int end = newlab();
  int va = is_void(at); int vb = is_void(bt);
  if (va || vb) { if (!(va && vb)) die("E_TYPE", "?: kollarindan biri void, digeri degil"); e_jcc("jz", c, els); gen(kid(n, 1)); w("  jmp "); wl(end); wc(10); wl(els); w(":\n"); gen(kid(n, 2)); wl(end); w(":\n"); return novalue(); }
  if (is_cls(at) && at == bt) {
    int lv = a0.cat == 1 && b0.cat == 1 && tcv[a0.ty] == tcv[b0.ty];
    e_jcc("jz", c, els); V a1 = gen(kid(n, 1));
    if (lv == 0) a1 = to_class_value(a1, at);
    e_mov(res, 1, a1); w("  jmp "); wl(end); wc(10); wl(els); w(":\n");
    V b1 = gen(kid(n, 2)); if (lv == 0) b1 = to_class_value(b1, at);
    e_mov(res, 1, b1); wl(end); w(":\n");
    V r = mkv(a0.ty, 0, res); if (lv) r.cat = 1; else if (a0.cat == 2 && b0.cat == 2) r.cat = 2; r.vp = 1; merge_eff(r, c); return r;
  }
  if (is_cls(at) || is_cls(bt)) die("E_TYPE", "?: kollari uyumsuz sinif turleri");
  if (a0.cat == 1 && b0.cat == 1 && at == bt && is_arr(at) == 0 && tcv[a0.ty] == tcv[b0.ty]) {
    e_jcc("jz", c, els); V a1 = gen(kid(n, 1)); e_mov(res, 1, a1); w("  jmp "); wl(end); wc(10); wl(els); w(":\n");
    V b1 = gen(kid(n, 2)); e_mov(res, 1, b1); wl(end); w(":\n");
    V r = mkv(a0.ty, 1, res); r.vp = 1; merge_eff(r, c); return r;
  }
  dry = dry + 1; V ar = rval(a0); V br = rval(b0); dry = dry - 1; int rt;
  if (is_arith(ar.ty) && is_arith(br.ty)) { if (ar.ty == br.ty) rt = ar.ty; else rt = uac(ar.ty, br.ty); }
  else if (is_ptr(ar.ty) && is_ptr(br.ty)) { if (ar.ty == br.ty) rt = ar.ty; else if (std_rank(br.ty, &br, ar.ty) >= 0) rt = ar.ty; else if (std_rank(ar.ty, &ar, br.ty) >= 0) rt = br.ty; else { die("E_TYPE", "?: isaretci turleri uyumsuz"); rt = 0; } }
  else if (is_ptr(ar.ty) && (tk[br.ty] == Y_NULLPTR || (b0.nl && b0.ci))) rt = ar.ty;
  else if (is_ptr(br.ty) && (tk[ar.ty] == Y_NULLPTR || (a0.nl && a0.ci))) rt = br.ty;
  else if (tk[ar.ty] == Y_NULLPTR && tk[br.ty] == Y_NULLPTR) rt = ar.ty;
  else { die("E_TYPE", "?: kollari uyumsuz"); rt = 0; }
  int rkd = kind_for(rt); e_jcc("jz", c, els); V a1 = to_scalar(gen(kid(n, 1)), rt, 0); e_mov(res, rkd, a1); w("  jmp "); wl(end); wc(10); wl(els); w(":\n");
  V b1 = to_scalar(gen(kid(n, 2)), rt, 0); e_mov(res, rkd, b1); wl(end); w(":\n");
  V r = mkv(rt, 0, res); merge_eff(r, c); merge_eff(r, a1); merge_eff(r, b1);
  if (c.ci && a1.ci && b1.ci) { r.ci = 1; r.cv = b1.cv; if (c.cv) r.cv = a1.cv; }
  return r;
}
// ---- cagri ----
int c_cands[64]; int c_nc = 0;
// ---- Bolum 04: std::function / std::move_only_function (tur silme) ----
int mkn(int k, long long iv, int s1, int line, int cnt, int* c) {
  if (nnodes >= NN || nkids + cnt + 1 >= NK) die("E_SINIR", "cok fazla dugum");
  int id = nnodes; nnodes = nnodes + 1; nk_k[id] = k; nk_i[id] = iv; nk_j[id] = 0; nk_d[id] = 0; nk_s1[id] = s1; nk_s2[id] = 0 - 1; nk_line[id] = line; nk_n[id] = cnt; nk_ks[id] = nkids;
  int i = 0; while (i < cnt) { kids[nkids] = c[i]; nkids = nkids + 1; i = i + 1; } return id;
}
int mk0(int k, long long iv, int s1) { int c0[1]; return mkn(k, iv, s1, curline, 0, c0); }
int mk1(int k, long long iv, int s1, int a) { int c1[1]; c1[0] = a; return mkn(k, iv, s1, curline, 1, c1); }
int mk2n(int k, long long iv, int s1, int a, int b) { int c2[2]; c2[0] = a; c2[1] = b; return mkn(k, iv, s1, curline, 2, c2); }
int tyn(int t) { return mk0(N_TYID, t, 0 - 1); }
int nameU(const char* pre, int v) { int k = 0; while (pre[k]) { tmpb[k] = pre[k]; k = k + 1; } char dg[12]; int nd = 0; if (v == 0) { dg[0] = '0'; nd = 1; } while (v > 0) { dg[nd] = '0' + v % 10; v = v / 10; nd = nd + 1; } while (nd > 0) { nd = nd - 1; tmpb[k] = dg[nd]; k = k + 1; } tmpb[k] = 0; return intern_n(tmpb, k); }
int nameN(const char* pre, int v) { int k = 0; while (pre[k]) { tmpb[k] = pre[k]; k = k + 1; } tmpb[k] = '0' + (v / 10) % 10; tmpb[k + 1] = '0' + v % 10; tmpb[k + 2] = 0; return intern_n(tmpb, k + 2); }
int inv_T[256]; int inv_ft[256]; int inv_f[256]; int ninv = 0; int cpy_T[256]; int cpy_f[256]; int ncpy = 0; int fw_cnt = 0;
// cagirici: R inv(T* __o, P0 __a0, ...) { return (*__o)(__a0, ...); }
int get_invoker(int T, int ft) {
  int i = 0; while (i < ninv) { if (inv_T[i] == T && inv_ft[i] == ft) return inv_f[i]; i = i + 1; }
  if (ninv >= 256) die("E_SINIR", "cok fazla std::function hedefi");
  int sg = fn_sig(ft); int np = sig_np[sg]; int rt = te[ft]; int ps[9]; ps[0] = mk1(N_VAR, 0, intern_c("__o"), tyn(ptrto(T)));
  i = 0; while (i < np) { ps[i + 1] = mk1(N_VAR, 0, nameN("__a", i), tyn(sig_pt[sg * 8 + i])); i = i + 1; }
  int params = mkn(N_PARAMS, 0, 0 - 1, curline, np + 1, ps);
  int ca[9]; ca[0] = mk1(N_UNARY, 0, intern_c("*"), mk0(N_ID, 0, intern_c("__o")));
  i = 0; while (i < np) { int an = mk0(N_ID, 0, nameN("__a", i)); int P = sig_pt[sg * 8 + i]; if (tk[P] == Y_RREF) an = mk2n(N_CAST, 0, intern_c("static_cast"), tyn(P), an); ca[i + 1] = an; i = i + 1; }
  int call = mkn(N_CALL, 0, 0 - 1, curline, np + 1, ca); int st;
  if (is_void(rt)) st = mk1(N_EXPRSTMT, 0, 0 - 1, call); else st = mk1(N_RETURN, 0, 0 - 1, call);
  int body = mk1(N_BLOCK, 0, 0 - 1, st);
  int fp3[3]; fp3[0] = tyn(rt); fp3[1] = params; fp3[2] = body;
  int fnode = mkn(N_FUNC, 0, nameN("__inv", fw_cnt), curline, 3, fp3); fw_cnt = fw_cnt + 1;
  int f = declare_func(fnode, 0 - 1); fn_used[f] = 1;
  inv_T[ninv] = T; inv_ft[ninv] = ft; inv_f[ninv] = f; ninv = ninv + 1; return f;
}
// kopyalayici: void* cp(T* __o) { T* __n = (T*)__alloc(W); *__n = *__o; return __n; }
int get_cloner(int T) {
  int i = 0; while (i < ncpy) { if (cpy_T[i] == T) return cpy_f[i]; i = i + 1; }
  if (ncpy >= 256) die("E_SINIR", "cok fazla std::function hedefi");
  int vp = ptrto(mkt(Y_VOID, 0 - 1, 0)); int pt = ptrto(T);
  int ps1[1]; ps1[0] = mk1(N_VAR, 0, intern_c("__o"), tyn(pt)); int params = mkn(N_PARAMS, 0, 0 - 1, curline, 1, ps1);
  int wd = mk0(N_INT, words_of(T) < 1 ? 1 : words_of(T), 0 - 1); nk_j[wd] = Y_LONG;
  int ac[2]; ac[0] = mk0(N_ID, 0, intern_c("__alloc")); ac[1] = wd; int acall = mkn(N_CALL, 0, 0 - 1, curline, 2, ac);
  int cast = mk2n(N_CAST, 0, intern_c("static_cast"), tyn(pt), acall);
  int d1 = mk2n(N_VAR, 1, intern_c("__n"), tyn(pt), cast); int ds = mk1(N_DECLS, 0, 0 - 1, d1);
  int lhs = mk1(N_UNARY, 0, intern_c("*"), mk0(N_ID, 0, intern_c("__n"))); int rhs = mk1(N_UNARY, 0, intern_c("*"), mk0(N_ID, 0, intern_c("__o")));
  int asg = mk2n(N_ASSIGN, 0, intern_c("="), lhs, rhs); int st2 = mk1(N_EXPRSTMT, 0, 0 - 1, asg);
  int st3 = mk1(N_RETURN, 0, 0 - 1, mk0(N_ID, 0, intern_c("__n")));
  int bk[3]; bk[0] = ds; bk[1] = st2; bk[2] = st3; int body = mkn(N_BLOCK, 0, 0 - 1, curline, 3, bk);
  int fp3[3]; fp3[0] = tyn(vp); fp3[1] = params; fp3[2] = body;
  int fnode = mkn(N_FUNC, 0, nameN("__cpy", fw_cnt), curline, 3, fp3); fw_cnt = fw_cnt + 1;
  int f = declare_func(fnode, 0 - 1); fn_used[f] = 1;
  cpy_T[ncpy] = T; cpy_f[ncpy] = f; ncpy = ncpy + 1; return f;
}
long long fn_idx_reg(int f) { long long r = newreg(); setk(r, 1); w("  mov "); wr(r); w(", f"); wn(f); wc(10); return r; }
// hedef cagrilabilirden sarmalayici nesne uret
V fn_make(V v, int ci) {
  int ft = cl_fsig[ci]; V t = tempobj(clsty(ci)); int T;
  if (tk[unq(v.ty)] == Y_NULLPTR || (is_int(v.ty) && v.ci && v.cv == 0)) { e_sti(0, t, 0); e_sti(0, t, 1); e_sti(0, t, 2); return t; }
  V src = v; int isptr = 0;
  if (is_cls(unq(v.ty))) { T = unq(v.ty); if (cl_bi[tcl[T]] >= 8) die("E_CONV", "std::function turleri arasi donusum yok"); }
  else { src = to_scalar(v, ptrto(ft), 0); T = ptrto(ft); isptr = 1; }
  long long wd = words_of(T); if (wd < 1) wd = 1;
  int fi = get_invoker(T, ft); int fc = get_cloner(T);
  long long hp = newreg(); long long nw = e_movi(0, wd); setk(hp, 1); w("  alloc "); wr(hp); w(", "); wr(nw); wc(10);
  V hv = mkv(0, 1, hp);
  if (isptr) {
    long long pv = src.reg; if (pv < 0) pv = mat(src).reg; e_st(mkv(0, 0, pv), hv, 0);
    int skip = newlab(); int dn = newlab(); e_jcc("jnz", mkv(0, 0, pv), skip);
    e_sti(0, t, 0); e_sti(0, t, 1); e_sti(0, t, 2); w("  jmp "); wl(dn); wc(10); wl(skip); w(":\n");
    long long r1 = fn_idx_reg(fi); e_st(mkv(0, 0, r1), t, 0); e_st(mkv(0, 0, hp), t, 1); long long r2 = fn_idx_reg(fc); e_st(mkv(0, 0, r2), t, 2); wl(dn); w(":\n");
    return t;
  }
  V dst = mkv(T, 1, hp);
  if (v.cat == 1 || is_mem(T)) { V c = to_mem_value(src, T); copy_obj(dst, c, tcl[T], 0); }
  long long r1 = fn_idx_reg(fi); e_st(mkv(0, 0, r1), t, 0); e_st(mkv(0, 0, hp), t, 1); long long r2 = fn_idx_reg(fc); e_st(mkv(0, 0, r2), t, 2);
  return t;
}
V call_fnobj(int n, V fobj) {
  int ci = tcl[unq(fobj.ty)]; int ft = cl_fsig[ci]; int sg = fn_sig(ft); int np = sig_np[sg]; int na = nk_n[n] - 1; if (na != np) die("E_NOVIABLE", "std::function cagrisinda arguman sayisi uyusmuyor");
  long long inv = newreg(); e_ld(inv, 1, fobj, 0); long long ob = newreg(); e_ld(ob, 1, fobj, 1);
  int ok = newlab(); e_jcc("jnz", mkv(0, 0, ob), ok); if (exc_on) throw_named("std::bad_function_call"); else trapnow(); wl(ok); w(":\n");
  V av[8]; V a2[9]; int vp = ptrto(mkt(Y_VOID, 0 - 1, 0)); a2[0] = mkv(vp, 0, ob);
  int i = 0; while (i < na) { int an = kid(n, i + 1); if (nk_k[an] == N_NAMEARG || nk_k[an] == N_INITLIST) die("E_ARG", "std::function cagrisinda isimli/suslu arguman olamaz"); av[i] = gen(an); a2[i + 1] = av[i]; i = i + 1; }
  int pt[9]; pt[0] = vp; i = 0; while (i < np) { pt[i + 1] = sig_pt[sg * 8 + i]; i = i + 1; }
  int fti = functy(te[ft], np + 1, pt, 0, fn_ne(ft), 0 - 1);
  V fp = mkv(ptrto(fti), 0, inv);
  return callptr(fp, 0, a2, na + 1);
}
// ---- Bolum 04: dolayli cagri (calli) ----
// Her (imza, sret, this) bileşimi icin bir PROTOTIP islev (`fpN`): gerekli parametre sayisi/turleri (tipdogr denetimi) ve calli'nin imza kontrolu icin.
V callptr(V fp, V* self, V* args, int na) {
  int ft = unq(te[fp.ty]); int sg = fn_sig(ft); int np = sig_np[sg]; int va = sig_va[sg]; int selfmode = tcl[ft] >= 0;
  if (na < np || (na > np && va == 0)) die("E_NOVIABLE", "islev isaretcisi cagrisinda arguman sayisi uyusmuyor");
  int rt = te[ft]; int sret = is_mem(unq(rt)) && is_ref(rt) == 0;
  V ops[12]; int no = 0; V out = mkv(0, 0, 0);
  if (sret) { out = tempmem(unq(rt)); ops[no] = out; no = no + 1; }
  if (selfmode) { ops[no] = *self; no = no + 1; }
  int i = 0; while (i < np) { ops[no] = bind_arg(args[i], sig_pt[sg * 8 + i]); no = no + 1; i = i + 1; }
  if (va) pack_va(args, np, na, ops, &no);
  if (fn_ne(ft) == 0) may_throw = 1;
  long long d = newreg(); int isv = is_void(rt);
  { int pi_ = 0; if (sret) { ops[pi_] = cast_k(mat_k(ops[pi_], 1), 1); pi_ = pi_ + 1; } if (selfmode) { ops[pi_] = cast_k(mat_k(ops[pi_], 1), 1); pi_ = pi_ + 1; }
    int q = 0; while (q < np) { int pk = param_kind(sig_pt[sg * 8 + q]); ops[pi_] = cast_k(mat_k(ops[pi_], pk), pk); pi_ = pi_ + 1; q = q + 1; }
    if (va) { ops[pi_] = cast_k(mat_k(ops[pi_], 1), 1); pi_ = pi_ + 1; ops[pi_] = cast_k(mat_k(ops[pi_], 0), 0); pi_ = pi_ + 1; } }
  V fv = cast_k(mat_k(fp, 0), 0);
  int pr = proto_for(ft, sret, selfmode);
  if (isv == 0 && sret == 0) setk(d, ret_kind(rt));
  w("  calli "); if (isv == 0 && sret == 0) { wr(d); w(", "); }
  w("fp"); wn(pr); w(", "); wr(fv.reg);
  i = 0; while (i < no) { w(", "); wr(ops[i].reg); i = i + 1; }
  wc(10); note_win(no);
  if (exc_on && fn_ne(ft) == 0) exc_check();
  V res = mkv(0, 0, 0);
  i = 0; while (i < na) { merge_eff(res, args[i]); i = i + 1; }
  if (self != 0) merge_eff(res, *self);
  if (isv) { res.ty = Y_VOID; res.reg = 0 - 2; return res; }
  if (sret) { out.ne = res.ne; i = 0; while (i < res.ne) { out.ek[i] = res.ek[i]; out.er[i] = res.er[i]; i = i + 1; } return out; }
  if (is_ref(rt)) { res.ty = te[rt]; res.cat = 1; if (tk[rt] == Y_RREF) res.cat = 2; res.reg = d; res.vp = 1; return res; }
  res.ty = unq(rt); res.cat = 0; res.reg = d;
  return res;
}
// varsayilan arguman cagri noktasinda degerlendirilir; yerel degiskenler gorunmez (bildirim baglami: genel adlar)
int lam_instantiate(int ci, V* av, int na);
V gen_default(int dn) { int sv = nvars; nvars = 0; V v = gen(dn); nvars = sv; return v; }
// Bolum 04: isimli argumanlar (.ad = ifade): konumsal onek + adlar -> adaylar arasinda adlari tasiyan TEK islev secilir; eksik konumlar varsayilanla doldurulur
int arrange_named(int* cc, int* ncc, V* av, int* an, int na) {
  int npos = 0; while (npos < na && an[npos] < 0) npos = npos + 1;
  int i = npos; while (i < na) { if (an[i] < 0) die("E_ARG", "isimli argumanlardan sonra konumsal arguman olamaz"); i = i + 1; }
  int pick = 0 - 1; int ci = 0;
  while (ci < *ncc) {
    int f = cc[ci]; ci = ci + 1; int np = fn_np[f]; int ok = 1;
    if (np < na || fn_node[f] < 0) continue;
    int used[8]; int k = 0; while (k < 8) { used[k] = 0; k = k + 1; }
    i = 0; while (i < npos) { used[i] = 1; i = i + 1; }
    int pn_ = kid(fn_node[f], 1);
    i = npos; while (i < na && ok) {
      int found = 0 - 1; k = 0; while (k < np) { if (nk_s1[kid(pn_, k)] == an[i]) found = k; k = k + 1; }
      if (found < 0 || used[found]) ok = 0; else used[found] = 1;
      i = i + 1;
    }
    k = 0; while (k < np && ok) { if (used[k] == 0 && fn_pdef[f * 8 + k] < 0) ok = 0; k = k + 1; }
    if (ok) { if (pick >= 0) die("E_AMBIG", "isimli argumanlar birden fazla asiri yuklemeye uyuyor"); pick = f; }
  }
  if (pick < 0) die("E_NOVIABLE", "isimli argumanlara uyan islev yok");
  V out[8]; int have[8]; int k2 = 0; while (k2 < 8) { have[k2] = 0; k2 = k2 + 1; }
  int np = fn_np[pick]; int pn2 = kid(fn_node[pick], 1);
  i = 0; while (i < npos) { out[i] = av[i]; have[i] = 1; i = i + 1; }
  i = npos; while (i < na) { int found = 0 - 1; k2 = 0; while (k2 < np) { if (nk_s1[kid(pn2, k2)] == an[i]) found = k2; k2 = k2 + 1; } out[found] = av[i]; have[found] = 1; i = i + 1; }
  k2 = 0; while (k2 < np) { if (have[k2] == 0) out[k2] = gen_default(fn_pdef[pick * 8 + k2]); k2 = k2 + 1; }
  k2 = 0; while (k2 < np) { av[k2] = out[k2]; k2 = k2 + 1; }
  cc[0] = pick; *ncc = 1; return np;
}
V gen_call_ptr(int n, V fpv, int mptr, V* mself) {
  fpv = rval(fpv);
  if (is_ptr(fpv.ty) == 0 || is_fn(unq(te[fpv.ty])) == 0) die("E_TYPE", "cagrilabilir olmayan ifade");
  int na = nk_n[n] - 1; V av[8]; if (na > 8) die("E_SINIR", "cok fazla arguman");
  int i = 0; while (i < na) { int an = kid(n, i + 1); if (nk_k[an] == N_INITLIST) die("E_ARG", "suslu parantez listesi arguman olamaz"); if (nk_k[an] == N_NAMEARG) die("E_ARG", "isimli arguman yalniz adli islevlerde kullanilir"); av[i] = gen(an); i = i + 1; }
  if (mptr == 0 && tcl[unq(te[fpv.ty])] >= 0) die("E_TYPE", "uye islev isaretcisi nesne olmadan cagrilamaz");
  if (mptr) return callptr(fpv, mself, av, na);
  return callptr(fpv, 0, av, na);
}
V gen_call(int n) {
  curline = nk_line[n]; int cn = kid(n, 0); int ck = nk_k[cn];
  V self = mkv(0, 0, 0); int haveself = 0; int allowvirt = 1; V calleeobj = mkv(0, 0, 0); int opcall = 0; c_nc = 0;
  V fpv = mkv(0, 0, 0); int fptr = 0; V mself = mkv(0, 0, 0); int mptr = 0;
  if (ck == N_ID && nk_n[n] == 2 && seqc(nk_s1[cn], "std::move")) { V mv = gen(kid(n, 1)); if (mv.cat == 1) mv.cat = 2; return mv; }
