// ifx -- PMX1 SAYISAL IFADE DERLEYICISI (cekirdek).  Bu dosya ifx.pmb'nin GELISTIRME GORUNUMUDUR: kanonik urun ifx.pmb (sayisal program) ve
// komutlar.pmk bolum 12 (IFADE KURAL TABLOSU)'dur. ifx.pmb calisma aninda stdin'den SAYI akisi okur:  <komutlar.pmk sayilari> <PMX1 sayilari>
// ve PMA metnini stdout'a yazar. Tur ozellikleri, operator->komut eslemesi, normallestirme/donusum komut adlari TABLODAN okunur (bu kodda sabit degil).
// Desteklenen cekirdek: skaler/isaretci/dizi, tum tekli/ikili/atama/?:/virgul/++/--, static_cast/C tipi donusum, sizeof, cagri, if/while/do/for/return/break/continue.
// Desteklenmeyen dugum (sinif, referans, dize, UDL ...) AYRIK hata verir ("@@HATA desteklenmiyor"): sessizce yanlis kod uretilmez.
const int NN = 90000;
const int NK = 220000;
const int NC = 120000;
const int NR = 20000;
long long RT[NR]; int nrt = 0;
// ---- PMX1 ----
int nk_line[NN]; int nk_k[NN]; long long nk_i[NN], nk_j[NN], nk_d[NN]; int nk_s1[NN], nk_s2[NN], nk_n[NN], nk_ks[NN]; int kids[NK]; int nkids = 0;
int s_off[4000], s_len[4000]; char chars[NC]; int nchars = 0; int nstr = 0; int nnodes = 0; int root = 0;
// ---- dizge havuzu: PMX1 dizgeleri + derleyicinin kendi adlari ayni havuzda, esitlik = kimlik esitligi ----
int intern_n(const char* t, int n) {
  int i = 0;
  while (i < nstr) { if (s_len[i] == n) { int j = 0; while (j < n && chars[s_off[i] + j] == t[j]) j = j + 1; if (j == n) return i; } i = i + 1; }
  s_off[nstr] = nchars; s_len[nstr] = n; int j = 0; while (j < n) { chars[nchars] = t[j]; nchars = nchars + 1; j = j + 1; }
  nstr = nstr + 1; return nstr - 1;
}
int intern_c(const char* t) { int n = 0; while (t[n]) n = n + 1; return intern_n(t, n); }
char tmpb[256];
int intern_buf(int n) { return intern_n(tmpb, n); }
// ---- temel cikti ----
int dry = 0; int nreg = 0; int nlab = 0; int foff = 0;
void wc(int c) { if (dry == 0) __putc(c); }
void w(const char* s) { while (*s) { wc(*s); s++; } }
void wn(long long v) { if (dry == 0) __puti(v); }
int npair = 0;
const int FPID = 300000;
int rk[20000]; int dl[4000]; int ndl = 0; int dl_pairs[2000]; int ndp = 0; char pair_fmt[4000];   // pair_fmt[k]: cift yazmac k f128 mi (PMT1 turu)
const char* KLET = "IUFBchwCHWsLl";
void wr(long long r) {
  if (r == FPID) { w("fp"); return; }
  if (r >= 100000) { long long k = (r - 100000) / 2; w("q"); wn(k); if ((r - 100000) % 2) w("l"); else w("L"); return; }
  w("r"); wn(r); wc(KLET[rk[r]]);
}
void note_reg(long long n) {   // (n, kind) cifti ilk kullanimda bildirim listesine
  int id = n * 16 + rk[n]; int i = 0; while (i < ndl) { if (dl[i] == id) return; i = i + 1; }
  if (ndl >= 4000) die("E_SINIR", "cok fazla yazmac"); dl[ndl] = id; ndl = ndl + 1;
}
void setk(long long n, int k) { rk[n] = k; note_reg(n); }
void wl(long long l) { w("L"); wn(l); }
void wstr(int sid) { int i = 0; while (i < s_len[sid]) { wc(chars[s_off[sid] + i]); i = i + 1; } }
int curline = 0;
void die(const char* kod, const char* m) { dry = 0; w("@@HATA "); w(kod); w(" satir "); wn(curline); w(": "); w(m); wc(10); long long* p = 0; p = p - 1; long long z = *p; wn(z); }

void die1(const char* m) { die("E_GIRDI", m); }
// ---- girdi ----
int rdc() { return __getc(); }
long long rd() {
  int c = rdc();
  while (c == ' ' || c == 10 || c == 9 || c == 13) c = rdc();
  if (c < 0) { die1("girdi erken bitti"); }
  int neg = 0;
  if (c == '-') { neg = 1; c = rdc(); }
  long long v = 0;
  while (c >= '0' && c <= '9') { v = v * 10 + (c - '0'); c = rdc(); }
  if (neg) return 0 - v;
  return v;
}
// ---- kural tablosu (PMK1 bolum 12) ----
// yuk: nrec ; kayit: sinif nstr (len chars...)*nstr nnum nums*nnum   (sinif 1 TUR, 2 IKILI, 3 KARSILASTIRMA, 4 AD)
int rec_off[400]; int nrec = 0;
long long ty_bits[32], ty_sg[32], ty_cls[32], ty_rank[32]; long long ty_norm[32]; int ty_ok[32];
long long names[64];
int rstr_pos(int r, int idx) {   // kaydin idx. dizgesinin RT'deki konumu (uzunluk sozcugu)
  int p = rec_off[r]; p = p + 1; int ns = RT[p]; p = p + 1;
  int i = 0;
  while (i < idx) { p = p + 1 + RT[p]; i = i + 1; }
  return p;
}
long long rnum(int r, int idx) {
  int p = rec_off[r]; p = p + 1; int ns = RT[p]; p = p + 1;
  int i = 0;
  while (i < ns) { p = p + 1 + RT[p]; i = i + 1; }
  return RT[p + 1 + idx];
}
void wrt(int p) { int n = RT[p]; int i = 0; while (i < n) { wc(RT[p + 1 + i]); i = i + 1; } }
int rt_len(int p) { return RT[p]; }
int slen(int sid) { if (sid < 0) return 0; return s_len[sid]; }
int soff(int sid) { if (sid < 0) return 0; return s_off[sid]; }
int seq_rt_pool(int sid, int p) {   // PMX1 dizgesi == tablo dizgesi
  if (sid < 0) return rt_len(p) == 0;
  if (s_len[sid] != rt_len(p)) return 0;
  int i = 0;
  while (i < s_len[sid]) { if (chars[s_off[sid] + i] != RT[p + 1 + i]) return 0; i = i + 1; }
  return 1;
}
int seqc(int sid, const char* t) {
  if (sid < 0) return 0;
  int n = 0; while (t[n]) n = n + 1;
  if (n != s_len[sid]) return 0;
  int i = 0; while (i < n) { if (chars[s_off[sid] + i] != t[i]) return 0; i = i + 1; }
  return 1;
}
void load_rules() {
  int p = 0; nrec = RT[p]; p = p + 1;
  int r = 0;
  while (r < nrec) {
    rec_off[r] = p;
    int cls = RT[p]; int ns = RT[p + 1]; int q = p + 2; int i = 0;
    while (i < ns) { q = q + 1 + RT[q]; i = i + 1; }
    int nn = RT[q]; q = q + 1 + nn; p = q; r = r + 1;
  }
  r = 0;
  while (r < nrec) {
    int cls = RT[rec_off[r]];
    if (cls == 1) {
      int tc = rnum(r, 0);
      ty_ok[tc] = 1; ty_bits[tc] = rnum(r, 1); ty_sg[tc] = rnum(r, 2); ty_cls[tc] = rnum(r, 3); ty_rank[tc] = rnum(r, 4);
      ty_norm[tc] = rstr_pos(r, 1);
    }
    if (cls == 4) { int i = 0; while (i < 64) { names[i] = rstr_pos(r, i); i = i + 1; } }
    if (cls == 5) { int i = 0; while (i < 14) { kt_ty[i] = rnum(r, i); i = i + 1; } }
    r = r + 1;
  }
}
const int NM_ADD80 = 9; const int NM_SUB80 = 10; const int NM_MUL80 = 11; const int NM_DIV80 = 12; const int NM_NEG80 = 13; const int NM_EQ80 = 14; const int NM_LT80 = 15; const int NM_LE80 = 16; const int NM_NE80 = 17; const int NM_TOB80 = 18; const int NM_F64TO80 = 19; const int NM_80TOF64 = 20; const int NM_80TOF32 = 21; const int NM_I64TO80 = 22; const int NM_U64TO80 = 23; const int NM_80TOI64 = 24; const int NM_80TOU64 = 25; const int NM_PACK80 = 26; const int NM_LO80 = 27; const int NM_HI80 = 28;
const int NM_CV80_128 = 49; const int NM_CV128_80 = 50;   // f128 adlari = f80 adlari + 20 (nmw); tabloda ayni sirada
const int NM_I2F = 0; const int NM_U2F = 1; const int NM_F2I = 2; const int NM_F2U = 3; const int NM_RND = 4; const int NM_NEG = 5; const int NM_FNEG = 6; const int NM_NOT = 7; const int NM_FEQ = 8;

// ============================ TURLER ============================
const int Y_VOID = 0; const int Y_BOOL = 1; const int Y_CHAR = 2; const int Y_UCHAR = 4; const int Y_INT = 7; const int Y_UINT = 8; const int Y_LONG = 9; const int Y_ULONG = 10; const int Y_ULLONG = 12;
const int Y_FLOAT = 13; const int Y_DOUBLE = 14; const int Y_LDOUBLE = 15; const int Y_NULLPTR = 16; const int Y_PTR = 17; const int Y_REF = 18; const int Y_RREF = 19; const int Y_ARR = 20; const int Y_CLASS = 21; const int Y_AUTO = 22; const int Y_FUNC = 23;
int tk[6000]; int te[6000]; long long tn[6000]; int tcl[6000]; int tcv[6000]; int nty = 0;
int mk2(int k, int e, long long n, int cls, int c) {
  int i = 0;
  while (i < nty) { if (tk[i] == k && te[i] == e && tn[i] == n && tcl[i] == cls && tcv[i] == c) return i; i = i + 1; }
  if (nty >= 6000) die("E_SINIR", "cok fazla tur");
  tk[nty] = k; te[nty] = e; tn[nty] = n; tcl[nty] = cls; tcv[nty] = c; nty = nty + 1; return nty - 1;
}
int mkt(int k, int e, long long n) { return mk2(k, e, n, 0 - 1, 0); }
int unq(int t) { if (tcv[t] == 0) return t; return mk2(tk[t], te[t], tn[t], tcl[t], 0); }
int withc(int t, int c) { return mk2(tk[t], te[t], tn[t], tcl[t], c); }
// Bolum 04: islev turleri. Y_FUNC: te = donus turu, tn = imza*2 + noexcept, tcl = uye islevse sinif (aksi -1). Imza: parametre turleri (kopyalanmis/zayiflamis) + degisken sayili bayrak.
int sig_np[512]; int sig_pt[512 * 8]; int sig_va[512]; int nsig = 0;
int mksig(int np, int* pt, int va) {
  int i = 0;
  while (i < nsig) {
    if (sig_np[i] == np && sig_va[i] == va) { int k = 0; int same = 1; while (k < np) { if (sig_pt[i * 8 + k] != pt[k]) same = 0; k = k + 1; } if (same) return i; }
    i = i + 1;
  }
  if (nsig >= 512) die("E_SINIR", "cok fazla islev imzasi");
  sig_np[nsig] = np; sig_va[nsig] = va; int k2 = 0; while (k2 < np) { sig_pt[nsig * 8 + k2] = pt[k2]; k2 = k2 + 1; }
  nsig = nsig + 1; return nsig - 1;
}
int functy(int ret, int np, int* pt, int va, int ne, int cls) { return mk2(Y_FUNC, ret, mksig(np, pt, va) * 2 + ne, cls, 0); }
int is_fn(int t) { return tk[t] == Y_FUNC; }
int fn_sig(int t) { return tn[t] / 2; }
int fn_ne(int t) { return tn[t] % 2; }
int ptrto(int t) { return mk2(Y_PTR, t, 0, 0 - 1, 0); }
int px_ft[256]; int px_sret[256]; int px_self[256]; int nproto = 0;
int proto_for(int ft, int sret, int self) {
  int i = 0; while (i < nproto) { if (px_ft[i] == ft && px_sret[i] == sret && px_self[i] == self) return i; i = i + 1; }
  if (nproto >= 256) die("E_SINIR", "cok fazla islev isaretcisi imzasi");
  px_ft[nproto] = ft; px_sret[nproto] = sret; px_self[nproto] = self; nproto = nproto + 1; return nproto - 1;
}

int lref(int t) { return mk2(Y_REF, t, 0, 0 - 1, 0); }
int rref(int t) { return mk2(Y_RREF, t, 0, 0 - 1, 0); }
int arrof(int t, long long n) { return mk2(Y_ARR, t, n, 0 - 1, 0); }
int clsty(int c) { return mk2(Y_CLASS, 0 - 1, 0, c, 0); }
int is_int(int t) { return tk[t] >= 1 && tk[t] <= 12; }
int is_flt(int t) { return tk[t] == 13 || tk[t] == 14; }
int is_ptr(int t) { return tk[t] == 17; }
int is_arr(int t) { return tk[t] == 20; }
int is_cls(int t) { return tk[t] == 21; }
int is_ref(int t) { return tk[t] == 18 || tk[t] == 19; }
int is_ld(int t) { return tk[t] == 15 || tk[t] == 24; }   // genis kayan nokta: long double (f80, 15) ve __float128 (f128, 24): 2 sozcuklu bellek degeri
int wfmt(int t) { return tk[unq(t)] == 24; }
int is_arith(int t) { return is_int(t) || is_flt(t) || is_ld(t); }
int is_sc(int t) { return is_int(t) || is_flt(t) || is_ptr(t) || is_ld(t); }
int is_void(int t) { return tk[t] == 0; }
int deref(int t) { if (is_ref(t)) return te[t]; return t; }
int bits_of(int t) { if (is_ptr(t)) return 64; return ty_bits[tk[t]]; }
int sg_of(int t) { if (is_ptr(t)) return 0; return ty_sg[tk[t]]; }
int rank_of(int t) { return ty_rank[tk[t]]; }
int uns64(int t) { return is_int(t) && sg_of(t) == 0 && bits_of(t) == 64; }
// ============================ SINIFLAR ============================
const int NCL = 600;
int cl_name[NCL]; int cl_base[NCL]; int cl_poly[NCL]; int cl_def[NCL]; int cl_id[NCL]; long long cl_words[NCL]; long long cl_size[NCL]; long long cl_align[NCL]; long long cl_dsize[NCL]; int cl_pod[NCL]; int cl_bi[NCL];
int cl_f0[NCL]; int cl_nf[NCL]; int ncl = 0;
int cl_fsig[NCL]; int cl_enc[NCL]; int cl_lam[NCL]; int cl_lamfree[NCL]; int cl_lamgen[NCL];   // lambda kapanis sinifi: kapsayan sinif (this yakalama), lambda dugumu+1, gecici-olmayan islev (isaretciye donusum), genel lambda
int fl_name[4000]; int fl_ty[4000]; long long fl_woff[4000]; long long fl_boff[4000]; int nfl = 0;
int fl_ref[4000]; int fl_srcn[4000]; int fl_kind[4000];   // yakalama alani: basvuru mu, kaynak dugum, tur (0 kopya 1 basvuru 2 this)
int newclass(int name) {
  cl_name[ncl] = name; cl_base[ncl] = 0 - 1; cl_poly[ncl] = 0; cl_def[ncl] = 0; cl_id[ncl] = ncl + 1; cl_words[ncl] = 0; cl_size[ncl] = 1; cl_align[ncl] = 1; cl_dsize[ncl] = 0; cl_pod[ncl] = 1; cl_bi[ncl] = 0;
  cl_f0[ncl] = nfl; cl_nf[ncl] = 0; cl_enc[ncl] = 0 - 1; cl_lam[ncl] = 0; cl_lamfree[ncl] = 0 - 1; cl_lamgen[ncl] = 0; ncl = ncl + 1; return ncl - 1;
}
int find_class(int name) { int i = 0; while (i < ncl) { if (cl_name[i] == name) return i; i = i + 1; } return 0 - 1; }
int derived_from(int d, int b) { int c = d; while (c >= 0) { if (c == b) return 1; c = cl_base[c]; } return 0; }
long long size_of(int t);
long long align_of(int t);
long long words_of(int t) {
  if (is_arr(t)) return tn[t] * words_of(te[t]);
  if (is_cls(t)) return cl_words[tcl[t]];
  if (is_void(t)) return 0;
  if (is_ld(t)) return 2;
  return 1;
}
long long size_of(int t) {
  if (is_ref(t)) return size_of(te[t]);
  if (is_arr(t)) return tn[t] * size_of(te[t]);
  if (is_ptr(t) || tk[t] == Y_NULLPTR) return 8;
  if (is_cls(t)) return cl_size[tcl[t]];
  if (is_void(t)) die("E_SIZEOF", "void boyutu yok");
  return ty_bits[tk[t]] / 8;
}
long long align_of(int t) {
  if (is_ref(t)) return align_of(te[t]);
  if (is_arr(t)) return align_of(te[t]);
  if (is_cls(t)) return cl_align[tcl[t]];
  if (is_ld(t)) return 16;
  return size_of(t);
}
int complete_obj(int t) {
  if (is_void(t)) return 0;
  if (is_cls(t)) return cl_def[tcl[t]];
  if (is_arr(t)) return complete_obj(te[t]);
  return 1;
}
// Itanium ABI sinif dizilimi (alan dizilimi + vptr + taban + EBO + kuyruk dolgusu)
void layout_class(int ci) {
  long long off = 0; long long al = 1; long long wd = 0; int b = cl_base[ci];
  if (b >= 0) {
    if (cl_poly[b]) cl_poly[ci] = 1;
    int bempty = cl_poly[b] == 0 && cl_base[b] < 0 && cl_nf[b] == 0;
    if (bempty == 0) { if (cl_pod[b]) off = cl_size[b]; else off = cl_dsize[b]; al = cl_align[b]; wd = cl_words[b]; }
  }
  if (cl_poly[ci] && (b < 0 || cl_poly[b] == 0)) {
    if (b >= 0 && wd > 0) die("E_SINIF", "polimorfik olmayan tabani olan sinifa sanal islev eklenemez");
    off = 8; al = 8; wd = 1;
  }
  int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
  while (i < e) {
    int ft = fl_ty[i];
    if (is_ref(ft)) die("E_TYPE", "referans uye desteklenmiyor");
    if (complete_obj(ft) == 0) die("E_TYPE", "uye turu tam degil");
    long long fa = align_of(ft); off = (off + fa - 1) / fa * fa; fl_boff[i] = off; off = off + size_of(ft);
    fl_woff[i] = wd; wd = wd + words_of(ft); if (fa > al) al = fa; i = i + 1;
  }
  cl_dsize[ci] = off; cl_align[ci] = al; long long sz = (off + al - 1) / al * al; if (sz < 1) sz = 1; cl_size[ci] = sz;
  if (b >= 0 && cl_poly[ci] == 0 && cl_nf[ci] == 0 && cl_poly[b] == 0 && cl_nf[b] == 0 && cl_size[b] == 1) cl_size[ci] = 1;
  cl_words[ci] = wd; cl_pod[ci] = 0; if (b < 0 && cl_poly[ci] == 0) cl_pod[ci] = 1; cl_def[ci] = 1;
}
// alan arama (taban zinciri dahil): sinif idx, woff, ty doner (-1 yok)
long long fq_woff = 0; int fq_ty = 0; long long fq_boff = 0; int fq_idx = 0;
int find_field(int ci, int name) {
  int c = ci;
  while (c >= 0) {
    int i = cl_f0[c]; int e = cl_f0[c] + cl_nf[c];
    while (i < e) { if (fl_name[i] == name) { fq_woff = fl_woff[i]; fq_ty = fl_ty[i]; fq_boff = fl_boff[i]; fq_idx = i; return c; } i = i + 1; }
    c = cl_base[c];
  }
  return 0 - 1;
}
int is_ord(int t) { t = unq(deref(t)); if (!is_cls(t)) return 0; int b = cl_bi[tcl[t]]; return b >= 1 && b <= 3; }
int ord_conv_ok(int from, int to) { int a = cl_bi[tcl[unq(from)]]; int b = cl_bi[tcl[unq(to)]]; return a >= 1 && a <= 3 && b >= 1 && b <= 3 && a <= b; }
// ============================ ISLEVLER ============================
const int NF = 1600;
int fn_name[NF]; int fn_cls[NF]; int fn_ret[NF]; int fn_np[NF]; int fn_pt[NF * 8]; int fn_fl[NF]; int fn_node[NF]; int fn_bi[NF]; int fn_vroot[NF]; int fn_used[NF]; int tc_req = 0; int tc_done = 0; int tc_node = 0 - 1; int fn_gen[NF]; int fn_va[NF]; int fn_pdef[NF * 8]; int fn_ndef[NF]; int allow_def = 0; int nfn = 0; int fn_line[NF];
const int F_INLINE = 512; const int F_CONSTEXPR = 1024; const int F_CONSTEVAL = 2048; const int F_STATIC = 4096; const int F_EXTC = 8192; const int F_EXTERN = 16384;
const int F_CONST = 1; const int F_VIRT = 2; const int F_NOEX = 4; const int F_DEFAULT = 16; const int F_OVR = 32; const int F_DELETE = 64; const int F_EXPL = 128; const int F_PURE = 256;
int fn_has(int f, int bit) { return (fn_fl[f] & bit) != 0; }
// ============================ DEGER / UretIM ============================
const int NEF = 8;
struct V { long long ty; long long cat; long long reg; long long ci; long long cv; long long key; long long nl; long long vp; long long ne; long long bp; long long bks; long long bkr; long long ovn; long long ek[8]; long long er[8]; };
V mkv(long long ty, long long cat, long long reg) { V v; v.ty = ty; v.cat = cat; v.reg = reg; v.ci = 0; v.cv = 0; v.key = 0; v.nl = 0; v.vp = 0; v.ne = 0; v.bp = 0; v.bks = 0; v.bkr = 0; v.ovn = 0 - 1; return v; }
V imm(long long ty, long long val) { V v = mkv(ty, 0, 0 - 1); v.ci = 1; v.cv = val; return v; }
V novalue() { return mkv(Y_VOID, 0, 0 - 2); }
// Bolum 04: islev adresi = islev INDEKSI (assembler `mov r, fN` sembol sabiti); 0. islev bos islev (__nul) -> bos isaretci hep gecersiz hedef
int fn_type_of(int f) {
  int pt[8]; int i = 0; while (i < fn_np[f]) { pt[i] = fn_pt[f * 8 + i]; i = i + 1; }
  return functy(fn_ret[f], fn_np[f], pt, fn_va[f], fn_has(f, F_NOEX), fn_cls[f]);
}
V fnaddr(int f) {
  if (fn_bi[f] != 0) die("E_ADDR", "yerlesik islevin adresi alinamaz");
  if (fn_has(f, F_CONSTEVAL)) die("E_CONSTEVAL", "consteval islevinin adresi alinamaz");
  fn_used[f] = 1; int ft = fn_type_of(f); long long r = newreg(); setk(r, 1);
  if (fn_cls[f] >= 0 && fn_has(f, F_VIRT)) { fn_used[fn_vroot[f]] = 1; w("  mov "); wr(r); w(", vd"); wn(fn_vroot[f]); wc(10); }
  else { w("  mov "); wr(r); w(", f"); wn(f); wc(10); }
  return mkv(ptrto(ft), 0, r);
}
void add_eff(V& v, long long key, long long rw) { if (key == 0) return; if (v.ne < NEF) { v.ek[v.ne] = key; v.er[v.ne] = rw; v.ne = v.ne + 1; } }
void merge_eff(V& v, V& o) { int i = 0; while (i < o.ne) { add_eff(v, o.ek[i], o.er[i]); i = i + 1; } }
int unseq_bad(V& a, V& b) {
  int i = 0;
  while (i < a.ne + 1) {
    long long ka = 0; long long ra = 0;
    if (i < a.ne) { ka = a.ek[i]; ra = a.er[i]; } else if (a.cat == 1 && a.key != 0 && a.ty >= 0) { ka = a.key; ra = 1; }
    int j = 0;
    while (ka != 0 && j < b.ne + 1) {
      long long kb = 0; long long rb = 0;
      if (j < b.ne) { kb = b.ek[j]; rb = b.er[j]; } else if (b.cat == 1 && b.key != 0 && b.ty >= 0) { kb = b.key; rb = 1; }
      if (kb == ka && (ra == 2 || rb == 2)) return 1;
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}
long long newreg() { nreg = nreg + 1; rk[nreg - 1] = 0; return nreg - 1; }
void opr(V v) { if (v.reg < 0) wn(v.cv); else wr(v.reg); }
// ---- OPSIG (komut imzalari) ve tur bilgisi: girdi akisindan (komut @@imza) ve PMK1 bolum 2/3'ten ----
long long op_sp[1200 * 3]; int op_known[1200]; int op_byname[9000]; int nopids = 0;
int ti_cl[256]; int ti_bits[256]; int ti_sg[256]; int kt_ty[16]; int ty_kind[256];
int host_id_byname[9000]; long long host_sig[64 * 4];
int opid_pool(int pool) { if (pool < 0 || pool >= 9000) return 0 - 1; return op_byname[pool]; }
int opid_c(const char* s) { int p = intern_c(s); int id = opid_pool(p); if (id < 0) die("E_OP", "komut tabloda yok"); return id; }
int opid_rt(int pos) { int n = RT[pos]; int i = 0; while (i < n) { tmpb[i] = RT[pos + 1 + i]; i = i + 1; } int p = intern_n(tmpb, n); int id = opid_pool(p); if (id < 0) die("E_OP", "komut tabloda yok (kural tablosundaki ad)"); return id; }
int pkind(long long reg) { if (pair_fmt[(reg - 100000) / 2]) return 13; return 11; }
int kind_of_type_id(int tid) { if (tid < 0 || tid > 255) return 0 - 1; return ty_kind[tid]; }
// bir tur icin dogal yazmac turu (C++ turu -> yazmac turu)
int kind_for(int t) {
  t = unq(deref(t));
  if (is_ptr(t) || tk[t] == Y_NULLPTR || is_cls(t) || is_arr(t)) return 1;
  if (is_ld(t)) return 1;
  if (tk[t] == Y_BOOL) return 3;
  if (is_flt(t)) return 2;
  if (is_int(t)) { if (sg_of(t)) return 0; return 1; }
  return 0;
}
// belirtimin gerektirdigi tur: spec>0 tam tur; sinif belirtimleri icin mevcut tur uygunsa o, degilse varsayilan
int spec_ok(int spec, int curtid) {   // mevcut tur belirtimi karsilar mi
  if (spec > 0) return curtid == spec;
  int cl = ti_cl[curtid]; int bt = ti_bits[curtid];
  if (spec == 0 - 10 || spec == 0 - 7) return cl == 1 && bt == 64;
  if (spec == 0 - 1) return cl >= 1 && cl <= 4;
  if (spec == 0 - 2) return cl == 5;
  if (spec == 0 - 9) return cl >= 1 && cl <= 4;
  return 1;
}
int default_kind_for_spec(int spec, int curkind) {
  if (spec > 0) { int k = kind_of_type_id(spec); if (k < 0) die("E_TIP", "imza turu bu derleyicide yazmac turu degil"); return k; }
  if (spec == 0 - 10 || spec == 0 - 7) return 0;
  if (spec == 0 - 1) return 0;
  if (spec == 0 - 2) return 2;
  return curkind;
}
// kaynak yazmaci belirtime uydur; gerekirse 'cast' ekle. dondurur: uyarlanmis V
V mat_k(V v, int kind) {   // anlik -> belirtilen turde yazmac
  if (v.reg >= 0) return v;
  long long r = newreg(); setk(r, kind); w("  mov "); wr(r); w(", "); wn(v.cv); wc(10); V o = v; o.reg = r; o.ci = 0; return o;
}
V cast_k(V v, int kind) {
  v = mat_k(v, kind);
  if (v.reg >= FPID) return v;
  int cur = 0; if (v.reg < 100000) cur = rk[v.reg]; else cur = pkind(v.reg);
  if (cur == kind) return v;
  long long r = newreg(); setk(r, kind); w("  cast "); wr(r); w(", "); wr(v.reg); wc(10); V o = v; o.reg = r; return o;
}
V adapt(V v, int spec, int refkind) {   // refkind: =slot belirtimleri icin gereken tur (kind)
  int curk; if (v.reg < 0) curk = kind_for(v.ty); else if (v.reg == FPID) curk = 1; else if (v.reg >= 100000) curk = pkind(v.reg); else curk = rk[v.reg];
  if (spec == 0 - 4 || spec == 0 - 5 || spec == 0 - 6) return cast_k(v, refkind);
  int tid = kt_ty[curk];
  if (v.reg < 0) { int dk = default_kind_for_spec(spec, kind_for(v.ty)); if (spec > 0 || spec == 0 - 10 || spec == 0 - 7 || spec == 0 - 1 || spec == 0 - 2) v = mat_k(v, dk); else v = mat_k(v, kind_for(v.ty)); return adapt(v, spec, refkind); }
  if (spec_ok(spec, tid)) return v;
  return cast_k(v, default_kind_for_spec(spec, curk));
}
int kind_of(V v) { if (v.reg == FPID) return 1; if (v.reg >= 100000) return pkind(v.reg); return rk[v.reg]; }
void emit3(int id, long long d, V a, V b) {
  int s0 = op_sp[id * 3]; int s1 = op_sp[id * 3 + 1]; int s2 = op_sp[id * 3 + 2];
  a = adapt(a, s1, 0);
  int ak = kind_of(a);
  b = adapt(b, s2, ak);
  int dk;
  if (s0 > 0) dk = default_kind_for_spec(s0, 0); else if (s0 == 0 - 5) dk = ak; else if (s0 == 0 - 6) dk = kind_of(b); else if (s0 == 0 - 4) dk = ak; else dk = ak;
  if (d >= 100000) note_pair(d); else setk(d, dk);
  w("  "); wstr(op_nm_pool[id]); w(" "); wr(d); w(", "); wr(a.reg); w(", "); wr(b.reg); wc(10);
}
void emit2(int id, long long d, V a) {
  int s0 = op_sp[id * 3]; int s1 = op_sp[id * 3 + 1];
  a = adapt(a, s1, 0); int ak = kind_of(a); int dk;
  if (s0 > 0) dk = default_kind_for_spec(s0, 0); else dk = ak;
  if (d >= 100000) note_pair(d); else setk(d, dk);
  w("  "); wstr(op_nm_pool[id]); w(" "); wr(d); w(", "); wr(a.reg); wc(10);
}
int op_nm_pool[1200];
void ins2(const char* op, long long d, V a) { emit2(opid_c(op), d, a); }
void ins3(const char* op, long long d, V a, V b) { emit3(opid_c(op), d, a, b); }
void ins2t(int nm, long long d, V a) { emit2(opid_rt(nm), d, a); }
void ins3t(int nm, long long d, V a, V b) { emit3(opid_rt(nm), d, a, b); }
V mat(V v) { return mat_k(v, kind_for(v.ty)); }
// ---- yazmac/bellek ilkelleri (tur duyarli) ----
V addr_reg(V a) { a = mat_k(a, 1); if (a.reg == FPID) return a; int k = kind_of(a); if (a.reg >= 100000) return a; if (k == 0 || k == 1) return a; return cast_k(a, 1); }
void e_ld(long long d, int kind, V addr, long long off) { addr = addr_reg(addr); setk(d, kind); w("  ld "); wr(d); w(", "); wr(addr.reg); w(", "); wn(off); wc(10); }
void e_st(V val, V addr, long long off) { addr = addr_reg(addr); val = mat(val); if (val.reg < FPID && val.reg >= 100000) die("E_IC", "cift yazmac st"); w("  st "); wr(val.reg); w(", "); wr(addr.reg); w(", "); wn(off); wc(10); }
void e_sti(long long imm_, V addr, long long off) { V m = mat_k(imm(0, imm_), 0); e_st(m, addr, off); }
long long e_movi(int kind, long long val) { long long r = newreg(); setk(r, kind); w("  mov "); wr(r); w(", "); wn(val); wc(10); return r; }
void e_mov(long long d, int kind, V src) { src = cast_k(mat_k(src, kind), kind); setk(d, kind); w("  mov "); wr(d); w(", "); wr(src.reg); wc(10); }
long long e_addi(V a, long long off) { a = addr_reg(a); long long r = newreg(); setk(r, kind_of(a) == 0 ? 0 : 1); w("  addi "); wr(r); w(", "); wr(a.reg); w(", "); wn(off); wc(10); return r; }
void e_jcc(const char* op, V c, long long lab) { c = mat_k(c, 3); int k = kind_of(c); if (k == 2 || k == 10) die("E_TIP", "kosul kayan nokta"); w("  "); w(op); w(" "); wr(c.reg); w(", "); wl(lab); wc(10); }
long long ndat = 0; long long dat[8000];
V fconst(int ty, long long bits) {
  dat[ndat] = bits; ndat = ndat + 1; long long a = newreg(); setk(a, 1); long long r = newreg();
  w("  mov "); wr(a); w(", d"); wn(ndat - 1); wc(10); e_ld(r, 2, mkv(0, 0, a), 0); return mkv(ty, 0, r);
}
void trapnow() { long long m = e_movi(0, 0 - 1); long long r = newreg(); e_ld(r, 0, mkv(0, 0, m), 0); }
int newlab() { nlab = nlab + 1; return nlab - 1; }
int tid_node = 0 - 1;
void nullchk_exc(V p, const char* cls) {
  if (p.ci && p.cv == 0) { throw_named(cls); return; }
  int ok = newlab(); V m = mat(p); e_jcc("jnz", m, ok); throw_named(cls); wl(ok); w(":\n");
}
void nullchk(V p) {
  if (p.ci && p.cv == 0) { trapnow(); return; }
  int ok = newlab(); V m = mat(p); e_jcc("jnz", m, ok); trapnow(); wl(ok); w(":\n");
}
int slot(long long wd) { int o = foff; foff = foff + wd; if (wd < 1) foff = o + 1; return o; }
V slotaddr(int off) { long long r = e_addi(mkv(0, 0, FPID), off); return mkv(0, 1, r); }
void zero_n(V dst, long long n) {
  long long i = 0;
  if (n <= 8) { while (i < n) { e_sti(0, dst, i); i = i + 1; } return; }
  long long ri = e_movi(0, 0); long long rp = newreg(); e_mov(rp, 1, dst); long long rc = newreg(); int top = newlab(); int end = newlab(); long long z = e_movi(0, 0);
  wl(top); w(":\n"); long long lim = e_movi(0, n); ins3("lt", rc, mkv(0, 0, ri), mkv(0, 0, lim)); e_jcc("jz", mkv(0, 0, rc), end);
  e_st(mkv(0, 0, z), mkv(0, 0, rp), 0); long long p2 = e_addi(mkv(0, 0, rp), 1); e_mov(rp, 1, mkv(0, 0, p2)); long long i2 = e_addi(mkv(0, 0, ri), 1); e_mov(ri, 0, mkv(0, 0, i2)); w("  jmp "); wl(top); wc(10); wl(end); w(":\n");
}
void copy_n(V dst, V src, long long from, long long n) {
  if (n - from <= 8) { long long i = from; while (i < n) { long long t = newreg(); e_ld(t, 0, src, i); e_st(mkv(0, 0, t), dst, i); i = i + 1; } return; }
  long long i = e_movi(0, from); long long pa = newreg(); long long pb = newreg(); long long c = newreg(); long long t = newreg(); int top = newlab(); int end = newlab();
  long long pa0 = e_addi(dst, from); e_mov(pa, 1, mkv(0, 0, pa0)); long long pb0 = e_addi(src, from); e_mov(pb, 1, mkv(0, 0, pb0)); long long lim = e_movi(0, n);
  wl(top); w(":\n"); ins3("lt", c, mkv(0, 0, i), mkv(0, 0, lim)); e_jcc("jz", mkv(0, 0, c), end); e_ld(t, 0, mkv(0, 0, pb), 0); e_st(mkv(0, 0, t), mkv(0, 0, pa), 0);
  long long p2 = e_addi(mkv(0, 0, pa), 1); e_mov(pa, 1, mkv(0, 0, p2)); long long p3 = e_addi(mkv(0, 0, pb), 1); e_mov(pb, 1, mkv(0, 0, p3)); long long i2 = e_addi(mkv(0, 0, i), 1); e_mov(i, 0, mkv(0, 0, i2));
  w("  jmp "); wl(top); wc(10); wl(end); w(":\n");
}
void set_vptr(V addr, int ci) { if (cl_poly[ci]) { e_sti(cl_id[ci], addr, 0); } }
void note_win(int n);
void fw_fixup(V dst, int dc, int srccat, V src);
void copy_obj(V dst, V src, int dc, int construct) {
  long long from = 0; if (cl_poly[dc]) from = 1;
  copy_n(dst, src, from, cl_words[dc]); if (construct) set_vptr(dst, dc);
  fw_fixup(dst, dc, src.cat, src);
}
// Bolum 04: sarmalayici icerikli sinif kopyasi -- std::function derin kopyalanir (kopyalayici islev yeni nesne uretir); std::move_only_function kopyalanamaz, rvalue'dan tasinir (kaynak bosalir).
int cl_hasfw(int ci) {
  if (cl_bi[ci] >= 8) return 1;
  int i = cl_f0[ci]; int e = i + cl_nf[ci];
  while (i < e) { int ft = fl_ty[i]; if (is_arr(ft)) ft = te[ft]; if (is_cls(unq(ft)) && cl_hasfw(tcl[unq(ft)])) return 1; i = i + 1; }
  if (cl_base[ci] >= 0) return cl_hasfw(cl_base[ci]);
  return 0;
}
int px_cp_ft = 0 - 1;
void fw_clone_at(V dst, long long woff, int moveonly, int srccat, V src) {
  long long a = dst.reg; if (woff != 0) a = e_addi(dst, woff); V ad = mkv(0, 1, a);
  if (moveonly) {
    if (srccat == 1) die("E_DELETED", "std::move_only_function kopyalanamaz (yalniz tasinabilir)");
    if (srccat == 2) { long long sa = src.reg; if (woff != 0) sa = e_addi(src, woff); e_sti(0, mkv(0, 1, sa), 1); }   // tasinan kaynak bosalir
    return;
  }
  long long ob = newreg(); e_ld(ob, 1, ad, 1); int skip = newlab(); e_jcc("jz", mkv(0, 0, ob), skip);
  long long cp = newreg(); e_ld(cp, 0, ad, 2);
  if (px_cp_ft < 0) { int vp = ptrto(mkt(Y_VOID, 0 - 1, 0)); int pt1[1]; pt1[0] = vp; px_cp_ft = functy(vp, 1, pt1, 0, 0, 0 - 1); }
  int pr = proto_for(px_cp_ft, 0, 0); long long nw = newreg(); setk(nw, 1);
  w("  calli "); wr(nw); w(", fp"); wn(pr); w(", "); wr(cp); w(", "); wr(ob); wc(10); note_win(1);
  e_st(mkv(0, 0, nw), ad, 1); wl(skip); w(":\n");
}
void fw_fixup_cls(V dst, long long base, int dc, int srccat, V src) {
  if (cl_bi[dc] >= 8) { fw_clone_at(dst, base, cl_bi[dc] == 9, srccat, src); return; }
  int i = cl_f0[dc]; int e = i + cl_nf[dc];
  while (i < e) { int ft = fl_ty[i]; if (is_cls(unq(ft)) && cl_hasfw(tcl[unq(ft)])) fw_fixup_cls(dst, base + fl_woff[i], tcl[unq(ft)], srccat, src); i = i + 1; }
  if (cl_base[dc] >= 0 && cl_hasfw(cl_base[dc])) fw_fixup_cls(dst, base, cl_base[dc], srccat, src);
}
void fw_fixup(V dst, int dc, int srccat, V src) { if (cl_hasfw(dc)) fw_fixup_cls(dst, 0, dc, srccat, src); }
V tempobj(int clsT) { int ci = tcl[clsT]; int off = slot(cl_words[ci]); V a = slotaddr(off); set_vptr(a, ci); V v = mkv(unq(clsT), 0, a.reg); return v; }
V tempscalar(int t, V val) { int off = slot(1); V a = slotaddr(off); V m = mat(val); e_st(m, a, 0); V v = mkv(t, 1, a.reg); return v; }
long long fold(long long x, int t) {
  if (tk[t] == Y_BOOL) { if (x != 0) return 1; return 0; }
  if (is_ptr(t) || bits_of(t) >= 64) return x;
  int sh = 64 - bits_of(t);
  if (sg_of(t)) return (x << sh) >> sh;
  return (x << sh) >> sh & ((1LL << bits_of(t)) - 1);
}
int promote(int t) { t = unq(t); if (is_int(t) && rank_of(t) < 4) return mkt(Y_INT, 0 - 1, 0); return t; }
int uac(int x, int y) {
  x = unq(x); y = unq(y);
  if (tk[x] == 24 || tk[y] == 24) return mkt(24, 0 - 1, 0);
  if (tk[x] == Y_LDOUBLE || tk[y] == Y_LDOUBLE) return mkt(Y_LDOUBLE, 0 - 1, 0);
  if (tk[x] == Y_DOUBLE || tk[y] == Y_DOUBLE) return mkt(Y_DOUBLE, 0 - 1, 0);
  if (tk[x] == Y_FLOAT || tk[y] == Y_FLOAT) return mkt(Y_FLOAT, 0 - 1, 0);
  x = promote(x); y = promote(y);
  if (x == y) return x;
  int sx = sg_of(x); int sy = sg_of(y);
  if (sx == sy) { if (rank_of(x) >= rank_of(y)) return x; return y; }
  int u = x; int s = y; if (sx) { u = y; s = x; }
  if (rank_of(u) >= rank_of(s)) return u;
  if (bits_of(s) > bits_of(u)) return s;
  if (tk[s] == 9) return mkt(10, 0 - 1, 0);
  if (tk[s] == 11) return mkt(12, 0 - 1, 0);
  return mkt(Y_UINT, 0 - 1, 0);
}
// ---- f80 (long double): 2 sozcuklu bellek degeri; yazmac cifti q<k>L/q<k>l, Bolum 01 f80 komutlariyla ----
void note_pair(long long d) { int k = (d - 100000) / 2; int i = 0; while (i < ndp) { if (dl_pairs[i] == k) return; i = i + 1; } if (ndp >= 2000) die("E_SINIR", "cok fazla cift yazmac"); dl_pairs[ndp] = k; ndp = ndp + 1; }
long long newreg2f(int f) { int k = npair; long long r = 100000 + 2 * npair; npair = npair + 1; if (k < 4000) pair_fmt[k] = f; note_pair(r); return r; }
long long nmw(int b80, int f) { return names[b80 + f * 20]; }   // genis kayan nokta komut adi: f80 (f=0) ya da f128 (f=1), tablodan
int wty(int f) { if (f) return mkt(24, 0 - 1, 0); return mkt(Y_LDOUBLE, 0 - 1, 0); }
int ldty() { return mkt(Y_LDOUBLE, 0 - 1, 0); }
long long ld_load(V a) {   // bellekteki f80/f128 -> yazmac cifti (ld, ld, pack_f80/pack_f128)
  int f = wfmt(a.ty); V m = addr_reg(mat(a)); long long lo = newreg(); long long hi = newreg(); e_ld(lo, 1, m, 0); e_ld(hi, 1, m, 1);
  long long p = newreg2f(f); w("  "); wrt(nmw(NM_PACK80, f)); w(" "); wr(p); w(", "); wr(lo); w(", "); wr(hi); wc(10); return p;
}
V ld_new(long long p) {   // yazmac cifti -> yeni gecici bellek degeri
  int f = pair_fmt[(p - 100000) / 2]; int off = slot(2); V ad = slotaddr(off); long long lo = newreg(); long long hi = newreg(); setk(lo, 1); setk(hi, 1);
  w("  "); wrt(nmw(NM_LO80, f)); w(" "); wr(lo); w(", "); wr(p); wc(10); w("  "); wrt(nmw(NM_HI80, f)); w(" "); wr(hi); w(", "); wr(p); wc(10);
  e_st(mkv(0, 0, lo), ad, 0); e_st(mkv(0, 0, hi), ad, 1); return mkv(wty(f), 0, ad.reg);
}
V to_ld(V v, int f) {   // genis kayan nokta degere (istenen bicim f) donustur: f80<->f128 yalniz acik komutlarla, f64'e inilmez
  v = rval(v); if (is_ld(v.ty) && wfmt(v.ty) == f) return v; if (is_arith(v.ty) == 0) die("E_CONV", "long double/__float128 donusumu yok"); return convert_arith(v, wty(f));
}
V ld_binop(const char* tok, V l, V r) {
  l = rval(l); r = rval(r); int f = wfmt(l.ty) || wfmt(r.ty); l = to_ld(l, f); r = to_ld(r, f);
  int cr = find_rule(3, tok); long long pa = ld_load(l); long long pb = ld_load(r);
  if (cr >= 0) {
    int nmp = rstr_pos(cr, 4 + f); long long d = newreg(); int swapw = rnum(cr, 3);
    if (rt_len(nmp) == 0) die("E_OP", "genis kayan nokta karsilastirmasi tabloda yok");
    if (swapw) ins3t(nmp, d, mkv(0, 0, pb), mkv(0, 0, pa)); else ins3t(nmp, d, mkv(0, 0, pa), mkv(0, 0, pb));
    V o = mkv(bool_t(), 0, d); merge_eff(o, l); merge_eff(o, r); return o;
  }
  int ar = find_rule(2, tok); if (ar < 0) die("E_OP", "bilinmeyen ikili islec");
  int nmp = rstr_pos(ar, 4 + f); if (rt_len(nmp) == 0) die("E_TYPE", "islec long double/__float128 turunde tanimli degil");
  long long d = newreg2f(f); ins3t(nmp, d, mkv(0, 0, pa), mkv(0, 0, pb));
  V o = ld_new(d); merge_eff(o, l); merge_eff(o, r); return o;
}
V ld_const(long long lo, long long hi, int f) {
  long long a = e_movi(1, lo); long long b = e_movi(1, hi);
  long long p = newreg2f(f); w("  "); wrt(nmw(NM_PACK80, f)); w(" "); wr(p); w(", "); wr(a); w(", "); wr(b); wc(10); return ld_new(p);
}
void ld_copy(V dst, V src) { int f = wfmt(src.ty); long long p = ld_load(src); V m = mat(dst); long long lo = newreg(); long long hi = newreg(); setk(lo, 1); setk(hi, 1);
  w("  "); wrt(nmw(NM_LO80, f)); w(" "); wr(lo); w(", "); wr(p); wc(10); w("  "); wrt(nmw(NM_HI80, f)); w(" "); wr(hi); w(", "); wr(p); wc(10); e_st(mkv(0, 0, lo), m, 0); e_st(mkv(0, 0, hi), m, 1); }
int is_mem(int t) { return is_cls(t) || is_ld(t); }
V to_mem_value(V v, int T) { T = unq(T); if (is_ld(T)) return to_ld(v, wfmt(T)); return to_class_value(v, T); }
V tempmem(int T) { T = unq(T); if (is_ld(T)) { int off = slot(2); V a = slotaddr(off); V o = mkv(T, 0, a.reg); return o; } return tempobj(T); }
V norm(V v, int t) {
  if (is_ld(t)) { v.ty = t; return v; }
  if (is_flt(t)) { if (tk[t] == Y_FLOAT) { V m = mat(v); long long d = newreg(); ins2t(names[NM_RND], d, m); return mkv(t, 0, d); } v.ty = t; return v; }
  if (tk[t] == Y_BOOL) { V m = mat(v); long long d = newreg(); ins3("ne", d, m, imm(t, 0)); return mkv(t, 0, d); }
  if (is_ptr(t) || bits_of(t) == 64) { v.ty = t; return v; }
  V m = mat(v); long long d = newreg(); ins2t(ty_norm[tk[t]], d, m); return mkv(t, 0, d);
}
V rval(V v) {
  if (v.ci && v.cat == 1 && is_int(unq(v.ty))) { V rc = imm(unq(v.ty), v.cv); return rc; }   // sabit ilklendirmeli const tamsayi: deger sabit olarak okunur
  if (is_arr(v.ty)) { V r = v; r.ty = ptrto(te[v.ty]); r.cat = 0; return r; }
  if (v.cat == 0 || is_cls(v.ty) || is_void(v.ty)) { V r = v; r.ty = unq(v.ty); if (is_cls(v.ty) == 0) r.cat = 0; return r; }
  if (is_ld(v.ty)) { long long p = ld_load(v); V o = ld_new(p); o.ne = v.ne; int q = 0; while (q < v.ne) { o.ek[q] = v.ek[q]; o.er[q] = v.er[q]; q = q + 1; } add_eff(o, v.key, 1); return o; }
  if (v.bks) {   // bayt gorunumu okuma: sozcuk -> (sozcuk >> 8*k) & 255, sonra 1 baytlik turun normalizasyonu
    long long w = newreg(); e_ld(w, 0, v, 0); long long t = newreg(); ins3("sar", t, mkv(0, 0, w), mkv(0, 0, v.bkr));
    long long m = newreg(); ins3("and", m, mkv(0, 0, t), imm(0, 255)); V rb = norm(mkv(unq(v.ty), 0, m), unq(v.ty)); rb.cat = 0; return rb;
  }
  V r = mkv(unq(v.ty), 0, 0); r.ne = v.ne; int i = 0; while (i < v.ne) { r.ek[i] = v.ek[i]; r.er[i] = v.er[i]; i = i + 1; }
  r.reg = newreg(); e_ld(r.reg, kind_for(r.ty), v, 0); r.bp = v.bp;
  if (pun_on && is_int(r.ty) && tk[r.ty] != Y_BOOL && bits_of(r.ty) < 64) {   // bellek gorunumu: dar tamsayi her okumada kendi genisligine/isaretine normalize (ayni boyutlu reinterpret_cast turleri arasi dogru)
    V nn = norm(r, r.ty); nn.ne = r.ne; int q = 0; while (q < r.ne) { nn.ek[q] = r.ek[q]; nn.er[q] = r.er[q]; q = q + 1; } r = nn;
  }
  add_eff(r, v.key, 1);
  return r;
}
V convert_arith(V v, int to) {
  int from = v.ty; to = unq(to);
  if (from == to) return v;
  if (is_ld(to) && is_ld(from)) {   // f80 <-> f128: acik donusum komutlari (araya f64 girmez)
    int tf = wfmt(to); long long p = ld_load(v); V pv = mkv(from, 0, p); long long d = newreg2f(tf);
    ins2t(names[tf ? NM_CV80_128 : NM_CV128_80], d, pv); V o = ld_new(d); o.ne = v.ne; return o;
  }
  if (is_ld(to) && is_ld(from) == 0) {
    int f = wfmt(to); long long p = newreg2f(f);
    if (is_int(from)) { V m = mat(v); if (uns64(from)) ins2t(nmw(NM_U64TO80, f), p, m); else ins2t(nmw(NM_I64TO80, f), p, m); }
    else { V m = mat(v); ins2t(nmw(NM_F64TO80, f), p, m); }
    V o = ld_new(p); o.ne = v.ne; return o;
  }
  if (is_ld(from) && is_ld(to) == 0) {
    int f = wfmt(from); long long p = ld_load(v); V pv = mkv(from, 0, p); long long d = newreg();
    if (tk[to] == Y_BOOL) { ins2t(nmw(NM_TOB80, f), d, pv); return mkv(to, 0, d); }
    if (tk[to] == Y_DOUBLE) { ins2t(nmw(NM_80TOF64, f), d, pv); return mkv(to, 0, d); }
    if (tk[to] == Y_FLOAT) { ins2t(nmw(NM_80TOF32, f), d, pv); return mkv(to, 0, d); }
    if (uns64(to)) ins2t(nmw(NM_80TOU64, f), d, pv); else ins2t(nmw(NM_80TOI64, f), d, pv);
    V o = mkv(to, 0, d); if (bits_of(to) < 64) return norm(o, to); return o;
  }
  if (is_int(from) && is_int(to)) {
    if (v.ci) { V o = imm(to, fold(v.cv, to)); o.ne = v.ne; return o; }
    int need = 1;
    if (tk[to] != Y_BOOL) {
      if (tk[from] == Y_BOOL) need = 0;
      else if (sg_of(from) == sg_of(to) && bits_of(to) >= bits_of(from)) need = 0;
      else if (sg_of(from) == 0 && sg_of(to) == 1 && bits_of(to) > bits_of(from)) need = 0;
      else if (bits_of(to) == 64) need = 0;
    }
    if (need == 0) { v.ty = to; return v; }
    return norm(v, to);
  }
  if (is_int(from) && is_flt(to)) {
    V m = mat(v); long long d = newreg();
    if (uns64(from)) ins2t(names[NM_U2F], d, m); else ins2t(names[NM_I2F], d, m);
    V o = mkv(to, 0, d); if (tk[to] == Y_FLOAT) return norm(o, to); return o;
  }
  if (is_flt(from) && is_int(to)) {
    V m = mat(v);
    if (tk[to] == Y_BOOL) { long long t1 = newreg(); ins3t(names[NM_FEQ], t1, m, fconst(from, 0)); long long d = newreg(); ins3("eq", d, mkv(from, 0, t1), imm(to, 0)); return mkv(to, 0, d); }
    long long d = newreg(); if (uns64(to)) ins2t(names[NM_F2U], d, m); else ins2t(names[NM_F2I], d, m);
    V o = mkv(to, 0, d); if (bits_of(to) < 64) return norm(o, to); return o;
  }
  if (is_flt(from) && is_flt(to)) { if (tk[to] == Y_FLOAT) return norm(v, to); v.ty = to; return v; }
  die("E_DONUSUM", "sayisal donusum yok"); return v;
}
// ============================ DONUSUM SIRALARI / ASIRI YUKLEME ============================
int N_CONV = 0; int N_CALLOP = 0; int N_EQ = 0; int N_NE = 0; int N_LT = 0; int N_GT = 0; int N_LE = 0; int N_GE = 0; int N_SS = 0; int N_ASG = 0; int N_NEG = 0; int N_NOT = 0; int N_DEREF = 0; int N_ADDR = 0; int N_IDX = 0; int N_ARW = 0; int N_INC = 0; int N_DEC = 0; int N_TILDE = 0; int N_PLUS = 0;
int std_rank(int from, V* v, int to) {   // -1 yok, 0 tam, 1 terfi, 2 donusum
  from = unq(from); to = unq(to);
  if (from == to) return 0;
  int fk = tk[from]; int tkk = tk[to];
  if (is_arith(from) && is_arith(to)) {
    if (tkk == Y_BOOL) return 2;
    if (tkk == Y_INT && fk >= Y_BOOL && fk <= 6) return 1;
    if (tkk == Y_DOUBLE && fk == Y_FLOAT) return 1;
    return 2;
  }
  if (tkk == Y_PTR) {
    if (fk == Y_NULLPTR) return 2;
    if (v != 0 && is_int(from) && v->ci && v->cv == 0 && v->nl) return 2;
    if (fk == Y_PTR) {
      int fe = te[from]; int tee = te[to];
      if (unq(fe) == unq(tee)) { if ((tcv[fe] == 0 || tcv[tee]) ) return 0; return 0 - 1; }
      { int a_ = unq(fe); int b_ = unq(tee); if (is_fn(a_) && is_fn(b_) && te[a_] == te[b_] && fn_sig(a_) == fn_sig(b_) && tcl[a_] == tcl[b_] && fn_ne(a_) >= fn_ne(b_)) return 0; }
      if (tk[tee] == Y_VOID) { if (tcv[fe] == 0 || tcv[tee]) return 2; return 0 - 1; }
      if (is_cls(fe) && is_cls(tee) && derived_from(tcl[fe], tcl[tee]) && (tcv[fe] == 0 || tcv[tee])) return 2;
      return 0 - 1;
    }
    return 0 - 1;
  }
  if (tkk == Y_BOOL && (fk == Y_PTR || fk == Y_NULLPTR)) return 2;
  if (tkk == Y_NULLPTR && v != 0 && is_int(from) && v->ci && v->cv == 0 && v->nl) return 2;
  return 0 - 1;
}
int meth_cand[64]; int nmeth_cand = 0;
// Bolum 04: asiri yuklenmis islev adi (v.ovn) hedef islev isaretcisi turune gore secilir
V fnaddr(int f);
int fn_type_of(int f);
V ovl_select(V v, int to) {
  int want = unq(te[to]); int f = 0; int pick = 0 - 1;
  while (f < nfn) { if (fn_cls[f] < 0 && fn_name[f] == v.ovn) { int ft = fn_type_of(f); if (ft == want || (te[ft] == te[want] && fn_sig(ft) == fn_sig(want) && tcl[ft] == tcl[want] && fn_ne(ft) >= fn_ne(want))) pick = f; } f = f + 1; }
  if (pick < 0) die("E_NOVIABLE", "asiri yuklenmis islev: hedef isaretci turune uyan aday yok");
  return fnaddr(pick);
}
void methods_named(int ci, int name) {   // ad gizleme: ilk adi tasiyan sinifin yontemleri
  nmeth_cand = 0; int c = ci;
  while (c >= 0) {
    int f = 0;
    while (f < nfn) { if (fn_cls[f] == c && fn_name[f] == name && nmeth_cand < 64) { meth_cand[nmeth_cand] = f; nmeth_cand = nmeth_cand + 1; } f = f + 1; }
    if (nmeth_cand > 0) return;
    c = cl_base[c];
  }
}
int conv_cands[32]; int nconv = 0;
void conv_funcs_of(int ci) {
  nconv = 0; int c = ci;
  while (c >= 0) {
    int f = 0;
    while (f < nfn) {
      if (fn_cls[f] == c && fn_name[f] == N_CONV) {
        int hidden = 0; int k = 0; while (k < nconv) { if (unq(deref(fn_ret[conv_cands[k]])) == unq(deref(fn_ret[f]))) hidden = 1; k = k + 1; }
        if (hidden == 0 && nconv < 32) { conv_cands[nconv] = f; nconv = nconv + 1; }
      }
      f = f + 1;
    }
    c = cl_base[c];
  }
}
int pick_sub = 0;
int pick_user_conv(int clsT, int to, int allow_expl) {   // donusum islevi ya da -1; belirsizse hata
  to = unq(deref(to)); int best = 0 - 1; int bestr = 99; int amb = 0;
  conv_funcs_of(tcl[unq(clsT)]);
  int n = nconv; int cs[32]; int i = 0; while (i < n) { cs[i] = conv_cands[i]; i = i + 1; }
  i = 0;
  while (i < n) {
    int m = cs[i]; i = i + 1;
    if (fn_has(m, F_EXPL) && allow_expl == 0) continue;
    int rt = unq(deref(fn_ret[m])); int r;
    if (is_cls(rt) || is_cls(to)) { r = 0 - 1; if (rt == to) r = 0; else if (is_cls(rt) && is_cls(to) && derived_from(tcl[rt], tcl[to])) r = 2; }
    else r = std_rank(rt, 0, to);
    if (r < 0) continue;
    if (r < bestr) { best = m; bestr = r; amb = 0; } else if (r == bestr) amb = 1;
  }
  if (amb) die("E_AMBIG", "belirsiz kullanici donusumu");
  pick_sub = bestr; return best;
}
int lam_conv_ok(int au, int pu) {   // yakalamasiz lambda -> islev isaretcisi parametresi
  int ci = tcl[au]; if (cl_lam[ci] == 0 || cl_enc[ci] >= 0 || is_ptr(pu) == 0 || is_fn(unq(te[pu])) == 0) return 0;
  if (cl_lamgen[ci]) return 1;
  if (cl_lamfree[ci] < 0) return 0;
  int ft = fn_type_of(cl_lamfree[ci]); int want = unq(te[pu]);
  return ft == want || (te[ft] == te[want] && fn_sig(ft) == fn_sig(want) && tcl[ft] == tcl[want] && fn_ne(ft) >= fn_ne(want));
}
long long arg_rank(V& a, int P) {   // r*16+t ; -1 gecersiz
  int aty = a.ty; int lv = a.cat == 1;
  if (is_ref(P)) {
    int rr = tk[P] == Y_RREF; int tgt = te[P]; int tu = unq(tgt); int tc = tcv[tgt]; int au = unq(aty); int ac = tcv[aty];
    int exactish = au == tu;
    if (is_cls(au) && is_cls(tu) && derived_from(tcl[au], tcl[tu])) exactish = 1;
    if (is_arr(au) && is_arr(tu) && tn[au] == tn[tu] && unq(te[au]) == unq(te[tu])) exactish = 1;
    if (exactish) {
      if (ac && tc == 0) return 0 - 1;
      long long r0 = 2; if (au == tu) r0 = 0;
      if (rr == 0) {
        if (tc == 0 && lv == 0) return 0 - 1;
        long long t0 = 0; if (tc) t0 = 1; if (lv == 0) t0 = t0 + 2; return r0 * 16 + t0;
      }
      if (lv) return 0 - 1;
      long long t1 = 0; if (tc) t1 = 1; return r0 * 16 + t1;
    }
    if (tc == 0 && rr == 0) return 0 - 1;
    long long r;
    if (is_cls(au)) { int m = pick_user_conv(au, tu, 0); if (m < 0) return 0 - 1; r = 4; }
    else if (is_cls(tu)) return 0 - 1;
    else {
      int src = au; if (is_arr(au)) src = ptrto(te[au]);
      int sr = std_rank(src, &a, tu); if (sr < 0) return 0 - 1; r = sr; if (r < 1) r = 1;
    }
    long long tt = 3; if (rr) { tt = 0; if (tc) tt = 1; }
    return r * 16 + tt;
  }
  int pu = unq(P); int au = unq(aty); if (is_arr(au)) au = ptrto(te[au]);
  if (is_cls(pu) && cl_bi[tcl[pu]] >= 8 && !(is_cls(au) && tcl[au] == tcl[pu])) {   // std::function / move_only_function: cagrilabilirden donusum
    if (tk[au] == Y_NULLPTR || (is_int(au) && a.ci && a.cv == 0)) return 4 * 16;
    if (is_ptr(au) && is_fn(unq(te[au]))) { int ft = cl_fsig[tcl[pu]]; int f2 = unq(te[au]); if (te[f2] == te[ft] && fn_sig(f2) == fn_sig(ft) && tcl[f2] == tcl[ft] && fn_ne(f2) >= fn_ne(ft)) return 4 * 16; if (a.ovn >= 0) return 4 * 16; return 0 - 1; }
    if (is_cls(au) && cl_bi[tcl[au]] == 0) return 4 * 16;
    return 0 - 1;
  }
  if (is_cls(pu)) {
    if (au == pu) return 0;
    if (is_cls(au) && derived_from(tcl[au], tcl[pu])) return 32;
    if (is_cls(au)) { int m = pick_user_conv(au, pu, 0); if (m >= 0) return 64; }
    return 0 - 1;
  }
  if (is_cls(au) && lam_conv_ok(au, pu)) return 4 * 16;
  if (is_cls(au)) { int m = pick_user_conv(au, pu, 0); if (m >= 0) return (4 + pick_sub) * 16; return 0 - 1; }
  int r = std_rank(au, &a, pu); if (r < 0) return 0 - 1; return r * 16;
}
int res_ok[64]; long long res_rk[64 * 9]; int nres_ok = 0;
// aday secimi. self: ortuk nesne (uye) ; dondurur islev, -1 yok, -2 belirsiz
int resolve(int* cands, int nc, V* self, V* args, int na) {
  nres_ok = 0; int ci = 0;
  while (ci < nc) {
    int f = cands[ci]; ci = ci + 1;
    if (na > fn_np[f] && fn_va[f] == 0) continue;
    if (na < fn_np[f] - (allow_def ? fn_ndef[f] : 0)) continue;
    int good = 1; long long rk[9]; int nr = 0;
    if (self != 0 && fn_cls[f] >= 0) {
      int objc = tcv[self->ty]; if (objc && fn_has(f, F_CONST) == 0) continue;
      int su = unq(self->ty); long long r;
      if (is_cls(su) && derived_from(tcl[su], fn_cls[f])) { if (su == clsty(fn_cls[f])) r = 0; else r = 2; } else continue;
      long long t0 = 0; if ((objc != 0) != (fn_has(f, F_CONST) != 0)) t0 = 1;
      rk[nr] = r * 16 + t0; nr = nr + 1;
    } else if (self == 0 && fn_cls[f] >= 0) continue;
    int i = 0;
    while (i < na && i < fn_np[f] && good) { long long a = arg_rank(args[i], fn_pt[f * 8 + i]); if (a < 0) good = 0; else { rk[nr] = a; nr = nr + 1; } i = i + 1; }
    if (good && nres_ok < 64) { res_ok[nres_ok] = f; int k = 0; while (k < 8) { res_rk[nres_ok * 9 + k] = 0; if (k < nr) res_rk[nres_ok * 9 + k] = rk[k]; k = k + 1; } res_rk[nres_ok * 9 + 8] = 8; nres_ok = nres_ok + 1; }
  }
  if (nres_ok == 0) return 0 - 1;
  int i = 0;
  while (i < nres_ok) {
    int isbest = 1; int j = 0;
    while (j < nres_ok && isbest) {
      if (i != j) {
        int allle = 1; int anylt = 0; int k = 0; int n = res_rk[i * 9 + 8];
        while (k < n) { long long x = res_rk[i * 9 + k]; long long y = res_rk[j * 9 + k]; if (x > y) allle = 0; if (x < y) anylt = 1; k = k + 1; }
        if (allle == 0 || anylt == 0) isbest = 0;
      }
      j = j + 1;
    }
    if (isbest) return res_ok[i];
    i = i + 1;
  }
  return 0 - 2;
}
// ============================ CAGRI / DONUSUM UYGULAMASI ============================
int may_throw = 0; int tiname_used = 0;
int exc_on = 0; int pun_on = 0; char ubp[60000];   // programda try var: cagri sonrasi bekleyen istisna denetimi + yazilimsal yayilim (yoksa throw dogrudan terminate=TRAP)
V callfn(int fi, V* self, V* args, int na, int allowvirt);
V gen_coawait_use(int n);
int has_co(int n);
int inline_cand(int fi, V* self, int allowvirt);
V inline_expand(int fi, V* ops, int n);
void exc_check();
void throw_named(const char* nm);
int param_kind(int P) { if (is_ref(P)) return 1; if (is_mem(unq(P))) return 1; return kind_for(P); }
int ret_kind(int rt) { if (is_ref(rt)) return 1; return kind_for(rt); }
void emit_host(const char* nm, V arg) {
  int hid = host_id_byname[intern_c(nm)]; if (hid < 0) die("E_HOST", "host islevi tabloda yok");
  int spec = host_sig[hid * 4 + 1]; arg = adapt(mat(arg), spec, 0);
  w("  host "); w(nm); w(", "); wr(arg.reg); wc(10); note_win(1);
}
int is_void_v(V& v) { return is_void(v.ty); }
V bool_of(V v) {   // skaler rvalue -> bool
  int bt = mkt(Y_BOOL, 0 - 1, 0);
  if (tk[v.ty] == Y_NULLPTR) { return imm(bt, 0); }
  if (is_arith(v.ty)) return convert_arith(v, bt);
  if (v.ci) { return imm(bt, v.cv != 0); }
  V m = mat(v); long long d = newreg(); ins3("ne", d, m, imm(v.ty, 0)); return mkv(bt, 0, d);
}
V lam_to_fnptr(V v, int to);
V to_scalar(V v, int to, int allow_expl) {
  to = unq(to);
  if (is_cls(unq(v.ty)) && cl_lam[tcl[unq(v.ty)]] != 0 && is_ptr(to) && is_fn(unq(te[to]))) return lam_to_fnptr(v, to);   // yakalamasiz lambda -> islev isaretcisi
  if (is_cls(unq(v.ty)) && cl_bi[tcl[unq(v.ty)]] >= 8 && tk[to] == Y_BOOL && allow_expl) return cond_bool(v);   // bool(std::function)
  if (is_cls(unq(v.ty))) {
    int m = pick_user_conv(v.ty, to, allow_expl); if (m < 0) die("E_CONV", "donusum yok");
    V r = callfn(m, &v, 0, 0, 0); v = r;
  }
  v = rval(v);
  if (v.ovn >= 0 && is_ptr(to) && is_fn(unq(te[to]))) v = ovl_select(v, to);
  if (v.ty == to) return v;
  if (is_void(v.ty)) die("E_CONV", "void deger kullanilamaz");
  int r = std_rank(v.ty, &v, to); if (r < 0) die("E_CONV", "ortuk donusum yok");
  if (is_arith(v.ty) && is_arith(to)) return convert_arith(v, to);
  if (tk[to] == Y_BOOL) return bool_of(v);
  if (tk[v.ty] == Y_NULLPTR || (is_int(v.ty) && v.ci)) { V z = imm(to, 0); z.ne = v.ne; return z; }
  v.ty = to; return v;
}
V cond_bool(V v) {
  if (is_cls(unq(v.ty)) && cl_bi[tcl[unq(v.ty)]] >= 8) { long long ob = newreg(); e_ld(ob, 1, v, 1); long long d = newreg(); ins3("ne", d, mkv(0, 0, ob), imm(0, 0)); return mkv(bool_t(), 0, d); }
  if (is_cls(unq(v.ty))) return to_scalar(v, mkt(Y_BOOL, 0 - 1, 0), 1);
  v = rval(v);
  if (is_sc(v.ty) == 0 && tk[v.ty] != Y_NULLPTR) die("E_TYPE", "kosul ifadesi skaler tur olmali");
  return bool_of(v);
}
V fn_make(V v, int ci);
V to_class_value(V v, int to) {
  to = unq(to); int tc = tcl[to];
  if (cl_bi[tc] >= 8 && !(is_cls(unq(v.ty)) && tcl[unq(v.ty)] == tc)) return fn_make(v, tc);
  if (is_cls(unq(v.ty))) {
    int vc = tcl[unq(v.ty)];
    if (vc != tc && is_ord(v.ty) && is_ord(to) && ord_conv_ok(v.ty, to)) { V t = tempobj(to); long long wr_ = newreg(); e_ld(wr_, 0, v, 0); e_st(mkv(0, 0, wr_), t, 0); return t; }
    if (vc == tc) {
      if (v.cat == 0) return v;
      V t = tempobj(to); if (cl_bi[tc] != 0 && cl_bi[tc] < 7) copy_n(t, v, 0, 1); else copy_obj(t, v, tc, 1); merge_eff(t, v); return t;
    }
    if (derived_from(vc, tc)) { V t = tempobj(to); copy_obj(t, v, tc, 1); merge_eff(t, v); return t; }
    int m = pick_user_conv(v.ty, to, 0);
    if (m >= 0) { V r = callfn(m, &v, 0, 0, 0); return to_class_value(r, to); }
  }
  die("E_CONV", "sinif donusumu yok"); return v;
}
V bind_arg(V a, int P) {
  if (a.bp) die("E_REINTERP", "bayt adresli isaretci islev argumani olamaz (calisan islev sozcuk adresli isaretci bekler)");
  if (is_ref(P)) no_bytelv(a);
  if (is_ref(P)) {
    int rr = tk[P] == Y_RREF; int tgt = te[P]; int tu = unq(tgt); int au = unq(a.ty); int tc = tcv[tgt];
    int direct = au == tu;
    if (is_cls(au) && is_cls(tu) && derived_from(tcl[au], tcl[tu])) direct = 1;
    if (is_arr(au) && is_arr(tu) && tn[au] == tn[tu] && unq(te[au]) == unq(te[tu])) direct = 1;
    if (direct && (tcv[a.ty] == 0 || tc)) {
      if (a.cat == 1 && rr) die("E_BIND", "rvalue referansi lvalue'ya baglanamaz");
      if (a.cat != 1 && tc == 0 && rr == 0) die("E_BIND", "const olmayan lvalue referansi rvalue'ya baglanamaz");
      if (a.cat == 0 && is_mem(au) == 0) { V t = tempscalar(au, a); return t; }
      return a;
    }
    if (tc == 0 && rr == 0) die("E_BIND", "const olmayan lvalue referansi icin tur uyumsuz");
    if (is_mem(tu)) { V c = to_mem_value(a, tu); return c; }
    V s = to_scalar(a, tu, 0); return tempscalar(tu, s);
  }
  int pu = unq(P);
  if (is_mem(pu)) { V c = to_mem_value(a, pu); return c; }
  return to_scalar(a, pu, 0);
}
// Bolum 04: degisken sayili arguman paketi. Ekstralar terfilerle (int'ten dar -> int, float -> double) cagiranin cercevesinde bir diziye yazilir; (dizi adresi, sayi) gizli son parametrelerdir.
void pack_va(V* args, int nfix, int na, V* ops, int* no) {
  int nx = na - nfix; int off = slot(nx < 1 ? 1 : nx); V ad = slotaddr(off); int k = 0;
  while (k < nx) {
    V a = rval(args[nfix + k]);
    if (is_cls(unq(a.ty)) || is_ld(unq(a.ty))) die("E_VARARGS", "degisken argumana sinif/uzun ondalik sayi gecirilemez");
    if (is_int(a.ty)) a = convert_arith(a, promote(a.ty)); else if (tk[a.ty] == Y_FLOAT) a = convert_arith(a, mkt(Y_DOUBLE, 0 - 1, 0));
    e_st(mat(a), ad, k); k = k + 1;
  }
  ops[*no] = ad; *no = *no + 1; ops[*no] = imm(mkt(Y_LONG, 0 - 1, 0), nx); *no = *no + 1;
}
// ---- Bolum 04.025: inline islevlerin satir ici acilimi ----
// Kosul: 'inline' + serbest islev + tek 'return ifade;' govdesi + skaler tek sozcuk degerli/parametreli + ozyinelemesiz. Aksi halde normal cagri (inline = baglanti anlami).
int inl_act[1700];
int inl_expr_ok(int n) {
  int k = nk_k[n]; int i = 0;
  if (k == N_INT || k == N_FLT) return nk_s2[n] < 0;
  if (k == N_CHR || k == N_BOOL || k == N_ID) return 1;
  if (k == N_TY) return 1;
  if (k == N_UNARY || k == N_BINARY || k == N_COND || k == N_COMMA || k == N_CALL || k == N_CAST || k == N_INDEX || k == N_SIZEOF_E || k == N_SIZEOF_T || k == N_ALIGNOF || k == N_ASSIGN || k == N_PREINC || k == N_POSTINC || k == N_TPTR) {
    while (i < nk_n[n]) { int c = kid(n, i); if (nk_k[c] == N_NAMEARG || nk_k[c] == N_INITLIST) return 0; if (inl_expr_ok(c) == 0) return 0; i = i + 1; }
    return 1;
  }
  return 0;
}
int inline_cand(int fi, V* self, int allowvirt) {
  if (fn_has(fi, F_INLINE) == 0 || self != 0 || fn_cls[fi] >= 0 || fn_va[fi] || fn_bi[fi] != 0 || inl_act[fi] || inl_depth >= 6 || co_mode || cur_fn < 0) return 0;
  if (fn_has(fi, F_NOEX) && exc_on) return 0;
  if (fn_has(fi, F_DELETE | F_PURE | F_DEFAULT | F_VIRT)) return 0;
  int body = fn_body_node(fi); if (body < 0 || nk_k[body] != N_BLOCK || nk_n[body] != 1) return 0;
  int r = kid(body, 0); if (nk_k[r] != N_RETURN || nk_n[r] != 1) return 0;
  int rt = fn_ret[fi]; if (is_ref(rt) || is_void(rt) || is_sc(rt) == 0 || words_of(rt) != 1 || is_ld(unq(rt))) return 0;
  int i = 0; while (i < fn_np[fi]) { int P = fn_pt[fi * 8 + i]; if (is_ref(P) || is_mem(unq(P)) || is_sc(P) == 0 || words_of(P) != 1 || is_ld(unq(P))) return 0; i = i + 1; }
  return inl_expr_ok(kid(r, 0));
}
V inline_expand(int fi, V* ops, int n) {
  int params = kid(fn_node[fi], 1); int offs[8]; int i = 0; int rt = fn_ret[fi];
  while (i < n) { int P = fn_pt[fi * 8 + i]; int pk = param_kind(P); V m = mat_k(ops[i], pk); int off = slot(1); V ad = slotaddr(off); e_st(m, ad, 0); offs[i] = off; i = i + 1; }
  int s_nv = nvars; int s_lo = var_lo; int s_cls = cur_cls; int s_line = curline;
  var_lo = nvars; cur_cls = 0 - 1; i = 0;
  while (i < n) { vname[nvars] = nk_s1[kid(params, i)]; vty[nvars] = fn_pt[fi * 8 + i]; voff[nvars] = offs[i]; vref[nvars] = 0; vci[nvars] = 0; vuid[nvars] = 0; nvars = nvars + 1; i = i + 1; }
  inl_act[fi] = 1; inl_depth = inl_depth + 1;
  V v = gen(kid(kid(fn_body_node(fi), 0), 0)); V sres = to_scalar(v, unq(rt), 0);
  inl_depth = inl_depth - 1; inl_act[fi] = 0; nvars = s_nv; var_lo = s_lo; cur_cls = s_cls; curline = s_line;
  return sres;
}
V callfn(int fi, V* self, V* args, int na, int allowvirt) {
  int nfix = fn_np[fi];
  if (fn_has(fi, F_DELETE)) die("E_DELETED", "silinmis islev cagrildi");
  if (fn_has(fi, F_PURE) && allowvirt == 0) die("E_PURE", "saf sanal islev dogrudan cagrilamaz");
  int inl = inline_cand(fi, self, allowvirt); if (inl == 0) fn_used[fi] = 1;
  int rt = fn_ret[fi]; int sret = is_mem(unq(rt)) && is_ref(rt) == 0;
  V ops[12]; int no = 0; V out = mkv(0, 0, 0);
  if (sret) { out = tempmem(unq(rt)); ops[no] = out; no = no + 1; }
  if (fn_cls[fi] >= 0) { if (self == 0) die("E_THIS", "uye islev nesnesiz cagrildi"); ops[no] = *self; no = no + 1; }
  int i = 0; while (i < nfix) { ops[no] = bind_arg(args[i], fn_pt[fi * 8 + i]); no = no + 1; i = i + 1; }
  if (inl) { tc_req = 0; return inline_expand(fi, ops, nfix); }   // Bolum 04.025: satir ici acilim
  if (fn_va[fi]) pack_va(args, nfix, na, ops, &no);
  if (fn_has(fi, F_NOEX) == 0) may_throw = 1;
  long long d = newreg(); int isv = is_void(rt);
  if (fn_bi[fi] != 0) {
    if (fn_bi[fi] == 4) { int hid = host_id_byname[intern_c("getc")]; setk(d, 0); w("  host "); wr(d); w(", getc\n"); note_win(1); return mkv(mkt(Y_INT, 0 - 1, 0), 0, d); }
    if (fn_bi[fi] == 5 || fn_bi[fi] == 6) {
      int pf = fn_bi[fi] == 6; long long p = ld_load(ops[0]); long long lo = newreg(); long long hi = newreg(); setk(lo, 1); setk(hi, 1);
      w("  "); wrt(nmw(NM_LO80, pf)); w(" "); wr(lo); w(", "); wr(p); w("\n  "); wrt(nmw(NM_HI80, pf)); w(" "); wr(hi); w(", "); wr(p); wc(10);
      emit_host("puti", mkv(0, 0, lo)); long long sp = e_movi(0, 32); emit_host("putc", mkv(0, 0, sp)); emit_host("puti", mkv(0, 0, hi)); long long nl_ = e_movi(0, 10); emit_host("putc", mkv(0, 0, nl_)); return novalue();
    }
    if (fn_bi[fi] >= 10) {   // Bolum 04.033: korutin tutamaci ic islevleri
      corun_used = 1;
      if (fn_bi[fi] == 15) { e_sti(1, mkv(0, 0, FPID), 3); return novalue(); }   // son askiya alma isareti: done() dogru olur
      V f = cast_k(mat_k(ops[0], 1), 1);
      int okn = newlab(); e_jcc("jnz", f, okn); trapnow(); wl(okn); w(":\n");   // bos tutamac tuzagi
      if (fn_bi[fi] == 13) { long long r13 = e_addi(f, 8); return mkv(ptrto(mkt(Y_VOID, 0 - 1, 0)), 0, r13); }
      if (fn_bi[fi] == 14) { long long r14 = e_addi(f, 0 - 8); return mkv(ptrto(mkt(Y_VOID, 0 - 1, 0)), 0, r14); }
      long long st = newreg(); e_ld(st, 0, f, 0);
      if (fn_bi[fi] == 11) {
        long long d1 = newreg(); ins3("lt", d1, mkv(0, 0, st), imm(0, 0)); long long fl = newreg(); e_ld(fl, 0, f, 3);
        long long d2 = newreg(); ins3("ne", d2, mkv(0, 0, fl), imm(0, 0));
        V orv = binop("|", mkv(bool_t(), 0, d1), mkv(bool_t(), 0, d2)); return to_scalar(orv, bool_t(), 0);
      }
      if (fn_bi[fi] == 12) {   // destroy: iki kez yok etme tuzaktir
        long long t2 = newreg(); ins3("eq", t2, mkv(0, 0, st), imm(0, 0 - 2)); int ok2 = newlab(); e_jcc("jz", mkv(0, 0, t2), ok2); trapnow(); wl(ok2); w(":\n");
        e_sti(0 - 2, f, 0); return novalue();
      }
      // resume: bitmis / yok edilmis / son askiya alma noktasindaki korutini surdurmek tuzaktir
      long long lt0 = newreg(); ins3("lt", lt0, mkv(0, 0, st), imm(0, 0)); int ok3 = newlab(); e_jcc("jz", mkv(0, 0, lt0), ok3); trapnow(); wl(ok3); w(":\n");
      long long fl2 = newreg(); e_ld(fl2, 0, f, 3); int ok4 = newlab(); e_jcc("jz", mkv(0, 0, fl2), ok4); trapnow(); wl(ok4); w(":\n");
      long long rr = newreg(); setk(rr, 0); w("  call "); wr(rr); w(", corun, "); wr(f.reg); wc(10); note_win(1); may_throw = 1; if (exc_on) exc_check();
      return novalue();
    }
    V a0 = mat(ops[0]);
    if (fn_bi[fi] == 1) emit_host("puti", a0); if (fn_bi[fi] == 2) emit_host("putc", a0); if (fn_bi[fi] == 3) emit_host("putf", a0);
    return novalue();
  }
  int virt = fn_has(fi, F_VIRT) && allowvirt && self != 0 && fn_cls[fi] >= 0;
  { int pi_ = 0; if (sret) { ops[pi_] = cast_k(mat_k(ops[pi_], 1), 1); pi_ = pi_ + 1; } if (fn_cls[fi] >= 0) { ops[pi_] = cast_k(mat_k(ops[pi_], 1), 1); pi_ = pi_ + 1; }
    int q = 0; while (q < nfix) { int pk = param_kind(fn_pt[fi * 8 + q]); ops[pi_] = cast_k(mat_k(ops[pi_], pk), pk); pi_ = pi_ + 1; q = q + 1; }
    if (fn_va[fi]) { ops[pi_] = cast_k(mat_k(ops[pi_], 1), 1); pi_ = pi_ + 1; ops[pi_] = cast_k(mat_k(ops[pi_], 0), 0); pi_ = pi_ + 1; } }
  if (isv == 0 && sret == 0) setk(d, ret_kind(rt));
  if (tc_req) {   // Bolum 04: kuyruk cagrisi -- return f(args); : cagiranin cercevesi serbest birakilir, argumanlar cerceve tabanina tasinir, ayni cerceve f'e devredilir (tcall)
    tc_req = 0; int okt = (has_alloca == 0 && sret == 0 && fn_va[fi] == 0 && self == 0 && try_depth == 0 && nhs == 0 && co_mode == 0 && cur_fn >= 0 && is_ref(rt) == 0 && is_ref(fn_ret[cur_fn]) == 0 && unq(rt) == unq(fn_ret[cur_fn]) && is_mem(unq(rt)) == 0);
    if (okt && fn_has(cur_fn, F_NOEX) && fn_has(fi, F_NOEX) == 0) okt = 0;
    int q2 = 0; while (q2 < nfix && okt) { int P = fn_pt[fi * 8 + q2]; if (is_ref(P) || is_mem(unq(P)) || is_ptr(unq(P)) || is_cls(unq(P))) { if (!(is_ptr(unq(P)) && args[q2].ci && args[q2].cv == 0)) okt = 0; } q2 = q2 + 1; }
    if (okt) {
      long long ts = newreg(); setk(ts, 1); w("  mov "); wr(ts); w(", __sp\n"); e_st(mkv(0, 0, FPID), mkv(0, 0, ts), 0);
      w("  tcall "); if (virt) { w("vd"); wn(fn_vroot[fi]); } else { w("f"); wn(fi); }
      i = 0; while (i < no) { w(", "); wr(ops[i].reg); i = i + 1; }
      wc(10); note_win(no); tc_done = 1; return novalue();
    }
  }
  w("  call "); if (isv == 0 && sret == 0) { wr(d); w(", "); }
  if (virt) { w("vd"); wn(fn_vroot[fi]); } else { w("f"); wn(fi); }
  i = 0; while (i < no) { w(", "); wr(ops[i].reg); i = i + 1; }
  wc(10); note_win(no);
  if (exc_on && fn_has(fi, F_NOEX) == 0) exc_check();
  V res = mkv(0, 0, 0);
  i = 0; while (i < na) { merge_eff(res, args[i]); i = i + 1; }
  if (self != 0) merge_eff(res, *self);
  if (isv) { res.ty = Y_VOID; res.reg = 0 - 2; return res; }
  if (sret) { out.ne = res.ne; i = 0; while (i < res.ne) { out.ek[i] = res.ek[i]; out.er[i] = res.er[i]; i = i + 1; } return out; }
  if (is_ref(rt)) { res.ty = te[rt]; res.cat = 1; if (tk[rt] == Y_RREF) res.cat = 2; res.reg = d; res.vp = 1; return res; }
  res.ty = unq(rt); res.cat = 0; res.reg = d;
  return res;
}
// kullanici operatoru: ops[0..no); sonuc.ty = -1 ise yok
V noV() { V v = mkv(0 - 1, 0, 0); return v; }
V attempt_op(int name, V* o, int no) {
  int mc[64]; int nmc = 0; int fc[64]; int nfc = 0;
  if (is_cls(unq(o[0].ty))) { methods_named(tcl[unq(o[0].ty)], name); nmc = nmeth_cand; int k = 0; while (k < nmc) { mc[k] = meth_cand[k]; k = k + 1; } }
  int f = 0; while (f < nfn) { if (fn_cls[f] < 0 && fn_name[f] == name && nfc < 64) { fc[nfc] = f; nfc = nfc + 1; } f = f + 1; }
  int mr = 0 - 1; int fr = 0 - 1;
  if (nmc > 0) mr = resolve(mc, nmc, &o[0], &o[1], no - 1);
  if (nfc > 0) fr = resolve(fc, nfc, 0, o, no);
  if (mr == 0 - 2 || fr == 0 - 2) die("E_AMBIG", "belirsiz operator cagrisi");
  if (mr >= 0 && fr >= 0) die("E_AMBIG", "uye ve serbest operator ayni derecede uygun");
  if (mr >= 0) return callfn(mr, &o[0], &o[1], no - 1, 1);
  if (fr >= 0) return callfn(fr, 0, o, no, 0);
  return noV();
}
V user_op(int name, V* o, int no, int allow_rev) {
  V r = attempt_op(name, o, no);
  if (r.ty >= 0) return r;
  if (allow_rev && no == 2) { V rv[2]; rv[0] = o[1]; rv[1] = o[0]; return attempt_op(name, rv, 2); }
  return noV();
}
// ============================ OPERATORLER (kurallar tablodan) ============================
int seq_rt_c(int p, const char* t) {
  int n = 0; while (t[n]) n = n + 1;
  if (n != rt_len(p)) return 0;
  int i = 0; while (i < n) { if (RT[p + 1 + i] != t[i]) return 0; i = i + 1; }
  return 1;
}
int streq(const char* a, const char* b) { int i = 0; while (a[i] && b[i] && a[i] == b[i]) i = i + 1; return a[i] == 0 && b[i] == 0; }
int find_rule(int cls, const char* tok) {
  int r = 0;
  while (r < nrec) { if (RT[rec_off[r]] == cls && seq_rt_c(rstr_pos(r, 0), tok)) return r; r = r + 1; }
  return 0 - 1;
}
char tokbuf[64];
void settok(int sid) { int i = 0; while (i < s_len[sid] && i < 62) { tokbuf[i] = chars[s_off[sid] + i]; i = i + 1; } tokbuf[i] = 0; }
int bool_t() { return mkt(Y_BOOL, 0 - 1, 0); }
V arith(int rule, V l, V r, int t) {
  int kind = rnum(rule, 0); int when = rnum(rule, 1); int needn = rnum(rule, 2);
  int pi_ = rstr_pos(rule, 1); int pu = rstr_pos(rule, 2); int pf = rstr_pos(rule, 3);
  long long d = newreg();
  if (is_flt(t)) { if (rt_len(pf) == 0) die("E_TYPE", "operator kayan nokta turunde tanimli degil"); ins3t(pf, d, l, r); return norm(mkv(t, 0, d), t); }
  int p = pi_;
  if (when == 1 && uns64(t)) p = pu;
  if (when == 2 && sg_of(t) == 0) p = pu;
  if (kind == 2) { l = mat(l); r = mat(r); }
  ins3t(p, d, l, r);
  V o = mkv(t, 0, d);
  if (needn) return norm(o, t);
  return o;
}
V compare(int rule, V l, V r, int t) {
  int sw_u = rnum(rule, 0); int sw_f = rnum(rule, 1); int inv_f = rnum(rule, 2);
  long long d = newreg(); int bt = bool_t();
  if (is_flt(t)) {
    if (sw_f) { V x = l; l = r; r = x; }
    if (inv_f) { long long t1 = newreg(); ins3t(rstr_pos(rule, 3), t1, l, r); ins3("eq", d, mkv(t, 0, t1), imm(bt, 0)); return mkv(bt, 0, d); }
    ins3t(rstr_pos(rule, 3), d, l, r); return mkv(bt, 0, d);
  }
  int p = rstr_pos(rule, 1);
  if (uns64(t) || is_ptr(t)) { p = rstr_pos(rule, 2); if (sw_u) { V x = l; l = r; r = x; } }
  else if (rnum(rule, 4)) { V x = l; l = r; r = x; }
  l = mat(l);
  ins3t(p, d, l, r);
  return mkv(bt, 0, d);
}
V byte_lv(V p, V idx, int et) {   // bayt adresli isaretci (p.bp = asil nesne boyutu S): p+idx baytinin sozcuk adresi ve sozcuk icindeki kaydirma
  et = unq(et); if (is_int(et) == 0 || tk[et] == Y_BOOL || size_of(et) != 1) die("E_REINTERP", "bayt adresli isaretci yalniz 1 baytlik tamsayi turuyle kullanilabilir");
  long long S = p.bp; V pi_ = cast_k(mat(p), 0); V ii = cast_k(mat_k(convert_arith(idx, mkt(Y_LONG, 0 - 1, 0)), 0), 0);
  long long p2 = newreg(); ins3("add", p2, pi_, ii); long long wd = newreg(); ins3("div", wd, mkv(0, 0, p2), imm(0, S));
  long long ky = newreg(); ins3("mod", ky, mkv(0, 0, p2), imm(0, S)); long long sh = newreg(); ins3("shl", sh, mkv(0, 0, ky), imm(0, 3));
  V a = cast_k(mkv(0, 0, wd), 1); V r = mkv(et, 1, a.reg); r.bks = S; r.bkr = sh; r.vp = 1; return r;
}
void no_bytelv(V v) { if (v.bks) die("E_REINTERP", "bayt gorunumu: bu islem (bilesik atama, ++/--, adres alma, referansa baglama) desteklenmiyor; yalniz okuma ve '=' atamasi"); }
V ptradd(V p, V i, int neg) {
  int et = te[p.ty]; if (complete_obj(et) == 0) die("E_PTRARITH", "tamamlanmamis/void turde isaretci aritmetigi");
  i = convert_arith(rval(i), mkt(Y_LONG, 0 - 1, 0));
  long long wd = words_of(et); V off = i;
  if (wd != 1) { long long t1 = newreg(); ins3("mul", t1, mat(i), imm(i.ty, wd)); off = mkv(i.ty, 0, t1); }
  long long d = newreg(); if (neg) ins3("sub", d, mat(p), off); else ins3("add", d, mat(p), off);
  V rr = mkv(p.ty, 0, d); rr.bp = p.bp; return rr;
}
V ord_obj(int kind, V val) { int c = find_class(intern_c(kind == 1 ? "std::strong_ordering" : kind == 2 ? "std::weak_ordering" : "std::partial_ordering")); V t = tempobj(clsty(c)); e_st(mat(val), t, 0); return t; }
V ord_cmp_zero(const char* op, V ord) {
  long long v = newreg(); e_ld(v, 0, ord, 0); long long d = newreg(); V vv = mkv(0, 0, v);
  if (streq(op, "<")) ins3("eq", d, vv, imm(0, 0 - 1)); else if (streq(op, "<=")) ins3("le", d, vv, imm(0, 0));
  else if (streq(op, ">")) ins3("eq", d, vv, imm(0, 1)); else if (streq(op, ">=")) ins3("ltu", d, vv, imm(0, 2));
  else if (streq(op, "==")) ins3("eq", d, vv, imm(0, 0)); else if (streq(op, "!=")) ins3("ne", d, vv, imm(0, 0));
  else die("E_OP", "siralama nesnesi icin gecersiz islec");
  V r = mkv(bool_t(), 0, d); merge_eff(r, ord); return r;
}
V builtin_spaceship(V l, V r) {
  int t;
  if (is_arith(l.ty) && is_arith(r.ty)) t = uac(l.ty, r.ty);
  else if (is_ptr(l.ty) || is_ptr(r.ty) || tk[l.ty] == Y_NULLPTR || tk[r.ty] == Y_NULLPTR) {
