  { w("func fpnul(p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11) {\n  halt\n}\n"); pm_begin(0); int z_ = 0; while (z_ < 12) { pm_add(1); z_ = z_ + 1; } pm_end(); }   // 0. islev: imzasi hicbir prototipe uymaz -> bos isaretci cagrisi OOB if (exc_on) w("data __ex = 0\ndata __exo = 0\ndata __cx = 0\ndata __cxo = 0\n");
