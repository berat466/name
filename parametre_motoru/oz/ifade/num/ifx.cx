// ifx -- PMX1 SAYISAL IFADE DERLEYICISI (cekirdek).  Bu dosya ifx.pmb'nin GELISTIRME GORUNUMUDUR: kanonik urun ifx.pmb (sayisal program) ve
// komutlar.pmk bolum 12 (IFADE KURAL TABLOSU)'dur. ifx.pmb calisma aninda stdin'den SAYI akisi okur:  <komutlar.pmk sayilari> <PMX1 sayilari>
// ve PMA metnini stdout'a yazar. Tur ozellikleri, operator->komut eslemesi, normallestirme/donusum komut adlari TABLODAN okunur (bu kodda sabit degil).
// Desteklenen cekirdek: skaler/isaretci/dizi, tum tekli/ikili/atama/?:/virgul/++/--, static_cast/C tipi donusum, sizeof, cagri, if/while/do/for/return/break/continue.
// Desteklenmeyen dugum (sinif, referans, dize, UDL ...) AYRIK hata verir ("@@HATA desteklenmiyor"): sessizce yanlis kod uretilmez.
const int NN = 40000;
const int NK = 120000;
const int NC = 120000;
const int NR = 20000;
long long RT[NR]; int nrt = 0;
// ---- PMX1 ----
int nk_line[NN]; int nk_k[NN]; long long nk_i[NN], nk_j[NN], nk_d[NN]; int nk_s1[NN], nk_s2[NN], nk_n[NN], nk_ks[NN]; int kids[NK]; int nkids = 0;
int s_off[4000], s_len[4000]; char chars[NC]; int nchars = 0; int nstr = 0; int nnodes = 0; int root = 0;
// ---- dizge havuzu: PMX1 dizgeleri + derleyicinin kendi adlari ayni havuzda, esitlik = kimlik esitligi ----
int intern_n(const char* t, int n) {
  int i = 0;
  while (i < nstr) { if (s_len[i] == n) { int j = 0; while (j < n && chars[s_off[i] + j] == t[j]) j = j + 1; if (j == n) return i; } i = i + 1; }
  s_off[nstr] = nchars; s_len[nstr] = n; int j = 0; while (j < n) { chars[nchars] = t[j]; nchars = nchars + 1; j = j + 1; }
  nstr = nstr + 1; return nstr - 1;
}
int intern_c(const char* t) { int n = 0; while (t[n]) n = n + 1; return intern_n(t, n); }
char tmpb[256];
int intern_buf(int n) { return intern_n(tmpb, n); }
// ---- temel cikti ----
int dry = 0; int nreg = 0; int nlab = 0; int foff = 0;
void wc(int c) { if (dry == 0) __putc(c); }
void w(const char* s) { while (*s) { wc(*s); s++; } }
void wn(long long v) { if (dry == 0) __puti(v); }
int npair = 0;
void wr(long long r) {
  if (r >= 100000) { long long k = (r - 100000) / 2; w("q"); wn(k); if ((r - 100000) % 2) w("h"); return; }
  w("t"); wn(r);
}
void wl(long long l) { w("L"); wn(l); }
void wstr(int sid) { int i = 0; while (i < s_len[sid]) { wc(chars[s_off[sid] + i]); i = i + 1; } }
int curline = 0;
void die(const char* kod, const char* m) { dry = 0; w("@@HATA "); w(kod); w(" satir "); wn(curline); w(": "); w(m); wc(10); long long* p = 0; p = p - 1; long long z = *p; wn(z); }

void die1(const char* m) { die("E_GIRDI", m); }
// ---- girdi ----
int rdc() { return __getc(); }
long long rd() {
  int c = rdc();
  while (c == ' ' || c == 10 || c == 9 || c == 13) c = rdc();
  if (c < 0) { die1("girdi erken bitti"); }
  int neg = 0;
  if (c == '-') { neg = 1; c = rdc(); }
  long long v = 0;
  while (c >= '0' && c <= '9') { v = v * 10 + (c - '0'); c = rdc(); }
  if (neg) return 0 - v;
  return v;
}
// ---- kural tablosu (PMK1 bolum 12) ----
// yuk: nrec ; kayit: sinif nstr (len chars...)*nstr nnum nums*nnum   (sinif 1 TUR, 2 IKILI, 3 KARSILASTIRMA, 4 AD)
int rec_off[400]; int nrec = 0;
long long ty_bits[32], ty_sg[32], ty_cls[32], ty_rank[32]; long long ty_norm[32]; int ty_ok[32];
long long names[64];
int rstr_pos(int r, int idx) {   // kaydin idx. dizgesinin RT'deki konumu (uzunluk sozcugu)
  int p = rec_off[r]; p = p + 1; int ns = RT[p]; p = p + 1;
  int i = 0;
  while (i < idx) { p = p + 1 + RT[p]; i = i + 1; }
  return p;
}
long long rnum(int r, int idx) {
  int p = rec_off[r]; p = p + 1; int ns = RT[p]; p = p + 1;
  int i = 0;
  while (i < ns) { p = p + 1 + RT[p]; i = i + 1; }
  return RT[p + 1 + idx];
}
void wrt(int p) { int n = RT[p]; int i = 0; while (i < n) { wc(RT[p + 1 + i]); i = i + 1; } }
int rt_len(int p) { return RT[p]; }
int slen(int sid) { if (sid < 0) return 0; return s_len[sid]; }
int soff(int sid) { if (sid < 0) return 0; return s_off[sid]; }
int seq_rt_pool(int sid, int p) {   // PMX1 dizgesi == tablo dizgesi
  if (sid < 0) return rt_len(p) == 0;
  if (s_len[sid] != rt_len(p)) return 0;
  int i = 0;
  while (i < s_len[sid]) { if (chars[s_off[sid] + i] != RT[p + 1 + i]) return 0; i = i + 1; }
  return 1;
}
int seqc(int sid, const char* t) {
  if (sid < 0) return 0;
  int n = 0; while (t[n]) n = n + 1;
  if (n != s_len[sid]) return 0;
  int i = 0; while (i < n) { if (chars[s_off[sid] + i] != t[i]) return 0; i = i + 1; }
  return 1;
}
void load_rules() {
  int p = 0; nrec = RT[p]; p = p + 1;
  int r = 0;
  while (r < nrec) {
    rec_off[r] = p;
    int cls = RT[p]; int ns = RT[p + 1]; int q = p + 2; int i = 0;
    while (i < ns) { q = q + 1 + RT[q]; i = i + 1; }
    int nn = RT[q]; q = q + 1 + nn; p = q; r = r + 1;
  }
  r = 0;
  while (r < nrec) {
    int cls = RT[rec_off[r]];
    if (cls == 1) {
      int tc = rnum(r, 0);
      ty_ok[tc] = 1; ty_bits[tc] = rnum(r, 1); ty_sg[tc] = rnum(r, 2); ty_cls[tc] = rnum(r, 3); ty_rank[tc] = rnum(r, 4);
      ty_norm[tc] = rstr_pos(r, 1);
    }
    if (cls == 4) { int i = 0; while (i < 40) { names[i] = rstr_pos(r, i); i = i + 1; } }
    r = r + 1;
  }
}
const int NM_ADD80 = 9; const int NM_SUB80 = 10; const int NM_MUL80 = 11; const int NM_DIV80 = 12; const int NM_NEG80 = 13; const int NM_EQ80 = 14; const int NM_LT80 = 15; const int NM_LE80 = 16; const int NM_NE80 = 17; const int NM_TOB80 = 18; const int NM_F64TO80 = 19; const int NM_80TOF64 = 20; const int NM_80TOF32 = 21; const int NM_I64TO80 = 22; const int NM_U64TO80 = 23; const int NM_80TOI64 = 24; const int NM_80TOU64 = 25; const int NM_PACK80 = 26; const int NM_LO80 = 27; const int NM_HI80 = 28;
const int NM_I2F = 0; const int NM_U2F = 1; const int NM_F2I = 2; const int NM_F2U = 3; const int NM_RND = 4; const int NM_NEG = 5; const int NM_FNEG = 6; const int NM_NOT = 7; const int NM_FEQ = 8;

// ============================ TURLER ============================
const int Y_VOID = 0; const int Y_BOOL = 1; const int Y_CHAR = 2; const int Y_UCHAR = 4; const int Y_INT = 7; const int Y_UINT = 8; const int Y_LONG = 9; const int Y_ULONG = 10; const int Y_ULLONG = 12;
const int Y_FLOAT = 13; const int Y_DOUBLE = 14; const int Y_LDOUBLE = 15; const int Y_NULLPTR = 16; const int Y_PTR = 17; const int Y_REF = 18; const int Y_RREF = 19; const int Y_ARR = 20; const int Y_CLASS = 21; const int Y_AUTO = 22;
int tk[1500]; int te[1500]; long long tn[1500]; int tcl[1500]; int tcv[1500]; int nty = 0;
int mk2(int k, int e, long long n, int cls, int c) {
  int i = 0;
  while (i < nty) { if (tk[i] == k && te[i] == e && tn[i] == n && tcl[i] == cls && tcv[i] == c) return i; i = i + 1; }
  if (nty >= 1500) die("E_SINIR", "cok fazla tur");
  tk[nty] = k; te[nty] = e; tn[nty] = n; tcl[nty] = cls; tcv[nty] = c; nty = nty + 1; return nty - 1;
}
int mkt(int k, int e, long long n) { return mk2(k, e, n, 0 - 1, 0); }
int unq(int t) { if (tcv[t] == 0) return t; return mk2(tk[t], te[t], tn[t], tcl[t], 0); }
int withc(int t, int c) { return mk2(tk[t], te[t], tn[t], tcl[t], c); }
int ptrto(int t) { return mk2(Y_PTR, t, 0, 0 - 1, 0); }
int lref(int t) { return mk2(Y_REF, t, 0, 0 - 1, 0); }
int rref(int t) { return mk2(Y_RREF, t, 0, 0 - 1, 0); }
int arrof(int t, long long n) { return mk2(Y_ARR, t, n, 0 - 1, 0); }
int clsty(int c) { return mk2(Y_CLASS, 0 - 1, 0, c, 0); }
int is_int(int t) { return tk[t] >= 1 && tk[t] <= 12; }
int is_flt(int t) { return tk[t] == 13 || tk[t] == 14; }
int is_ptr(int t) { return tk[t] == 17; }
int is_arr(int t) { return tk[t] == 20; }
int is_cls(int t) { return tk[t] == 21; }
int is_ref(int t) { return tk[t] == 18 || tk[t] == 19; }
int is_ld(int t) { return tk[t] == 15; }
int is_arith(int t) { return is_int(t) || is_flt(t) || tk[t] == 15; }
int is_sc(int t) { return is_int(t) || is_flt(t) || is_ptr(t) || tk[t] == 15; }
int is_void(int t) { return tk[t] == 0; }
int deref(int t) { if (is_ref(t)) return te[t]; return t; }
int bits_of(int t) { if (is_ptr(t)) return 64; return ty_bits[tk[t]]; }
int sg_of(int t) { if (is_ptr(t)) return 0; return ty_sg[tk[t]]; }
int rank_of(int t) { return ty_rank[tk[t]]; }
int uns64(int t) { return is_int(t) && sg_of(t) == 0 && bits_of(t) == 64; }
// ============================ SINIFLAR ============================
const int NCL = 200;
int cl_name[NCL]; int cl_base[NCL]; int cl_poly[NCL]; int cl_def[NCL]; int cl_id[NCL]; long long cl_words[NCL]; long long cl_size[NCL]; long long cl_align[NCL]; long long cl_dsize[NCL]; int cl_pod[NCL]; int cl_bi[NCL];
int cl_f0[NCL]; int cl_nf[NCL]; int ncl = 0;
int fl_name[4000]; int fl_ty[4000]; long long fl_woff[4000]; long long fl_boff[4000]; int nfl = 0;
int newclass(int name) {
  cl_name[ncl] = name; cl_base[ncl] = 0 - 1; cl_poly[ncl] = 0; cl_def[ncl] = 0; cl_id[ncl] = ncl + 1; cl_words[ncl] = 0; cl_size[ncl] = 1; cl_align[ncl] = 1; cl_dsize[ncl] = 0; cl_pod[ncl] = 1; cl_bi[ncl] = 0;
  cl_f0[ncl] = nfl; cl_nf[ncl] = 0; ncl = ncl + 1; return ncl - 1;
}
int find_class(int name) { int i = 0; while (i < ncl) { if (cl_name[i] == name) return i; i = i + 1; } return 0 - 1; }
int derived_from(int d, int b) { int c = d; while (c >= 0) { if (c == b) return 1; c = cl_base[c]; } return 0; }
long long size_of(int t);
long long align_of(int t);
long long words_of(int t) {
  if (is_arr(t)) return tn[t] * words_of(te[t]);
  if (is_cls(t)) return cl_words[tcl[t]];
  if (is_void(t)) return 0;
  if (tk[t] == 15) return 2;
  return 1;
}
long long size_of(int t) {
  if (is_ref(t)) return size_of(te[t]);
  if (is_arr(t)) return tn[t] * size_of(te[t]);
  if (is_ptr(t) || tk[t] == Y_NULLPTR) return 8;
  if (is_cls(t)) return cl_size[tcl[t]];
  if (is_void(t)) die("E_SIZEOF", "void boyutu yok");
  return ty_bits[tk[t]] / 8;
}
long long align_of(int t) {
  if (is_ref(t)) return align_of(te[t]);
  if (is_arr(t)) return align_of(te[t]);
  if (is_cls(t)) return cl_align[tcl[t]];
  if (tk[t] == Y_LDOUBLE) return 16;
  return size_of(t);
}
int complete_obj(int t) {
  if (is_void(t)) return 0;
  if (is_cls(t)) return cl_def[tcl[t]];
  if (is_arr(t)) return complete_obj(te[t]);
  return 1;
}
// Itanium ABI sinif dizilimi (alan dizilimi + vptr + taban + EBO + kuyruk dolgusu)
void layout_class(int ci) {
  long long off = 0; long long al = 1; long long wd = 0; int b = cl_base[ci];
  if (b >= 0) {
    if (cl_poly[b]) cl_poly[ci] = 1;
    int bempty = cl_poly[b] == 0 && cl_base[b] < 0 && cl_nf[b] == 0;
    if (bempty == 0) { if (cl_pod[b]) off = cl_size[b]; else off = cl_dsize[b]; al = cl_align[b]; wd = cl_words[b]; }
  }
  if (cl_poly[ci] && (b < 0 || cl_poly[b] == 0)) {
    if (b >= 0 && wd > 0) die("E_SINIF", "polimorfik olmayan tabani olan sinifa sanal islev eklenemez");
    off = 8; al = 8; wd = 1;
  }
  int i = cl_f0[ci]; int e = cl_f0[ci] + cl_nf[ci];
  while (i < e) {
    int ft = fl_ty[i];
    if (is_ref(ft)) die("E_TYPE", "referans uye desteklenmiyor");
    if (complete_obj(ft) == 0) die("E_TYPE", "uye turu tam degil");
    long long fa = align_of(ft); off = (off + fa - 1) / fa * fa; fl_boff[i] = off; off = off + size_of(ft);
    fl_woff[i] = wd; wd = wd + words_of(ft); if (fa > al) al = fa; i = i + 1;
  }
  cl_dsize[ci] = off; cl_align[ci] = al; long long sz = (off + al - 1) / al * al; if (sz < 1) sz = 1; cl_size[ci] = sz;
  if (b >= 0 && cl_poly[ci] == 0 && cl_nf[ci] == 0 && cl_poly[b] == 0 && cl_nf[b] == 0 && cl_size[b] == 1) cl_size[ci] = 1;
  cl_words[ci] = wd; cl_pod[ci] = 0; if (b < 0 && cl_poly[ci] == 0) cl_pod[ci] = 1; cl_def[ci] = 1;
}
// alan arama (taban zinciri dahil): sinif idx, woff, ty doner (-1 yok)
long long fq_woff = 0; int fq_ty = 0; long long fq_boff = 0;
int find_field(int ci, int name) {
  int c = ci;
  while (c >= 0) {
    int i = cl_f0[c]; int e = cl_f0[c] + cl_nf[c];
    while (i < e) { if (fl_name[i] == name) { fq_woff = fl_woff[i]; fq_ty = fl_ty[i]; fq_boff = fl_boff[i]; return c; } i = i + 1; }
    c = cl_base[c];
  }
  return 0 - 1;
}
int is_ord(int t) { t = unq(deref(t)); if (!is_cls(t)) return 0; int b = cl_bi[tcl[t]]; return b >= 1 && b <= 3; }
int ord_conv_ok(int from, int to) { int a = cl_bi[tcl[unq(from)]]; int b = cl_bi[tcl[unq(to)]]; return a >= 1 && a <= 3 && b >= 1 && b <= 3 && a <= b; }
// ============================ ISLEVLER ============================
const int NF = 800;
int fn_name[NF]; int fn_cls[NF]; int fn_ret[NF]; int fn_np[NF]; int fn_pt[NF * 8]; int fn_fl[NF]; int fn_node[NF]; int fn_bi[NF]; int fn_vroot[NF]; int fn_used[NF]; int fn_gen[NF]; int nfn = 0; int fn_line[NF];
const int F_CONST = 1; const int F_VIRT = 2; const int F_NOEX = 4; const int F_DEFAULT = 16; const int F_OVR = 32; const int F_DELETE = 64; const int F_EXPL = 128; const int F_PURE = 256;
int fn_has(int f, int bit) { return (fn_fl[f] & bit) != 0; }
// ============================ DEGER / UretIM ============================
const int NEF = 8;
struct V { long long ty; long long cat; long long reg; long long ci; long long cv; long long key; long long nl; long long vp; long long ne; long long ek[8]; long long er[8]; };
V mkv(long long ty, long long cat, long long reg) { V v; v.ty = ty; v.cat = cat; v.reg = reg; v.ci = 0; v.cv = 0; v.key = 0; v.nl = 0; v.vp = 0; v.ne = 0; return v; }
V imm(long long ty, long long val) { V v = mkv(ty, 0, 0 - 1); v.ci = 1; v.cv = val; return v; }
V novalue() { return mkv(Y_VOID, 0, 0 - 2); }
void add_eff(V& v, long long key, long long rw) { if (key == 0) return; if (v.ne < NEF) { v.ek[v.ne] = key; v.er[v.ne] = rw; v.ne = v.ne + 1; } }
void merge_eff(V& v, V& o) { int i = 0; while (i < o.ne) { add_eff(v, o.ek[i], o.er[i]); i = i + 1; } }
int unseq_bad(V& a, V& b) {
  int i = 0;
  while (i < a.ne + 1) {
    long long ka = 0; long long ra = 0;
    if (i < a.ne) { ka = a.ek[i]; ra = a.er[i]; } else if (a.cat == 1 && a.key != 0 && a.ty >= 0) { ka = a.key; ra = 1; }
    int j = 0;
    while (ka != 0 && j < b.ne + 1) {
      long long kb = 0; long long rb = 0;
      if (j < b.ne) { kb = b.ek[j]; rb = b.er[j]; } else if (b.cat == 1 && b.key != 0 && b.ty >= 0) { kb = b.key; rb = 1; }
      if (kb == ka && (ra == 2 || rb == 2)) return 1;
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}
long long newreg() { nreg = nreg + 1; return nreg - 1; }
void opr(V v) { if (v.reg < 0) wn(v.cv); else wr(v.reg); }
void ins2(const char* op, long long d, V a) { w("  "); w(op); w(" "); wr(d); w(", "); opr(a); wc(10); }
void ins3(const char* op, long long d, V a, V b) { w("  "); w(op); w(" "); wr(d); w(", "); opr(a); w(", "); opr(b); wc(10); }
void ins2t(int nm, long long d, V a) { w("  "); wrt(nm); w(" "); wr(d); w(", "); opr(a); wc(10); }
void ins3t(int nm, long long d, V a, V b) { w("  "); wrt(nm); w(" "); wr(d); w(", "); opr(a); w(", "); opr(b); wc(10); }
V mat(V v) { if (v.reg >= 0) return v; long long r = newreg(); w("  mov "); wr(r); w(", "); wn(v.cv); wc(10); V o = v; o.reg = r; o.ci = 0; return o; }
long long ndat = 0; long long dat[2000];
V fconst(int ty, long long bits) {
  dat[ndat] = bits; ndat = ndat + 1; long long a = newreg(); long long r = newreg();
  w("  mov "); wr(a); w(", d"); wn(ndat - 1); wc(10); w("  ld "); wr(r); w(", "); wr(a); w(", 0\n"); return mkv(ty, 0, r);
}
void trapnow() { long long r = newreg(); w("  ld "); wr(r); w(", -1, 0\n"); }
int newlab() { nlab = nlab + 1; return nlab - 1; }
void nullchk(V p) {
  if (dry) return;
  if (p.ci && p.cv == 0) { trapnow(); return; }
  int ok = newlab(); V m = mat(p); w("  jnz "); wr(m.reg); w(", "); wl(ok); wc(10); trapnow(); wl(ok); w(":\n");
}
int slot(long long wd) { int o = foff; foff = foff + wd; if (wd < 1) foff = o + 1; return o; }
V slotaddr(int off) { long long r = newreg(); w("  add "); wr(r); w(", fp, "); wn(off); wc(10); return mkv(0, 1, r); }
void zero_n(V dst, long long n) {
  long long i = 0;
  if (n <= 8) { while (i < n) { w("  st 0, "); opr(dst); w(", "); wn(i); wc(10); i = i + 1; } return; }
  long long ri = newreg(); long long rp = newreg(); long long rc = newreg(); int top = newlab(); int end = newlab();
  w("  mov "); wr(ri); w(", 0\n  mov "); wr(rp); w(", "); opr(dst); wc(10); wl(top); w(":\n  lt "); wr(rc); w(", "); wr(ri); w(", "); wn(n); wc(10);
  w("  jz "); wr(rc); w(", "); wl(end); w("\n  st 0, "); wr(rp); w(", 0\n  add "); wr(rp); w(", "); wr(rp); w(", 1\n  add "); wr(ri); w(", "); wr(ri); w(", 1\n  jmp "); wl(top); wc(10); wl(end); w(":\n");
}
void copy_n(V dst, V src, long long from, long long n) {
  if (n - from <= 8) { long long i = from; while (i < n) { long long t = newreg(); w("  ld "); wr(t); w(", "); opr(src); w(", "); wn(i); wc(10); w("  st "); wr(t); w(", "); opr(dst); w(", "); wn(i); wc(10); i = i + 1; } return; }
  long long i = newreg(); long long c = newreg(); int top = newlab(); int end = newlab(); long long pa = newreg(); long long pb = newreg(); long long t = newreg();
  w("  add "); wr(pa); w(", "); opr(dst); w(", "); wn(from); wc(10); w("  add "); wr(pb); w(", "); opr(src); w(", "); wn(from); wc(10); w("  mov "); wr(i); w(", "); wn(from); wc(10);
  wl(top); w(":\n  lt "); wr(c); w(", "); wr(i); w(", "); wn(n); w("\n  jz "); wr(c); w(", "); wl(end); w("\n  ld "); wr(t); w(", "); wr(pb); w(", 0\n  st "); wr(t); w(", "); wr(pa); w(", 0\n");
  w("  add "); wr(pa); w(", "); wr(pa); w(", 1\n  add "); wr(pb); w(", "); wr(pb); w(", 1\n  add "); wr(i); w(", "); wr(i); w(", 1\n  jmp "); wl(top); wc(10); wl(end); w(":\n");
}
void set_vptr(V addr, int ci) { if (cl_poly[ci]) { w("  st "); wn(cl_id[ci]); w(", "); opr(addr); w(", 0\n"); } }
void copy_obj(V dst, V src, int dc, int construct) {
  long long from = 0; if (cl_poly[dc]) from = 1;
  copy_n(dst, src, from, cl_words[dc]); if (construct) set_vptr(dst, dc);
}
V tempobj(int clsT) { int ci = tcl[clsT]; int off = slot(cl_words[ci]); V a = slotaddr(off); set_vptr(a, ci); V v = mkv(unq(clsT), 0, a.reg); return v; }
V tempscalar(int t, V val) { int off = slot(1); V a = slotaddr(off); V m = mat(val); w("  st "); opr(m); w(", "); opr(a); w(", 0\n"); V v = mkv(t, 1, a.reg); return v; }
long long fold(long long x, int t) {
  if (tk[t] == Y_BOOL) { if (x != 0) return 1; return 0; }
  if (is_ptr(t) || bits_of(t) >= 64) return x;
  int sh = 64 - bits_of(t);
  if (sg_of(t)) return (x << sh) >> sh;
  return (x << sh) >> sh & ((1LL << bits_of(t)) - 1);
}
int promote(int t) { t = unq(t); if (is_int(t) && rank_of(t) < 4) return mkt(Y_INT, 0 - 1, 0); return t; }
int uac(int x, int y) {
  x = unq(x); y = unq(y);
  if (tk[x] == Y_LDOUBLE || tk[y] == Y_LDOUBLE) return mkt(Y_LDOUBLE, 0 - 1, 0);
  if (tk[x] == Y_DOUBLE || tk[y] == Y_DOUBLE) return mkt(Y_DOUBLE, 0 - 1, 0);
  if (tk[x] == Y_FLOAT || tk[y] == Y_FLOAT) return mkt(Y_FLOAT, 0 - 1, 0);
  x = promote(x); y = promote(y);
  if (x == y) return x;
  int sx = sg_of(x); int sy = sg_of(y);
  if (sx == sy) { if (rank_of(x) >= rank_of(y)) return x; return y; }
  int u = x; int s = y; if (sx) { u = y; s = x; }
  if (rank_of(u) >= rank_of(s)) return u;
  if (bits_of(s) > bits_of(u)) return s;
  if (tk[s] == 9) return mkt(10, 0 - 1, 0);
  if (tk[s] == 11) return mkt(12, 0 - 1, 0);
  return mkt(Y_UINT, 0 - 1, 0);
}
// ---- f80 (long double): 2 sozcuklu bellek degeri; yazmac cifti ardisik numarali, Bolum 01 f80 komutlariyla ----
long long newreg2() { long long r = 100000 + 2 * npair; npair = npair + 1; w("  mov "); wr(r); w(", 0\n  mov "); wr(r + 1); w(", 0\n"); return r; }
int ldty() { return mkt(Y_LDOUBLE, 0 - 1, 0); }
long long ld_load(V a) {   // a: bellekteki f80'in adresi (lvalue ya da gecici) -> yazmac cifti
  V m = mat(a); long long p = newreg2(); w("  ld "); wr(p); w(", "); opr(m); w(", 0\n  ld "); wr(p + 1); w(", "); opr(m); w(", 1\n"); return p;
}
V ld_new(long long p) {   // yazmac cifti -> yeni gecici bellek degeri (prvalue, adres)
  int off = slot(2); V ad = slotaddr(off); w("  st "); wr(p); w(", "); opr(ad); w(", 0\n  st "); wr(p + 1); w(", "); opr(ad); w(", 1\n");
  return mkv(ldty(), 0, ad.reg);
}
V to_ld(V v) { v = rval(v); if (is_ld(v.ty)) return v; if (is_arith(v.ty) == 0) die("E_CONV", "long double donusumu yok"); return convert_arith(v, ldty()); }
V ld_binop(const char* tok, V l, V r) {
  l = to_ld(l); r = to_ld(r);
  int cr = find_rule(3, tok); long long pa = ld_load(l); long long pb = ld_load(r);
  if (cr >= 0) {
    int nmp = rstr_pos(cr, 4); long long d = newreg(); int swapw = rnum(cr, 3);
    if (rt_len(nmp) == 0) die("E_OP", "long double karsilastirmasi tabloda yok");
    if (swapw) ins3t(nmp, d, mkv(0, 0, pb), mkv(0, 0, pa)); else ins3t(nmp, d, mkv(0, 0, pa), mkv(0, 0, pb));
    V o = mkv(bool_t(), 0, d); merge_eff(o, l); merge_eff(o, r); return o;
  }
  int ar = find_rule(2, tok); if (ar < 0) die("E_OP", "bilinmeyen ikili islec");
  int nmp = rstr_pos(ar, 4); if (rt_len(nmp) == 0) die("E_TYPE", "islec long double turunde tanimli degil");
  long long d = newreg2(); ins3t(nmp, d, mkv(0, 0, pa), mkv(0, 0, pb));
  V o = ld_new(d); merge_eff(o, l); merge_eff(o, r); return o;
}
V ld_const(long long lo, long long hi) {
  long long a = newreg(); long long b = newreg(); w("  mov "); wr(a); w(", "); wn(lo); w("\n  mov "); wr(b); w(", "); wn(hi); wc(10);
  long long p = newreg2(); w("  "); wrt(names[NM_PACK80]); w(" "); wr(p); w(", "); wr(a); w(", "); wr(b); wc(10); return ld_new(p);
}
void ld_copy(V dst, V src) { long long p = ld_load(src); V m = mat(dst); w("  st "); wr(p); w(", "); opr(m); w(", 0\n  st "); wr(p + 1); w(", "); opr(m); w(", 1\n"); }
int is_mem(int t) { return is_cls(t) || is_ld(t); }
V to_mem_value(V v, int T) { T = unq(T); if (is_ld(T)) return to_ld(v); return to_class_value(v, T); }
V tempmem(int T) { T = unq(T); if (is_ld(T)) { int off = slot(2); V a = slotaddr(off); V o = mkv(T, 0, a.reg); return o; } return tempobj(T); }
V norm(V v, int t) {
  if (is_ld(t)) { v.ty = t; return v; }
  if (is_flt(t)) { if (tk[t] == Y_FLOAT) { V m = mat(v); long long d = newreg(); ins2t(names[NM_RND], d, m); return mkv(t, 0, d); } v.ty = t; return v; }
  if (tk[t] == Y_BOOL) { V m = mat(v); long long d = newreg(); ins3("ne", d, m, imm(t, 0)); return mkv(t, 0, d); }
  if (is_ptr(t) || bits_of(t) == 64) { v.ty = t; return v; }
  V m = mat(v); long long d = newreg(); ins2t(ty_norm[tk[t]], d, m); return mkv(t, 0, d);
}
V rval(V v) {
  if (is_arr(v.ty)) { V r = v; r.ty = ptrto(te[v.ty]); r.cat = 0; return r; }
  if (v.cat == 0 || is_cls(v.ty) || is_void(v.ty)) { V r = v; r.ty = unq(v.ty); if (is_cls(v.ty) == 0) r.cat = 0; return r; }
  if (is_ld(v.ty)) { long long p = ld_load(v); V o = ld_new(p); o.ne = v.ne; int q = 0; while (q < v.ne) { o.ek[q] = v.ek[q]; o.er[q] = v.er[q]; q = q + 1; } add_eff(o, v.key, 1); return o; }
  V r = mkv(unq(v.ty), 0, 0); r.ne = v.ne; int i = 0; while (i < v.ne) { r.ek[i] = v.ek[i]; r.er[i] = v.er[i]; i = i + 1; }
  r.reg = newreg(); w("  ld "); wr(r.reg); w(", "); opr(v); w(", 0\n");
  add_eff(r, v.key, 1);
  return r;
}
V convert_arith(V v, int to) {
  int from = v.ty; to = unq(to);
  if (from == to) return v;
  if (is_ld(to) && is_ld(from) == 0) {
    long long p = newreg2();
    if (is_int(from)) { V m = mat(v); if (uns64(from)) ins2t(names[NM_U64TO80], p, m); else ins2t(names[NM_I64TO80], p, m); }
    else { V m = mat(v); ins2t(names[NM_F64TO80], p, m); }
    V o = ld_new(p); o.ne = v.ne; return o;
  }
  if (is_ld(from) && is_ld(to) == 0) {
    long long p = ld_load(v); V pv = mkv(from, 0, p); long long d = newreg();
    if (tk[to] == Y_BOOL) { ins2t(names[NM_TOB80], d, pv); return mkv(to, 0, d); }
    if (tk[to] == Y_DOUBLE) { ins2t(names[NM_80TOF64], d, pv); return mkv(to, 0, d); }
    if (tk[to] == Y_FLOAT) { ins2t(names[NM_80TOF32], d, pv); return mkv(to, 0, d); }
    if (uns64(to)) ins2t(names[NM_80TOU64], d, pv); else ins2t(names[NM_80TOI64], d, pv);
    V o = mkv(to, 0, d); if (bits_of(to) < 64) return norm(o, to); return o;
  }
  if (is_int(from) && is_int(to)) {
    if (v.ci) { V o = imm(to, fold(v.cv, to)); o.ne = v.ne; return o; }
    int need = 1;
    if (tk[to] != Y_BOOL) {
      if (tk[from] == Y_BOOL) need = 0;
      else if (sg_of(from) == sg_of(to) && bits_of(to) >= bits_of(from)) need = 0;
      else if (sg_of(from) == 0 && sg_of(to) == 1 && bits_of(to) > bits_of(from)) need = 0;
      else if (bits_of(to) == 64) need = 0;
    }
    if (need == 0) { v.ty = to; return v; }
    return norm(v, to);
  }
  if (is_int(from) && is_flt(to)) {
    V m = mat(v); long long d = newreg();
    if (uns64(from)) ins2t(names[NM_U2F], d, m); else ins2t(names[NM_I2F], d, m);
    V o = mkv(to, 0, d); if (tk[to] == Y_FLOAT) return norm(o, to); return o;
  }
  if (is_flt(from) && is_int(to)) {
    V m = mat(v);
    if (tk[to] == Y_BOOL) { long long t1 = newreg(); ins3t(names[NM_FEQ], t1, m, fconst(from, 0)); long long d = newreg(); ins3("eq", d, mkv(from, 0, t1), imm(to, 0)); return mkv(to, 0, d); }
    long long d = newreg(); if (uns64(to)) ins2t(names[NM_F2U], d, m); else ins2t(names[NM_F2I], d, m);
    V o = mkv(to, 0, d); if (bits_of(to) < 64) return norm(o, to); return o;
  }
  if (is_flt(from) && is_flt(to)) { if (tk[to] == Y_FLOAT) return norm(v, to); v.ty = to; return v; }
  die("E_DONUSUM", "sayisal donusum yok"); return v;
}
// ============================ DONUSUM SIRALARI / ASIRI YUKLEME ============================
int N_CONV = 0; int N_CALLOP = 0; int N_EQ = 0; int N_NE = 0; int N_LT = 0; int N_GT = 0; int N_LE = 0; int N_GE = 0; int N_SS = 0; int N_ASG = 0; int N_NEG = 0; int N_NOT = 0; int N_DEREF = 0; int N_ADDR = 0; int N_IDX = 0; int N_ARW = 0; int N_INC = 0; int N_DEC = 0; int N_TILDE = 0; int N_PLUS = 0;
int std_rank(int from, V* v, int to) {   // -1 yok, 0 tam, 1 terfi, 2 donusum
  from = unq(from); to = unq(to);
  if (from == to) return 0;
  int fk = tk[from]; int tkk = tk[to];
  if (is_arith(from) && is_arith(to)) {
    if (tkk == Y_BOOL) return 2;
    if (tkk == Y_INT && fk >= Y_BOOL && fk <= 6) return 1;
    if (tkk == Y_DOUBLE && fk == Y_FLOAT) return 1;
    return 2;
  }
  if (tkk == Y_PTR) {
    if (fk == Y_NULLPTR) return 2;
    if (v != 0 && is_int(from) && v->ci && v->cv == 0 && v->nl) return 2;
    if (fk == Y_PTR) {
      int fe = te[from]; int tee = te[to];
      if (unq(fe) == unq(tee)) { if ((tcv[fe] == 0 || tcv[tee]) ) return 0; return 0 - 1; }
      if (tk[tee] == Y_VOID) { if (tcv[fe] == 0 || tcv[tee]) return 2; return 0 - 1; }
      if (is_cls(fe) && is_cls(tee) && derived_from(tcl[fe], tcl[tee]) && (tcv[fe] == 0 || tcv[tee])) return 2;
      return 0 - 1;
    }
    return 0 - 1;
  }
  if (tkk == Y_BOOL && (fk == Y_PTR || fk == Y_NULLPTR)) return 2;
  if (tkk == Y_NULLPTR && v != 0 && is_int(from) && v->ci && v->cv == 0 && v->nl) return 2;
  return 0 - 1;
}
int meth_cand[64]; int nmeth_cand = 0;
void methods_named(int ci, int name) {   // ad gizleme: ilk adi tasiyan sinifin yontemleri
  nmeth_cand = 0; int c = ci;
  while (c >= 0) {
    int f = 0;
    while (f < nfn) { if (fn_cls[f] == c && fn_name[f] == name && nmeth_cand < 64) { meth_cand[nmeth_cand] = f; nmeth_cand = nmeth_cand + 1; } f = f + 1; }
    if (nmeth_cand > 0) return;
    c = cl_base[c];
  }
}
int conv_cands[32]; int nconv = 0;
void conv_funcs_of(int ci) {
  nconv = 0; int c = ci;
  while (c >= 0) {
    int f = 0;
    while (f < nfn) {
      if (fn_cls[f] == c && fn_name[f] == N_CONV) {
        int hidden = 0; int k = 0; while (k < nconv) { if (unq(deref(fn_ret[conv_cands[k]])) == unq(deref(fn_ret[f]))) hidden = 1; k = k + 1; }
        if (hidden == 0 && nconv < 32) { conv_cands[nconv] = f; nconv = nconv + 1; }
      }
      f = f + 1;
    }
    c = cl_base[c];
  }
}
int pick_sub = 0;
int pick_user_conv(int clsT, int to, int allow_expl) {   // donusum islevi ya da -1; belirsizse hata
  to = unq(deref(to)); int best = 0 - 1; int bestr = 99; int amb = 0;
  conv_funcs_of(tcl[unq(clsT)]);
  int n = nconv; int cs[32]; int i = 0; while (i < n) { cs[i] = conv_cands[i]; i = i + 1; }
  i = 0;
  while (i < n) {
    int m = cs[i]; i = i + 1;
    if (fn_has(m, F_EXPL) && allow_expl == 0) continue;
    int rt = unq(deref(fn_ret[m])); int r;
    if (is_cls(rt) || is_cls(to)) { r = 0 - 1; if (rt == to) r = 0; else if (is_cls(rt) && is_cls(to) && derived_from(tcl[rt], tcl[to])) r = 2; }
    else r = std_rank(rt, 0, to);
    if (r < 0) continue;
    if (r < bestr) { best = m; bestr = r; amb = 0; } else if (r == bestr) amb = 1;
  }
  if (amb) die("E_AMBIG", "belirsiz kullanici donusumu");
  pick_sub = bestr; return best;
}
long long arg_rank(V& a, int P) {   // r*16+t ; -1 gecersiz
  int aty = a.ty; int lv = a.cat == 1;
  if (is_ref(P)) {
    int rr = tk[P] == Y_RREF; int tgt = te[P]; int tu = unq(tgt); int tc = tcv[tgt]; int au = unq(aty); int ac = tcv[aty];
    int exactish = au == tu;
    if (is_cls(au) && is_cls(tu) && derived_from(tcl[au], tcl[tu])) exactish = 1;
    if (is_arr(au) && is_arr(tu) && tn[au] == tn[tu] && unq(te[au]) == unq(te[tu])) exactish = 1;
    if (exactish) {
      if (ac && tc == 0) return 0 - 1;
      long long r0 = 2; if (au == tu) r0 = 0;
      if (rr == 0) {
        if (tc == 0 && lv == 0) return 0 - 1;
        long long t0 = 0; if (tc) t0 = 1; if (lv == 0) t0 = t0 + 2; return r0 * 16 + t0;
      }
      if (lv) return 0 - 1;
      long long t1 = 0; if (tc) t1 = 1; return r0 * 16 + t1;
    }
    if (tc == 0 && rr == 0) return 0 - 1;
    long long r;
    if (is_cls(au)) { int m = pick_user_conv(au, tu, 0); if (m < 0) return 0 - 1; r = 4; }
    else if (is_cls(tu)) return 0 - 1;
    else {
      int src = au; if (is_arr(au)) src = ptrto(te[au]);
      int sr = std_rank(src, &a, tu); if (sr < 0) return 0 - 1; r = sr; if (r < 1) r = 1;
    }
    long long tt = 3; if (rr) { tt = 0; if (tc) tt = 1; }
    return r * 16 + tt;
  }
  int pu = unq(P); int au = unq(aty); if (is_arr(au)) au = ptrto(te[au]);
  if (is_cls(pu)) {
    if (au == pu) return 0;
    if (is_cls(au) && derived_from(tcl[au], tcl[pu])) return 32;
    if (is_cls(au)) { int m = pick_user_conv(au, pu, 0); if (m >= 0) return 64; }
    return 0 - 1;
  }
  if (is_cls(au)) { int m = pick_user_conv(au, pu, 0); if (m >= 0) return (4 + pick_sub) * 16; return 0 - 1; }
  int r = std_rank(au, &a, pu); if (r < 0) return 0 - 1; return r * 16;
}
int res_ok[64]; long long res_rk[64 * 9]; int nres_ok = 0;
// aday secimi. self: ortuk nesne (uye) ; dondurur islev, -1 yok, -2 belirsiz
int resolve(int* cands, int nc, V* self, V* args, int na) {
  nres_ok = 0; int ci = 0;
  while (ci < nc) {
    int f = cands[ci]; ci = ci + 1;
    if (fn_np[f] != na) continue;
    int good = 1; long long rk[9]; int nr = 0;
    if (self != 0 && fn_cls[f] >= 0) {
      int objc = tcv[self->ty]; if (objc && fn_has(f, F_CONST) == 0) continue;
      int su = unq(self->ty); long long r;
      if (is_cls(su) && derived_from(tcl[su], fn_cls[f])) { if (su == clsty(fn_cls[f])) r = 0; else r = 2; } else continue;
      long long t0 = 0; if ((objc != 0) != (fn_has(f, F_CONST) != 0)) t0 = 1;
      rk[nr] = r * 16 + t0; nr = nr + 1;
    } else if (self == 0 && fn_cls[f] >= 0) continue;
    int i = 0;
    while (i < na && good) { long long a = arg_rank(args[i], fn_pt[f * 8 + i]); if (a < 0) good = 0; else { rk[nr] = a; nr = nr + 1; } i = i + 1; }
    if (good && nres_ok < 64) { res_ok[nres_ok] = f; int k = 0; while (k < nr) { res_rk[nres_ok * 9 + k] = rk[k]; k = k + 1; } res_rk[nres_ok * 9 + 8] = nr; nres_ok = nres_ok + 1; }
  }
  if (nres_ok == 0) return 0 - 1;
  int i = 0;
  while (i < nres_ok) {
    int isbest = 1; int j = 0;
    while (j < nres_ok && isbest) {
      if (i != j) {
        int allle = 1; int anylt = 0; int k = 0; int n = res_rk[i * 9 + 8];
        while (k < n) { long long x = res_rk[i * 9 + k]; long long y = res_rk[j * 9 + k]; if (x > y) allle = 0; if (x < y) anylt = 1; k = k + 1; }
        if (allle == 0 || anylt == 0) isbest = 0;
      }
      j = j + 1;
    }
    if (isbest) return res_ok[i];
    i = i + 1;
  }
  return 0 - 2;
}
// ============================ CAGRI / DONUSUM UYGULAMASI ============================
int may_throw = 0; int tiname_used = 0;
V callfn(int fi, V* self, V* args, int na, int allowvirt);
int is_void_v(V& v) { return is_void(v.ty); }
V bool_of(V v) {   // skaler rvalue -> bool
  int bt = mkt(Y_BOOL, 0 - 1, 0);
  if (tk[v.ty] == Y_NULLPTR) { return imm(bt, 0); }
  if (is_arith(v.ty)) return convert_arith(v, bt);
  if (v.ci) { return imm(bt, v.cv != 0); }
  V m = mat(v); long long d = newreg(); ins3("ne", d, m, imm(v.ty, 0)); return mkv(bt, 0, d);
}
V to_scalar(V v, int to, int allow_expl) {
  to = unq(to);
  if (is_cls(unq(v.ty))) {
    int m = pick_user_conv(v.ty, to, allow_expl); if (m < 0) die("E_CONV", "donusum yok");
    V r = callfn(m, &v, 0, 0, 0); v = r;
  }
  v = rval(v);
  if (v.ty == to) return v;
  if (is_void(v.ty)) die("E_CONV", "void deger kullanilamaz");
  int r = std_rank(v.ty, &v, to); if (r < 0) die("E_CONV", "ortuk donusum yok");
  if (is_arith(v.ty) && is_arith(to)) return convert_arith(v, to);
  if (tk[to] == Y_BOOL) return bool_of(v);
  if (tk[v.ty] == Y_NULLPTR || (is_int(v.ty) && v.ci)) { V z = imm(to, 0); z.ne = v.ne; return z; }
  v.ty = to; return v;
}
V cond_bool(V v) {
  if (is_cls(unq(v.ty))) return to_scalar(v, mkt(Y_BOOL, 0 - 1, 0), 1);
  v = rval(v);
  if (is_sc(v.ty) == 0 && tk[v.ty] != Y_NULLPTR) die("E_TYPE", "kosul ifadesi skaler tur olmali");
  return bool_of(v);
}
V to_class_value(V v, int to) {
  to = unq(to); int tc = tcl[to];
  if (is_cls(unq(v.ty))) {
    int vc = tcl[unq(v.ty)];
    if (vc != tc && is_ord(v.ty) && is_ord(to) && ord_conv_ok(v.ty, to)) { V t = tempobj(to); long long wr_ = newreg(); w("  ld "); wr(wr_); w(", "); opr(v); w(", 0\n  st "); wr(wr_); w(", "); opr(t); w(", 0\n"); return t; }
    if (vc == tc) {
      if (v.cat == 0) return v;
      V t = tempobj(to); if (cl_bi[tc]) copy_n(t, v, 0, 1); else copy_obj(t, v, tc, 1); merge_eff(t, v); return t;
    }
    if (derived_from(vc, tc)) { V t = tempobj(to); copy_obj(t, v, tc, 1); merge_eff(t, v); return t; }
    int m = pick_user_conv(v.ty, to, 0);
    if (m >= 0) { V r = callfn(m, &v, 0, 0, 0); return to_class_value(r, to); }
  }
  die("E_CONV", "sinif donusumu yok"); return v;
}
V bind_arg(V a, int P) {
  if (is_ref(P)) {
    int rr = tk[P] == Y_RREF; int tgt = te[P]; int tu = unq(tgt); int au = unq(a.ty); int tc = tcv[tgt];
    int direct = au == tu;
    if (is_cls(au) && is_cls(tu) && derived_from(tcl[au], tcl[tu])) direct = 1;
    if (is_arr(au) && is_arr(tu) && tn[au] == tn[tu] && unq(te[au]) == unq(te[tu])) direct = 1;
    if (direct && (tcv[a.ty] == 0 || tc)) {
      if (a.cat == 1 && rr) die("E_BIND", "rvalue referansi lvalue'ya baglanamaz");
      if (a.cat != 1 && tc == 0 && rr == 0) die("E_BIND", "const olmayan lvalue referansi rvalue'ya baglanamaz");
      if (a.cat == 0 && is_mem(au) == 0) { V t = tempscalar(au, a); return t; }
      return a;
    }
    if (tc == 0 && rr == 0) die("E_BIND", "const olmayan lvalue referansi icin tur uyumsuz");
    if (is_mem(tu)) { V c = to_mem_value(a, tu); return c; }
    V s = to_scalar(a, tu, 0); return tempscalar(tu, s);
  }
  int pu = unq(P);
  if (is_mem(pu)) { V c = to_mem_value(a, pu); return c; }
  return to_scalar(a, pu, 0);
}
V callfn(int fi, V* self, V* args, int na, int allowvirt) {
  if (fn_has(fi, F_DELETE)) die("E_DELETED", "silinmis islev cagrildi");
  if (fn_has(fi, F_PURE) && allowvirt == 0) die("E_PURE", "saf sanal islev dogrudan cagrilamaz");
  fn_used[fi] = 1;
  int rt = fn_ret[fi]; int sret = is_mem(unq(rt)) && is_ref(rt) == 0;
  V ops[12]; int no = 0; V out = mkv(0, 0, 0);
  if (sret) { out = tempmem(unq(rt)); ops[no] = out; no = no + 1; }
  if (fn_cls[fi] >= 0) { if (self == 0) die("E_THIS", "uye islev nesnesiz cagrildi"); ops[no] = *self; no = no + 1; }
  int i = 0; while (i < na) { ops[no] = bind_arg(args[i], fn_pt[fi * 8 + i]); no = no + 1; i = i + 1; }
  if (fn_has(fi, F_NOEX) == 0) may_throw = 1;
  long long d = newreg(); int isv = is_void(rt);
  if (fn_bi[fi] != 0) {
    if (fn_bi[fi] == 4) { w("  host "); wr(d); w(", getc\n"); return mkv(mkt(Y_INT, 0 - 1, 0), 0, d); }
    if (fn_bi[fi] == 5) { long long p = ld_load(ops[0]); long long lo = newreg(); long long hi = newreg(); w("  "); wrt(names[NM_LO80]); w(" "); wr(lo); w(", "); wr(p); w("\n  "); wrt(names[NM_HI80]); w(" "); wr(hi); w(", "); wr(p); w("\n  host puti, "); wr(lo); w("\n  host putc, 32\n  host puti, "); wr(hi); w("\n  host putc, 10\n"); return novalue(); }
    V a0 = mat(ops[0]);
    if (fn_bi[fi] == 1) w("  host puti, "); if (fn_bi[fi] == 2) w("  host putc, "); if (fn_bi[fi] == 3) w("  host putf, ");
    opr(a0); wc(10); return novalue();
  }
  int virt = fn_has(fi, F_VIRT) && allowvirt && self != 0 && fn_cls[fi] >= 0;
  w("  call "); if (isv == 0 && sret == 0) { wr(d); w(", "); }
  if (virt) { w("vd"); wn(fn_vroot[fi]); } else { w("f"); wn(fi); }
  i = 0; while (i < no) { w(", "); opr(ops[i]); i = i + 1; }
  wc(10);
  V res = mkv(0, 0, 0);
  i = 0; while (i < na) { merge_eff(res, args[i]); i = i + 1; }
  if (self != 0) merge_eff(res, *self);
  if (isv) { res.ty = Y_VOID; res.reg = 0 - 2; return res; }
  if (sret) { out.ne = res.ne; i = 0; while (i < res.ne) { out.ek[i] = res.ek[i]; out.er[i] = res.er[i]; i = i + 1; } return out; }
  if (is_ref(rt)) { res.ty = te[rt]; res.cat = 1; if (tk[rt] == Y_RREF) res.cat = 2; res.reg = d; res.vp = 1; return res; }
  res.ty = unq(rt); res.cat = 0; res.reg = d;
  return res;
}
// kullanici operatoru: ops[0..no); sonuc.ty = -1 ise yok
V noV() { V v = mkv(0 - 1, 0, 0); return v; }
V attempt_op(int name, V* o, int no) {
  int mc[64]; int nmc = 0; int fc[64]; int nfc = 0;
  if (is_cls(unq(o[0].ty))) { methods_named(tcl[unq(o[0].ty)], name); nmc = nmeth_cand; int k = 0; while (k < nmc) { mc[k] = meth_cand[k]; k = k + 1; } }
  int f = 0; while (f < nfn) { if (fn_cls[f] < 0 && fn_name[f] == name && nfc < 64) { fc[nfc] = f; nfc = nfc + 1; } f = f + 1; }
  int mr = 0 - 1; int fr = 0 - 1;
  if (nmc > 0) mr = resolve(mc, nmc, &o[0], &o[1], no - 1);
  if (nfc > 0) fr = resolve(fc, nfc, 0, o, no);
  if (mr == 0 - 2 || fr == 0 - 2) die("E_AMBIG", "belirsiz operator cagrisi");
  if (mr >= 0 && fr >= 0) die("E_AMBIG", "uye ve serbest operator ayni derecede uygun");
  if (mr >= 0) return callfn(mr, &o[0], &o[1], no - 1, 1);
  if (fr >= 0) return callfn(fr, 0, o, no, 0);
  return noV();
}
V user_op(int name, V* o, int no, int allow_rev) {
  V r = attempt_op(name, o, no);
  if (r.ty >= 0) return r;
  if (allow_rev && no == 2) { V rv[2]; rv[0] = o[1]; rv[1] = o[0]; return attempt_op(name, rv, 2); }
  return noV();
}
// ============================ OPERATORLER (kurallar tablodan) ============================
int seq_rt_c(int p, const char* t) {
  int n = 0; while (t[n]) n = n + 1;
  if (n != rt_len(p)) return 0;
  int i = 0; while (i < n) { if (RT[p + 1 + i] != t[i]) return 0; i = i + 1; }
  return 1;
}
int streq(const char* a, const char* b) { int i = 0; while (a[i] && b[i] && a[i] == b[i]) i = i + 1; return a[i] == 0 && b[i] == 0; }
int find_rule(int cls, const char* tok) {
  int r = 0;
  while (r < nrec) { if (RT[rec_off[r]] == cls && seq_rt_c(rstr_pos(r, 0), tok)) return r; r = r + 1; }
  return 0 - 1;
}
char tokbuf[64];
void settok(int sid) { int i = 0; while (i < s_len[sid] && i < 62) { tokbuf[i] = chars[s_off[sid] + i]; i = i + 1; } tokbuf[i] = 0; }
int bool_t() { return mkt(Y_BOOL, 0 - 1, 0); }
V arith(int rule, V l, V r, int t) {
  int kind = rnum(rule, 0); int when = rnum(rule, 1); int needn = rnum(rule, 2);
  int pi_ = rstr_pos(rule, 1); int pu = rstr_pos(rule, 2); int pf = rstr_pos(rule, 3);
  long long d = newreg();
  if (is_flt(t)) { if (rt_len(pf) == 0) die("E_TYPE", "operator kayan nokta turunde tanimli degil"); ins3t(pf, d, l, r); return norm(mkv(t, 0, d), t); }
  int p = pi_;
  if (when == 1 && uns64(t)) p = pu;
  if (when == 2 && sg_of(t) == 0) p = pu;
  if (kind == 2) { l = mat(l); r = mat(r); }
  ins3t(p, d, l, r);
  V o = mkv(t, 0, d);
  if (needn) return norm(o, t);
  return o;
}
V compare(int rule, V l, V r, int t) {
  int sw_u = rnum(rule, 0); int sw_f = rnum(rule, 1); int inv_f = rnum(rule, 2);
  long long d = newreg(); int bt = bool_t();
  if (is_flt(t)) {
    if (sw_f) { V x = l; l = r; r = x; }
    if (inv_f) { long long t1 = newreg(); ins3t(rstr_pos(rule, 3), t1, l, r); ins3("eq", d, mkv(t, 0, t1), imm(bt, 0)); return mkv(bt, 0, d); }
    ins3t(rstr_pos(rule, 3), d, l, r); return mkv(bt, 0, d);
  }
  int p = rstr_pos(rule, 1);
  if (uns64(t) || is_ptr(t)) { p = rstr_pos(rule, 2); if (sw_u) { V x = l; l = r; r = x; } }
  l = mat(l);
  ins3t(p, d, l, r);
  return mkv(bt, 0, d);
}
V ptradd(V p, V i, int neg) {
  int et = te[p.ty]; if (complete_obj(et) == 0) die("E_PTRARITH", "tamamlanmamis/void turde isaretci aritmetigi");
  i = convert_arith(rval(i), mkt(Y_LONG, 0 - 1, 0));
  long long wd = words_of(et); V off = i;
  if (wd != 1) { long long t1 = newreg(); ins3("mul", t1, mat(i), imm(i.ty, wd)); off = mkv(i.ty, 0, t1); }
  long long d = newreg(); if (neg) ins3("sub", d, mat(p), off); else ins3("add", d, mat(p), off);
  return mkv(p.ty, 0, d);
}
V ord_obj(int kind, V val) { int c = find_class(intern_c(kind == 1 ? "std::strong_ordering" : kind == 2 ? "std::weak_ordering" : "std::partial_ordering")); V t = tempobj(clsty(c)); V m = mat(val); w("  st "); opr(m); w(", "); opr(t); w(", 0\n"); return t; }
V ord_cmp_zero(const char* op, V ord) {
  long long v = newreg(); w("  ld "); wr(v); w(", "); opr(ord); w(", 0\n"); long long d = newreg(); V vv = mkv(0, 0, v);
  if (streq(op, "<")) ins3("eq", d, vv, imm(0, 0 - 1)); else if (streq(op, "<=")) ins3("le", d, vv, imm(0, 0));
  else if (streq(op, ">")) ins3("eq", d, vv, imm(0, 1)); else if (streq(op, ">=")) ins3("ltu", d, vv, imm(0, 2));
  else if (streq(op, "==")) ins3("eq", d, vv, imm(0, 0)); else if (streq(op, "!=")) ins3("ne", d, vv, imm(0, 0));
  else die("E_OP", "siralama nesnesi icin gecersiz islec");
  V r = mkv(bool_t(), 0, d); merge_eff(r, ord); return r;
}
V builtin_spaceship(V l, V r) {
  int t;
  if (is_arith(l.ty) && is_arith(r.ty)) t = uac(l.ty, r.ty);
  else if (is_ptr(l.ty) || is_ptr(r.ty) || tk[l.ty] == Y_NULLPTR || tk[r.ty] == Y_NULLPTR) {
    if (is_ptr(l.ty) && is_ptr(r.ty) && unq(l.ty) != unq(r.ty)) { if (std_rank(r.ty, &r, l.ty) >= 0) t = unq(l.ty); else if (std_rank(l.ty, &l, r.ty) >= 0) t = unq(r.ty); else { die("E_TYPE", "<=> farkli isaretci turleri"); t = 0; } }
    else { if (is_ptr(l.ty)) t = unq(l.ty); else t = unq(r.ty); }
  } else { die("E_TYPE", "<=> bu turler icin tanimli degil"); t = 0; }
  l = to_scalar(l, t, 0); r = to_scalar(r, t, 0);
  if (is_ld(t)) {
    long long pa = ld_load(l); long long pb = ld_load(r); long long lt1 = newreg(); long long gt1 = newreg(); long long e1 = newreg(); long long r0 = newreg(); long long z = newreg(); long long nz = newreg(); long long un = newreg(); long long u2 = newreg(); long long res2 = newreg();
    ins3t(names[NM_LT80], lt1, mkv(0, 0, pa), mkv(0, 0, pb)); ins3t(names[NM_LT80], gt1, mkv(0, 0, pb), mkv(0, 0, pa)); ins3t(names[NM_EQ80], e1, mkv(0, 0, pa), mkv(0, 0, pb));
    ins3("sub", r0, mkv(0, 0, gt1), mkv(0, 0, lt1)); ins3("eq", z, mkv(0, 0, r0), imm(0, 0)); ins3("eq", nz, mkv(0, 0, e1), imm(0, 0)); ins3("and", un, mkv(0, 0, z), mkv(0, 0, nz)); ins3("mul", u2, mkv(0, 0, un), imm(0, 2)); ins3("add", res2, mkv(0, 0, r0), mkv(0, 0, u2));
    V o2 = ord_obj(3, mkv(0, 0, res2)); merge_eff(o2, l); merge_eff(o2, r); return o2;
  }
  int flt = is_flt(t); long long res = newreg();
  if (flt == 0) {
    int u = uns64(t) || is_ptr(t); long long g1 = newreg(); long long l1 = newreg();
    if (u) ins3("ltu", g1, mat(r), l); else ins3("gt", g1, mat(l), r);
    ins3(u ? "ltu" : "lt", l1, mat(l), r); ins3("sub", res, mkv(0, 0, g1), mkv(0, 0, l1));
  } else {
    long long g1 = newreg(); long long l1 = newreg(); long long r0 = newreg(); long long e = newreg(); long long z = newreg(); long long nz = newreg(); long long un = newreg(); long long u2 = newreg();
    ins3("fgt", g1, mat(l), r); ins3("flt", l1, mat(l), r); ins3("sub", r0, mkv(0, 0, g1), mkv(0, 0, l1));
    ins3("feq", e, mat(l), r); ins3("eq", z, mkv(0, 0, r0), imm(0, 0)); ins3("eq", nz, mkv(0, 0, e), imm(0, 0)); ins3("and", un, mkv(0, 0, z), mkv(0, 0, nz)); ins3("mul", u2, mkv(0, 0, un), imm(0, 2)); ins3("add", res, mkv(0, 0, r0), mkv(0, 0, u2));
  }
  V o = ord_obj(flt ? 3 : 1, mkv(0, 0, res)); merge_eff(o, l); merge_eff(o, r); return o;
}
V binop(const char* tok, V l, V r) {   // iki rvalue skaler
  l = rval(l); r = rval(r);
  if (is_void(l.ty) || is_void(r.ty)) die("E_TYPE", "void deger islecte kullanilamaz");
  if (streq(tok, "<=>")) return builtin_spaceship(l, r);
  if ((is_ld(l.ty) || is_ld(r.ty)) && is_arith(l.ty) && is_arith(r.ty)) return ld_binop(tok, l, r);
  int lp = is_ptr(l.ty) || tk[l.ty] == Y_NULLPTR; int rp = is_ptr(r.ty) || tk[r.ty] == Y_NULLPTR;
  int cr = find_rule(3, tok);
  int rel = cr >= 0 && !(streq(tok, "==") || streq(tok, "!="));
  if (lp || rp) {
    if (cr >= 0) {
      int t;
      if (is_ptr(l.ty) && is_ptr(r.ty)) { if (unq(l.ty) == unq(r.ty)) t = unq(l.ty); else if (std_rank(r.ty, &r, l.ty) >= 0) t = unq(l.ty); else if (std_rank(l.ty, &l, r.ty) >= 0) t = unq(r.ty); else { die("E_TYPE", "isaretci turleri uyumsuz"); t = 0; } }
      else if (is_ptr(l.ty)) { if (rel && tk[r.ty] != Y_NULLPTR) die("E_TYPE", "isaretci ile tamsayi siralanamaz"); if (std_rank(r.ty, &r, l.ty) < 0) die("E_TYPE", "isaretci ile karsilastirilamaz"); t = unq(l.ty); }
      else if (is_ptr(r.ty)) { if (rel && tk[l.ty] != Y_NULLPTR) die("E_TYPE", "isaretci ile tamsayi siralanamaz"); if (std_rank(l.ty, &l, r.ty) < 0) die("E_TYPE", "isaretci ile karsilastirilamaz"); t = unq(r.ty); }
      else t = mkt(Y_LONG, 0 - 1, 0);
      if (tk[l.ty] == Y_NULLPTR) l = imm(t, 0); if (tk[r.ty] == Y_NULLPTR) r = imm(t, 0);
      l = to_scalar(l, t, 0); r = to_scalar(r, t, 0);
      return compare(cr, mat(l), mat(r), t);
    }
    if (streq(tok, "+") && is_ptr(l.ty) && is_int(r.ty)) return ptradd(l, r, 0);
    if (streq(tok, "+") && is_ptr(r.ty) && is_int(l.ty)) return ptradd(r, l, 0);
    if (streq(tok, "-") && is_ptr(l.ty) && is_int(r.ty)) return ptradd(l, r, 1);
    if (streq(tok, "-") && is_ptr(l.ty) && is_ptr(r.ty)) {
      if (unq(te[l.ty]) != unq(te[r.ty])) die("E_TYPE", "isaretci farki: farkli turler");
      if (complete_obj(te[l.ty]) == 0) die("E_PTRARITH", "tamamlanmamis/void turde isaretci aritmetigi");
      long long wd = words_of(te[l.ty]); long long d = newreg(); ins3("sub", d, mat(l), r);
      if (wd != 1) { long long q = newreg(); ins3("div", q, mkv(0, 0, d), imm(0, wd)); d = q; }
      return mkv(mkt(Y_LONG, 0 - 1, 0), 0, d);
    }
    die("E_TYPE", "isaretci operandli gecersiz islec");
  }
  if (is_arith(l.ty) == 0 || is_arith(r.ty) == 0) die("E_TYPE", "islec icin gecersiz operand turleri");
  int ar = find_rule(2, tok);
  if (cr < 0 && ar < 0) die("E_OP", "bilinmeyen ikili islec");
  int kind = 0; if (ar >= 0) kind = rnum(ar, 0);
  int intonly = ar >= 0 && (kind == 3 || kind == 4 || streq(tok, "%"));
  if (intonly && (is_int(l.ty) == 0 || is_int(r.ty) == 0)) die("E_TYPE", "islec yalniz tamsayi operandlarla kullanilir");
  if (ar >= 0 && kind == 4) {
    int lt = promote(l.ty); int rt = promote(r.ty); l = convert_arith(l, lt); r = convert_arith(r, rt);
    if (r.ci) { if (r.cv < 0) die("E_SHIFT", "negatif kaydirma miktari"); if (r.cv >= bits_of(lt)) die("E_SHIFT", "kaydirma miktari tur genisligini asiyor"); }
    return arith(ar, l, r, lt);
  }
  int t = uac(l.ty, r.ty); l = convert_arith(l, t); r = convert_arith(r, t);
  if (cr >= 0) return compare(cr, mat(l), mat(r), t);
  return arith(ar, mat(l), mat(r), t);
}
// ============================ SEMBOLLER ============================

int kid(int n, int i) { return kids[nk_ks[n] + i]; }
int vname[3000]; int vty[3000]; int voff[3000]; int vref[3000]; int vci[3000]; long long vcv[3000]; int vuid[3000]; int nvars = 0; int uidn = 0;
int gname[600]; int gty[600]; int gnode[600]; int gci[600]; long long gcv[600]; int guid[600]; int ngl = 0;
int str_node[600]; int nstrn = 0;
int cur_fn = 0 - 1; int cur_cls = 0 - 1;
int findvar(int sid) { int i = nvars - 1; while (i >= 0) { if (vname[i] == sid) return i; i = i - 1; } return 0 - 1; }
int findgl(int sid) { int i = 0; while (i < ngl) { if (gname[i] == sid) return i; i = i + 1; } return 0 - 1; }
const int N_INT = 0; const int N_FLT = 1; const int N_CHR = 2; const int N_STR = 3; const int N_BOOL = 4; const int N_NULLPTR = 5; const int N_THIS = 6; const int N_ID = 7; const int N_UNARY = 8; const int N_BINARY = 9; const int N_ASSIGN = 10;
const int N_COND = 11; const int N_COMMA = 12; const int N_CALL = 13; const int N_INDEX = 14; const int N_MEMBER = 15; const int N_ARROW = 16; const int N_PREINC = 17; const int N_POSTINC = 18; const int N_SIZEOF_E = 19; const int N_SIZEOF_T = 20; const int N_ALIGNOF = 21;
const int N_NOEXCEPT = 22; const int N_TYPEID_E = 23; const int N_TYPEID_T = 24; const int N_CAST = 25; const int N_FCAST = 26; const int N_UDL = 27; const int N_INITLIST = 28; const int N_TY = 29; const int N_TPTR = 30; const int N_TREF = 31; const int N_TRREF = 32; const int N_TARR = 33;
const int N_BLOCK = 34; const int N_VAR = 35; const int N_DECLS = 36; const int N_EXPRSTMT = 37; const int N_IF = 38; const int N_WHILE = 39; const int N_DO = 40; const int N_FOR = 41; const int N_RETURN = 42; const int N_BREAK = 43; const int N_CONTINUE = 44; const int N_EMPTY = 45;
const int N_FUNC = 46; const int N_PARAMS = 47; const int N_CLASS = 48; const int N_PROG = 49; const int N_NONE = 51;
V gen(int n);
void init_obj(V addr, int T, int init, int style);
long long ceval(int n) {
  int k = nk_k[n];
  if (k == N_INT || k == N_CHR || k == N_BOOL) return nk_i[n];
  if (k == N_SIZEOF_T || k == N_SIZEOF_E || k == N_ALIGNOF) { dry = dry + 1; V v = gen(n); dry = dry - 1; if (v.ci == 0) die("E_CONST", "sabit ifade gerekli"); return v.cv; }
  if (k == N_UNARY && seqc(nk_s1[n], "-")) return 0 - ceval(kid(n, 0));
  if (k == N_ID) { int gi = findgl(nk_s1[n]); if (gi >= 0 && gci[gi]) return gcv[gi]; }
  if (k == N_COND) { if (ceval(kid(n, 0))) return ceval(kid(n, 1)); return ceval(kid(n, 2)); }
  if (k == N_BINARY) {
    long long a = ceval(kid(n, 0)); long long b = ceval(kid(n, 1)); int s = nk_s1[n];
    if (seqc(s, "+")) return a + b; if (seqc(s, "-")) return a - b; if (seqc(s, "*")) return a * b;
    if (seqc(s, "/") && b != 0) return a / b; if (seqc(s, "%") && b != 0) return a % b; if (seqc(s, "<<")) return a << b; if (seqc(s, ">>")) return a >> b;
  }
  die("E_CONST", "sabit ifade gerekli"); return 0;
}
int typeof_(int n) {
  int k = nk_k[n];
  if (k == N_TY) {
    int c = nk_i[n]; int cv = 0; if (nk_j[n] & 1) cv = 1;
    if (c == Y_CLASS) { int ci = find_class(nk_s1[n]); if (ci < 0) die("E_TYPE", "bilinmeyen sinif"); return mk2(Y_CLASS, 0 - 1, 0, ci, cv); }
    return mk2(c, 0 - 1, 0, 0 - 1, cv);
  }
  if (k == N_TPTR) { int cv = 0; if (nk_j[n] & 1) cv = 1; return mk2(Y_PTR, typeof_(kid(n, 0)), 0, 0 - 1, cv); }
  if (k == N_TREF) return lref(typeof_(kid(n, 0)));
  if (k == N_TRREF) return rref(typeof_(kid(n, 0)));
  if (k == N_TARR) {
    int e = typeof_(kid(n, 0)); if (nk_n[n] < 2) return arrof(e, 0 - 1);
    long long c = ceval(kid(n, 1)); if (c <= 0) die("E_TYPE", "dizi boyutu pozitif olmali");
    if (c > 16777216 || c * words_of(e) > 16777216) die("E_TYPE", "dizi cok buyuk");
    if (complete_obj(e) == 0) die("E_TYPE", "dizi eleman turu tam degil");
    return arrof(e, c);
  }
  die("E_TYPE", "tur dugumu bekleniyordu"); return 0;
}
V var_ref(int vi) {
  long long r = newreg(); V v = mkv(vty[vi], 1, r); v.key = vuid[vi] * 1000 + 1;
  if (vref[vi]) { w("  ld "); wr(r); w(", fp, "); wn(voff[vi]); wc(10); v.vp = 1; v.key = 0; }
  else { w("  add "); wr(r); w(", fp, "); wn(voff[vi]); wc(10); }
  if (vci[vi]) { v.ci = 1; v.cv = vcv[vi]; }
  return v;
}
int N_THISV = 0;
V this_value() {
  int vi = findvar(N_THISV); if (vi < 0) die("E_THIS", "'this' uye islev disinda kullanilamaz");
  V a = var_ref(vi); return rval(a);
}
V gen_id(int n) {
  int nm = nk_s1[n]; curline = nk_line[n];
  int p = s_len[nm]; int i = 0; int has = 0;
  while (i + 1 < p) { if (chars[s_off[nm] + i] == ':' && chars[s_off[nm] + i + 1] == ':') has = 1; i = i + 1; }
  if (has) {   // std::strong_ordering::less ...
    int cut = p - 1; while (cut > 0 && chars[s_off[nm] + cut] != ':') cut = cut - 1;
    int cn = intern_n(&chars[s_off[nm]], cut - 1); int mem = intern_n(&chars[s_off[nm] + cut + 1], p - cut - 1);
    int ci = find_class(cn);
    if (ci >= 0 && cl_bi[ci] >= 1 && cl_bi[ci] <= 3) {
      int kind = cl_bi[ci]; long long val = 0;
      if (seqc(mem, "less")) val = 0 - 1; else if (seqc(mem, "greater")) val = 1; else if (seqc(mem, "equal") && kind == 1) val = 0; else if (seqc(mem, "equivalent") && kind != 1) val = 0; else if (seqc(mem, "unordered") && kind == 3) val = 2;
      else die("E_UNDECL", "bilinmeyen siralama sabiti");
      return ord_obj(kind, imm(0, val));
    }
    die("E_UNDECL", "bilinmeyen niteleyici ad");
  }
  int vi = findvar(nm);
  if (vi >= 0) return var_ref(vi);
  if (cur_cls >= 0) {
    int oc = find_field(cur_cls, nm);
    if (oc >= 0) {
      V th = this_value(); long long woff = fq_woff; int fty = fq_ty;
      V r = mkv(fty, 1, 0); r.vp = 1;
      if (woff != 0) { r.reg = newreg(); w("  add "); wr(r.reg); w(", "); opr(th); w(", "); wn(woff); wc(10); } else r.reg = th.reg;
      int thv = findvar(N_THISV); if (tcv[te[vty[thv]]]) r.ty = withc(fty, 1);
      return r;
    }
  }
  int gi = findgl(nm);
  if (gi >= 0) { long long gr = newreg(); w("  mov "); wr(gr); w(", g"); wn(gi); wc(10); V g = mkv(gty[gi], 1, gr); g.key = guid[gi] * 1000 + 1; if (gci[gi]) { g.ci = 1; g.cv = gcv[gi]; } return g; }
  die("E_UNDECL", "tanimsiz ad"); return novalue();
}
V gen_member(int n) {
  int arrow = nk_k[n] == N_ARROW; curline = nk_line[n]; V o = gen(kid(n, 0));
  if (arrow) {
    if (is_cls(unq(o.ty))) { V ops[1]; ops[0] = o; V u = user_op(N_ARW, ops, 1, 0); if (u.ty >= 0) o = u; }
    o = rval(o); if (is_ptr(o.ty) == 0 || is_cls(unq(te[o.ty])) == 0) die("E_TYPE", "'->' sinif isaretcisi gerektirir");
    nullchk(o); V l = mkv(te[o.ty], 1, o.reg); l.vp = 1; if (o.reg < 0) { l = mat(o); l.ty = te[o.ty]; l.cat = 1; l.vp = 1; } l.ne = o.ne; int k = 0; while (k < o.ne) { l.ek[k] = o.ek[k]; l.er[k] = o.er[k]; k = k + 1; } o = l;
  }
  int clsT = unq(o.ty); if (is_cls(clsT) == 0) die("E_TYPE", "'.' sinif nesnesi gerektirir");
  int oc = find_field(tcl[clsT], nk_s1[n]); if (oc < 0) die("E_UNDECL", "sinifta boyle bir uye yok");
  long long woff = fq_woff; int fty = fq_ty;
  V r = mkv(fty, 1, 0); if (tcv[o.ty]) r.ty = withc(fty, 1); r.cat = 1; if (o.cat != 1) r.cat = 2; r.vp = o.vp; r.ne = o.ne; int k = 0; while (k < o.ne) { r.ek[k] = o.ek[k]; r.er[k] = o.er[k]; k = k + 1; }
  if (woff != 0) { r.reg = newreg(); w("  add "); wr(r.reg); w(", "); opr(o); w(", "); wn(woff); wc(10); } else r.reg = o.reg;
  if (o.key != 0) r.key = o.key + nk_s1[n] * 7 + 3;
  return r;
}
V gen_index(int n) {
  curline = nk_line[n]; V b = gen(kid(n, 0)); V i = gen(kid(n, 1));
  if (is_cls(unq(b.ty))) { V ops[2]; ops[0] = b; ops[1] = i; V u = user_op(N_IDX, ops, 2, 0); if (u.ty >= 0) return u; b = unwrap_conv(b); }
  if (is_cls(unq(i.ty))) i = unwrap_conv(i);
  int barr = is_arr(b.ty);
  V bp = rval(b); i = rval(i);
  if (is_ptr(bp.ty) == 0 && is_ptr(i.ty)) { V x = bp; bp = i; i = x; barr = 0; }
  if (is_ptr(bp.ty) == 0) die("E_TYPE", "dizi/isaretci olmayan ifade indekslenemez");
  if (is_int(i.ty) == 0) die("E_TYPE", "dizi indeksi tamsayi olmali");
  int et = te[bp.ty]; if (complete_obj(et) == 0) die("E_PTRARITH", "tamamlanmamis turde eleman indekslenemez");
  if (barr == 0) nullchk(bp);
  i = convert_arith(i, mkt(Y_LONG, 0 - 1, 0));
  if (barr) {
    long long cnt = tn[b.ty];
    if (i.ci && (i.cv < 0 || i.cv >= cnt)) die("E_BOUNDS", "sabit dizi indeksi sinir disi");
    if (i.ci == 0) { long long c = newreg(); int ok = newlab(); ins3("ltu", c, i, imm(0, cnt)); w("  jnz "); wr(c); w(", "); wl(ok); wc(10); trapnow(); wl(ok); w(":\n"); }
  }
  long long wd = words_of(et); V off = i;
  if (wd != 1) { long long t1 = newreg(); ins3("mul", t1, mat(i), imm(i.ty, wd)); off = mkv(i.ty, 0, t1); }
  long long d = newreg(); ins3("add", d, mat(bp), off);
  V r = mkv(et, 1, d); r.vp = 1; if (barr && tcv[b.ty]) r.ty = withc(et, 1); merge_eff(r, b); merge_eff(r, i); return r;
}
// ============================ IFADELER ============================
V unwrap_conv(V v) {   // sinif -> skaler (yerlesik operator icin): tek acik olmayan donusum
  conv_funcs_of(tcl[unq(v.ty)]); int cs[32]; int nc = 0; int i = 0;
  while (i < nconv) { int m = conv_cands[i]; if (fn_has(m, F_EXPL) == 0 && is_sc(unq(deref(fn_ret[m])))) { cs[nc] = m; nc = nc + 1; } i = i + 1; }
  if (nc == 0) die("E_NOVIABLE", "operator icin uygun operand yok (kullanici donusumu yok)");
  if (nc > 1) die("E_AMBIG", "belirsiz kullanici donusumu");
  V r = callfn(cs[0], &v, 0, 0, 0); return rval(r);
}
void need_modifiable(V& v) {
  if (v.cat != 1) die("E_LVALUE", "sol operand degistirilebilir lvalue olmali");
  if (tcv[v.ty]) die("E_CONST", "const nesneye atama");
  if (is_arr(v.ty)) die("E_LVALUE", "diziye atanamaz");
}
V store(V lv, V val) {
  if (is_ld(lv.ty)) { ld_copy(lv, val); V r0 = lv; merge_eff(r0, val); add_eff(r0, lv.key, 2); return r0; }
  V mv = mat(val); w("  st "); opr(mv); w(", "); opr(lv); w(", 0\n");
  V r = lv; merge_eff(r, val); add_eff(r, lv.key, 2); r.ci = 0; return r;
}
V gen_logical(int n, int isand) {
  V a = cond_bool(gen(kid(n, 0))); long long res = newreg(); int end = newlab();
  w("  mov "); wr(res); w(", "); opr(a); wc(10);
  if (isand) w("  jz "); else w("  jnz ");
  wr(res); w(", "); wl(end); wc(10);
  V b = cond_bool(gen(kid(n, 1)));
  w("  mov "); wr(res); w(", "); opr(b); wc(10); wl(end); w(":\n");
  V o = mkv(bool_t(), 0, res); merge_eff(o, a); merge_eff(o, b); return o;
}
int op_name(const char* t) { return intern_c(t); }
V gen_binary(int n) {
  curline = nk_line[n]; int s = nk_s1[n];
  if (seqc(s, "&&")) return gen_logical(n, 1);
  if (seqc(s, "||")) return gen_logical(n, 0);
  V L = gen(kid(n, 0)); V R = gen(kid(n, 1)); settok(s);
  char tok[64]; int ti = 0; while (tokbuf[ti]) { tok[ti] = tokbuf[ti]; ti = ti + 1; } tok[ti] = 0;
  if (streq(tok, "<<") == 0 && streq(tok, ">>") == 0) { if (unseq_bad(L, R)) die("E_UNSEQ", "ayni nesne siralanmamis iki degerlendirmede degistiriliyor/okunuyor (tanimsiz davranis)"); }
  int lc = is_cls(unq(L.ty)); int rc = is_cls(unq(R.ty));
  if (lc || rc) {
    int zl = R.nl && R.ci; int zr = L.nl && L.ci;
    if (lc && is_ord(L.ty) && zl) return ord_cmp_zero(tok, L);
    if (rc && is_ord(R.ty) && zr) { const char* sw = tok; if (streq(tok, "<")) sw = ">"; else if (streq(tok, ">")) sw = "<"; else if (streq(tok, "<=")) sw = ">="; else if (streq(tok, ">=")) sw = "<="; return ord_cmp_zero(sw, R); }
    if (lc && rc && unq(L.ty) == unq(R.ty) && (is_ord(L.ty) || cl_bi[tcl[unq(L.ty)]] == 4) && (streq(tok, "==") || streq(tok, "!="))) {
      long long p1 = newreg(); long long p2 = newreg(); long long d = newreg(); w("  ld "); wr(p1); w(", "); opr(L); w(", 0\n  ld "); wr(p2); w(", "); opr(R); w(", 0\n");
      ins3(streq(tok, "==") ? "eq" : "ne", d, mkv(0, 0, p1), mkv(0, 0, p2)); V o = mkv(bool_t(), 0, d); merge_eff(o, L); merge_eff(o, R); return o;
    }
    V ops[2]; ops[0] = L; ops[1] = R; int nm = op_name(tok);
    int rev = streq(tok, "==") || streq(tok, "!=");
    V r = noV();
    { char nb[80]; int k = 0; const char* pre = "operator"; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (tok[j]) { nb[k] = tok[j]; k = k + 1; j = j + 1; } nb[k] = 0; nm = intern_c(nb); }
    r = user_op(nm, ops, 2, rev);
    if (r.ty >= 0) return r;
    if (streq(tok, "!=")) { V e = user_op(intern_c("operator=="), ops, 2, 1); if (e.ty >= 0) { V b = cond_bool(e); long long d = newreg(); ins3("eq", d, mat(b), imm(bool_t(), 0)); V o = mkv(bool_t(), 0, d); merge_eff(o, b); return o; } }
    if (streq(tok, "<") || streq(tok, ">") || streq(tok, "<=") || streq(tok, ">=")) {
      V sp = user_op(intern_c("operator<=>"), ops, 2, 0);
      if (sp.ty >= 0) { if (is_ord(sp.ty) == 0) die("E_TYPE", "<=> sonucu siralama turu degil"); return ord_cmp_zero(tok, sp); }
      V rv[2]; rv[0] = R; rv[1] = L; V s2 = user_op(intern_c("operator<=>"), rv, 2, 0);
      if (s2.ty >= 0) { const char* sw = "<="; if (streq(tok, "<")) sw = ">"; else if (streq(tok, ">")) sw = "<"; else if (streq(tok, "<=")) sw = ">="; return ord_cmp_zero(sw, s2); }
    }
    if (lc) L = unwrap_conv(L); if (rc) R = unwrap_conv(R);
    return binop(tok, rval(L), rval(R));
  }
  return binop(tok, L, R);
}
V gen_assign(int n) {
  curline = nk_line[n]; int s = nk_s1[n];
  if (nk_k[kid(n, 1)] == N_INITLIST) {
    V Lh = gen(kid(n, 0)); need_modifiable(Lh);
    if (is_cls(unq(Lh.ty))) { V t = tempobj(unq(Lh.ty)); init_obj(t, unq(Lh.ty), kid(n, 1), 3); int c = tcl[unq(Lh.ty)]; long long fr = 0; if (cl_poly[c]) fr = 1; copy_n(Lh, t, fr, cl_words[c]); return Lh; }
    if (is_sc(Lh.ty)) { init_obj(Lh, unq(Lh.ty), kid(n, 1), 3); return Lh; }
    die("E_TYPE", "bu hedefe {..} atanamaz");
  }
  V R = gen(kid(n, 1)); V Lv = gen(kid(n, 0));
  if (seqc(s, "=")) {
    if (is_cls(unq(Lv.ty))) {
      if (Lv.cat != 1) die("E_LVALUE", "atama: sol operand lvalue olmali");
      V ops[2]; ops[0] = Lv; ops[1] = R; V u = user_op(N_ASG, ops, 2, 0); if (u.ty >= 0) return Lv;
      if (tcv[Lv.ty]) die("E_CONST", "const nesneye atama");
      int dc = tcl[unq(Lv.ty)]; V rc = R;
      if (is_cls(unq(R.ty)) == 0 || !(tcl[unq(R.ty)] == dc || derived_from(tcl[unq(R.ty)], dc))) rc = to_class_value(R, unq(Lv.ty));
      if (cl_bi[dc]) copy_n(Lv, rc, 0, 1); else { long long fr = 0; if (cl_poly[dc]) fr = 1; copy_n(Lv, rc, fr, cl_words[dc]); }
      V r = Lv; merge_eff(r, R); return r;
    }
    need_modifiable(Lv);
    V val = to_scalar(R, unq(Lv.ty), 0); return store(Lv, val);
  }
  settok(s); int l = 0; while (tokbuf[l]) l = l + 1; tokbuf[l - 1] = 0;
  if (is_cls(unq(Lv.ty))) {
    V ops[2]; ops[0] = Lv; ops[1] = R; char nb[80]; int k = 0; const char* pre = "operator"; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (s_off[s] + j < s_off[s] + s_len[s]) { nb[k] = chars[s_off[s] + j]; k = k + 1; j = j + 1; } nb[k] = 0;
    V u = user_op(intern_c(nb), ops, 2, 0); if (u.ty >= 0) return u; die("E_NOVIABLE", "operator bu sinif icin tanimli degil");
  }
  need_modifiable(Lv);
  if (is_cls(unq(R.ty))) R = unwrap_conv(R); else R = rval(R);
  V cur; if (is_ld(Lv.ty)) { cur = rval(Lv); } else { cur = mkv(unq(Lv.ty), 0, newreg()); w("  ld "); wr(cur.reg); w(", "); opr(Lv); w(", 0\n"); merge_eff(cur, Lv); add_eff(cur, Lv.key, 1); }
  if (is_ptr(Lv.ty) && !(streq(tokbuf, "+") || streq(tokbuf, "-"))) die("E_TYPE", "isaretciye bu islec uygulanamaz");
  char tok[64]; int ti = 0; while (tokbuf[ti]) { tok[ti] = tokbuf[ti]; ti = ti + 1; } tok[ti] = 0;
  V res = binop(tok, cur, R);
  if (tk[Lv.ty] == Y_BOOL || is_ptr(Lv.ty)) res = to_scalar(res, unq(Lv.ty), 0); else res = convert_arith(res, unq(Lv.ty));
  return store(Lv, res);
}
V gen_incdec(int n) {
  curline = nk_line[n]; int post = nk_k[n] == N_POSTINC; int inc = seqc(nk_s1[n], "++");
  V lv = gen(kid(n, 0));
  if (is_cls(unq(lv.ty))) { V ops[2]; ops[0] = lv; int no = 1; if (post) { ops[1] = imm(mkt(Y_INT, 0 - 1, 0), 0); no = 2; } V u = user_op(inc ? N_INC : N_DEC, ops, no, 0); if (u.ty >= 0) return u; die("E_NOVIABLE", "++/-- bu sinif icin tanimli degil"); }
  need_modifiable(lv); int t = unq(lv.ty);
  if (tk[t] == Y_BOOL) die("E_TYPE", "bool uzerinde ++/-- gecersiz");
  if (is_arith(t) == 0 && is_ptr(t) == 0) die("E_TYPE", "++/-- yalniz aritmetik/isaretci");
  V old; if (is_ld(t)) old = rval(lv); else { old = mkv(t, 0, newreg()); w("  ld "); wr(old.reg); w(", "); opr(lv); w(", 0\n"); } V nv;
  if (is_ptr(t)) nv = ptradd(old, imm(mkt(Y_INT, 0 - 1, 0), 1), inc == 0);
  else if (is_flt(t)) { V one = fconst(t, 4607182418800017408LL); nv = binop(inc ? "+" : "-", old, one); nv = convert_arith(nv, t); }
  else { V one = imm(mkt(Y_INT, 0 - 1, 0), 1); nv = binop(inc ? "+" : "-", old, one); nv = convert_arith(nv, t); }
  if (is_ld(t)) ld_copy(lv, nv); else { w("  st "); opr(mat(nv)); w(", "); opr(lv); w(", 0\n"); }
  V res;
  if (post) { res = old; res.cat = 0; res.ne = 0; merge_eff(res, lv); add_eff(res, lv.key, 2); res.key = 0; }
  else { res = lv; add_eff(res, lv.key, 2); }
  return res;
}
V gen_unary(int n) {
  curline = nk_line[n]; int s = nk_s1[n]; V v = gen(kid(n, 0));
  if (seqc(s, "&")) {
    if (is_cls(unq(v.ty))) { V ops[1]; ops[0] = v; V u = user_op(N_ADDR, ops, 1, 0); if (u.ty >= 0) return u; }
    if (v.cat != 1) die("E_ADDR", "adresi alinamaz: lvalue gerekli");
    V r = mkv(ptrto(v.ty), 0, v.reg); merge_eff(r, v); return r;
  }
  if (seqc(s, "*")) {
    if (is_cls(unq(v.ty))) { V ops[1]; ops[0] = v; V u = user_op(N_DEREF, ops, 1, 0); if (u.ty >= 0) return u; v = unwrap_conv(v); }
    v = rval(v); if (is_ptr(v.ty) == 0) die("E_TYPE", "'*' isaretci gerektirir");
    if (is_void(te[v.ty])) die("E_TYPE", "void isaretcisi dolayli erisilemez");
    nullchk(v); V m = mat(v); V r = mkv(te[v.ty], 1, m.reg); r.vp = 1; merge_eff(r, v); return r;
  }
  if (is_cls(unq(v.ty))) {
    V ops[1]; ops[0] = v; char nb[80]; int k = 0; const char* pre = "operator"; while (pre[k]) { nb[k] = pre[k]; k = k + 1; } int j = 0; while (j < s_len[s]) { nb[k] = chars[s_off[s] + j]; k = k + 1; j = j + 1; } nb[k] = 0;
    V u = user_op(intern_c(nb), ops, 1, 0); if (u.ty >= 0) return u;
    if (seqc(s, "!")) { V b = cond_bool(v); long long d = newreg(); ins3("eq", d, mat(b), imm(bool_t(), 0)); V o = mkv(bool_t(), 0, d); merge_eff(o, b); return o; }
    v = unwrap_conv(v);
  }
  v = rval(v);
  if (seqc(s, "!")) { V b = cond_bool(v); if (b.ci) { V o = imm(bool_t(), b.cv == 0); o.ne = b.ne; return o; } long long d = newreg(); ins3("eq", d, mat(b), imm(bool_t(), 0)); V o = mkv(bool_t(), 0, d); merge_eff(o, v); return o; }
  if (is_arith(v.ty) == 0) die("E_TYPE", "tekli islec aritmetik operand gerektirir");
  if (seqc(s, "+")) { if (is_int(v.ty)) return convert_arith(v, promote(v.ty)); return v; }
  if (seqc(s, "-")) {
    if (is_ld(v.ty)) { long long p = ld_load(v); long long d = newreg2(); ins2t(names[NM_NEG80], d, mkv(0, 0, p)); V o = ld_new(d); merge_eff(o, v); return o; }
    if (is_flt(v.ty)) { long long d = newreg(); ins2t(names[NM_FNEG], d, v); return mkv(v.ty, 0, d); }
    int t = promote(v.ty); v = convert_arith(v, t);
    if (v.ci) { V o = imm(t, fold(0 - v.cv, t)); o.ne = v.ne; return o; }
    long long d = newreg(); ins2t(names[NM_NEG], d, mat(v)); V o = norm(mkv(t, 0, d), t); merge_eff(o, v); return o;
  }
  if (seqc(s, "~")) {
    if (is_int(v.ty) == 0) die("E_TYPE", "'~' tamsayi gerektirir");
    int t = promote(v.ty); v = convert_arith(v, t);
    if (v.ci) { V o = imm(t, fold(~v.cv, t)); o.ne = v.ne; return o; }
    long long d = newreg(); ins2t(names[NM_NOT], d, mat(v)); V o = norm(mkv(t, 0, d), t); merge_eff(o, v); return o;
  }
  die("E_OP", "bilinmeyen tekli islec"); return v;
}
V gen_cond(int n) {
  curline = nk_line[n]; V c = cond_bool(gen(kid(n, 0)));
  int save_throw = may_throw;
  dry = dry + 1; V a0 = gen(kid(n, 1)); V b0 = gen(kid(n, 2)); dry = dry - 1; may_throw = save_throw;
  int at = unq(a0.ty); int bt = unq(b0.ty); long long res = newreg(); int els = newlab(); int end = newlab();
  int va = is_void(at); int vb = is_void(bt);
  if (va || vb) { if (!(va && vb)) die("E_TYPE", "?: kollarindan biri void, digeri degil"); w("  jz "); opr(c); w(", "); wl(els); wc(10); gen(kid(n, 1)); w("  jmp "); wl(end); wc(10); wl(els); w(":\n"); gen(kid(n, 2)); wl(end); w(":\n"); return novalue(); }
  if (is_cls(at) && at == bt) {
    int lv = a0.cat == 1 && b0.cat == 1 && tcv[a0.ty] == tcv[b0.ty];
    w("  jz "); opr(c); w(", "); wl(els); wc(10); V a1 = gen(kid(n, 1));
    if (lv == 0) a1 = to_class_value(a1, at);
    w("  mov "); wr(res); w(", "); opr(a1); wc(10); w("  jmp "); wl(end); wc(10); wl(els); w(":\n");
    V b1 = gen(kid(n, 2)); if (lv == 0) b1 = to_class_value(b1, at);
    w("  mov "); wr(res); w(", "); opr(b1); wc(10); wl(end); w(":\n");
    V r = mkv(a0.ty, 0, res); if (lv) r.cat = 1; else if (a0.cat == 2 && b0.cat == 2) r.cat = 2; r.vp = 1; merge_eff(r, c); return r;
  }
