  N_CONV = intern_c("operator conv"); N_CALLOP = intern_c("operator()"); N_EQ = intern_c("operator=="); N_NE = intern_c("operator!="); N_SS = intern_c("operator<=>"); N_ASG = intern_c("operator=");
  N_DEREF = intern_c("operator*"); N_ADDR = intern_c("operator&"); N_IDX = intern_c("operator[]"); N_ARW = intern_c("operator->"); N_INC = intern_c("operator++"); N_DEC = intern_c("operator--");
  N_PROMISE = intern_c("__promise"); N_COFINAL = intern_c("__cofinal"); N_THISV = intern_c("this"); N_VAP = intern_c("__va_p"); N_VAN = intern_c("__va_n"); N_LTHIS = intern_c("__this"); N_SRET = intern_c("__sret"); N_ONAME = intern_c("__o");
  { int bi = 0; while (bi < 4) { const char* nmx = "std::strong_ordering"; if (bi == 1) nmx = "std::weak_ordering"; if (bi == 2) nmx = "std::partial_ordering"; if (bi == 3) nmx = "std::type_info";
      int c = newclass(intern_c(nmx)); cl_def[c] = 1; cl_words[c] = 1; cl_bi[c] = bi + 1; cl_size[c] = 1; cl_align[c] = 1; if (bi == 3) { cl_size[c] = 16; cl_align[c] = 8; }
      fl_name[nfl] = intern_c("__v"); fl_ty[nfl] = mkt(Y_INT, 0 - 1, 0); fl_woff[nfl] = 0; fl_boff[nfl] = 0; cl_f0[c] = nfl; cl_nf[c] = 1; nfl = nfl + 1; bi = bi + 1; } }
