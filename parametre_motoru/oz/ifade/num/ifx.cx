// ---- donusumler ----
int casts_away(int from, int to) {
  while (1) {
    if (tk[from] != Y_PTR || tk[to] != Y_PTR) return 0;
    int fe = te[from]; int tee = te[to];
    if (tcv[fe] && tcv[tee] == 0) return 1;
    from = fe; to = tee; if (tk[from] != Y_PTR) return 0;
  }
  return 0;
}
V static_cast_(V v, int T) {
  if (is_void(T)) { V o = novalue(); o.ne = v.ne; return o; }
  if (is_ref(T)) {
    int rr = tk[T] == Y_RREF; int tgt = te[T]; int tu = unq(tgt); int au = unq(v.ty);
    int rel = au == tu || (is_cls(au) && is_cls(tu) && (derived_from(tcl[au], tcl[tu]) || derived_from(tcl[tu], tcl[au])));
    if (rel) {
      if (tcv[v.ty] && tcv[tgt] == 0) die("E_CONSTCAST", "static_cast const'i kaldiramaz");
      if (rr == 0 && v.cat != 1 && tcv[tgt] == 0) die("E_BIND", "static_cast<T&>: lvalue gerekli");
      if (rr && v.cat == 1) { V o = v; o.cat = 2; o.ty = tgt; return o; }
      if (v.cat == 0 && is_cls(au) == 0) { V t = tempscalar(au, v); t.cat = 1; if (rr) t.cat = 2; t.ty = tgt; return t; }
      V o = v; o.ty = tgt; o.cat = 1; if (rr) o.cat = 2; return o;
    }
    if (rr == 0 && tcv[tgt] == 0) die("E_BIND", "static_cast<T&>: uyumsuz tur");
    if (is_cls(tu)) { V s = to_class_value(v, tu); s.cat = 1; if (rr) s.cat = 2; s.ty = tgt; return s; }
    V s = to_scalar(v, tu, 0); V t = tempscalar(tu, s); t.cat = 1; if (rr) t.cat = 2; t.ty = tgt; return t;
  }
  if (is_cls(unq(T))) return to_class_value(v, T);
  if (is_arith(T)) { if (is_cls(unq(v.ty))) return to_scalar(v, T, 1); V r = rval(v); if (is_arith(r.ty) == 0) die("E_CAST", "static_cast gecersiz"); return convert_arith(r, T); }
  if (is_ptr(T)) {
    if (is_cls(unq(v.ty))) return to_scalar(v, T, 1);
    V r = rval(v);
    if (tk[r.ty] == Y_NULLPTR || (is_int(r.ty) && r.ci && r.cv == 0 && r.nl)) { V o = imm(unq(T), 0); o.ne = r.ne; return o; }
    if (is_ptr(r.ty) == 0) die("E_CAST", "static_cast: reinterpret_cast gerekir");
    int fe = te[r.ty]; int tee = te[T];
    if (casts_away(r.ty, T)) die("E_CONSTCAST", "static_cast const'i kaldiramaz");
    int ok = unq(fe) == unq(tee) || is_void(tee) || is_void(fe) || (is_cls(fe) && is_cls(tee) && (derived_from(tcl[fe], tcl[tee]) || derived_from(tcl[tee], tcl[fe])));
    if (ok == 0) die("E_CAST", "static_cast: iliskisiz isaretci turleri");
    V o = r; o.ty = unq(T); return o;
  }
  if (tk[T] == Y_NULLPTR) { V r = rval(v); if (tk[r.ty] != Y_NULLPTR) die("E_CAST", "nullptr_t'ye donusum yok"); return r; }
  die("E_CAST", "static_cast hedef turu desteklenmiyor"); return v;
}
int view_compat(int a, int b) {   // iki nesne turunun sozcuk-modelindeki gosterimi uyumlu mu (okuma/yazma ayni degeri verir)
  a = unq(a); b = unq(b); while (is_arr(a)) a = unq(te[a]); while (is_arr(b)) b = unq(te[b]);
  if (a == b || is_void(a) || is_void(b)) return 1;
  if (is_cls(a) || is_cls(b)) return is_cls(a) && is_cls(b);
  if (is_int(a) && is_int(b) && tk[a] != Y_BOOL && tk[b] != Y_BOOL && size_of(a) == size_of(b)) return 1;
  if ((is_int(a) && is_flt(b)) || (is_flt(a) && is_int(b))) { int i = a; int f = b; if (is_flt(a)) { i = b; f = a; } return tk[f] == Y_DOUBLE && size_of(i) == 8 && tk[i] != Y_BOOL; }
  return 0;
}
V reinterpret_cast_(V v, int T) {
  if (is_ref(T)) {
    if (v.cat != 1 && tk[T] != Y_RREF) die("E_LVALUE", "reinterpret_cast<T&>: lvalue gerekli");
    int tgt = te[T]; int vt = v.ty;
    if (tcv[vt] && tcv[tgt] == 0) die("E_CONSTCAST", "reinterpret_cast const'i kaldiramaz");
    if (is_sc(unq(vt)) && is_sc(unq(tgt)) && size_of(vt) != size_of(tgt)) die("E_REINTERP", "boyutlar farkli -- motor sozcuk modelinde bayt gorunumu yok");
    if (view_compat(vt, tgt) == 0) die("E_REINTERP", "bu turler arasi bit gorunumu yok (f32/f80/bool/sinif-skaler gosterimi farkli)");
    V o = v; o.ty = tgt; o.cat = 1; if (tk[T] == Y_RREF) o.cat = 2; return o;
  }
  V r = rval(v); T = unq(T);
  if (r.ty == T && (is_int(T) || is_ptr(T) || is_flt(T))) return r;
  if (is_ptr(T)) {
    if (is_ptr(r.ty)) {
      if (casts_away(r.ty, T)) die("E_CONSTCAST", "reinterpret_cast const'i kaldiramaz");
      int se = unq(te[r.ty]); while (is_arr(se)) se = unq(te[se]); int de = unq(te[T]); while (is_arr(de)) de = unq(te[de]);
      V o = r; o.ty = T; int one = is_int(de) && tk[de] != Y_BOOL && size_of(de) == 1;
      if (r.bp) {   // kaynak bayt adresli (bp = asil nesne boyutu)
        if (one) return o;
        if ((is_int(de) || tk[de] == Y_DOUBLE) && tk[de] != Y_BOOL && size_of(de) == r.bp) { long long q = newreg(); ins3("div", q, cast_k(mat(r), 0), imm(0, r.bp)); V bk = cast_k(mkv(0, 0, q), 1); bk.ty = T; return bk; }
        die("E_REINTERP", "bayt adresli isaretci yalniz 1 baytlik ture ya da asil nesne boyutundaki ture cevrilebilir");
      }
      if (view_compat(se, de)) return o;
      if (one && (is_int(se) || tk[se] == Y_DOUBLE) && tk[se] != Y_BOOL && size_of(se) > 1) {   // nesnenin baytlarina bakis: bayt adresi = sozcuk adresi * boyut
        long long S = size_of(se); long long q = newreg(); ins3("mul", q, cast_k(mat(r), 0), imm(0, S)); V bk = cast_k(mkv(0, 0, q), 1); bk.ty = T; bk.bp = S; return bk;
      }
      die("E_REINTERP", "bu isaretci donusumu icin bayt/bit gorunumu yok (yalniz tamsayi/double nesnelerin 1 baytlik turle gorunumu desteklenir)");
    }
    if (is_int(r.ty)) {
      if (size_of(r.ty) != 8) die("E_REINTERP", "tamsayidan isaretciye yalniz 64 bit tamsayi");
      if (r.ci && r.cv == 0) { V z = imm(T, 0); return z; }
      V o = mkv(T, 0, newreg()); ins3("sar", o.reg, r, imm(0, 3)); merge_eff(o, r); return o;
    }
    die("E_REINTERP", "reinterpret_cast gecersiz");
  }
  if (is_int(T) && is_ptr(r.ty)) {
    if (tk[T] == Y_BOOL || size_of(T) != 8) die("E_REINTERP", "isaretciden tamsayiya yalniz 64 bit tamsayi");
    V o = mkv(T, 0, newreg()); ins3("shl", o.reg, r, imm(0, 3)); merge_eff(o, r); return o;
  }
  die("E_REINTERP", "reinterpret_cast gecersiz"); return v;
}
V const_cast_(V v, int T) {
  if (is_ref(T)) {
    if (v.cat != 1 && tk[T] != Y_RREF) die("E_LVALUE", "const_cast<T&>: lvalue gerekli");
    if (unq(v.ty) != unq(te[T])) die("E_CONSTCAST", "const_cast yalniz cv niteleyicilerini degistirir");
    V o = v; o.ty = te[T]; if (tk[T] == Y_RREF) o.cat = 2; return o;
  }
  V r = rval(v); T = unq(T);
  if (is_ptr(T) == 0 || is_ptr(r.ty) == 0) die("E_CONSTCAST", "const_cast yalniz isaretci/referans");
  int f = r.ty; int t = T;
  while (is_ptr(f) && is_ptr(t)) { f = te[f]; t = te[t]; if (unq(f) == unq(t)) break; }
  if (unq(f) != unq(t)) die("E_CONSTCAST", "const_cast yalniz cv niteleyicilerini degistirir");
  V o = r; o.ty = T; return o;
}
int type_id_of(int t) { t = unq(deref(t)); if (is_cls(t)) return cl_id[tcl[t]]; return 1000 + t; }
int isa_need[200]; int nisa = 0; int ti_seen[600]; int nti_seen = 0;
void note_typeid(int id, int t) { int i = 0; while (i < nti_seen) { if (ti_seen[i] == id) return; i = i + 1; } if (nti_seen < 600) { ti_seen[nti_seen] = id; nti_seen = nti_seen + 1; ti_types[id % 600] = t; } }
int ti_types[600];
