  long long nd = rd(); o = 0; while (o < nd) { rd(); rd(); rd(); o = o + 1; }
  long long nh = rd(); o = 0; while (o < nh) { long long id = rd(); long long dn = rd(); long long a0 = rd(); long long a1 = rd(); long long a2 = rd(); if (id < 64) { host_sig[id * 4] = dn; host_sig[id * 4 + 1] = a0; host_sig[id * 4 + 2] = a1; host_sig[id * 4 + 3] = a2; } o = o + 1; }
