// ---- donusumler ----
int casts_away(int from, int to) {
  while (1) {
    if (tk[from] != Y_PTR || tk[to] != Y_PTR) return 0;
    int fe = te[from]; int tee = te[to];
    if (tcv[fe] && tcv[tee] == 0) return 1;
    from = fe; to = tee; if (tk[from] != Y_PTR) return 0;
  }
  return 0;
}
V static_cast_(V v, int T) {
  if (is_void(T)) { V o = novalue(); o.ne = v.ne; return o; }
  if (is_ref(T)) {
    int rr = tk[T] == Y_RREF; int tgt = te[T]; int tu = unq(tgt); int au = unq(v.ty);
    int rel = au == tu || (is_cls(au) && is_cls(tu) && (derived_from(tcl[au], tcl[tu]) || derived_from(tcl[tu], tcl[au])));
    if (rel) {
      if (tcv[v.ty] && tcv[tgt] == 0) die("E_CONSTCAST", "static_cast const'i kaldiramaz");
      if (rr == 0 && v.cat != 1 && tcv[tgt] == 0) die("E_BIND", "static_cast<T&>: lvalue gerekli");
      if (rr && v.cat == 1) { V o = v; o.cat = 2; o.ty = tgt; return o; }
      if (v.cat == 0 && is_cls(au) == 0) { V t = tempscalar(au, v); t.cat = 1; if (rr) t.cat = 2; t.ty = tgt; return t; }
      V o = v; o.ty = tgt; o.cat = 1; if (rr) o.cat = 2; return o;
    }
    if (rr == 0 && tcv[tgt] == 0) die("E_BIND", "static_cast<T&>: uyumsuz tur");
    if (is_cls(tu)) { V s = to_class_value(v, tu); s.cat = 1; if (rr) s.cat = 2; s.ty = tgt; return s; }
    V s = to_scalar(v, tu, 0); V t = tempscalar(tu, s); t.cat = 1; if (rr) t.cat = 2; t.ty = tgt; return t;
  }
  if (is_cls(unq(T))) return to_class_value(v, T);
  if (is_arith(T)) { if (is_cls(unq(v.ty))) return to_scalar(v, T, 1); V r = rval(v); if (is_arith(r.ty) == 0) die("E_CAST", "static_cast gecersiz"); return convert_arith(r, T); }
  if (is_ptr(T)) {
    if (is_cls(unq(v.ty))) return to_scalar(v, T, 1);
    V r = rval(v);
    if (tk[r.ty] == Y_NULLPTR || (is_int(r.ty) && r.ci && r.cv == 0 && r.nl)) { V o = imm(unq(T), 0); o.ne = r.ne; return o; }
    if (is_ptr(r.ty) == 0) die("E_CAST", "static_cast: reinterpret_cast gerekir");
    int fe = te[r.ty]; int tee = te[T];
    if (casts_away(r.ty, T)) die("E_CONSTCAST", "static_cast const'i kaldiramaz");
    int ok = unq(fe) == unq(tee) || is_void(tee) || is_void(fe) || (is_cls(fe) && is_cls(tee) && (derived_from(tcl[fe], tcl[tee]) || derived_from(tcl[tee], tcl[fe])));
    if (ok == 0) die("E_CAST", "static_cast: iliskisiz isaretci turleri");
    V o = r; o.ty = unq(T); return o;
  }
  if (tk[T] == Y_NULLPTR) { V r = rval(v); if (tk[r.ty] != Y_NULLPTR) die("E_CAST", "nullptr_t'ye donusum yok"); return r; }
  die("E_CAST", "static_cast hedef turu desteklenmiyor"); return v;
}
V reinterpret_cast_(V v, int T) {
  if (is_ref(T)) {
    if (v.cat != 1 && tk[T] != Y_RREF) die("E_LVALUE", "reinterpret_cast<T&>: lvalue gerekli");
    int tgt = te[T]; int vt = v.ty;
    if (tcv[vt] && tcv[tgt] == 0) die("E_CONSTCAST", "reinterpret_cast const'i kaldiramaz");
    if (is_sc(unq(vt)) && is_sc(unq(tgt)) && size_of(vt) != size_of(tgt)) die("E_REINTERP", "boyutlar farkli -- motor sozcuk modelinde bayt gorunumu yok");
    V o = v; o.ty = tgt; o.cat = 1; if (tk[T] == Y_RREF) o.cat = 2; return o;
  }
  V r = rval(v); T = unq(T);
  if (r.ty == T && (is_int(T) || is_ptr(T) || is_flt(T))) return r;
