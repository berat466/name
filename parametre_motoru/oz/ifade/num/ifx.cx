V gen_cast(int n) {
  curline = nk_line[n]; int T = typeof_(kid(n, 0));
  if (tk[T] == Y_AUTO) die("E_TYPE", "auto donusum hedefi olamaz");
  V v = gen(kid(n, 1)); int s = nk_s1[n];
  if (seqc(s, "static_cast")) return static_cast_(v, T);
  if (seqc(s, "dynamic_cast")) return dynamic_cast_(v, T);
  if (seqc(s, "const_cast")) return const_cast_(v, T);
  if (seqc(s, "reinterpret_cast")) return reinterpret_cast_(v, T);
  // C tipi: once static, olmazsa const_cast / reinterpret_cast (hata tuzagi ile degil: on-deneme)
  return c_style_cast(v, T);
}
