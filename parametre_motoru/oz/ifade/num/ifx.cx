// ifx -- PMX1 SAYISAL IFADE DERLEYICISI (cekirdek).  Bu dosya ifx.pmb'nin GELISTIRME GORUNUMUDUR: kanonik urun ifx.pmb (sayisal program) ve
// komutlar.pmk bolum 12 (IFADE KURAL TABLOSU)'dur. ifx.pmb calisma aninda stdin'den SAYI akisi okur:  <komutlar.pmk sayilari> <PMX1 sayilari>
// ve PMA metnini stdout'a yazar. Tur ozellikleri, operator->komut eslemesi, normallestirme/donusum komut adlari TABLODAN okunur (bu kodda sabit degil).
// Desteklenen cekirdek: skaler/isaretci/dizi, tum tekli/ikili/atama/?:/virgul/++/--, static_cast/C tipi donusum, sizeof, cagri, if/while/do/for/return/break/continue.
// Desteklenmeyen dugum (sinif, referans, dize, UDL ...) AYRIK hata verir ("@@HATA desteklenmiyor"): sessizce yanlis kod uretilmez.
const int NN = 40000;
const int NK = 120000;
const int NC = 120000;
const int NR = 20000;
long long RT[NR]; int nrt = 0;
// ---- PMX1 ----
int nk_k[NN]; long long nk_i[NN], nk_j[NN], nk_d[NN]; int nk_s1[NN], nk_s2[NN], nk_n[NN], nk_ks[NN]; int kids[NK]; int nkids = 0;
int s_off[4000], s_len[4000]; char chars[NC]; int nchars = 0; int nstr = 0; int nnodes = 0; int root = 0;
// ---- yardimci G/C ----
int dry = 0; int nreg = 0; int nlab = 0; int foff = 0;
void wc(int c) { if (dry == 0) __putc(c); }
void w(const char* s) { while (*s) { wc(*s); s++; } }
void wn(long long v) { if (dry == 0) __puti(v); }
void wr(long long r) { w("t"); wn(r); }
void wl(long long l) { w("L"); wn(l); }
void die(const char* m) { dry = 0; w("@@HATA "); w(m); wc(10); long long* p = 0; p = p - 1; long long z = *p; wn(z); }
// ---- girdi ----
int rdc() { return __getc(); }
long long rd() {
  int c = rdc();
  while (c == ' ' || c == 10 || c == 9 || c == 13) c = rdc();
  if (c < 0) { die("girdi erken bitti"); }
  int neg = 0;
  if (c == '-') { neg = 1; c = rdc(); }
  long long v = 0;
  while (c >= '0' && c <= '9') { v = v * 10 + (c - '0'); c = rdc(); }
  if (neg) return 0 - v;
  return v;
}
// ---- kural tablosu (PMK1 bolum 12) ----
// yuk: nrec ; kayit: sinif nstr (len chars...)*nstr nnum nums*nnum   (sinif 1 TUR, 2 IKILI, 3 KARSILASTIRMA, 4 AD)
int rec_off[400]; int nrec = 0;
long long ty_bits[32], ty_sg[32], ty_cls[32], ty_rank[32]; long long ty_norm[32]; int ty_ok[32];
long long names[32];
int rstr_pos(int r, int idx) {   // kaydin idx. dizgesinin RT'deki konumu (uzunluk sozcugu)
  int p = rec_off[r]; p = p + 1; int ns = RT[p]; p = p + 1;
  int i = 0;
  while (i < idx) { p = p + 1 + RT[p]; i = i + 1; }
  return p;
}
long long rnum(int r, int idx) {
  int p = rec_off[r]; p = p + 1; int ns = RT[p]; p = p + 1;
  int i = 0;
  while (i < ns) { p = p + 1 + RT[p]; i = i + 1; }
  return RT[p + 1 + idx];
}
void wrt(int p) { int n = RT[p]; int i = 0; while (i < n) { wc(RT[p + 1 + i]); i = i + 1; } }
int rt_len(int p) { return RT[p]; }
int slen(int sid) { if (sid < 0) return 0; return s_len[sid]; }
int soff(int sid) { if (sid < 0) return 0; return s_off[sid]; }
int seq_rt_pool(int sid, int p) {   // PMX1 dizgesi == tablo dizgesi
  if (sid < 0) return rt_len(p) == 0;
  if (s_len[sid] != rt_len(p)) return 0;
  int i = 0;
  while (i < s_len[sid]) { if (chars[s_off[sid] + i] != RT[p + 1 + i]) return 0; i = i + 1; }
  return 1;
}
int seqc(int sid, const char* t) {
  if (sid < 0) return 0;
  int n = 0; while (t[n]) n = n + 1;
  if (n != s_len[sid]) return 0;
  int i = 0; while (i < n) { if (chars[s_off[sid] + i] != t[i]) return 0; i = i + 1; }
  return 1;
}
void load_rules() {
  int p = 0; nrec = RT[p]; p = p + 1;
  int r = 0;
  while (r < nrec) {
    rec_off[r] = p;
    int cls = RT[p]; int ns = RT[p + 1]; int q = p + 2; int i = 0;
    while (i < ns) { q = q + 1 + RT[q]; i = i + 1; }
    int nn = RT[q]; q = q + 1 + nn; p = q; r = r + 1;
  }
  r = 0;
  while (r < nrec) {
    int cls = RT[rec_off[r]];
    if (cls == 1) {
      int tc = rnum(r, 0);
      ty_ok[tc] = 1; ty_bits[tc] = rnum(r, 1); ty_sg[tc] = rnum(r, 2); ty_cls[tc] = rnum(r, 3); ty_rank[tc] = rnum(r, 4);
      ty_norm[tc] = rstr_pos(r, 1);
    }
    if (cls == 4) { int i = 0; while (i < 16) { names[i] = rstr_pos(r, i); i = i + 1; } }
    r = r + 1;
  }
}
const int NM_I2F = 0; const int NM_U2F = 1; const int NM_F2I = 2; const int NM_F2U = 3; const int NM_RND = 4; const int NM_NEG = 5; const int NM_FNEG = 6; const int NM_NOT = 7; const int NM_FEQ = 8;
// ---- turler ----
int tk[400]; int te[400]; long long tn[400]; int nty = 0;
const int Y_BOOL = 1; const int Y_CHAR = 2; const int Y_INT = 7; const int Y_UINT = 8; const int Y_LONG = 9; const int Y_ULONG = 10; const int Y_FLOAT = 13; const int Y_DOUBLE = 14; const int Y_PTR = 17; const int Y_ARR = 20; const int Y_VOID = 0;
int mkt(int k, int e, long long n) {
  int i = 0;
  while (i < nty) { if (tk[i] == k && te[i] == e && tn[i] == n) return i; i = i + 1; }
  tk[nty] = k; te[nty] = e; tn[nty] = n; nty = nty + 1; return nty - 1;
}
int is_int(int t) { return tk[t] >= 1 && tk[t] <= 12; }
int is_flt(int t) { return tk[t] == 13 || tk[t] == 14; }
int is_ptr(int t) { return tk[t] == 17; }
int is_arr(int t) { return tk[t] == 20; }
int is_sc(int t) { return is_int(t) || is_flt(t) || is_ptr(t); }
int bits_of(int t) { if (is_ptr(t)) return 64; return ty_bits[tk[t]]; }
int sg_of(int t) { if (is_ptr(t)) return 0; return ty_sg[tk[t]]; }
int rank_of(int t) { return ty_rank[tk[t]]; }
long long size_of(int t) {
  if (is_arr(t)) return tn[t] * size_of(te[t]);
  if (is_ptr(t)) return 8;
  if (tk[t] == Y_VOID) die("void boyutu yok");
  return ty_bits[tk[t]] / 8;
}
long long words_of(int t) { if (is_arr(t)) return tn[t] * words_of(te[t]); return 1; }
int promote(int t) { if (is_int(t) && rank_of(t) < 4) return mkt(Y_INT, -1, 0); return t; }
int uac(int x, int y) {
  if (tk[x] == 15 || tk[y] == 15) die("desteklenmiyor: long double");
  if (tk[x] == Y_DOUBLE || tk[y] == Y_DOUBLE) return mkt(Y_DOUBLE, -1, 0);
  if (tk[x] == Y_FLOAT || tk[y] == Y_FLOAT) return mkt(Y_FLOAT, -1, 0);
  x = promote(x); y = promote(y);
  if (x == y) return x;
  int sx = sg_of(x); int sy = sg_of(y);
  if (sx == sy) { if (rank_of(x) >= rank_of(y)) return x; return y; }
  int u = x; int s = y; if (sx) { u = y; s = x; }
  if (rank_of(u) >= rank_of(s)) return u;
  if (bits_of(s) > bits_of(u)) return s;
  if (tk[s] == 9) return mkt(10, -1, 0);
  if (tk[s] == 11) return mkt(12, -1, 0);
  return mkt(Y_UINT, -1, 0);
}
int uns64(int t) { return is_int(t) && sg_of(t) == 0 && bits_of(t) == 64; }
// ---- deger ----
struct V { long long ty; long long cat; long long reg; long long ci; long long cv; };
V mkv(long long ty, long long cat, long long reg) { V v; v.ty = ty; v.cat = cat; v.reg = reg; v.ci = 0; v.cv = 0; return v; }
V imm(long long ty, long long val) { V v; v.ty = ty; v.cat = 0; v.reg = 0 - 1; v.ci = 1; v.cv = val; return v; }
long long newreg() { nreg = nreg + 1; return nreg - 1; }
void opr(V v) { if (v.reg < 0) wn(v.cv); else wr(v.reg); }
void ins2(const char* op, long long d, V a) { w("  "); w(op); w(" "); wr(d); w(", "); opr(a); wc(10); }
void ins3(const char* op, long long d, V a, V b) { w("  "); w(op); w(" "); wr(d); w(", "); opr(a); w(", "); opr(b); wc(10); }
void ins2t(int nm, long long d, V a) { w("  "); wrt(nm); w(" "); wr(d); w(", "); opr(a); wc(10); }
void ins3t(int nm, long long d, V a, V b) { w("  "); wrt(nm); w(" "); wr(d); w(", "); opr(a); w(", "); opr(b); wc(10); }
V mat(V v) {   // anlik -> yazmac
  if (v.reg >= 0) return v;
  long long r = newreg(); w("  mov "); wr(r); w(", "); wn(v.cv); wc(10);
  V o = v; o.reg = r; o.ci = 0; return o;
}
long long ndat = 0; long long dat[2000];
V fconst(int ty, long long bits) {
  dat[ndat] = bits; ndat = ndat + 1;
  long long a = newreg(); long long r = newreg();
  w("  mov "); wr(a); w(", d"); wn(ndat - 1); wc(10);
  w("  ld "); wr(r); w(", "); wr(a); w(", 0\n");
  return mkv(ty, 0, r);
}
void trapnow() { long long r = newreg(); w("  ld "); wr(r); w(", -1, 0\n"); }
void nullchk(V p) {
  if (dry) return;
  long long ok = nlab; nlab = nlab + 1;
  V m = mat(p);
  w("  jnz "); wr(m.reg); w(", "); wl(ok); wc(10); trapnow(); wl(ok); w(":\n");
}
// normallestirme: tablo (ty_norm) bos degilse o komut; bool icin ne
V norm(V v, int t) {
  if (is_flt(t)) { if (tk[t] == Y_FLOAT) { V m = mat(v); long long d = newreg(); ins2t(names[NM_RND], d, m); return mkv(t, 0, d); } v.ty = t; return v; }
  if (tk[t] == Y_BOOL) { V m = mat(v); long long d = newreg(); ins3("ne", d, m, imm(t, 0)); return mkv(t, 0, d); }
  if (is_ptr(t) || bits_of(t) == 64) { v.ty = t; return v; }
  V m = mat(v); long long d = newreg(); ins2t(ty_norm[tk[t]], d, m); return mkv(t, 0, d);
}
V rval(V v) {
  if (is_arr(v.ty)) { V r = v; r.ty = mkt(Y_PTR, te[v.ty], 0); r.cat = 0; return r; }
  if (v.cat == 0) return v;
  long long d = newreg(); w("  ld "); wr(d); w(", "); opr(v); w(", 0\n");
  return mkv(v.ty, 0, d);
}
long long fold(long long x, int t) {   // sabit normallestirme (tablodaki bit/isaret ozelliklerinden)
  if (tk[t] == Y_BOOL) { if (x != 0) return 1; return 0; }
  if (is_ptr(t) || bits_of(t) >= 64) return x;
  int sh = 64 - bits_of(t);
  if (sg_of(t)) return (x << sh) >> sh;
  return (x << sh) >> sh & ((1LL << bits_of(t)) - 1);
}
V convert(V v, int to) {   // v rvalue skaler -> to
  int from = v.ty;
  if (from == to) return v;
  if (is_int(from) && is_int(to)) {
    if (v.ci) return imm(to, fold(v.cv, to));
    int need = 1;
    if (tk[to] != Y_BOOL) {
      if (tk[from] == Y_BOOL) need = 0;
      else if (sg_of(from) == sg_of(to) && bits_of(to) >= bits_of(from)) need = 0;
      else if (sg_of(from) == 0 && sg_of(to) == 1 && bits_of(to) > bits_of(from)) need = 0;
      else if (bits_of(to) == 64) need = 0;
    }
    if (!need) { v.ty = to; return v; }
    return norm(v, to);
  }
  if (is_int(from) && is_flt(to)) {
    V m = mat(v); long long d = newreg();
    if (uns64(from)) ins2t(names[NM_U2F], d, m); else ins2t(names[NM_I2F], d, m);
    V o = mkv(to, 0, d); if (tk[to] == Y_FLOAT) return norm(o, to); return o;
  }
  if (is_flt(from) && is_int(to)) {
    V m = mat(v);
    if (tk[to] == Y_BOOL) { long long t1 = newreg(); ins3t(names[NM_FEQ], t1, m, fconst(from, 0)); long long d = newreg(); ins3("eq", d, mkv(from, 0, t1), imm(to, 0)); return mkv(to, 0, d); }
    long long d = newreg(); if (uns64(to)) ins2t(names[NM_F2U], d, m); else ins2t(names[NM_F2I], d, m);
    V o = mkv(to, 0, d); if (bits_of(to) < 64) return norm(o, to); return o;
  }
  if (is_flt(from) && is_flt(to)) { if (tk[to] == Y_FLOAT) return norm(v, to); v.ty = to; return v; }
  if (is_ptr(to)) {
    if (is_ptr(from)) { v.ty = to; return v; }
    if (is_int(from) && v.ci && v.cv == 0) { return imm(to, 0); }
    die("ortuk donusum yok: isaretciye");
  }
  if (is_int(from) && is_ptr(from) == 0 && tk[to] == Y_BOOL && is_ptr(from)) { }
  if (is_ptr(from) && tk[to] == Y_BOOL) { V m = mat(v); long long d = newreg(); ins3("ne", d, m, imm(from, 0)); return mkv(to, 0, d); }
  die("ortuk donusum yok"); return v;
}
V condbool(V v) {
  v = rval(v);
  if (!is_sc(v.ty)) die("kosul skaler olmali");
  return convert(v, mkt(Y_BOOL, -1, 0));
}
// ---- sembol/islev tablolari ----
int vname[2000]; int vty[2000]; int voff[2000]; int nvars = 0;
int fn_name[400]; int fn_ret[400]; int fn_np[400]; int fn_pt[3200]; int fn_node[400]; int fn_bi[400]; int nfn = 0; int cur_fn = 0;
int kid(int n, int i) { return kids[nk_ks[n] + i]; }
int slot(long long w) { int o = foff; foff = foff + w; if (w < 1) foff = o + 1; return o; }
int nodek(int n) { return nk_k[n]; }
const int N_INT = 0; const int N_FLT = 1; const int N_CHR = 2; const int N_BOOL = 4; const int N_NULLPTR = 5; const int N_ID = 7; const int N_UNARY = 8; const int N_BINARY = 9; const int N_ASSIGN = 10;
const int N_COND = 11; const int N_COMMA = 12; const int N_CALL = 13; const int N_INDEX = 14; const int N_PREINC = 17; const int N_POSTINC = 18; const int N_SIZEOF_E = 19; const int N_SIZEOF_T = 20;
const int N_STR = 3; const int N_CAST = 25; const int N_FCAST = 26; const int N_INITLIST = 28; const int N_TY = 29; const int N_TPTR = 30; const int N_TARR = 33; const int N_BLOCK = 34; const int N_VAR = 35; const int N_DECLS = 36;
const int N_EXPRSTMT = 37; const int N_IF = 38; const int N_WHILE = 39; const int N_DO = 40; const int N_FOR = 41; const int N_RETURN = 42; const int N_BREAK = 43; const int N_CONTINUE = 44; const int N_EMPTY = 45;
const int N_FUNC = 46; const int N_PARAMS = 47; const int N_PROG = 49; const int N_NONE = 51;
V gen(int n);
int gname[400]; int gty[400]; int gnode[400]; int ngl = 0;
int str_node[400]; int nstrn = 0;
int findgl(int sid) { int i = 0; while (i < ngl) { if (gname[i] == sid) return i; i = i + 1; } return -1; }
long long ceval(int n) {
  int k = nodek(n);
  if (k == N_INT || k == N_CHR || k == N_BOOL) return nk_i[n];
  if (k == N_SIZEOF_T || k == N_SIZEOF_E) { dry = dry + 1; V v = gen(n); dry = dry - 1; if (v.ci == 0) die("sabit ifade gerekli"); return v.cv; }
  if (k == N_UNARY && seqc(nk_s1[n], "-")) return 0 - ceval(kid(n, 0));
  if (k == N_ID) { int gi = findgl(nk_s1[n]); if (gi >= 0) { int f = gnode[gi]; if (nk_n[f] > 1 && (nk_j[kid(f, 0)] & 1)) return ceval(kid(f, 1)); } }
  if (k == N_COND) { if (ceval(kid(n, 0))) return ceval(kid(n, 1)); return ceval(kid(n, 2)); }
  if (k == N_BINARY) {
    long long a = ceval(kid(n, 0)); long long b = ceval(kid(n, 1)); int s = nk_s1[n];
    if (seqc(s, "+")) return a + b; if (seqc(s, "-")) return a - b; if (seqc(s, "*")) return a * b;
    if (seqc(s, "/") && b != 0) return a / b; if (seqc(s, "%") && b != 0) return a % b; if (seqc(s, "<<")) return a << b; if (seqc(s, ">>")) return a >> b;
  }
  die("sabit ifade gerekli"); return 0;
}
int typeof_(int n) {
  int k = nodek(n);
  if (k == N_TY) {
    int c = nk_i[n];
    if (c == 21 || c == 22) die("desteklenmiyor: sinif/auto turu (ifx cekirdegi)");
    return mkt(c, -1, 0);
  }
  if (k == N_TPTR) return mkt(Y_PTR, typeof_(kid(n, 0)), 0);
  if (k == N_TARR) { int e = typeof_(kid(n, 0)); long long c = ceval(kid(n, 1)); if (c <= 0) die("dizi boyutu pozitif olmali"); return mkt(Y_ARR, e, c); }
  die("desteklenmiyor: referans turu"); return 0;
}
int findvar(int sid) { int i = nvars - 1; while (i >= 0) { if (vname[i] == sid) return i; i = i - 1; } return -1; }
int seq_rt_c(int p, const char* t) {
  int n = 0; while (t[n]) n = n + 1;
  if (n != rt_len(p)) return 0;
  int i = 0; while (i < n) { if (RT[p + 1 + i] != t[i]) return 0; i = i + 1; }
  return 1;
}
int streq(const char* a, const char* b) { int i = 0; while (a[i] && b[i] && a[i] == b[i]) i = i + 1; return a[i] == 0 && b[i] == 0; }
int find_rule(int cls, const char* tok) {
  int r = 0;
  while (r < nrec) { if (RT[rec_off[r]] == cls && seq_rt_c(rstr_pos(r, 0), tok)) return r; r = r + 1; }
  return -1;
}
char tokbuf[64];
void settok(int sid) { int i = 0; while (i < s_len[sid] && i < 62) { tokbuf[i] = chars[s_off[sid] + i]; i = i + 1; } tokbuf[i] = 0; }
// ---- ikili operatorler (kurallar tablodan) ----
V arith(int rule, V l, V r, int t) {
  int kind = rnum(rule, 0); int when = rnum(rule, 1); int needn = rnum(rule, 2);
  int pi_ = rstr_pos(rule, 1); int pu = rstr_pos(rule, 2); int pf = rstr_pos(rule, 3);
  long long d = newreg();
  if (is_flt(t)) {
    if (rt_len(pf) == 0) die("operator kayan nokta turunde tanimli degil");
    ins3t(pf, d, l, r); return norm(mkv(t, 0, d), t);
  }
  int p = pi_;
  if (when == 1 && uns64(t)) p = pu;
  if (when == 2 && sg_of(t) == 0) p = pu;
  if (kind == 2) { l = mat(l); r = mat(r); }
  ins3t(p, d, l, r);
  V o = mkv(t, 0, d);
  if (needn) return norm(o, t);
  return o;
}
V compare(int rule, V l, V r, int t) {
  int sw_u = rnum(rule, 0); int sw_f = rnum(rule, 1); int inv_f = rnum(rule, 2);
  long long d = newreg(); int bt = mkt(Y_BOOL, -1, 0);
  if (is_flt(t)) {
    if (sw_f) { V x = l; l = r; r = x; }
    if (inv_f) { long long t1 = newreg(); ins3t(rstr_pos(rule, 3), t1, l, r); ins3("eq", d, mkv(t, 0, t1), imm(bt, 0)); return mkv(bt, 0, d); }
    ins3t(rstr_pos(rule, 3), d, l, r); return mkv(bt, 0, d);
  }
  int p = rstr_pos(rule, 1);
  if (uns64(t) || is_ptr(t)) { p = rstr_pos(rule, 2); if (sw_u) { V x = l; l = r; r = x; } }
  l = mat(l);
  ins3t(p, d, l, r);
  return mkv(bt, 0, d);
}
V ptradd(V p, V i, int neg) {
  int et = te[p.ty]; if (tk[et] == Y_VOID) die("void isaretcisinde aritmetik yok");
  i = convert(rval(i), mkt(Y_LONG, -1, 0));
  long long w = words_of(et); V off = i;
  if (w != 1) { long long t1 = newreg(); ins3("mul", t1, mat(i), imm(i.ty, w)); off = mkv(i.ty, 0, t1); }
  long long d = newreg(); if (neg) ins3("sub", d, mat(p), off); else ins3("add", d, mat(p), off);
  return mkv(p.ty, 0, d);
}
V binop(const char* tok, V l, V r) {
  l = rval(l); r = rval(r);
  if (!is_sc(l.ty) || !is_sc(r.ty)) die("ikili islec skaler operand gerektirir");
  int cr = find_rule(3, tok);
  if (cr >= 0) {
    int t;
    if (is_ptr(l.ty) || is_ptr(r.ty)) {
      if (is_ptr(l.ty)) t = l.ty; else t = r.ty;
      l = convert(l, t); r = convert(r, t);
    } else t = uac(l.ty, r.ty);
    if (is_flt(l.ty) || is_flt(r.ty)) { l = convert(l, t); r = convert(r, t); } else { l = convert(l, t); r = convert(r, t); }
    return compare(cr, mat(l), mat(r), t);
  }
  int ar = find_rule(2, tok);
  if (ar < 0) die("bilinmeyen ikili islec");
  int kind = rnum(ar, 0);
  if (is_ptr(l.ty) || is_ptr(r.ty)) {
    if (streq(tok, "+") && is_ptr(l.ty) && is_int(r.ty)) return ptradd(l, r, 0);
    if (streq(tok, "+") && is_ptr(r.ty) && is_int(l.ty)) return ptradd(r, l, 0);
    if (streq(tok, "-") && is_ptr(l.ty) && is_int(r.ty)) return ptradd(l, r, 1);
    if (streq(tok, "-") && is_ptr(l.ty) && is_ptr(r.ty)) {
      long long w = words_of(te[l.ty]); long long d = newreg(); ins3("sub", d, mat(l), mat(r));
      if (w != 1) { long long q = newreg(); ins3("div", q, mkv(0, 0, d), imm(0, w)); d = q; }
      return mkv(mkt(Y_LONG, -1, 0), 0, d);
    }
    die("isaretci operandli gecersiz islec");
  }
  if (kind != 1 && kind != 2 || 1) { }
  if (kind == 4) {   // kaydirma: sonuc turu terfi etmis sol operand
    int lt = promote(l.ty); int rt = promote(r.ty);
    if (!is_int(lt) || !is_int(rt)) die("kaydirma tamsayi gerektirir");
    l = convert(l, lt); r = convert(r, rt);
    if (r.ci) { if (r.cv < 0) die("negatif kaydirma miktari"); if (r.cv >= bits_of(lt)) die("kaydirma miktari tur genisligini asiyor"); }
    return arith(ar, l, r, lt);
  }
  int t = uac(l.ty, r.ty);
  if ((kind == 3 || streq(tok, "%")) && is_flt(t)) die("operator yalniz tamsayi operandlarla kullanilir");
  l = convert(l, t); r = convert(r, t);
  return arith(ar, mat(l), mat(r), t);
}
// ---- ifadeler ----
int bool_t() { return mkt(Y_BOOL, -1, 0); }
V lval_check(V v, const char* what) { if (v.cat != 1) die("sol operand degistirilebilir lvalue olmali"); if (is_arr(v.ty)) die("diziye atanamaz"); return v; }
V store(V lv, V val) { V mv = mat(val); w("  st "); opr(mv); w(", "); opr(lv); w(", 0\n"); return lv; }
V gen_logical(int n, int isand) {
  V a = condbool(gen(kid(n, 0))); long long res = newreg(); long long end = nlab; nlab = nlab + 1;
  w("  mov "); wr(res); w(", "); opr(a); wc(10);
  if (isand) w("  jz "); else w("  jnz ");
  wr(res); w(", "); wl(end); wc(10);
  V b = condbool(gen(kid(n, 1)));
  w("  mov "); wr(res); w(", "); opr(b); wc(10); wl(end); w(":\n");
  return mkv(bool_t(), 0, res);
}
V gen_incdec(int n) {
  int post = nodek(n) == N_POSTINC; int inc = seqc(nk_s1[n], "++");
  V lv = lval_check(gen(kid(n, 0)), "++");
  int t = lv.ty; if (tk[t] == Y_BOOL) die("bool uzerinde ++/-- gecersiz");
  if (!is_int(t) && !is_flt(t) && !is_ptr(t)) die("++/-- yalniz aritmetik/isaretci");
  long long o = newreg(); w("  ld "); wr(o); w(", "); opr(lv); w(", 0\n");
  V old = mkv(t, 0, o); V nv;
  if (is_ptr(t)) nv = ptradd(old, imm(mkt(Y_INT, -1, 0), 1), !inc);
  else if (is_flt(t)) { V one = fconst(t, 4607182418800017408LL); if (inc) nv = binop("+", old, one); else nv = binop("-", old, one); nv = convert(nv, t); }
  else { V one = imm(mkt(Y_INT, -1, 0), 1); if (inc) nv = binop("+", old, one); else nv = binop("-", old, one); nv = convert(nv, t); }
  store(lv, nv);
  if (post) return old;
  return lv;
}
V gen_call(int n);
V gen_unary(int n) {
  int s = nk_s1[n]; V v = gen(kid(n, 0));
  if (seqc(s, "&")) { if (v.cat != 1) die("adresi alinamaz: lvalue gerekli"); return mkv(mkt(Y_PTR, v.ty, 0), 0, v.reg); }
  if (seqc(s, "*")) {
    v = rval(v); if (!is_ptr(v.ty)) die("'*' isaretci gerektirir");
    if (tk[te[v.ty]] == Y_VOID) die("void isaretcisi dolayli erisilemez");
    nullchk(v); v = mat(v); return mkv(te[v.ty], 1, v.reg);
  }
  if (seqc(s, "!")) { V b = condbool(v); long long d = newreg(); ins3("eq", d, mat(b), imm(bool_t(), 0)); return mkv(bool_t(), 0, d); }
  v = rval(v);
  if (!is_int(v.ty) && !is_flt(v.ty)) die("tekli islec aritmetik operand gerektirir");
  if (seqc(s, "+")) { if (is_int(v.ty)) return convert(v, promote(v.ty)); return v; }
  if (seqc(s, "-")) {
    if (is_flt(v.ty)) { long long d = newreg(); ins2t(names[NM_FNEG], d, v); return mkv(v.ty, 0, d); }
    int t = promote(v.ty); v = convert(v, t); long long d = newreg(); ins2t(names[NM_NEG], d, mat(v)); return norm(mkv(t, 0, d), t);
  }
  if (seqc(s, "~")) {
    if (!is_int(v.ty)) die("'~' tamsayi gerektirir");
    int t = promote(v.ty); v = convert(v, t); long long d = newreg(); ins2t(names[NM_NOT], d, mat(v)); return norm(mkv(t, 0, d), t);
  }
  die("bilinmeyen tekli islec"); return v;
}
V gen_index(int n) {
  V b = gen(kid(n, 0)); V i = gen(kid(n, 1));
  int barr = is_arr(b.ty);
  V bp = rval(b); i = rval(i);
  if (!is_ptr(bp.ty) && is_ptr(i.ty)) { V x = bp; bp = i; i = x; barr = 0; }
  if (!is_ptr(bp.ty)) die("dizi/isaretci olmayan ifade indekslenemez");
  if (!is_int(i.ty)) die("dizi indeksi tamsayi olmali");
  int et = te[bp.ty];
  if (!barr) nullchk(bp);
  i = convert(i, mkt(Y_LONG, -1, 0));
  if (barr) {
    long long cnt = tn[b.ty];
    if (i.ci && (i.cv < 0 || i.cv >= cnt)) die("sabit dizi indeksi sinir disi");
    if (i.ci == 0) { long long c = newreg(); long long ok = nlab; nlab = nlab + 1; ins3("ltu", c, i, imm(0, cnt)); w("  jnz "); wr(c); w(", "); wl(ok); wc(10); trapnow(); wl(ok); w(":\n"); }
  }
  long long w1 = words_of(et); V off = i;
  if (w1 != 1) { long long t1 = newreg(); ins3("mul", t1, mat(i), imm(i.ty, w1)); off = mkv(i.ty, 0, t1); }
  long long d = newreg(); ins3("add", d, mat(bp), off);
  return mkv(et, 1, d);
}
V gen_assign(int n) {
  int s = nk_s1[n];
  V r = gen(kid(n, 1)); V lv = lval_check(gen(kid(n, 0)), "=");
  if (!is_sc(lv.ty)) die("desteklenmiyor: sinif atamasi");
  if (seqc(s, "=")) { r = rval(r); if (!is_sc(r.ty)) die("atama sag operandi skaler olmali"); return store(lv, convert(r, lv.ty)); }
  settok(s); int l = 0; while (tokbuf[l]) l = l + 1; tokbuf[l - 1] = 0;
  r = rval(r);
  long long o = newreg(); w("  ld "); wr(o); w(", "); opr(lv); w(", 0\n");
  V cur = mkv(lv.ty, 0, o);
  V res = binop(tokbuf, cur, r);
  if (is_ptr(lv.ty)) { } else res = convert(res, lv.ty);
  return store(lv, res);
}
V gen_cond(int n) {
  V c = condbool(gen(kid(n, 0)));
  dry = dry + 1; V a0r = gen(kid(n, 1)); V b0r = gen(kid(n, 2)); dry = dry - 1;
  if (a0r.cat == 1 && b0r.cat == 1 && a0r.ty == b0r.ty && !is_arr(a0r.ty)) {
    long long lres = newreg(); long long lels = nlab; nlab = nlab + 1; long long lend = nlab; nlab = nlab + 1;
    w("  jz "); opr(c); w(", "); wl(lels); wc(10);
    V la = gen(kid(n, 1)); w("  mov "); wr(lres); w(", "); opr(la); wc(10); w("  jmp "); wl(lend); wc(10); wl(lels); w(":\n");
    V lb = gen(kid(n, 2)); w("  mov "); wr(lres); w(", "); opr(lb); wc(10); wl(lend); w(":\n");
    return mkv(a0r.ty, 1, lres);
  }
  dry = dry + 1; V a0 = rval(a0r); V b0 = rval(b0r); dry = dry - 1;
  int rt;
  if (a0.ty == b0.ty) rt = a0.ty;
  else if (is_ptr(a0.ty) || is_ptr(b0.ty)) { if (is_ptr(a0.ty)) rt = a0.ty; else rt = b0.ty; }
  else rt = uac(a0.ty, b0.ty);
  if (!is_sc(rt)) die("?: kollari skaler olmali");
  long long res = newreg(); long long els = nlab; nlab = nlab + 1; long long end = nlab; nlab = nlab + 1;
  w("  jz "); opr(c); w(", "); wl(els); wc(10);
  V a1 = convert(rval(gen(kid(n, 1))), rt); w("  mov "); wr(res); w(", "); opr(a1); wc(10);
  w("  jmp "); wl(end); wc(10); wl(els); w(":\n");
  V b1 = convert(rval(gen(kid(n, 2))), rt); w("  mov "); wr(res); w(", "); opr(b1); wc(10); wl(end); w(":\n");
  return mkv(rt, 0, res);
}
V gen_cast(int n) {
  int T = typeof_(kid(n, 0)); V v = rval(gen(kid(n, 1)));
  if (nk_k[n] == N_CAST) { if (!(seqc(nk_s1[n], "static_cast") || seqc(nk_s1[n], "c"))) die("desteklenmiyor: bu donusum turu (ifx cekirdegi: static_cast ve C tipi)"); }
  if (tk[T] == Y_VOID) { return mkv(Y_VOID, 0, 0 - 2); }
  if (!is_sc(T) || !is_sc(v.ty)) die("donusum skaler turler arasinda olmali");
  if (is_ptr(T) && is_int(v.ty) && !(v.ci && v.cv == 0)) die("desteklenmiyor: tamsayidan isaretciye (reinterpret_cast gerekir)");
  if (is_int(T) && is_ptr(v.ty) && tk[T] != Y_BOOL) die("desteklenmiyor: isaretciden tamsayiya");
  if (is_flt(T) && is_ptr(v.ty)) die("gecersiz donusum");
  return convert(v, T);
}
V gen(int n) {
  int k = nodek(n);
  if (k == N_INT) { V v = imm(mkt(nk_j[n], -1, 0), nk_i[n]); return v; }
  if (k == N_CHR) return imm(mkt(Y_CHAR, -1, 0), fold(nk_i[n], mkt(Y_CHAR, -1, 0)));
  if (k == N_BOOL) return imm(bool_t(), nk_i[n]);
  if (k == N_NULLPTR) return imm(mkt(Y_PTR, mkt(Y_VOID, -1, 0), 0), 0);
  if (k == N_FLT) { int t = mkt(nk_j[n], -1, 0); if (tk[t] == 15) { if (dry == 0) die("desteklenmiyor: long double sabiti (f80 komutlari bu cekirdekte yok; f64'e sessizce indirilmez)"); return mkv(t, 0, 0 - 2); } V f = fconst(t, nk_d[n]); return norm(f, t); }
  if (k == N_ID) {
    int vi = findvar(nk_s1[n]);
    if (vi < 0) { int gi = findgl(nk_s1[n]); if (gi < 0) die("tanimsiz ad"); long long gr = newreg(); w("  mov "); wr(gr); w(", g"); wn(gi); wc(10); return mkv(gty[gi], 1, gr); }
    long long r = newreg(); w("  add "); wr(r); w(", fp, "); wn(voff[vi]); wc(10); return mkv(vty[vi], 1, r);
  }
  if (k == N_STR) {
    str_node[nstrn] = n; nstrn = nstrn + 1; long long sr = newreg(); w("  mov "); wr(sr); w(", s"); wn(nstrn - 1); wc(10);
    return mkv(mkt(Y_ARR, mkt(Y_CHAR, -1, 0), slen(nk_s1[n]) + 1), 1, sr);
  }
  if (k == N_UNARY) return gen_unary(n);
  if (k == N_BINARY) {
    if (seqc(nk_s1[n], "&&")) return gen_logical(n, 1);
    if (seqc(nk_s1[n], "||")) return gen_logical(n, 0);
    V l = gen(kid(n, 0)); V r = gen(kid(n, 1)); settok(nk_s1[n]); return binop(tokbuf, l, r);
  }
  if (k == N_ASSIGN) return gen_assign(n);
  if (k == N_PREINC || k == N_POSTINC) return gen_incdec(n);
  if (k == N_COND) return gen_cond(n);
  if (k == N_COMMA) { gen(kid(n, 0)); return gen(kid(n, 1)); }
  if (k == N_CALL) return gen_call(n);
  if (k == N_INDEX) return gen_index(n);
  if (k == N_SIZEOF_T) { int t = typeof_(kid(n, 0)); return imm(mkt(Y_ULONG, -1, 0), size_of(t)); }
  if (k == 21) { int t = typeof_(kid(n, 0)); while (is_arr(t)) t = te[t]; return imm(mkt(Y_ULONG, -1, 0), size_of(t)); }
  if (k == N_SIZEOF_E) { dry = dry + 1; V v = gen(kid(n, 0)); dry = dry - 1; return imm(mkt(Y_ULONG, -1, 0), size_of(v.ty)); }
  if (k == N_CAST || k == N_FCAST) {
    if (k == N_FCAST && nk_n[n] != 2) die("desteklenmiyor: T() / T{} (ifx cekirdegi)");
    return gen_cast(n);
  }
  die("desteklenmiyor: bu ifade dugumu (sinif/dize/UDL/typeid/... ifx cekirdeginde yok)"); return imm(0, 0);
}
V gen_call(int n) {
  int callee = kid(n, 0); if (nodek(callee) != N_ID) die("desteklenmiyor: yalniz islev adi cagrilabilir");
  int na = nk_n[n] - 1; int f = -1; int i = 0;
  while (i < nfn) { if (fn_name[i] == nk_s1[callee] && fn_np[i] == na) { if (f >= 0) die("desteklenmiyor: asiri yukleme"); f = i; } i = i + 1; }
  if (f < 0) die("tanimsiz islev ya da arguman sayisi uyumsuz");
  V av[8]; if (na > 8) die("cok fazla arguman");
  i = 0; while (i < na) { V a = rval(gen(kid(n, i + 1))); if (!is_sc(a.ty)) die("arguman skaler olmali"); av[i] = convert(a, fn_pt[f * 8 + i]); i = i + 1; }
  int rt = fn_ret[f]; long long d = newreg();
  if (fn_bi[f] == 4) { w("  host "); wr(d); w(", getc\n"); return mkv(mkt(Y_INT, -1, 0), 0, d); }
  if (fn_bi[f] >= 1) {
    V a0 = mat(av[0]);
    if (fn_bi[f] == 1) w("  host puti, "); if (fn_bi[f] == 2) w("  host putc, "); if (fn_bi[f] == 3) w("  host putf, ");
    opr(a0); wc(10); return mkv(Y_VOID, 0, 0 - 2);
  }
  w("  call "); if (tk[rt] != Y_VOID) { wr(d); w(", "); } w("f"); wn(f);
  i = 0; while (i < na) { w(", "); opr(av[i]); i = i + 1; }
  wc(10);
  if (tk[rt] == Y_VOID) return mkv(Y_VOID, 0, 0 - 2);
  return mkv(rt, 0, d);
}
// ---- deyimler ----
int loop_brk[64]; int loop_cont[64]; int nloop = 0;
void emit_ret(V v) { long long t = newreg(); w("  mov "); wr(t); w(", __sp\n  st fp, "); wr(t); w(", 0\n  ret "); opr(v); wc(10); }
void zero_fill(long long addr, long long n) {
  long long i = 0;
  if (n <= 8) { while (i < n) { w("  st 0, "); wr(addr); w(", "); wn(i); wc(10); i = i + 1; } return; }
  long long ri = newreg(); long long rp = newreg(); long long rc = newreg(); long long top = nlab; nlab = nlab + 1; long long end = nlab; nlab = nlab + 1;
  w("  mov "); wr(ri); w(", 0\n  mov "); wr(rp); w(", "); wr(addr); wc(10); wl(top); w(":\n  lt "); wr(rc); w(", "); wr(ri); w(", "); wn(n); wc(10);
  w("  jz "); wr(rc); w(", "); wl(end); w("\n  st 0, "); wr(rp); w(", 0\n  add "); wr(rp); w(", "); wr(rp); w(", 1\n  add "); wr(ri); w(", "); wr(ri); w(", 1\n  jmp "); wl(top); wc(10); wl(end); w(":\n");
}
void init_obj(long long addr, int T, int init);
void init_scalar(long long addr, int T, int e) {
  if (nodek(e) == N_INITLIST) { if (nk_n[e] > 1) die("skaler tek degerle ilklendirilir"); if (nk_n[e] == 0) { w("  st 0, "); wr(addr); w(", 0\n"); return; } e = kid(e, 0); }
  V v = rval(gen(e)); if (!is_sc(v.ty)) die("ilklendirici skaler olmali");
  V cv_ = mat(convert(v, T)); w("  st "); opr(cv_); w(", "); wr(addr); w(", 0\n");
}
void init_obj(long long addr, int T, int init) {
  if (is_arr(T)) {
    if (nodek(init) == N_STR && tk[te[T]] == Y_CHAR) {
      int sid = nk_s1[init]; if (slen(sid) + 1 > tn[T]) die("dize sabiti diziye sigmiyor");
      zero_fill(addr, words_of(T)); int i = 0;
      while (i < slen(sid)) { w("  st "); wn(chars[soff(sid) + i]); w(", "); wr(addr); w(", "); wn(i); wc(10); i = i + 1; }
      return;
    }
    if (nodek(init) != N_INITLIST) die("dizi {..} listesiyle ilklendirilir");
    if (nk_n[init] > tn[T]) die("ilklendirici listesinde fazla eleman");
    if (!is_sc(te[T]) && !is_arr(te[T])) die("desteklenmiyor: dizi elemani skaler/dizi degil");
    zero_fill(addr, words_of(T));
    int i = 0; while (i < nk_n[init]) { long long ea = newreg(); w("  add "); wr(ea); w(", "); wr(addr); w(", "); wn(i * words_of(te[T])); wc(10); init_obj(ea, te[T], kid(init, i)); i = i + 1; }
  } else if (is_sc(T)) init_scalar(addr, T, init);
  else die("desteklenmiyor: bu turde degisken");
}
void declvar(int vn) {
  int tn_ = kid(vn, 0); int init = -1; if (nk_n[vn] > 1) init = kid(vn, 1);
  int T;
  if (nodek(tn_) == N_TARR && nk_n[tn_] < 2) {
    if (init >= 0 && nodek(init) == N_INITLIST) T = mkt(Y_ARR, typeof_(kid(tn_, 0)), nk_n[init]);
    else if (init >= 0 && nodek(init) == N_STR) T = mkt(Y_ARR, typeof_(kid(tn_, 0)), slen(nk_s1[init]) + 1);
    else { die("boyutsuz dizi ilklendirici gerektirir"); T = 0; }
  } else T = typeof_(tn_);
  if (tk[T] == Y_VOID) die("void degisken");
  int off = slot(words_of(T)); long long addr = newreg(); w("  add "); wr(addr); w(", fp, "); wn(off); wc(10);
  if (init >= 0) init_obj(addr, T, init);
  vname[nvars] = nk_s1[vn]; vty[nvars] = T; voff[nvars] = off; nvars = nvars + 1;
}
void stmt(int n) {
  int k = nodek(n); int base = nreg;
  if (k == N_EMPTY) return;
  if (k == N_BLOCK) { int mark = nvars; int i = 0; while (i < nk_n[n]) { stmt(kid(n, i)); i = i + 1; } nvars = mark; return; }
  if (k == N_DECLS) { int i = 0; while (i < nk_n[n]) { declvar(kid(n, i)); nreg = base; i = i + 1; } return; }
  if (k == N_EXPRSTMT) { gen(kid(n, 0)); nreg = base; return; }
  if (k == N_IF) {
    V c = condbool(gen(kid(n, 0))); long long els = nlab; nlab = nlab + 1; long long end = nlab; nlab = nlab + 1;
    w("  jz "); opr(c); w(", "); wl(els); wc(10); nreg = base;
    int mark = nvars; stmt(kid(n, 1)); nvars = mark;
    if (nk_n[n] > 2) { w("  jmp "); wl(end); wc(10); wl(els); w(":\n"); stmt(kid(n, 2)); nvars = mark; wl(end); w(":\n"); } else { wl(els); w(":\n"); }
    return;
  }
  if (k == N_WHILE) {
    long long top = nlab; nlab = nlab + 1; long long end = nlab; nlab = nlab + 1; wl(top); w(":\n");
    V c = condbool(gen(kid(n, 0))); w("  jz "); opr(c); w(", "); wl(end); wc(10); nreg = base;
    loop_brk[nloop] = end; loop_cont[nloop] = top; nloop = nloop + 1; int mark = nvars; stmt(kid(n, 1)); nvars = mark; nloop = nloop - 1;
    w("  jmp "); wl(top); wc(10); wl(end); w(":\n"); return;
  }
  if (k == N_DO) {
    long long top = nlab; nlab = nlab + 1; long long cont = nlab; nlab = nlab + 1; long long end = nlab; nlab = nlab + 1; wl(top); w(":\n");
    loop_brk[nloop] = end; loop_cont[nloop] = cont; nloop = nloop + 1; int mark = nvars; stmt(kid(n, 0)); nvars = mark; nloop = nloop - 1;
    wl(cont); w(":\n"); V c = condbool(gen(kid(n, 1))); w("  jnz "); opr(c); w(", "); wl(top); wc(10); nreg = base; wl(end); w(":\n"); return;
  }
  if (k == N_FOR) {
    int mark = nvars; if (nodek(kid(n, 0)) != N_NONE) stmt(kid(n, 0));
    long long top = nlab; nlab = nlab + 1; long long cont = nlab; nlab = nlab + 1; long long end = nlab; nlab = nlab + 1; wl(top); w(":\n");
    int base2 = nreg;
    if (nodek(kid(n, 1)) != N_NONE) { V c = condbool(gen(kid(n, 1))); w("  jz "); opr(c); w(", "); wl(end); wc(10); nreg = base2; }
    loop_brk[nloop] = end; loop_cont[nloop] = cont; nloop = nloop + 1; int m2 = nvars; stmt(kid(n, 3)); nvars = m2; nloop = nloop - 1;
    wl(cont); w(":\n"); if (nodek(kid(n, 2)) != N_NONE) { gen(kid(n, 2)); nreg = base2; }
    w("  jmp "); wl(top); wc(10); wl(end); w(":\n"); nvars = mark; return;
  }
  if (k == N_RETURN) {
    int rt = fn_ret[cur_fn];
    if (nk_n[n] == 0) { if (tk[rt] != Y_VOID) die("deger donduren islevde 'return' degersiz"); emit_ret(imm(0, 0)); return; }
    if (tk[rt] == Y_VOID) die("void islevden deger donduruluyor");
    V v = rval(gen(kid(n, 0))); if (!is_sc(v.ty)) die("donus degeri skaler olmali");
    emit_ret(convert(v, rt)); nreg = base; return;
  }
  if (k == N_BREAK) { if (nloop == 0) die("'break' dongu disinda"); w("  jmp "); wl(loop_brk[nloop - 1]); wc(10); return; }
  if (k == N_CONTINUE) { if (nloop == 0) die("'continue' dongu disinda"); w("  jmp "); wl(loop_cont[nloop - 1]); wc(10); return; }
  die("desteklenmiyor: bu deyim dugumu");
}
// ---- islev ----
int body_pass(int fi, int real, int frame) {
  int fnode = fn_node[fi]; int params = kid(fnode, 1); int body = kid(fnode, 2);
  int saved_lab = nlab; long long saved_dat = ndat; int saved_s = nstrn;
  nvars = 0; nreg = 0; foff = 0; nloop = 0; cur_fn = fi;
  if (real) {
    w("func f"); wn(fi); w("(");
    int i = 0; while (i < fn_np[fi]) { if (i) w(", "); w("p"); wn(i); i = i + 1; }
    w(") {\n  mov _spa, __sp\n  ld fp, _spa, 0\n  add _nsp, fp, "); wn(frame); w("\n  mov _lma, __lim\n  ld _lim, _lma, 0\n  leu _okc, _nsp, _lim\n  jnz _okc, _stk_ok\n  ld _trp, -1, 0\n_stk_ok: st _nsp, _spa, 0\n");
  }
  int i = 0;
  while (i < fn_np[fi]) {
    int pv = kid(params, i); int off = slot(1);
    if (real) { w("  st p"); wn(i); w(", fp, "); wn(off); wc(10); }
    vname[nvars] = nk_s1[pv]; vty[nvars] = fn_pt[fi * 8 + i]; voff[nvars] = off; nvars = nvars + 1; i = i + 1;
  }
  stmt(body);
  if (real) { emit_ret(imm(0, 0)); w("}\n"); }
  int used = foff; if (used < 1) used = 1;
  if (real == 0) { nlab = saved_lab; ndat = saved_dat; nstrn = saved_s; }
  return used;
}
int init_pass(int real, int frame) {
  int saved_lab = nlab; long long saved_dat = ndat; int saved_s = nstrn;
  nvars = 0; nreg = 0; foff = 0; nloop = 0;
  if (real) {
    w("func __init() {\n  mov _spa, __sp\n  ld fp, _spa, 0\n  add _nsp, fp, "); wn(frame); w("\n  mov _lma, __lim\n  ld _lim, _lma, 0\n  leu _okc, _nsp, _lim\n  jnz _okc, _stk_ok\n  ld _trp, -1, 0\n_stk_ok: st _nsp, _spa, 0\n");
  }
  int i = 0;
  while (i < ngl) {
    int f = gnode[i]; int init = -1; if (nk_n[f] > 1) init = kid(f, 1);
    if (init >= 0) { int base = nreg; long long a = newreg(); w("  mov "); wr(a); w(", g"); wn(i); wc(10); init_obj(a, gty[i], init); nreg = base; }
    i = i + 1;
  }
  if (real) { emit_ret(imm(0, 0)); w("}\n"); }
  int used = foff; if (used < 1) used = 1;
  if (real == 0) { nlab = saved_lab; ndat = saved_dat; nstrn = saved_s; }
  return used;
}
void declare_funcs(int prog) {
  int i = 0;
  while (i < nk_n[prog]) {
    int f = kid(prog, i);
    if (nodek(f) == N_FUNC) {
      int params = kid(f, 1); int np = nk_n[params];
      if (np > 8) die("cok fazla parametre");
      fn_name[nfn] = nk_s1[f]; fn_ret[nfn] = typeof_(kid(f, 0)); fn_np[nfn] = np; fn_node[nfn] = f; fn_bi[nfn] = 0;
      int j = 0; while (j < np) { int pt = typeof_(kid(kid(params, j), 0)); if (is_arr(pt)) pt = mkt(Y_PTR, te[pt], 0); if (!is_sc(pt)) die("parametre skaler olmali"); fn_pt[nfn * 8 + j] = pt; j = j + 1; }
      if (seqc(nk_s1[f], "__puti")) fn_bi[nfn] = 1; if (seqc(nk_s1[f], "__putc")) fn_bi[nfn] = 2; if (seqc(nk_s1[f], "__putf")) fn_bi[nfn] = 3; if (seqc(nk_s1[f], "__getc")) fn_bi[nfn] = 4;
      nfn = nfn + 1;
    } else if (nodek(f) == N_VAR) {
      int tn_ = kid(f, 0); int T;
      int init = -1; if (nk_n[f] > 1) init = kid(f, 1);
      if (nodek(tn_) == N_TARR && nk_n[tn_] < 2) {
        if (init >= 0 && nodek(init) == N_INITLIST) T = mkt(Y_ARR, typeof_(kid(tn_, 0)), nk_n[init]);
        else if (init >= 0 && nodek(init) == N_STR) T = mkt(Y_ARR, typeof_(kid(tn_, 0)), slen(nk_s1[init]) + 1);
        else { die("boyutsuz global dizi"); T = 0; }
      } else T = typeof_(tn_);
      gname[ngl] = nk_s1[f]; gty[ngl] = T; gnode[ngl] = f; ngl = ngl + 1;
    }
    else die("desteklenmiyor: sinif tanimi (ifx cekirdegi)");
    i = i + 1;
  }
}
int main() {
  int i = 0; while (i <= 16) { mkt(i, -1, 0); i = i + 1; }
  // PMK1 (komut/kural tablosu)
  long long magic = rd(); if (magic != 1347242801) die("PMK1 sihirli sayisi yanlis");
  rd(); rd(); long long nb = rd(); int found = 0; long long b = 0;
  while (b < nb) {
    long long id = rd(); rd(); rd(); long long len = rd(); long long j = 0;
    if (id == 12) { found = 1; if (len > NR) die("kural tablosu cok buyuk"); while (j < len) { RT[j] = rd(); j = j + 1; } nrt = len; }
    else while (j < len) { rd(); j = j + 1; }
    b = b + 1;
  }
  if (!found) die("PMK1 bolum 12 (IFADE KURAL TABLOSU) yok");
  load_rules();
  // PMX1
  if (rd() != 1347246129) die("PMX1 sihirli sayisi yanlis"); if (rd() != 1) die("PMX1 surumu desteklenmiyor");
  nstr = rd(); if (nstr > 4000) die("cok fazla dizge");
  i = 0; while (i < nstr) { long long l = rd(); s_off[i] = nchars; s_len[i] = l; long long j = 0; while (j < l) { chars[nchars] = rd(); nchars = nchars + 1; j = j + 1; } i = i + 1; }
  nnodes = rd(); root = rd(); if (nnodes > NN) die("cok fazla dugum");
  i = 0;
  while (i < nnodes) {
    nk_k[i] = rd(); nk_i[i] = rd(); nk_j[i] = rd(); nk_d[i] = rd(); nk_s1[i] = rd(); nk_s2[i] = rd(); rd(); nk_n[i] = rd();
    nk_ks[i] = nkids; long long j = 0; while (j < nk_n[i]) { kids[nkids] = rd(); nkids = nkids + 1; j = j + 1; } i = i + 1;
  }
  w("memory 2097152\ndata __sp = 0\ndata __lim = 0\n");
  declare_funcs(root);
  { dry = 1; int fr = init_pass(0, 0); dry = 0; init_pass(1, fr); }
  i = 0; while (i < nfn) { if (nk_n[fn_node[i]] > 2) { dry = 1; int fr = body_pass(i, 0, 0); dry = 0; body_pass(i, 1, fr); } i = i + 1; }
  int mainf = -1; i = 0; while (i < nfn) { if (seqc(fn_name[i], "main") && fn_np[i] == 0) mainf = i; i = i + 1; }
  if (mainf < 0) die("int main() bulunamadi");
  i = 0; while (i < ngl) { w("space g"); wn(i); w(" "); long long wd = words_of(gty[i]); if (wd < 1) wd = 1; wn(wd); wc(10); i = i + 1; }
  i = 0; while (i < nstrn) { int sid = nk_s1[str_node[i]]; w("data s"); wn(i); w(" = "); int j = 0; while (j < slen(sid)) { wn(chars[soff(sid) + j]); w(", "); j = j + 1; } w("0\n"); i = i + 1; }
  i = 0; while (i < ndat) { w("data d"); wn(i); w(" = "); wn(dat[i]); wc(10); i = i + 1; }
  w("func __start() {\n  alloc _base, 262144\n  mov _spa, __sp\n  st _base, _spa, 0\n  add _top, _base, 262128\n  mov _lma, __lim\n  st _top, _lma, 0\n  call __init\n  call _r, f"); wn(mainf); w("\n  ret _r\n}\nentry __start\n");
  return 0;
}
