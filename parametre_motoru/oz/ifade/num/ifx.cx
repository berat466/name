      CV cv0 = cx_eval_top(init); int okc = cx_fail == 0 && (cx_isi(cv0.t) || cx_isf(cv0.t)) && (cx_isi(unq(T)) || cx_isf(unq(T))); cx_fail = 0;
      if (okc == 0) { if (vf0 & 2) die("E_CONSTINIT", "constinit ilklendirici sabit ifade degil"); if (is_int(T)) die("E_CONSTEXPR", "constexpr ilklendirici sabit ifade degil"); }
      else if (vf0 & 2) { CV c2 = cx_conv(cv0, unq(T)); gcinit[ngl] = 1; if (cx_isf(unq(T))) gcib[ngl] = d_to_bits(c2.d); else gcib[ngl] = c2.i; }
    }
  }
  if ((vf0 & 1) && is_int(T) && gci[ngl] == 0) die("E_CONSTEXPR", "constexpr ilklendirici sabit ifade degil");
  if (merge_g >= 0) ngl = ngl_save; else ngl = ngl + 1;
}
int init_pass(int real, int frame) {
  int saved_lab = nlab; long long saved_dat = ndat; int saved_s = nstrn;
  nvars = 0; nreg = 0; npair = 0; foff = 0; nloop = 0; try_depth = 0; nhs = 0; cur_cls = 0 - 1; cur_fn = 0 - 1;
  if (real == 0) { ndl = 0; ndp = 0; }
  cur_ret_kind = 0 - 1;
  if (real) { w("func __init() {\n"); pm_begin(0); fn_prologue(frame); }
  int i = 0;
  while (i < ngl) {
    int f = gnode[i]; int init = 0 - 1; if (nk_n[f] > 1) init = kid(f, 1); curline = nk_line[f];
    if (gcinit[i] == 0 && (init >= 0 || is_cls(unq(gty[i])) || is_arr(gty[i]))) { int base = nreg; long long a = newreg(); setk(a, 1); w("  mov "); wr(a); w(", g"); wn(i); wc(10); init_obj(mkv(0, 1, a), gty[i], init, nk_i[f]); nreg = base; }
    i = i + 1;
  }
  emit_ret(imm(0, 0)); if (real) { w("}\n"); pm_end(); }
  int used = foff; if (used < 1) used = 1;
  if (real == 0) { nlab = saved_lab; ndat = saved_dat; nstrn = saved_s; }
  return used;
}
