void declare_class(int node) {
  curline = nk_line[node]; int nm = nk_s1[node]; int ci = find_class(nm);
  if (nk_j[node] == 1) { if (ci < 0) newclass(nm); return; }
  if (ci >= 0) { if (cl_def[ci]) die("E_REDEF", "sinif iki kez tanimlandi"); } else ci = newclass(nm);
  if (nk_s2[node] >= 0) { int b = find_class(nk_s2[node]); if (b < 0 || cl_def[b] == 0) die("E_SINIF", "taban sinif tanimli degil"); cl_base[ci] = b; }
