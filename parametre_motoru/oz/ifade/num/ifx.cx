        else { int al = buf[2]; int k = 0; pn_kind[npn] = 3; pn_id[npn] = buf[0]; pn_off[npn] = npc; pn_len[npn] = al; while (k < al) { pn_chars[npc] = buf[3 + k]; npc = npc + 1; k = k + 1; } npn = npn + 1; }
