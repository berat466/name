      V v = mkv(ptrto(withc(mkt(Y_CHAR, 0 - 1, 0), 1)), 0, r); merge_eff(v, o); return v;
    }
    methods_named(search, nk_s1[cn]);
    if (nmeth_cand == 0) {
      int oc = find_field(ocls, nk_s1[cn]);
      if (oc >= 0 && is_cls(unq(fq_ty))) { V f = mkv(fq_ty, 1, 0); if (fq_woff) { f.reg = newreg(); w("  add "); wr(f.reg); w(", "); opr(o); w(", "); wn(fq_woff); wc(10); } else f.reg = o.reg; f.vp = o.vp; calleeobj = f; opcall = 1; }
