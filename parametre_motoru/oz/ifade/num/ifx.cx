  layout_class(ci); finish_defaulted(ci);
}
void static_assert_check(int n) {
  curline = nk_line[n]; CV v = cx_eval_top(kid(n, 0));
  if (cx_fail || (cx_isi(v.t) == 0 && cx_isf(v.t) == 0)) { cx_fail = 0; die("E_STATIC_ASSERT", "static_assert kosulu sabit ifade degil"); }
  if (cx_truth(v) == 0) die("E_STATIC_ASSERT", "static_assert basarisiz");
