  V b1 = to_scalar(gen(kid(n, 2)), rt, 0); w("  mov "); wr(res); w(", "); opr(b1); wc(10); wl(end); w(":\n");
  V r = mkv(rt, 0, res); merge_eff(r, c); merge_eff(r, a1); merge_eff(r, b1);
