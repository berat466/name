int type_name_buf = 0;
void mangle_into(int t, int pos_unused);
char mgb[300]; int mgn = 0;
void mg_c(const char* s) { while (*s) { mgb[mgn] = *s; mgn = mgn + 1; s++; } }
void mg_n(long long v) { if (v >= 10) mg_n(v / 10); mgb[mgn] = '0' + (v % 10); mgn = mgn + 1; }
void mangle_rec(int t) {
  if (tcv[t]) mg_c("K");
  int k = tk[t];
  if (k == Y_VOID) mg_c("v"); else if (k == 1) mg_c("b"); else if (k == 2) mg_c("c"); else if (k == 3) mg_c("a"); else if (k == 4) mg_c("h"); else if (k == 5) mg_c("s"); else if (k == 6) mg_c("t");
  else if (k == 7) mg_c("i"); else if (k == 8) mg_c("j"); else if (k == 9) mg_c("l"); else if (k == 10) mg_c("m"); else if (k == 11) mg_c("x"); else if (k == 12) mg_c("y"); else if (k == 13) mg_c("f");
  else if (k == 14) mg_c("d"); else if (k == 15) mg_c("e"); else if (k == 16) mg_c("Dn");
  else if (k == Y_PTR) { mg_c("P"); mangle_rec(te[t]); }
  else if (k == Y_ARR) { mg_c("A"); mg_n(tn[t]); mg_c("_"); mangle_rec(te[t]); }
  else if (k == Y_CLASS) { int nm = cl_name[tcl[t]]; mg_n(s_len[nm]); int i = 0; while (i < s_len[nm]) { mgb[mgn] = chars[s_off[nm] + i]; mgn = mgn + 1; i = i + 1; } }
}
int mangle(int t) { mgn = 0; mangle_rec(t); mgb[mgn] = 0; return intern_n(mgb, mgn); }
V typeid_v(int id) {
