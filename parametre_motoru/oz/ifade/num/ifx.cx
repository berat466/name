V const_cast_(V v, int T) {
  if (is_ref(T)) {
    if (v.cat != 1 && tk[T] != Y_RREF) die("E_LVALUE", "const_cast<T&>: lvalue gerekli");
    if (unq(v.ty) != unq(te[T])) die("E_CONSTCAST", "const_cast yalniz cv niteleyicilerini degistirir");
    V o = v; o.ty = te[T]; if (tk[T] == Y_RREF) o.cat = 2; return o;
  }
  V r = rval(v); T = unq(T);
  if (is_ptr(T) == 0 || is_ptr(r.ty) == 0) die("E_CONSTCAST", "const_cast yalniz isaretci/referans");
