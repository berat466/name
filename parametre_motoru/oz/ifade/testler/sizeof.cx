// 02.015 / 02.016: sizeof, alignof (ABI), sabit ifade
struct E {};
struct A { char c; };
struct B { char c; int i; };
struct C { char c; double d; char e; };
struct D { int a[3]; char b; };
struct V { virtual void f() {} int x; };
struct Dr : B { char z; };
struct W : V { char y; };
struct Em2 : E { int k; };
const int N = 4;
int main() {
  pi(sizeof(char)); pi(sizeof(short)); pi(sizeof(int)); pi(sizeof(long)); pi(sizeof(long long)); pi(sizeof(float)); pi(sizeof(double)); pi(sizeof(long double));
  pi(sizeof(bool)); pi(sizeof(void*)); pi(sizeof(unsigned char)); pi(sizeof(unsigned long long));
  pi(sizeof(E)); pi(sizeof(A)); pi(sizeof(B)); pi(sizeof(C)); pi(sizeof(D)); pi(sizeof(V)); pi(sizeof(Dr)); pi(sizeof(W)); pi(sizeof(Em2));
  pi(alignof(char)); pi(alignof(int)); pi(alignof(double)); pi(alignof(B)); pi(alignof(C)); pi(alignof(V)); pi(alignof(D)); pi(alignof(long double));
  int arr[N * 2 + 1]; pi(sizeof(arr)); pi(sizeof(arr) / sizeof(arr[0]));
  int x = 5; pi(sizeof x); pi(sizeof(x + 1.0)); pi(sizeof(x++)); pi(x);
  pi(sizeof(int[10])); pi(sizeof(int*[3])); pi(sizeof(char[4][5]));
  pi(sizeof('a')); pi(sizeof(1L)); pi(sizeof(1.0f)); pi(sizeof("abc")); pi(sizeof(nullptr));
  pi(sizeof(sizeof(int)) == 8);
  unsigned long long big = sizeof(arr) * 1000000000ull; pi(big);
  pi(sizeof(B*)); pi(sizeof(A&));
  B b; pi(sizeof(b)); pi(sizeof b.i); pi(sizeof(b.c)); B* pb = &b; pi(sizeof(*pb));
  return 0;
}
