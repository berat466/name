  ++i = 50; pi(i);
  (++i)++; pi(i);
  char c = 127; c++; pi(c);
  unsigned char u = 255; ++u; pi(u);
  short s = -32768; s--; pi(s);
  unsigned w = 0; --w; pi(w);
