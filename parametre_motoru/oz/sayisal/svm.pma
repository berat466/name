n_lit: eqi z, pid, 58
    jz z, d_bad
    mov v, f1
    jmp a_st
d_bad: call x, red, 30
mdone: mov ip, nip
    jmp loop
}

; host islevi (ic kod): w = pencere taban konumu (RS), pencere RS[w..]
func dohost(hid, w, memw) {
    add a, hid, HM
    ld hc, a, 0
    add a, w, RS
    ld v, a, 0
    eqi z, hc, 1
    jz z, h2
    host putc, v
    mov zr, 0
    st zr, a, 0
    ret 0
h2: eqi z, hc, 2
    jz z, h3
    host puti, v
    mov zr, 0
    st zr, a, 0
    ret 0
h3: eqi z, hc, 3
    jz z, h4
    host putf, v
    mov zr, 0
    st zr, a, 0
    ret 0
h4: eqi z, hc, 4
    jz z, h5
    call ch, gchar
    st ch, a, 0
    ret 0
h5: eqi z, hc, 5
    jz z, h6
    ; present(ptr, w, h)
    ld pt, a, 0
    ld wd, a, 1
    ld ht, a, 2
    mov m1, -1
    jz wd, hp_bad
    jz ht, hp_bad
    lti z, wd, 0
    jnz z, hp_bad
    lti z, ht, 0
    jnz z, hp_bad
    gti z, wd, 4096
    jnz z, hp_bad
    gti z, ht, 4096
    jnz z, hp_bad
    jz pt, hp_bad
    lti z, pt, 0
    jnz z, hp_bad
    gt z, pt, memw
    jnz z, hp_bad
    mul wh, wd, ht
    sub rem, memw, pt
    gt z, wh, rem
    jnz z, hp_bad
    ; gecerli: kendi present'imizle (pencere bu aracin belleginde: MG + pt)
    mov base, MG
    add pp, base, pt
    host r, present, pp, wd, ht
    st r, a, 0
    ret 0
hp_bad: st m1, a, 0
    ret 0
h6: eqi z, hc, 6
    jz z, h7
    host r, poll
    st r, a, 0
    ret 0
h7: eqi z, hc, 7
    jz z, h8
    host r, frame
    st r, a, 0
    ret 0
h8: call x, red, 31
    ret 0
}

; programin getc'i: IB'de @@GIRDI sonrasi bayt dizisi; G[7]=konum G[8]=son
func gchar() {
    ld p, G, 7
    ld e, G, 8
    ge z, p, e
    jz z, g1
    ret -1
g1: add a, p, IB
    ld c, a, 0
    addi p, p, 1
    st p, G, 7
    ret c
}

func main() {
    call n, readall
    mov p, 0
    mov tabend, n
    mov progs, -1
    mov proge, n
    mov inps, n
    mov inpe, n
    mov fuel0, 4000000000
m1: ge z, p, n
    jnz z, m9
    call e, eol, p, n
    add a, p, IB
    ld c0, a, 0
    eqi z, c0, 64
    jz z, mnx
    addi a, p, 1
    add a, a, IB
    ld c1, a, 0
    eqi z, c1, 64
    jz z, mnx
    addi a, p, 2
    add a, a, IB
    ld c2, a, 0
    ; tablo sonu = ilk ayirac satirinin basi
    ne z, tabend, n
    jnz z, ms1
    mov tabend, p
ms1: eqi z, c2, 89
    jz z, m2
    addi q, p, 7
    mov v, 0
my1: ge z, q, e
    jnz z, my2
    add a, q, IB
    ld c, a, 0
    lti z, c, 48
    jnz z, my2a
    gti z, c, 57
    jnz z, my2a
    muli v, v, 10
    addi c, c, -48
    add v, v, c
my2a: addi q, q, 1
    jmp my1
my2: mov fuel0, v
    jmp mnx
m2: eqi z, c2, 80
    jz z, m3
    addi progs, e, 1
    jmp mnx
m3: eqi z, c2, 71
    jz z, mnx
    mov proge, p
    addi inps, e, 1
    mov inpe, n
    mov p, n
    jmp m9
mnx: addi p, e, 1
    jmp m1
m9: gei z, progs, 0
    jnz z, ok1
    call x, red, 40
ok1: call ntab, nums, 0, tabend, TB, 600000
    st ntab, G, 0
    call x, loadtab, ntab
    call np, nums, progs, proge, PG, 3000000
    call x, loadprog, np
    st fuel0, G, 6
    st inps, G, 7
    st inpe, G, 8
    call res, run
    ret 0
}
