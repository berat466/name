    add heap, heap, x
    jmp mloop
al_bad: call x, trap, N_ALLOC
d_f: lei z, pid, 46
    jz z, d_sel
    ; ondalik: x = T[f1], y = T[f2] (tekliler y kullanmaz)
    add a, f1, TS
    ld x, a, 0
    add a, f2, TS
    ld y, a, 0
    eqi z, pid, 36
    jz z, fp37
    fadd v, x, y
    jmp a_st
fp37: eqi z, pid, 37
    jz z, fp38
    fsub v, x, y
    jmp a_st
fp38: eqi z, pid, 38
    jz z, fp39
    fmul v, x, y
    jmp a_st
fp39: eqi z, pid, 39
    jz z, fp40
    fdiv v, x, y
    jmp a_st
fp40: eqi z, pid, 40
    jz z, fp41
    fneg v, x
    jmp a_st
fp41: eqi z, pid, 41
    jz z, fp42
    fsqrt v, x
    jmp a_st
fp42: eqi z, pid, 42
    jz z, fp43
    feq v, x, y
    jmp a_st
fp43: eqi z, pid, 43
    jz z, fp44
    flt v, x, y
    jmp a_st
fp44: eqi z, pid, 44
    jz z, fp45
    fle v, x, y
    jmp a_st
fp45: eqi z, pid, 45
    jz z, fp46
    i2f v, x
    jmp a_st
fp46: f2i v, x
    jmp a_st
d_sel: eqi z, pid, 47
    jz z, d_new
    add a, f1, TS
    ld c, a, 0
    add a, f2, TS
    ld x, a, 0
    add a, f3, TS
    ld y, a, 0
    mov v, y
    jz c, a_st
    mov v, x
    jmp a_st
d_new: ; 48..58: isaret/sifir genisletme, isaretsiz karsilastirma ve bolme, sabit sayi
    gei z, pid, 48
    jz z, d_bad
    lei z, pid, 53
    jz z, n_cmp
    add a, f1, TS
    ld x, a, 0
    eqi z, pid, 48
    jz z, nx2
