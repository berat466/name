    add a, f1, OP3
    ld cb, a, 0
    add a, cf, FR
    ld cnr, a, 0
    add nrb, rb, cb
    mov lim, 1048576
    sub room, lim, nrb
    ge z, room, cnr
    jnz z, cl1
    call x, trap, N_STACK
cl1: gei z, depth, 65536
    jz z, cl2
    call x, trap, N_DEPTH
cl2: add a, depth, FRI
    addi t, ip, 1
    st t, a, 0
    add a, depth, FRB
    st rb, a, 0
    add a, depth, FRF
    st fn, a, 0
    addi depth, depth, 1
    ; yerelleri sifirla: [np, nr)
    add a, cf, FP
    ld cnp, a, 0
    mov r, cnp
cl3: ge z, r, cnr
    jnz z, cl4
    add a, nrb, r
    add a, a, RS
    mov zr, 0
    st zr, a, 0
    addi r, r, 1
    jmp cl3
cl4: mov rb, nrb
    mov fn, cf
    add a, fn, FB
    ld nip, a, 0
    jmp mdone
d_ret: eqi z, pid, 32
    jz z, d_halt
    add a, f0, TS
    ld x, a, 0
    jnz depth, rt1
    ret x
rt1: add a, rb, RS
    st x, a, 0
    addi depth, depth, -1
    add a, depth, FRI
    ld nip, a, 0
    add a, depth, FRB
    ld rb, a, 0
    add a, depth, FRF
    ld fn, a, 0
    jmp mdone
d_halt: eqi z, pid, 33
    jz z, d_host
    ret 0
d_host: eqi z, pid, 34
    jz z, d_alloc
    jnz fuel, ho0
    call x, trap, N_FUEL
ho0: addi fuel, fuel, -1
    add a, f0, OP3
    ld hid, a, 0
    add a, f1, OP3
    ld hb, a, 0
    add w, rb, hb
