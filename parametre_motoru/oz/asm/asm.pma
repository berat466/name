; ---------- baslangic: SRC sonuna sabit metinler ----------
func copyz(src_base, idx) {      ; NUL ile ayrilmis tablodan idx. metni SRC sonuna kopyala: ofset dondur, uzunluk G[30]
    mov k, 0
    mov i, 0
c1: ge z, i, idx
    jnz z, c4
c2: add a, src_base, k
