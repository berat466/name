; asm.pma -- .pma metni -> PMB1 (adlar atilmis: `pm asm --strip` ile BAYT-BAYT ayni cikti) ASSEMBLER'I (parametre tablosu).
; stdin: .pma kaynagi (en cok 1 MiB); stdout: PMB1 baytlari. Hata -> stdout'a "HATA satir N: kod" yazilir ve DIV0 tuzagi (cikis 2).
; C++ karsiligi: src/asm.cpp (ayni algoritma: etiket/dogrudan-operand donusumu, sabit yazmaclari, cagri pencereleri, gozetleme deligi).
; Fark [Kesin]: ondalik sabitler (2.0 gibi) desteklenmez (strtod yok) -> hata kodu 90. validate_program/analyze_program calistirilmaz
; (cikti oz/dogr/valid.pmb ile dogrulanir); yalnizca "veri bellege sigmiyor" ve "giris fonksiyonu parametre almamali" burada da denetlenir.
memory 12582912
entry main
space SRC 1200000
space TOKO 262144
space TOKL 262144
space STLN 131072
space STT0 131072
space STNT 131072
space FNNO 65536
space FNNL 65536
space FNLN 65536
space FNNP 65536
space FNPT 65536
space FNBS 65536
space FNBE 65536
space FNNR 65536
space FNCS 65536
space FNCN 65536
space PARO 131072
space PARL 131072
space SYO 65536
space SYL 65536
space SYK 65536
space SYV 65536
space CONSTV 65536
space DATAV 262144
space REGO 65536
space REGL 65536
space LABO 65536
space LABL 65536
space LABV 65536
space IRMN 65536
space IRS 65536
space IRN 65536
space IRLN 65536
space OPO 262144
space OPL 262144
space IIOP 65536
space IIHAS 65536
space IIDEST 65536
space IOT0 65536
space IOV0 65536
space IOT1 65536
space IOV1 65536
space IOT2 65536
space IOV2 65536
space IAS 65536
space IAN 65536
space ARGT 262144
space ARGV 262144
space LITV 65536
space COP 131072
space CA 131072
space CB 131072
space CC 131072
space PCOF 65536
space RD 65536
space WR 65536
space TGT 131072
space DEL 131072
space IDX 131072
space GOP 524288
space GA 524288
space GB 524288
space GC 524288
space OUTB 1048576
space NMO 64
space NML 64
space G 128
data OPNAMES = 109 111 118 0 108 100 105 0 108 100 107 0 97 100 100 0 115 117 98 0 109 117 108 0 100 105 118 0 109 111 100 0 97 110 100 0 111 114 0 120 111 114 0 115 104 108 0 115 104 114 0 115 97 114 0 101 113 0 110 101 0 108 116 0 108 101 0 110 101 103 0 110 111 116 0 102 97 100 100 0 102 115 117 98 0 102 109 117 108 0 102 100 105 118 0 102 110 101 103 0 102 115 113 114 116 0 102 101 113 0 102 108 116 0 102 108 101 0 105 50 102 0 102 50 105 0 106 109 112 0 106 122 0 106 110 122 0 99 97 108 108 0 114 101 116 0 104 97 108 116 0 108 100 0 115 116 0 97 108 108 111 99 0 104 111 115 116 0 97 100 100 105 0 109 117 108 105 0 97 110 100 105 0 115 104 108 105 0 115 104 114 105 0 115 97 114 105 0 100 105 118 105 0 109 111 100 105 0 101 113 105 0 110 101 105 0 108 116 105 0 108 101 105 0 103 116 105 0 103 101 105 0 112 117 116 99 0 112 117 116 105 0 112 117 116 102 0 103 101 116 99 0 112 114 101 115 101 110 116 0 112 111 108 108 0 102 114 97 109 101 0
data NOPS = 2 2 2 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 2 2 3 3 3 3 2 2 3 3 3 2 2 1 2 2 2 1 0 3 3 2 2 3 3 3 3 3 3 3 3 3 3 3 3 3 3
data KIND = 1 4 0 1 5 0 1 6 0 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 2 1 2 0 1 2 0 1 3 3 1 3 3 1 3 3 1 3 3 1 3 0 1 3 0 1 3 3 1 3 3 1 3 3 1 2 0 1 3 0 7 0 0 2 7 0 2 7 0 8 9 0 4 0 0 0 0 0 1 2 5 4 2 5 1 2 0 10 9 0 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5 1 2 5
data ARITY = 1 1 1 0 3 0 0
data KWS = "memory\0entry\0data\0space\0func\0gt\0ge\0fgt\0fge\0main\0"

; G: 0 NSRC(kullanilan) 1 SATIR 2 NTOK 3 NST 4 NFN 5 NSY 6 NCONST 7 NDATA 8 BSS 9 BELLEK 10 giris-ad-ofset 11 giris-ad-uzunluk 12 giris-satiri
;    13 PV(parse_int degeri) 14 NGC(genel komut sayisi) 15 NOUT 16 gecerli fonksiyon 17 ORJ_UZUNLUK(kaynak) 20 NREG 21 NLAB 22 NIR 23 NOPR 24 NLIT 25 MAXWIN
;    26 NARG 27 NCODE 28 FNLN 30 mkint-uzunluk 31 ASM-hata-satiri

func err(code) {
    host putc, 72
    host putc, 65
    host putc, 84
    host putc, 65
    host putc, 32
    ld ln, G, 1
    host puti, ln
    host putc, 58
    host putc, 32
    host puti, code
    host putc, 10
    mov z, 0
    div x, 1, z
    ret 0
}

func sc(i) {
    add a, i, SRC
    ld c, a, 0
    ret c
}

func isdig(c) {
    lt z, c, 48
    jnz z, no
    gt z, c, 57
    jnz z, no
    ret 1
no: ret 0
}

func isalp(c) {      ; harf ya da '_'
    eq z, c, 95
    jz z, a1
    ret 1
a1: lt z, c, 65
    jnz z, no
    le z, c, 90
    jz z, a2
    ret 1
a2: lt z, c, 97
    jnz z, no
    le z, c, 122
    jz z, no
    ret 1
no: ret 0
}

func isalnum_(c) {
    call r, isdig, c
    jz r, a1
    ret 1
a1: call r, isalp, c
    ret r
}

func is_ident(o, l) {
    jnz l, i1
    ret 0
i1: call c, sc, o
    call r, isalp, c
    jnz r, i2
    ret 0
i2: mov k, 1
i3: ge z, k, l
    jnz z, ok
    add p, o, k
    call c, sc, p
    call r, isalnum_, c
    jnz r, i4
    ret 0
i4: add k, k, 1
    jmp i3
ok: ret 1
}

func streq(o1, l1, o2, l2) {
    eq z, l1, l2
    jnz z, s1
    ret 0
s1: mov k, 0
s2: ge z, k, l1
    jnz z, ok
    add p, o1, k
    call c1, sc, p
    add p, o2, k
    call c2, sc, p
    eq z, c1, c2
    jnz z, s3
    ret 0
s3: add k, k, 1
    jmp s2
ok: ret 1
}

; ad tablolari: NMO/NML = komut (0..54) ve host (55..61) adlari (SRC sonuna kopyalanmis)
func opid(o, l) {
    mov i, 0
o1: ge z, i, 55
    jnz z, no
    add a, i, NMO
    ld po, a, 0
    add a, i, NML
    ld pl, a, 0
    call r, streq, o, l, po, pl
    jnz r, yes
    add i, i, 1
    jmp o1
yes: ret i
no: ret -1
}

func hostid(o, l) {
    mov i, 0
h1: ge z, i, 7
    jnz z, no
    add j, i, 55
    add a, j, NMO
    ld po, a, 0
    add a, j, NML
    ld pl, a, 0
    call r, streq, o, l, po, pl
    jnz r, yes
    add i, i, 1
    jmp h1
yes: ret i
no: ret -1
}

func funcfind(o, l) {
    ld n, G, 5
    mov i, 0
f1: ge z, i, n
    jnz z, no
    add a, i, SYK
    ld k, a, 0
    eq z, k, 1
    jz z, f2
    add a, i, SYO
    ld po, a, 0
    add a, i, SYL
    ld pl, a, 0
    call r, streq, o, l, po, pl
    jz r, f2
    add a, i, SYV
    ld v, a, 0
    ret v
f2: add i, i, 1
    jmp f1
no: ret -1
}

func datafind(o, l) {     ; data/space adi: sembol indeksi ya da -1
    ld n, G, 5
    mov i, 0
f1: ge z, i, n
    jnz z, no
    add a, i, SYK
    ld k, a, 0
    eq z, k, 1
    jnz z, f2
    add a, i, SYO
    ld po, a, 0
    add a, i, SYL
    ld pl, a, 0
    call r, streq, o, l, po, pl
    jz r, f2
    ret i
f2: add i, i, 1
    jmp f1
no: ret -1
}

func addsym(o, l, k, v) {
    ld n, G, 5
    ge z, n, 65536
    jz z, a1
    call x, err, 80
a1: add a, n, SYO
    st o, a, 0
    add a, n, SYL
    st l, a, 0
    add a, n, SYK
    st k, a, 0
    add a, n, SYV
    st v, a, 0
    add n, n, 1
    st n, G, 5
    ret 0
}

; SRC sonuna yazi ekle (sentezlenmis simge): int32 araligindaki bir tam sayiyi onluk yazar; ofseti dondurur, uzunlugu G[30]'a koyar
func mkint(v) {
    ld o, G, 0
    mov ng, 0
    mov u, v
    lt z, v, 0
    jz z, m1
    mov ng, 1
    neg u, v
m1: mov nd, 0
    add tmp, o, 40
m2: modi r, u, 10
    divi u, u, 10
    addi r, r, 48
    add a, tmp, nd
    add a, a, SRC
    st r, a, 0
    add nd, nd, 1
    jnz u, m2
    mov len, 0
    jz ng, m3
    mov c, 45
    add a, o, SRC
    st c, a, 0
    mov len, 1
m3: mov i, 0
m4: ge z, i, nd
    jnz z, m5
    sub k, nd, 1
    sub k, k, i
    add a, tmp, k
    add a, a, SRC
    ld c, a, 0
    add a, o, len
    add a, a, SRC
    st c, a, 0
    add len, len, 1
    add i, i, 1
    jmp m4
m5: st len, G, 30
    add o2, o, len
    st o2, G, 0
    ret o
}

; parse_int: [o,l) -> 1/0; deger G[13]'te (strtoll semantigi: onluk/onaltilik, +/-, 'c' karakter sabiti)
func esc_char(c) {
    eq z, c, 110
    jz z, e1
    ret 10
e1: eq z, c, 116
    jz z, e2
    ret 9
e2: eq z, c, 114
    jz z, e3
    ret 13
e3: eq z, c, 48
    jz z, e4
    ret 0
e4: eq z, c, 92
    jz z, e5
    ret 92
e5: eq z, c, 34
    jz z, e6
    ret 34
e6: eq z, c, 39
    jz z, e7
    ret 39
e7: ret -1
}

func hexval(c) {      ; -1: onaltilik basamak degil
    call d, isdig, c
    jz d, h1
    sub r, c, 48
    ret r
h1: lt z, c, 97
    jnz z, h2
    gt z, c, 102
    jnz z, h2
    sub r, c, 87
    ret r
h2: lt z, c, 65
    jnz z, h3
    gt z, c, 70
    jnz z, h3
    sub r, c, 55
    ret r
h3: ret -1
}

func parse_int(o, l) {
    lti z, l, 3
    jnz z, num
    call c0, sc, o
    eq z, c0, 39
    jz z, num
    sub e, l, 1
    add e, e, o
    call c1, sc, e
    eq z, c1, 39
    jz z, num
    add p, o, 1
    call c1, sc, p
    eq z, c1, 92
    jz z, ch2
    eq z, l, 4
    jz z, ch2
    add p, o, 2
    call c2, sc, p
    call v, esc_char, c2
    lti z, v, 0
    jnz z, bad
    st v, G, 13
    ret 1
ch2: eq z, l, 3
    jz z, bad
    add p, o, 1
    call c1, sc, p
    st c1, G, 13
    ret 1
num: jnz l, n1
    ret 0
n1: call c, sc, o
    eq z, c, 45
    jnz z, sg
    eq z, c, 43
    jnz z, sg
    call d, isdig, c
    jnz d, n2
    ret 0
n2: mov k, 0
    jmp n3
sg: mov k, 1
n3: ge z, k, l
    jz z, n4
    ret 0
n4: add p, o, k
    call c, sc, p
    call d, isdig, c
    jnz d, n5
    ret 0
n5: mov hex, 0
    add k1, k, 1
    ge z, l, k1
    jnz z, n6
    jmp n7
n6: gt z, l, k1
    jz z, n7
    call c0, sc, p
    eq z, c0, 48
    jz z, n7
    add p1, p, 1
    call c1, sc, p1
    eq z, c1, 120
    jnz z, n8
    eq z, c1, 88
    jz z, n7
n8: mov hex, 1
n7: ; basamaklari topla (isaretsiz, tasma denetimli)
    mov val, 0
    add i, o, k
    jz hex, n9
    add i, i, 2
    ; en az bir onaltilik basamak
    add e, o, l
    ge z, i, e
    jz z, n9
    ret 0
n9: add e, o, l
n10: ge z, i, e
    jnz z, n13
    call c, sc, i
    jnz hex, n11
    call d, isdig, c
    jnz d, n12
    ret 0
n11: call d, hexval, c
    lti z, d, 0
    jz z, n12
    ret 0
n12: ; (hex ise d zaten onaltilik deger; onluk ise d=1 -> yeniden hesapla)
    jnz hex, n14
    sub d, c, 48
n14: jnz hex, hx
    ; onluk: val*10+d tasma (isaretsiz)
    xor tx, val, -9223372036854775808
    gt o2, tx, -7378697629483820647
    jnz o2, ovf
    eq o2, val, 1844674407370955161
    jz o2, ok10
    gt o2, d, 5
    jnz o2, ovf
ok10: muli val, val, 10
    add val, val, d
    add i, i, 1
    jmp n10
hx: xor tx, val, -9223372036854775808
    gt o2, tx, -8070450532247928833
    jnz o2, ovf
    shli val, val, 4
    add val, val, d
    add i, i, 1
    jmp n10
ovf: ret 0
n13: ; isaret ve aralik: negatifse |val| <= 2^63, degilse <= 2^63-1
    call c, sc, o
    eq z, c, 45
    jz z, pos
    xor tx, val, -9223372036854775808
    gt o2, tx, 0
    jnz o2, ovf
    neg val, val
    st val, G, 13
    ret 1
pos: lt z, val, 0
    jnz z, ovf
    st val, G, 13
    ret 1
bad: ret 0
}

; ';' ile baslayan yorumu kes (string ve karakter sabiti icinde sayma): [a,b) icin yeni bitis
func strip_comment(a, b) {
    mov i, a
    mov ins, 0
s1: ge z, i, b
    jnz z, done
    call c, sc, i
    jz ins, s3
    eq z, c, 92
    jz z, s2
    add i, i, 2
    jmp s1
s2: eq z, c, 34
    jz z, s6
    mov ins, 0
s6: add i, i, 1
    jmp s1
s3: eq z, c, 34
    jz z, s4
    mov ins, 1
    add i, i, 1
    jmp s1
s4: eq z, c, 39
    jz z, s5
    add k, i, 1
    lt z, k, b
    jz z, s7
    call c2, sc, k
    eq z, c2, 92
    jz z, s7
    add i, i, 4
    jmp s1
s7: add i, i, 3
    jmp s1
s5: eq z, c, 59
    jz z, s8
    ret i
s8: add i, i, 1
    jmp s1
done: ret b
}

; [a,b) icindeki simgeleri TOKO/TOKL'ye ekler (ayirici: bosluk, sekme, virgul, CR); eklenen simge sayisini dondurur
func tokenize(a, b) {
    mov i, a
    mov cnt, 0
    mov sx, -1
t1: ge z, i, b
    jnz z, t9
    call c, sc, i
    eq z, c, 32
    jnz z, sep
    eq z, c, 9
    jnz z, sep
    eq z, c, 44
    jnz z, sep
    eq z, c, 13
    jnz z, sep
    gei z, sx, 0
    jnz z, t2
    mov sx, i
t2: add i, i, 1
    jmp t1
sep: lti z, sx, 0
    jnz z, t3
    call x, addtok, sx, i
    add cnt, cnt, 1
    mov sx, -1
t3: add i, i, 1
    jmp t1
t9: lti z, sx, 0
    jnz z, t10
    call x, addtok, sx, i
    add cnt, cnt, 1
t10: ret cnt
}

func addtok(s, e) {
    ld n, G, 2
    ge z, n, 262144
    jz z, a1
    call x, err, 81
a1: add a, n, TOKO
    st s, a, 0
    sub l, e, s
    add a, n, TOKL
    st l, a, 0
    add n, n, 1
    st n, G, 2
    ret 0
}

func kw(ti, o2, l2) {     ; jeton ti, [o2,l2) metnine esit mi? (anahtar sozcuk icin SRC sonuna konmus metin)
    add a, ti, TOKO
    ld o, a, 0
    add a, ti, TOKL
    ld l, a, 0
    call r, streq, o, l, o2, l2
    ret r
}

func findch(a, b, ch) {    ; [a,b) icinde ilk ch; yoksa -1
    mov i, a
f1: ge z, i, b
    jnz z, no
    call c, sc, i
    eq z, c, ch
    jz z, f2
    ret i
f2: add i, i, 1
    jmp f1
no: ret -1
}

func addstmt(ln, t0, nt) {
    ld n, G, 3
    ge z, n, 131072
    jz z, a1
    call x, err, 82
a1: add a, n, STLN
    st ln, a, 0
    add a, n, STT0
    st t0, a, 0
    add a, n, STNT
    st nt, a, 0
    add n, n, 1
    st n, G, 3
    ret 0
}

; ---------- data satiri: [a,b) = "ad = degerler" ----------
func data_line(a, b) {
    call eq_, findch, a, b, 61
    lti z, eq_, 0
    jz z, d1
    call x, err, 10
d1: ld n0, G, 2
    call nt, tokenize, a, eq_
    eq z, nt, 1
    jnz z, d2
    call x, err, 11
d2: add a1, n0, TOKO
    ld no, a1, 0
    add a1, n0, TOKL
    ld nl, a1, 0
    call r, is_ident, no, nl
    jnz r, d3
    call x, err, 11
d3: call r, datafind, no, nl
    lti z, r, 0
    jnz z, d4
    call x, err, 12
d4: ld before, G, 7
    add addr, before, 1
    call x, addsym, no, nl, 2, addr
    st n0, G, 2
    add i, eq_, 1
d5: ge z, i, b
    jnz z, d99
    call c, sc, i
    eq z, c, 32
    jnz z, d6
    eq z, c, 9
    jnz z, d6
    eq z, c, 44
    jnz z, d6
    eq z, c, 13
    jnz z, d6
    eq z, c, 34
    jnz z, str
    ; bosluksuz simge
    mov j, i
    eq z, c, 39
    jz z, d7
    add k, i, 1
    lt z, k, b
    jz z, d8
    call c2, sc, k
    eq z, c2, 92
    jz z, d8
    add j, i, 4
    jmp d9
d8: add j, i, 3
    jmp d9
d7: ge z, j, b
    jnz z, d9
    call c3, sc, j
    eq z, c3, 32
    jnz z, d9
    eq z, c3, 9
    jnz z, d9
    eq z, c3, 44
    jnz z, d9
    eq z, c3, 13
    jnz z, d9
    add j, j, 1
    jmp d7
d9: gt z, j, b
    jz z, d10
    mov j, b
d10: sub l, j, i
    call r, parse_int, i, l
    jz r, d11
    ld v, G, 13
    call x, pushdata, v
    mov i, j
    jmp d5
d11: call r, isfloat, i, l
    jz r, d12
    call x, err, 90
d12: call x, err, 13
d6: add i, i, 1
    jmp d5
str: add i, i, 1
s1: ge z, i, b
    jnz z, s9
    call c, sc, i
    eq z, c, 34
    jnz z, s8
    eq z, c, 92
    jz z, s2
    add k, i, 1
    ge z, k, b
    jz z, s3
    call x, err, 14
s3: call c2, sc, k
    eq z, c2, 120
    jz z, s4
    add k, i, 3
    ge z, k, b
    jz z, s5
    call x, err, 15
s5: add p, i, 2
    call h1, sc, p
    call h1, hexval, h1
    add p, i, 3
    call h2, sc, p
    call h2, hexval, h2
    ; strtol: en cok 2 onaltilik basamak; ilk gecersizde dur
    lti z, h1, 0
    jz z, s6
    mov hv, 0
    jmp s7
s6: lti z, h2, 0
    jz z, s6b
    mov hv, h1
    jmp s7
s6b: muli hv, h1, 16
    add hv, hv, h2
s7: call x, pushdata, hv
    add i, i, 4
    jmp s1
s4: call v, esc_char, c2
    lti z, v, 0
    jz z, s4b
    call x, err, 16
s4b: call x, pushdata, v
    add i, i, 2
    jmp s1
s2: call x, pushdata, c
    add i, i, 1
    jmp s1
s8: add i, i, 1
    jmp d5
s9: call x, err, 17
d99: ld nd, G, 7
    ne z, nd, before
    jnz z, d98
    call x, err, 18
d98: ret 0
}

func pushdata(v) {
    ld n, G, 7
    ge z, n, 262144
    jz z, p1
    call x, err, 83
p1: add a, n, DATAV
    st v, a, 0
    add n, n, 1
    st n, G, 7
    ret 0
}

; parse_float'in kabul edecegi bir jeton mu? (yalniz karar; deger hesaplanmaz)
func isfloat(o, l) {
    jnz l, f0
    ret 0
f0: call c, sc, o
    call d, isdig, c
    jnz d, f1
    eq z, c, 45
    jnz z, f1
    eq z, c, 43
    jnz z, f1
    eq z, c, 46
    jnz z, f1
    ret 0
f1: mov hasd, 0
    mov i, 0
f2: ge z, i, l
    jnz z, f3
    add p, o, i
