}

func uleb(v) {
u1: andi b, v, 127
    shri v, v, 7
    jz v, u2
    or b, b, 128
u2: call x, outb, b
    jnz v, u1
    ret 0
}

func zig(v) {
    shli t, v, 1
    sari s, v, 63
    xor r, t, s
    ret r
}

func encode(entry) {
    call x, outb, 80
