    jnz z, e1
    call x, err, 21
e1: add t1, nt0, 1
    add a, t1, TOKO
    ld o, a, 0
    add a, t1, TOKL
    ld l, a, 0
    call r, is_ident, o, l
    jnz r, e2
    call x, err, 21
e2: st o, G, 10
    st l, G, 11
    st line, G, 12
    jmp reset
tp2: call r, ckw, nt0, 2
    jz r, tp3
    ; data: "data" sozcugunden sonrasi
    add s0, t0o, 4
    call x, data_line, s0, lend
    jmp reset
tp3: call r, ckw, nt0, 3
    jz r, tp4
    ; space ad N
    eq z, nt, 3
    jnz z, s1
    call x, err, 22
s1: add t1, nt0, 1
    add a, t1, TOKO
    ld no, a, 0
    add a, t1, TOKL
