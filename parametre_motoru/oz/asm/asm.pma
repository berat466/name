    ld ch, a, 0
    jz ch, c6
    add a, o, len
    add a, a, SRC
    st ch, a, 0
    add len, len, 1
    add k, k, 1
    jmp c5
c6: add o2, o, len
    st o2, G, 0
    st len, G, 30
    ret o
}

func init_names() {
    mov i, 0
n1: gei z, i, 62
    jnz z, n2
