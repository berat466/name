fbad: call x, err, 29
tp5: call x, err, 19
body:
    ; ---- fonksiyon govdesi
    eq z, nt, 1
    jz z, b1
    add a, nt0, TOKL
    ld l, a, 0
    eq z, l, 1
    jz z, b1
    add a, nt0, TOKO
    ld o, a, 0
    call c, sc, o
    eq z, c, 125
    jz z, b1
    ; "}" : fonksiyon bitti
    ld nst, G, 3
    ld cf, G, 4
    sub cf, cf, 1
    add a, cf, FNBE
    st nst, a, 0
    mov infunc, 0
    st nt0, G, 2
    jmp advance
b1: ; etiket + komut ayni satirda
    add a, nt0, TOKO
    ld o, a, 0
    add a, nt0, TOKL
    ld l, a, 0
    sub e, l, 1
    add e, e, o
    call c, sc, e
    eq z, c, 58
    jz z, b2
    gti z, nt, 1
    jz z, b2
    call x, addstmt, line, nt0, 1
    add n1, nt0, 1
    sub n2, nt, 1
    call x, addstmt, line, n1, n2
    jmp advance
b2: call x, addstmt, line, nt0, nt
    jmp advance
reset:
    st nt0, G, 2
advance:
    mov ls, nxt
    jmp pl
pend:
    jz infunc, pdone
    call x, err, 30
pdone:
    ret 0
}

