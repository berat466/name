k3: add a, j, G
    st o, a, 0
    add a, j, 1
    add a, a, G
    st l, a, 0
    add i, i, 1
    jmp k1
k9: call o, copyz, KWS, 9
    ld l, G, 30
    st o, G, 10
    st l, G, 11
    ret 0
}

func main() {
    ; stdin -> SRC
    mov n, 0
r1: host ch, getc
    lti z, ch, 0
    jnz z, r2
    ge z, n, 1048576
    jz z, r1a
