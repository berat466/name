    call nt, tokenize, ls, lend
    jz nt, advance
    jnz infunc, body
    ; ---- ust duzey
    add a, nt0, TOKO
    ld t0o, a, 0
    call r, ckw, nt0, 0
    jz r, tp1
    ; memory
    eq z, nt, 2
    jnz z, m1
