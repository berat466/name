    call nn, tokenize, fpos, lp
    eq z, nn, 1
    jnz z, f1
    call x, err, 24
f1: add a, c0, TOKO
    ld no, a, 0
    add a, c0, TOKL
    ld nl, a, 0
    call r, is_ident, no, nl
    jnz r, f2
    call x, err, 24
f2: add b1, br, 1
