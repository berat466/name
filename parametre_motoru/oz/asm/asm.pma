    lti z, r, 0
    jnz z, s6
    call x, err, 23
s6: call x, addsym, no, nl, 3, v
    jmp reset
tp4: call r, ckw, nt0, 4
    jz r, tp5
    ; func ad(p1, p2) {
    add fpos, t0o, 4
    call lp, findch, ls, lend, 40
    call rp, findch, ls, lend, 41
    call br, findch, ls, lend, 123
    lti z, lp, 0
    jnz z, fbad
    lti z, rp, 0
    jnz z, fbad
    lti z, br, 0
    jnz z, fbad
    ge z, lp, rp
    jnz z, fbad
    ge z, rp, br
    jnz z, fbad
    ; ad
