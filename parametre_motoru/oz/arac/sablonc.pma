; sablonc.pma -- x86-64 sablon bildirimi (sablon.txt) -> sayi tablolari TPLS/TPL (sablon.awk yerine).
; stdin: ops.h metni, "@@SABLON" satiri, sablon.txt. stdout: sozluk satirlari "TPLS ..." (74 baslangic, -1: tanimsiz) ve "TPL ..." (simge akisi, her sablon -1 ile biter).
; Simge: iki haneli buyuk onaltilik = bayt; LDA(x)/LDC(x)/STA(x) ve FUELCHK makrolari; R_A.. I_A.. K_B MEMW ... (imm32, kod 256+), REL_* (kod 300+), IMM8C (320).
memory 4194304
entry main
space IB 1100000
space NMO 128
space NML 128
space START 128
space TB 262144
space G 16
data IMMN = "R_A\0R_B\0R_C\0I_A\0I_B\0I_C\0K_B\0MEMW\0STKEND\0NREGS8\0NP8\0CNT\0MSG_DIV0\0MSG_OOB\0MSG_STACK\0MSG_DEPTH\0MSG_ALLOC\0RSBASE\0MBASE\0HEAP0\0DATAIMG\0ND\0HDR_ENTRY\0FILESZ\0MEMSZ\0FUEL0\0MSG_FUEL\0"
data RELN = "REL_DIV0\0REL_OOB\0REL_STACK\0REL_DEPTH\0REL_ALLOC\0REL_PUTI\0REL_PUTC\0REL_TA\0REL_TB\0REL_FA\0REL_EXIT\0REL_ENTRY\0REL_FUEL\0"
data XTRN = "host_putc\0host_puti\0host_putf\0host_getc\0host_present\0host_poll\0host_frame\0prologue\0exit0\0trap_div0\0trap_oob\0trap_stack\0trap_depth\0trap_alloc\0header\0jmp_back\0jz_back\0jnz_back\0trap_fuel\0"
data KW1 = "IMM8C\0FUELCHK\0"

func err(code) {
    host putc, 72
    host putc, 65
    host putc, 84
    host putc, 65
    host putc, 58
    host putc, 32
    host puti, code
    host putc, 10
    mov z, 0
    div x, 1, z
    ret 0
}

; NUL ayrilmis tablo (taban) icinde idx. girdisinin SRC'deki [o,l) metnine esit olup olmadigi
func eqn(tab, idx, o, l) {
    mov k, 0
    mov i, 0
c1: ge z, i, idx
    jnz z, c4
c2: add a, tab, k
    ld ch, a, 0
    addi k, k, 1
    jnz ch, c2
    addi i, i, 1
    jmp c1
c4: mov j, 0
c5: add a, tab, k
    ld ch, a, 0
    jz ch, c8
    ge z, j, l
    jnz z, no
    add a, o, j
    add a, a, IB
    ld c, a, 0
    ne z, c, ch
    jnz z, no
    addi j, j, 1
    addi k, k, 1
    jmp c5
c8: eq z, j, l
    jnz z, yes
no: ret 0
yes: ret 1
}

; metin [o,l) icin: tablo (NUL ayrilmis, n girdi) icinde indeks ya da -1
func findn(tab, n, o, l) {
    mov i, 0
f1: ge z, i, n
    jnz z, no
    call r, eqn, tab, i, o, l
    jz r, f2
    ret i
f2: addi i, i, 1
    jmp f1
no: ret -1
}

func hexv(c) {
    lti z, c, 48
    jnz z, no
    lei z, c, 57
    jz z, h1
    addi r, c, -48
    ret r
h1: lti z, c, 65
    jnz z, no
    lei z, c, 70
    jz z, no
    addi r, c, -55
    ret r
no: ret -1
}

func push(v) {
    ld n, G, 1
    gei z, n, 262144
    jz z, p1
    call x, err, 20
p1: add a, n, TB
    st v, a, 0
    addi n, n, 1
    st n, G, 1
    ret 0
}

func main() {
    mov n, 0
r1: host ch, getc
    lti z, ch, 0
    jnz z, r2
    gei z, n, 1048576
    jz z, r1a
    call x, err, 1
r1a: add a, n, IB
    st ch, a, 0
    addi n, n, 1
    jmp r1
r2: ; ---- ops.h: komut adlari ("  X(" ile baslayan satirlar) ---- "@@SABLON" satirina kadar
    mov p, 0
    mov nop, 0
l1: ge z, p, n
    jnz z, nosep
    mov e, p
l2: ge z, e, n
    jnz z, l3
    add a, e, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, l3
    addi e, e, 1
    jmp l2
l3: sub len, e, p
    eqi z, len, 8
    jz z, l4
    add a, p, IB
    ld c0, a, 0
    eqi z, c0, 64
    jz z, l4
    add a, p, 2
    add a, a, IB
    ld c2, a, 0
    eqi z, c2, 83
    jz z, l4
    addi p, e, 1
    jmp spec
l4: ; "  X(" ?
    lti z, len, 4
    jnz z, lnext
    add a, p, IB
    ld c0, a, 0
    eqi z, c0, 32
    jz z, lnext
    add a, p, 1
    add a, a, IB
    ld c1, a, 0
    eqi z, c1, 32
    jz z, lnext
    add a, p, 2
    add a, a, IB
    ld c2, a, 0
    eqi z, c2, 88
    jz z, lnext
    add a, p, 3
    add a, a, IB
    ld c3, a, 0
    eqi z, c3, 40
    jz z, lnext
    addi i, p, 4
m1: ge z, i, e
    jnz z, lnext
    add a, i, IB
    ld c, a, 0
    eqi z, c, 34
    jnz z, m2
    addi i, i, 1
    jmp m1
m2: addi i, i, 1
    mov ns, i
m3: ge z, i, e
    jnz z, lnext
    add a, i, IB
    ld c, a, 0
    eqi z, c, 34
    jnz z, m4
    addi i, i, 1
    jmp m3
m4: sub nl, i, ns
    gei z, nop, 128
    jz z, m5
    call x, err, 2
m5: add a, nop, NMO
    st ns, a, 0
    add a, nop, NML
    st nl, a, 0
    addi nop, nop, 1
lnext: addi p, e, 1
    jmp l1
nosep: call x, err, 3
spec: ; ---- sablon.txt satirlari
    mov zero, 0
    mov i, 0
sv0: gei z, i, 128
    jnz z, sv1
    add a, i, START
    mov m1v, -1
    st m1v, a, 0
    addi i, i, 1
    jmp sv0
sv1: st zero, G, 1
s1: ge z, p, n
    jnz z, out
    mov e, p
s2: ge z, e, n
    jnz z, s3
    add a, e, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, s3
    addi e, e, 1
    jmp s2
s3: ; yorumu kes
    mov q, p
s3a: ge z, q, e
    jnz z, s3b
    add a, q, IB
    ld c, a, 0
    eqi z, c, 35
    jnz z, s3b
    addi q, q, 1
    jmp s3a
s3b: mov e2, q
    ; ilk simge
    mov i, p
t0: ge z, i, e2
    jnz z, snext
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, t0a
    eqi z, c, 9
    jnz z, t0a
    eqi z, c, 13
    jz z, t0b
t0a: addi i, i, 1
    jmp t0
t0b: mov ts, i
t0c: ge z, i, e2
    jnz z, t0d
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, t0d
    eqi z, c, 9
    jnz z, t0d
    eqi z, c, 13
    jnz z, t0d
    addi i, i, 1
    jmp t0c
t0d: sub tl, i, ts
    ; sondaki ':' at
    sub t, tl, 1
    add t, t, ts
    add a, t, IB
    ld c, a, 0
    eqi z, c, 58
    jz z, nm0
    addi tl, tl, -1
nm0: ; ad -> indeks: once komutlar
    mov idx, -1
    mov j, 0
nm1: ge z, j, nop
    jnz z, nm3
    add a, j, NML
    ld l, a, 0
    eq z, l, tl
    jz z, nm2
    add a, j, NMO
    ld o, a, 0
    mov q, 0
nm1a: ge z, q, tl
    jnz z, nm1b
    add a, o, q
    add a, a, IB
    ld c1, a, 0
    add a, ts, q
    add a, a, IB
    ld c2, a, 0
    ne z, c1, c2
    jnz z, nm2
    addi q, q, 1
    jmp nm1a
nm1b: mov idx, j
    jmp nm4
nm2: addi j, j, 1
    jmp nm1
nm3: call r, findn, XTRN, 19, ts, tl
    lti z, r, 0
    jnz z, nm3a
    addi idx, r, 55
    jmp nm4
nm3a: call x, err, 4
nm4: ; tanimsiz mi?
    add a, idx, START
    ld sv, a, 0
    gei z, sv, 0
    jz z, nm5
    call x, err, 5
nm5: ld pos, G, 1
    add a, idx, START
    st pos, a, 0
    ; kalan simgeler
tk0: ge z, i, e2
    jnz z, tkend
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, tk0a
    eqi z, c, 9
    jnz z, tk0a
    eqi z, c, 13
    jz z, tk1
tk0a: addi i, i, 1
    jmp tk0
tk1: mov ts, i
tk2: ge z, i, e2
    jnz z, tk3
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, tk3
    eqi z, c, 9
    jnz z, tk3
    eqi z, c, 13
    jnz z, tk3
    addi i, i, 1
    jmp tk2
tk3: sub tl, i, ts
    call x, token, ts, tl
    jmp tk0
tkend: mov m1v, -1
    call x, push, m1v
snext: addi p, e, 1
    jmp s1
out: ; ---- cikti
    host putc, 84
    host putc, 80
    host putc, 76
    host putc, 83
    mov j, 0
o1: gei z, j, 74
    jnz z, o2
    host putc, 32
    add a, j, START
    ld v, a, 0
    host puti, v
    addi j, j, 1
    jmp o1
o2: host putc, 10
    host putc, 84
    host putc, 80
    host putc, 76
    ld cnt, G, 1
    mov j, 0
o3: ge z, j, cnt
    jnz z, o4
    host putc, 32
    add a, j, TB
    ld v, a, 0
    host puti, v
    addi j, j, 1
    jmp o3
o4: host putc, 10
    ret 0
}

; bir simge [o,l)
func token(o, l) {
    ; FUELCHK
    call r, eqn, KW1, 1, o, l
    jz r, t1
    call x, push, 77
    call x, push, 133
    call x, push, 246
    call x, push, 15
    call x, push, 132
    call x, push, 312
    call x, push, 73
    call x, push, 255
    call x, push, 206
    ret 0
t1: ; LDA(x) LDC(x) STA(x)
    eqi z, l, 6
    jz z, t2
    add a, o, 3
    add a, a, IB
    ld c3, a, 0
    eqi z, c3, 40
    jz z, t2
    add a, o, 5
    add a, a, IB
    ld c5, a, 0
    eqi z, c5, 41
    jz z, t2
    add a, o, 4
    add a, a, IB
    ld x4, a, 0
    addi xi, x4, -97
    lti z, xi, 0
    jnz z, t2
    gti z, xi, 2
    jnz z, t2
    add a, o, IB
    ld c0, a, 0
    add a, o, 1
    add a, a, IB
    ld c1, a, 0
    add a, o, 2
    add a, a, IB
    ld c2, a, 0
    eqi z, c1, 68
    jz z, t1a
    eqi z, c0, 76
    jz z, t1a
    eqi z, c2, 65
    jz z, t1a
    ; LDA
    call x, push, 72
    call x, push, 139
    call x, push, 131
    jmp t1z
t1a: eqi z, c0, 76
    jz z, t1b
    eqi z, c1, 68
    jz z, t1b
    eqi z, c2, 67
    jz z, t1b
    call x, push, 72
    call x, push, 139
    call x, push, 139
    jmp t1z
t1b: eqi z, c0, 83
    jz z, t2
    eqi z, c1, 84
    jz z, t2
    eqi z, c2, 65
    jz z, t2
    call x, push, 72
    call x, push, 137
    call x, push, 131
t1z: addi code, xi, 256
    call x, push, code
    ret 0
t2: ; iki haneli onaltilik bayt
    eqi z, l, 2
    jz z, t3
    add a, o, IB
    ld c0, a, 0
    call h0, hexv, c0
    lti z, h0, 0
    jnz z, t3
    add a, o, 1
    add a, a, IB
    ld c1, a, 0
    call h1, hexv, c1
    lti z, h1, 0
    jnz z, t3
    muli v, h0, 16
    add v, v, h1
    call x, push, v
    ret 0
t3: ; imm32 / rel32 adlari
    call r, findn, IMMN, 27, o, l
    lti z, r, 0
    jnz z, t4
    addi code, r, 256
    call x, push, code
    ret 0
t4: call r, findn, RELN, 13, o, l
    lti z, r, 0
    jnz z, t5
    addi code, r, 300
    call x, push, code
    ret 0
t5: call r, eqn, KW1, 0, o, l
    jz r, t6
    call x, push, 320
    ret 0
t6: call x, err, 6
}
