; sablonc.pma -- x86-64 sablon bildirimi (sablon.txt) -> sayi tablolari TPLS/TPL (sablon.awk yerine).
; stdin: KANONIK SAYISAL KOMUT TABLOSU (PMK1; komutlar.pmk; sablon anahtari = komut SEMBOLU kucuk harf), "@@SABLON" satiri, sablon.txt. stdout: sozluk satirlari "TPLS ..." (81 baslangic, -1: tanimsiz) ve "TPL ..." (simge akisi, her sablon -1 ile biter).
; Simge: iki haneli buyuk onaltilik = bayt; LDA(x)/LDC(x)/STA(x) ve FUELCHK makrolari; R_A.. I_A.. K_B MEMW ... (imm32, kod 256+), REL_* (kod 300+), IMM8C (320).
memory 4194304
entry main
space IB 1100000
space NMO 128
space NML 128
space START 128
space TK 200000
space NB 8192
space TB 262144
space G 16
data IMMN = "R_A\0R_B\0R_C\0I_A\0I_B\0I_C\0K_B\0MEMW\0STKEND\0NREGS8\0NP8\0CNT\0MSG_DIV0\0MSG_OOB\0MSG_STACK\0MSG_DEPTH\0MSG_ALLOC\0RSBASE\0MBASE\0HEAP0\0DATAIMG\0ND\0HDR_ENTRY\0FILESZ\0MEMSZ\0FUEL0\0MSG_FUEL\0LIMRT\0RTW\0RTNEG\0STK4\0R_B8\0R_B16\0RTIMG\0RTNW\0"
data RELN = "REL_DIV0\0REL_OOB\0REL_STACK\0REL_DEPTH\0REL_ALLOC\0REL_PUTI\0REL_PUTC\0REL_TA\0REL_TB\0REL_FA\0REL_EXIT\0REL_ENTRY\0REL_FUEL\0REL_EXITC\0REL_RTEND\0"
data XTRN = "host_putc\0host_puti\0host_putf\0host_getc\0host_present\0host_poll\0host_frame\0prologue\0exit0\0trap_div0\0trap_oob\0trap_stack\0trap_depth\0trap_alloc\0header\0jmp_back\0jz_back\0jnz_back\0trap_fuel\0ldp\0stp\0call_p\0host_sysw\0exitc\0exitc_rt\0prologue_rt\0"
data KW1 = "IMM8C\0FUELCHK\0"

func err(code) {
    host putc, 72
    host putc, 65
    host putc, 84
    host putc, 65
    host putc, 58
    host putc, 32
    host puti, code
    host putc, 10
    mov z, 0
    div x, 1, z
    ret 0
}

; NUL ayrilmis tablo (taban) icinde idx. girdisinin SRC'deki [o,l) metnine esit olup olmadigi
func eqn(tab, idx, o, l) {
    mov k, 0
    mov i, 0
c1: ge z, i, idx
    jnz z, c4
c2: add a, tab, k
    ld ch, a, 0
    addi k, k, 1
    jnz ch, c2
    addi i, i, 1
    jmp c1
c4: mov j, 0
c5: add a, tab, k
    ld ch, a, 0
    jz ch, c8
    ge z, j, l
    jnz z, no
    add a, o, j
    add a, a, IB
    ld c, a, 0
    ne z, c, ch
    jnz z, no
    addi j, j, 1
    addi k, k, 1
    jmp c5
c8: eq z, j, l
    jnz z, yes
no: ret 0
yes: ret 1
}

; metin [o,l) icin: tablo (NUL ayrilmis, n girdi) icinde indeks ya da -1
func findn(tab, n, o, l) {
    mov i, 0
f1: ge z, i, n
    jnz z, no
    call r, eqn, tab, i, o, l
    jz r, f2
    ret i
f2: addi i, i, 1
    jmp f1
no: ret -1
}

func hexv(c) {
    lti z, c, 48
    jnz z, no
    lei z, c, 57
    jz z, h1
    addi r, c, -48
    ret r
h1: lti z, c, 65
    jnz z, no
    lei z, c, 70
    jz z, no
    addi r, c, -55
    ret r
no: ret -1
}

func push(v) {
    ld n, G, 1
    gei z, n, 262144
    jz z, p1
    call x, err, 20
p1: add a, n, TB
    st v, a, 0
    addi n, n, 1
    st n, G, 1
    ret 0
}


; "@@SABLON" satirina kadar sayilari TK'ya oku, OP bolumunden komut simgelerini (kucuk harf) NB'ye cikar. Donus: ayiracin sonrasi konum ya da -1. G[3] = komut sayisi
func tabnames(n) {
    mov p, 0
    mov nt, 0
t1: ge z, p, n
    jnz z, bad
    mov e, p
t2: ge z, e, n
    jnz z, t3
    add a, e, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, t3
    addi e, e, 1
    jmp t2
t3: sub len, e, p
    eqi z, len, 8
    jz z, t4
    add a, p, IB
    ld c0, a, 0
    eqi z, c0, 64
    jz z, t4
    add a, p, 2
    add a, a, IB
    ld c2, a, 0
    eqi z, c2, 83
    jz z, t4
    addi p, e, 1
    jmp w0
t4: mov i, p
t5: ge z, i, e
    jnz z, t9
    add a, i, IB
    ld c, a, 0
    lei z, c, 32
    jz z, t6
    addi i, i, 1
    jmp t5
t6: mov ng, 0
    eqi z, c, 45
    jz z, t7
    mov ng, 1
    addi i, i, 1
t7: mov v, 0
t8: ge z, i, e
    jnz z, t8e
    add a, i, IB
    ld c, a, 0
    lti z, c, 48
    jnz z, t8e
    gti z, c, 57
    jnz z, t8e
    muli v, v, 10
    addi c, c, -48
    add v, v, c
    addi i, i, 1
    jmp t8
t8e: jz ng, t8f
    neg v, v
t8f: gei z, nt, 200000
    jz z, t8g
    call x, err, 30
t8g: add a, nt, TK
    st v, a, 0
    addi nt, nt, 1
    jmp t5
t9: addi p, e, 1
    jmp t1
bad: ret -1
; ---- tablo: bolumleri gez, OP bolumu (id 2) kayitlari
w0: mov ret_p, p
    lti z, nt, 4
    jnz z, bad2
    ld ns, TK, 3
    mov q, 4
    mov si, 0
    mov nb, 0
    mov cnt, 0
w1: ge z, si, ns
    jnz z, wend
    add a, q, TK
    ld id, a, 0
    ld ln, a, 3
    eqi z, id, 2
    jz z, w5
    addi r0, q, 4
    add a, r0, TK
    ld nrec, a, 0
    addi r, r0, 1
    mov j, 0
w2: ge z, j, nrec
    jnz z, w5
    add a, r, TK
    ld rl, a, 0
    ld opc, a, 1
    ld sl, a, 2
    gei z, opc, 128
    jz z, w2a
    call x, err, 31
w2a: add a, opc, NMO
    st nb, a, 0
    add a, opc, NML
    st sl, a, 0
    mov m, 0
w3: ge z, m, sl
    jnz z, w4
    add a, r, m
    add a, a, TK
    ld c, a, 3
    gei z, c, 65
    jz z, w3a
    lei z, c, 90
    jz z, w3a
    addi c, c, 32
w3a: add a, nb, NB
    st c, a, 0
    addi nb, nb, 1
    addi m, m, 1
    jmp w3
w4: addi t, opc, 1
    gt z, t, cnt
    jz z, w4a
    mov cnt, t
w4a: add r, r, rl
    addi r, r, 1
    addi j, j, 1
    jmp w2
w5: addi q, q, 4
    add q, q, ln
    addi si, si, 1
    jmp w1
wend: st cnt, G, 3
    ret ret_p
bad2: ret -1
}

func main() {
    mov n, 0
r1: host ch, getc
    lti z, ch, 0
    jnz z, r2
    gei z, n, 1048576
    jz z, r1a
    call x, err, 1
r1a: add a, n, IB
    st ch, a, 0
    addi n, n, 1
    jmp r1
r2: ; ---- kanonik sayisal komut tablosu (PMK1): "@@SABLON" satirina kadar; komut simgeleri (kucuk harf) NB'ye
    call p, tabnames, n
    lti z, p, 0
    jnz z, nosep
    ld nop, G, 3
    jmp spec
nosep: call x, err, 3
spec: ; ---- sablon.txt satirlari
    mov zero, 0
    mov i, 0
sv0: gei z, i, 128
    jnz z, sv1
    add a, i, START
    mov m1v, -1
    st m1v, a, 0
    addi i, i, 1
    jmp sv0
sv1: st zero, G, 1
s1: ge z, p, n
    jnz z, out
    mov e, p
s2: ge z, e, n
    jnz z, s3
    add a, e, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, s3
    addi e, e, 1
    jmp s2
s3: ; yorumu kes
    mov q, p
s3a: ge z, q, e
    jnz z, s3b
    add a, q, IB
    ld c, a, 0
    eqi z, c, 35
    jnz z, s3b
    addi q, q, 1
    jmp s3a
s3b: mov e2, q
    ; ilk simge
    mov i, p
t0: ge z, i, e2
    jnz z, snext
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, t0a
    eqi z, c, 9
    jnz z, t0a
    eqi z, c, 13
    jz z, t0b
t0a: addi i, i, 1
    jmp t0
t0b: mov ts, i
t0c: ge z, i, e2
    jnz z, t0d
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, t0d
    eqi z, c, 9
    jnz z, t0d
    eqi z, c, 13
    jnz z, t0d
    addi i, i, 1
    jmp t0c
t0d: sub tl, i, ts
    ; sondaki ':' at
    sub t, tl, 1
    add t, t, ts
    add a, t, IB
    ld c, a, 0
    eqi z, c, 58
    jz z, nm0
    addi tl, tl, -1
nm0: ; ad -> indeks: once komutlar
    mov idx, -1
    mov j, 0
nm1: ge z, j, nop
    jnz z, nm3
    add a, j, NML
    ld l, a, 0
    eq z, l, tl
    jz z, nm2
    add a, j, NMO
    ld o, a, 0
    mov q, 0
nm1a: ge z, q, tl
    jnz z, nm1b
    add a, o, q
    add a, a, NB
    ld c1, a, 0
    add a, ts, q
    add a, a, IB
    ld c2, a, 0
    ne z, c1, c2
    jnz z, nm2
    addi q, q, 1
    jmp nm1a
nm1b: mov idx, j
    jmp nm4
nm2: addi j, j, 1
    jmp nm1
nm3: call r, findn, XTRN, 26, ts, tl
    lti z, r, 0
    jnz z, nm3a
    add idx, r, nop
    jmp nm4
nm3a: call x, err, 4
nm4: ; tanimsiz mi?
    add a, idx, START
    ld sv, a, 0
    gei z, sv, 0
    jz z, nm5
    call x, err, 5
nm5: ld pos, G, 1
    add a, idx, START
    st pos, a, 0
    ; kalan simgeler
tk0: ge z, i, e2
    jnz z, tkend
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, tk0a
    eqi z, c, 9
    jnz z, tk0a
    eqi z, c, 13
    jz z, tk1
tk0a: addi i, i, 1
    jmp tk0
tk1: mov ts, i
tk2: ge z, i, e2
    jnz z, tk3
    add a, i, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, tk3
    eqi z, c, 9
    jnz z, tk3
    eqi z, c, 13
    jnz z, tk3
    addi i, i, 1
    jmp tk2
tk3: sub tl, i, ts
    call x, token, ts, tl
    jmp tk0
tkend: mov m1v, -1
    call x, push, m1v
snext: addi p, e, 1
    jmp s1
out: ; ---- cikti
    host putc, 84
    host putc, 80
    host putc, 76
    host putc, 83
    addi tot, nop, 26
    mov j, 0
o1: ge z, j, tot
    jnz z, o2
    host putc, 32
    add a, j, START
    ld v, a, 0
    host puti, v
    addi j, j, 1
    jmp o1
o2: host putc, 10
    host putc, 84
    host putc, 80
    host putc, 76
    ld cnt, G, 1
    mov j, 0
o3: ge z, j, cnt
    jnz z, o4
    host putc, 32
    add a, j, TB
    ld v, a, 0
    host puti, v
    addi j, j, 1
    jmp o3
o4: host putc, 10
    ; ozel sablon yuvasi adlari: TS_<AD> <yuva> (yuva = komut sayisi + XTRN sirasi); kaynaklar yuva numaralarini yer tutucu olarak kullanir
    mov k, 0
    mov nm, 0
ts0: gei z, nm, 26
    jnz z, ts9
    host putc, 84
    host putc, 83
    host putc, 95
ts1: add a, k, XTRN
    ld c, a, 0
    jz c, ts3
    gei z, c, 97
    jz z, ts2
    lei z, c, 122
    jz z, ts2
    addi c, c, -32
ts2: host putc, c
    addi k, k, 1
    jmp ts1
ts3: addi k, k, 1
    host putc, 32
    add v, nop, nm
    host puti, v
    host putc, 10
    addi nm, nm, 1
    jmp ts0
ts9: ret 0
}

; bir simge [o,l)
func token(o, l) {
    ; FUELCHK
    call r, eqn, KW1, 1, o, l
    jz r, t1
    call x, push, 77
    call x, push, 133
    call x, push, 246
    call x, push, 15
    call x, push, 132
    call x, push, 312
    call x, push, 73
    call x, push, 255
    call x, push, 206
    ret 0
t1: ; LDA(x) LDC(x) STA(x)
    eqi z, l, 6
    jz z, t2
    add a, o, 3
    add a, a, IB
    ld c3, a, 0
    eqi z, c3, 40
    jz z, t2
    add a, o, 5
    add a, a, IB
    ld c5, a, 0
    eqi z, c5, 41
    jz z, t2
    add a, o, 4
    add a, a, IB
    ld x4, a, 0
    addi xi, x4, -97
    lti z, xi, 0
    jnz z, t2
    gti z, xi, 2
    jnz z, t2
    add a, o, IB
    ld c0, a, 0
    add a, o, 1
    add a, a, IB
    ld c1, a, 0
    add a, o, 2
    add a, a, IB
    ld c2, a, 0
    eqi z, c1, 68
    jz z, t1a
    eqi z, c0, 76
    jz z, t1a
    eqi z, c2, 65
    jz z, t1a
    ; LDA
    call x, push, 72
    call x, push, 139
    call x, push, 131
    jmp t1z
t1a: eqi z, c0, 76
    jz z, t1b
    eqi z, c1, 68
    jz z, t1b
    eqi z, c2, 67
    jz z, t1b
    call x, push, 72
    call x, push, 139
    call x, push, 139
    jmp t1z
t1b: eqi z, c0, 83
    jz z, t2
    eqi z, c1, 84
    jz z, t2
    eqi z, c2, 65
    jz z, t2
    call x, push, 72
    call x, push, 137
    call x, push, 131
t1z: addi code, xi, 256
    call x, push, code
    ret 0
t2: ; iki haneli onaltilik bayt
    eqi z, l, 2
    jz z, t3
    add a, o, IB
    ld c0, a, 0
    call h0, hexv, c0
    lti z, h0, 0
    jnz z, t3
    add a, o, 1
    add a, a, IB
    ld c1, a, 0
    call h1, hexv, c1
    lti z, h1, 0
    jnz z, t3
    muli v, h0, 16
    add v, v, h1
    call x, push, v
    ret 0
t3: ; imm32 / rel32 adlari
    call r, findn, IMMN, 35, o, l
    lti z, r, 0
    jnz z, t4
    addi code, r, 256
    call x, push, code
    ret 0
t4: call r, findn, RELN, 15, o, l
    lti z, r, 0
    jnz z, t5
    addi code, r, 300
    call x, push, code
    ret 0
t5: call r, eqn, KW1, 0, o, l
    jz r, t6
    call x, push, 320
    ret 0
t6: call x, err, 6
}
