; ---------- dogrudan sayi isleneni ----------
; ayarlar: G[53] = bagil kayit adedi, RTK/RTC dolu. Python referansindaki imm() ile ayni.
func relall() {
    ld nh, G, 21
    mov h, 0
a1: ge z, h, nh
    jnz z, a9
    add a, h, HDK
    ld k, a, 0
    add a, h, RTK
    st k, a, 0
    mov one, 1
    add a, h, RTC
    st one, a, 0
    addi h, h, 1
    jmp a1
a9: st nh, G, 53
    ret 0
}
; veri indeksi j'den once gelen basliklar (+ istege bagli anahtar k >= 0)
func relpre(j, extra) {
    ld nh, G, 21
    mov h, 0
    mov m, 0
a1: ge z, h, nh
    jnz z, a9
    add a, h, HDI
    ld hi, a, 0
    ge z, hi, j
    jnz z, a9
    add a, h, HDK
    ld k, a, 0
    add a, m, RTK
    st k, a, 0
    mov one, 1
    add a, m, RTC
    st one, a, 0
    addi m, m, 1
    addi h, h, 1
    jmp a1
a9: lti z, extra, 0
    jnz z, a10
    add a, m, RTK
    st extra, a, 0
    mov one, 1
    add a, m, RTC
    st one, a, 0
    addi m, m, 1
a10: st m, G, 53
    ret 0
}

; ident [A-Za-z_][A-Za-z0-9_]* en uzun onek: IB[s+from ..) icinde bitis (goreli indeks; from ise baslamadiysa from)
func identrun(s, l, from) {
    mov j, from
    ge z, j, l
    jnz z, e
    add a, s, j
