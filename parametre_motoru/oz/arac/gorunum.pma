    jz z, o5
    eqi z, ch, 35
    jz z, o4a
    addi s1, s, 1
    addi l1, l, -1
    call v, parsenum, s1, l1, 0, 30, 31
    jmp ofin
o4a: call v, ffind, s, l
    gei z, v, 0
    jnz z, ofin
    call x, fail, 63
o5: eqi z, c, 5
    jz z, o6
    ; c-?[0-9]+
    eqi z, ch, 99
    jz z, ebad64
    addi s1, s, 1
    addi l1, l, -1
    mov o, 0
    lei z, l1, 0
    jnz z, ebad64
    add a, s1, IB
    ld c1, a, 0
    eqi z, c1, 45
    jz z, o5a
    mov o, 1
o5a: add s2, s1, o
    sub l2, l1, o
    call dg, isdig, s2, l2
    jz dg, ebad64
    call v, parsenum, s1, l1, 0, 30, 31
    jmp ofin
ebad64: call x, fail, 64
