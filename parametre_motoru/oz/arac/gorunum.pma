    jz z, b3
    ld s, TS, 0
    ld l, TL, 0
    add a, s, l
    addi a, a, -1
    add a, a, IB
    ld c, a, 0
    eqi z, c, 58
    jz z, b3
    addi l, l, -1
    call ok, isident, IB, s, l
    jnz ok, b2
    call x, fail, 58
b2: ld nlab, G, 46
    mov w, 0
b2a: ge z, w, nlab
    jnz z, b2b
    add a, w, LBS
    ld s2, a, 0
    add a, w, LBL
    ld l2, a, 0
    call e, eqbb, IB, s, l, IB, s2, l2
    jz e, b2c
    call x, fail, 58
b2c: addi w, w, 1
    jmp b2a
b2b: gei z, nlab, 262144
    jz z, b2d
    call x, fail, 5
b2d: add a, nlab, LBS
    st s, a, 0
    add a, nlab, LBL
    st l, a, 0
    add a, nlab, LBI
    st ni, a, 0
    addi nlab, nlab, 1
    st nlab, G, 46
    jmp b0
b3: addi ni, ni, 1
    jmp b0
b9: ret 0
}

; etiket adi (IB[s,s+l)) -> komut indeksi ya da -1
func labfind(s, l) {
    ld nlab, G, 46
    mov w, 0
l1: ge z, w, nlab
    jnz z, no
    add a, w, LBS
    ld s2, a, 0
    add a, w, LBL
    ld l2, a, 0
    call e, eqbb, IB, s, l, IB, s2, l2
    jnz e, yes
    addi w, w, 1
    jmp l1
yes: add a, w, LBI
    ld v, a, 0
    ret v
no: ret -1
}

; operand jetonu (IB[s,s+l)), sinif c, konum ps -> deger (kontroller dahil); bagil kayit adedi G[53]
func opval(s, l, c, ps) {
    mov zr, 0
    st zr, G, 53
