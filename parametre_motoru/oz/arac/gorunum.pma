; islev f'nin etiket tablosunu kur (LBS/LBL/LBI); G[46] = adet. Python: ayni ad iki kez ya da gecersiz ad -> 58
func buildlabels(f) {
    mov zr, 0
    st zr, G, 46
    add a, f, FBP
    ld p, a, 0
    ld n, G, 1
    mov ni, 0
b0: call nt, getline, p, n
