    jz z, o7
    ; host adi ya da sayi
    ld oc, G, 4
    ld hc, G, 5
    mov h, 0
o6a: ge z, h, hc
    jnz z, o6n
    add t, oc, h
    add a, t, NS
    ld o1, a, 0
    add a, t, NL
    ld m1, a, 0
    call e, eqbuf, s, l, NMB, o1, m1
    jnz e, o6y
    addi h, h, 1
    jmp o6a
o6y: mov v, h
