; gorunum.pma -- PMO1 SAYISAL NESNE GORUNUMU (okunabilir gorunum <-> sayilar). Metinsiz zincirin "istege bagli okunabilir gorunum ve duzenleme" halkasi.
; Asil kaynak: sayisal nesne (PMO1, .pmo). Bu arac nesneyi okunabilir metne (PMV) cevirir ve duzenlenmis metni AYNI sayilara geri yazar (bayt-bayt: gor -> yaz kimlik).
; stdin ilk satir "@@mod":
;   @@gor    : sozluk satirlari ("komut @@tab" ciktisi) , istege bagli "@@ADLAR" + sidecar satirlari (func AD / space AD OFSET), "@@NESNE" , PMO1 sayilari  -> gorunum (PMV)
;   @@yaz    : sozluk satirlari , "@@GORUNUM" , gorunum metni                                                                                         -> PMO1 sayilari
;   @@adlar  : gorunum metni                                                                                                                          -> sidecar (func AD / space AD OFSET satirlari)
; Hata: "HATA: kod" + DIV0 tuzagi (cikis kodu != 0). Hicbir hatada kismi cikti yazilmaz (once sessiz gecis, sonra yazim).
; PMV bicimi ve hata kodlari: oz/nesne/GORUNUM.md ; bagimsiz referans: oz/nesne/ref/pmo_ref.py (ayni gorunum, ayni nesne, ayni hata kodu).
; G[] dizini: 0 ikinci donus | 1 girdi uzunlugu | 2 sessiz | 3 yeni konum | 4 OPCOUNT | 5 HOSTCOUNT | 6 ad sayisi | 7 NMB kullanim | 8 nk | 9 nb | 10 liste tabani LB | 11 NT |
;   12 flag | 13 mem | 14 entry | 15 ncon | 16 consts liste konumu | 17 ndata | 18 data liste konumu | 19 bss | 20 nf | 21 nh | 22 ndata liste konumu | 23 bss liste konumu |
;   24 tuketilen bagil kayit | 25 NL (liste uzunlugu) | 26 nsp (sidecar space) | 27 nsf (sidecar func) | 28 sozluk anahtar bitleri | 29 nkf | 30 islev tablo baslangici |
;   31 nops-sayisi | 32 nkd-sayisi | 33 govde baslangici | 34 mod
memory 16777216
entry main
space IB 4200000
space NMB 65536
space NS 4100
space NL 4100
space NOPSV 4100
space KD 12300
space KF 300
space TK 1100000
space TNEG 1100000
space KK 4100
space KNS 4100
space KNL 4100
space NC 300000
space HD 524300
space RP 65600
space RK 65600
space RC 65600
space RX 65600
space HDI 4100
space HDK 4100
space FIS 4100
space FNC 4100
space FNP 4100
space FNR 4100
space FNS 4100
space FNL 4100
space FNB 1100000
space HKI 4100
space SFS 4100
space SFL 4100
space SPS 4100
space SPL 4100
space SPO 4100
space LT 524300
space TS 4100
space TL 4100
space CV 524300
space DVV 524300
space DHK 524300
space LBS 262200
space LBL 262200
space LBI 262200
space FBP 4100
space RSC 4100
space RSO 65600
space KS 4100
space RTK 4100
space RTC 4100
space CB 64
space G 128

func fail(code) {
    host putc, 72
    host putc, 65
    host putc, 84
    host putc, 65
    host putc, 58
    host putc, 32
    host puti, code
    host putc, 10
    mov z, 0
    div x, 1, z
    ret 0
}

; ---------- cikti (sessiz gecis: G[2] != 0 ise hicbir sey yazilmaz) ----------
func pc(c) {
    ld q, G, 2
    jnz q, e
    host putc, c
e:  ret 0
}
func pn(v) {
    ld q, G, 2
    jnz q, e
    host puti, v
e:  ret 0
}
; isaretsiz 64 bit onluk
func pu(v) {
    ld q, G, 2
    jnz q, e
    lti z, v, 0
    jnz z, big
    host puti, v
    ret 0
big: shri t, v, 1
    divi q, t, 5
    muli t, q, 10
    sub r, v, t
    host puti, q
    addi r, r, 48
    host putc, r
e:  ret 0
}
; veri dizesi d (NUL sonlu)
func pdat(d) {
    ld q, G, 2
    jnz q, e
    mov i, 0
s1: add a, d, i
    ld c, a, 0
    jz c, e
    host putc, c
    addi i, i, 1
    jmp s1
e:  ret 0
}
; base[o, o+l) karakterleri
func pbuf(base, o, l) {
    ld q, G, 2
    jnz q, e
    mov i, 0
s1: ge z, i, l
    jnz z, e
    add a, o, i
    add a, a, base
    ld c, a, 0
    host putc, c
    addi i, i, 1
    jmp s1
e:  ret 0
}

; ---------- sayi bicimleme / ayristirma ----------
; v'yi CB[0..] ondalik karakter olarak yaz; uns=1: isaretsiz 64 bit, uns=0: isaretli. uzunluk doner
func fmtnum(v, uns) {
    mov ng, 0
    jnz uns, f1
    lti z, v, 0
    jz z, f1
    mov ng, 1
    neg v, v
f1: mov n, 0
f2: lti z, v, 0
    jnz z, f3
    divi q, v, 10
    jmp f4
f3: shri t, v, 1
    divi q, t, 5
f4: muli t, q, 10
    sub r, v, t
    addi r, r, 48
    add a, n, CB
    addi a, a, 32
    st r, a, 0
    addi n, n, 1
    mov v, q
    jnz v, f2
    ; CB[0..] = (eksi) + ters sirali basamaklar (CB[32..32+n) basamaklar ters)
    mov o, 0
    jz ng, f5
    mov m, 45
    st m, CB, 0
    mov o, 1
f5: mov i, 0
f6: ge z, i, n
    jnz z, f7
    sub j, n, i
    addi j, j, -1
    add a, j, CB
    addi a, a, 32
    ld m, a, 0
    add a, o, i
    add a, a, CB
    st m, a, 0
    addi i, i, 1
    jmp f6
f7: add r, o, n
    ret r
}

; IB[p, p+n) kanonik ondalik sayi mi? mod 0: isaretli, 1: isaretsiz (eksi varsa aralik hatasi), 2: PMO jetonu (eksi varsa isaretli, yoksa isaretsiz).
; Soz dizimi hatasi (bos, rakam disi, bas sifir, "-0") -> fail(ecs); 64 bit araligi disi -> fail(ecr). Degeri doner (64 bit sarmali)
func parsenum(p, n, mode, ecs, ecr) {
    mov ng, 0
    lei z, n, 0
    jz z, q0
    call x, fail, ecs
q0: add a, p, IB
    ld c, a, 0
    eqi z, c, 45
    jz z, q1
    mov ng, 1
q1: mov i, ng
    ge z, i, n
    jz z, q2
    call x, fail, ecs
q2: ; bas sifir ve -0
    add a, p, i
    add a, a, IB
    ld c, a, 0
    eqi z, c, 48
    jz z, q3
    sub t, n, i
    eqi z, t, 1
    jnz z, q2b
    call x, fail, ecs
q2b: jz ng, q3
    call x, fail, ecs
q3: mov v, 0
    mov nd, 0
q4: ge z, i, n
    jnz z, q5
    add a, p, i
    add a, a, IB
    ld c, a, 0
    lti z, c, 48
    jnz z, q4f
    gti z, c, 57
    jnz z, q4f
    muli v, v, 10
    addi c, c, -48
    add v, v, c
    addi nd, nd, 1
    addi i, i, 1
    jmp q4
q4f: call x, fail, ecs
q5: gti z, nd, 20
    jz z, q6
    call x, fail, ecr
q6: jz ng, q7
    neg v, v
q7: ; aralik: yeniden bicimle ve karsilastir
    eqi z, mode, 1
    jz z, q8
    jz ng, q8
    call x, fail, ecr
q8: mov uns, 0
    jnz ng, q9
    eqi z, mode, 0
    jnz z, q9
    mov uns, 1
q9: call l, fmtnum, v, uns
    ne z, l, n
    jz z, q10
    call x, fail, ecr
q10: mov i, 0
q11: ge z, i, n
    jnz z, q12
    add a, i, CB
    ld c1, a, 0
    add a, p, i
    add a, a, IB
    ld c2, a, 0
    ne z, c1, c2
    jz z, q11a
    call x, fail, ecr
q11a: addi i, i, 1
    jmp q11
q12: ret v
}

; hosgorulu (sozluk) sayi: p'de bosluk atla, [-]rakamlar; G[3] = yeni konum
func lnum(p, n) {
    mov v, 0
    mov ng, 0
l1: ge z, p, n
    jnz z, l9
    add a, p, IB
    ld c, a, 0
    eqi z, c, 32
    jnz z, l1a
    eqi z, c, 9
    jz z, l2
l1a: addi p, p, 1
    jmp l1
l2: eqi z, c, 45
    jz z, l3
    mov ng, 1
    addi p, p, 1
l3: ge z, p, n
    jnz z, l8
    add a, p, IB
    ld c, a, 0
    lti z, c, 48
    jnz z, l8
    gti z, c, 57
    jnz z, l8
    muli v, v, 10
    addi c, c, -48
    add v, v, c
    addi p, p, 1
    jmp l3
l8: jz ng, l9
    neg v, v
l9: st p, G, 3
    ret v
}

; ---------- girdi ----------
func readall() {
    mov n, 0
r1: host ch, getc
    lti z, ch, 0
    jnz z, r2
    gei z, n, 4200000
    jz z, r1a
    call x, fail, 1
r1a: add a, n, IB
    st ch, a, 0
    addi n, n, 1
    jmp r1
r2: st n, G, 1
    ret n
}

; IB[o, o+l) == veri dizesi d (NUL sonlu) ?
func streq(o, l, d) {
    mov i, 0
q1: add a, d, i
    ld c, a, 0
    jz c, q2
    ge z, i, l
    jnz z, no
    add b, o, i
    add b, b, IB
    ld e, b, 0
    ne z, e, c
    jnz z, no
    addi i, i, 1
    jmp q1
q2: eq z, i, l
    jz z, no
    ret 1
no: ret 0
}

; IB[o1, o1+l1) == base2[o2, o2+l2) ?  (base2: bir dizi)
func eqbuf(o1, l1, base2, o2, l2) {
    ne z, l1, l2
    jnz z, no
    mov i, 0
q1: ge z, i, l1
    jnz z, yes
    add a, o1, i
    add a, a, IB
    ld c1, a, 0
    add a, o2, i
    add a, a, base2
    ld c2, a, 0
    ne z, c1, c2
    jnz z, no
    addi i, i, 1
    jmp q1
yes: ret 1
no: ret 0
}

; base1[o1, o1+l1) == base2[o2, o2+l2) ?
func eqbb(base1, o1, l1, base2, o2, l2) {
    ne z, l1, l2
    jnz z, no
    mov i, 0
q1: ge z, i, l1
    jnz z, yes
    add a, o1, i
    add a, a, base1
    ld c1, a, 0
    add a, o2, i
    add a, a, base2
    ld c2, a, 0
    ne z, c1, c2
    jnz z, no
    addi i, i, 1
    jmp q1
yes: ret 1
no: ret 0
}

; ssinif: karakter bosluk/tab/CR mi (satir sonu degil)
func issp(c) {
    eqi z, c, 32
    jnz z, y
    eqi z, c, 9
    jnz z, y
    eqi z, c, 13
    jnz z, y
    ret 0
y:  ret 1
}

; kimlik karakteri: harf ya da alt cizgi (ilk) / harf rakam alt cizgi
func idchar(c, first) {
    gei z, c, 65
    jz z, d1
    lei z, c, 90
    jnz z, y
d1: gei z, c, 97
    jz z, d2
    lei z, c, 122
    jnz z, y
d2: eqi z, c, 95
    jnz z, y
    jnz first, n
    gei z, c, 48
    jz z, n
    lei z, c, 57
    jnz z, y
n:  ret 0
y:  ret 1
}

; base[o, o+l) gecerli kimlik mi
func isident(base, o, l) {
    lti z, l, 1
    jnz z, no
    mov i, 0
q1: ge z, i, l
    jnz z, yes
    add a, o, i
    add a, a, base
    ld c, a, 0
    eqi first, i, 0
    call k, idchar, c, first
    jz k, no
    addi i, i, 1
    jmp q1
yes: ret 1
no: ret 0
}

; ---------- sozluk ----------
data D_OPCOUNT = "OPCOUNT\0"
data D_OPNAMES = "OPNAMES\0"
data D_NOPS = "NOPS\0"
data D_KIND = "KIND\0"
data D_KFLAGS = "KFLAGS\0"
data D_HOSTCOUNT = "HOSTCOUNT\0"

; p'den baslayarak sozluk satirlari; "@@" ile baslayan satirda durur (G[3] = o satirin konumu). Doldurur: NMB/NS/NL (OPNAMES), NOPSV, KD, KF, G[4], G[5], G[6], G[28]
func dictparse(p, n) {
    mov nmb, 0
    mov nnops, 0
    mov nkd, 0
    mov nkf, 0
    mov found, 0
d0: ge z, p, n
    jnz z, d9
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, d0n
    call w, issp, c
    jz w, d1
d0n: addi p, p, 1
    jmp d0
d1: eqi z, c, 64
    jz z, d2
    addi a, p, 1
    add a, a, IB
    ld c1, a, 0
    eqi z, c1, 64
    jnz z, d9
d2: mov s0, p
d2a: ge z, p, n
    jnz z, d2b
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, d2b
    call w, issp, c
    jnz w, d2b
    addi p, p, 1
    jmp d2a
d2b: sub l, p, s0
    mov key, 0
    call r, streq, s0, l, D_OPCOUNT
    jz r, k2
    mov key, 1
k2: call r, streq, s0, l, D_OPNAMES
    jz r, k3
    mov key, 2
k3: call r, streq, s0, l, D_NOPS
    jz r, k4
    mov key, 3
k4: call r, streq, s0, l, D_KIND
    jz r, k5
    mov key, 4
k5: call r, streq, s0, l, D_KFLAGS
    jz r, k6
    mov key, 5
k6: call r, streq, s0, l, D_HOSTCOUNT
    jz r, k7
    mov key, 6
k7: jz key, skipl
    ; bu anahtar bulundu
    addi sh, key, -1
    mov bit, 1
    shl bit, bit, sh
    or found, found, bit
    mov first, 1
v1: ; satir sonuna kadar sayilar
    ge z, p, n
    jnz z, v9
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, v9
    call w, issp, c
    jz w, v2
    addi p, p, 1
    jmp v1
v2: call v, lnum, p, n
    ld p, G, 3
    eqi z, key, 1
    jz z, v3
    st v, G, 4
    jmp v1
v3: eqi z, key, 6
    jz z, v4
    st v, G, 5
    jmp v1
v4: eqi z, key, 2
    jz z, v5
    gei z, nmb, 65536
    jz z, v4a
    call x, fail, 2
v4a: add a, nmb, NMB
    st v, a, 0
    addi nmb, nmb, 1
    jmp v1
v5: eqi z, key, 3
    jz z, v6
    gei z, nnops, 4096
    jz z, v5a
    call x, fail, 2
v5a: add a, nnops, NOPSV
    st v, a, 0
    addi nnops, nnops, 1
    jmp v1
v6: eqi z, key, 4
    jz z, v7
    gei z, nkd, 12288
    jz z, v6a
    call x, fail, 2
v6a: add a, nkd, KD
    st v, a, 0
    addi nkd, nkd, 1
    jmp v1
v7: ; KFLAGS
    gei z, nkf, 256
    jz z, v7a
    call x, fail, 2
v7a: add a, nkf, KF
    st v, a, 0
    addi nkf, nkf, 1
    jmp v1
v9: jmp d0
skipl: ; bilinmeyen anahtar: satirin sonuna kadar atla
sk1: ge z, p, n
    jnz z, d0
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, d0
    addi p, p, 1
    jmp sk1
d9: st p, G, 3
    st found, G, 28
    ; zorunlu anahtarlar
    eqi z, found, 63
    jnz z, d10
    call x, fail, 2
d10: st nkf, G, 29
    st nnops, G, 31
    st nkd, G, 32
    st nmb, G, 7
    ld oc, G, 4
    ld hc, G, 5
    gti z, oc, 4096
    jz z, d11
    call x, fail, 2
d11: gti z, hc, 4096
    jz z, d12
    call x, fail, 2
d12: lti z, oc, 0
    jz z, d12a
    call x, fail, 2
d12a: lti z, hc, 0
    jz z, d13
    call x, fail, 2
d13: ; adlari bol
    mov i, 0
    mov nn, 0
    mov st0, 0
d14: ge z, i, nmb
    jnz z, d16
    add a, i, NMB
    ld c, a, 0
    jnz c, d15
    ; ad bitti
    add a, nn, NS
    st st0, a, 0
    sub l, i, st0
    add a, nn, NL
    st l, a, 0
    addi nn, nn, 1
    addi st0, i, 1
d15: addi i, i, 1
    jmp d14
d16: st nn, G, 6
    add t, oc, hc
    lt z, nn, t
    jz z, d17
    call x, fail, 2
d17: lt z, nnops, oc
    jz z, d18
    call x, fail, 2
d18: muli t, oc, 3
    lt z, nkd, t
    jz z, d19
    call x, fail, 2
d19: ret 0
}

; kind kimliginin bayraklari
func kflags(k) {
    lti z, k, 0
    jnz z, z0
    ld nk, G, 29
    ge z, k, nk
    jnz z, z0
    add a, k, KF
    ld f, a, 0
    ret f
z0: ret 0
}

; (op, j) isleneninin sinifi: 1 yazmac, 2 dogrudan sayi, 3 etiket, 4 islev, 5 sabit havuzu, 6 host, 0 duz sayi
func opclass(op, j) {
    muli a, op, 3
    add a, a, j
    add a, a, KD
    ld kd, a, 0
    call f, kflags, kd
    andi t, f, 3
    jz t, c1
    ret 1
c1: andi t, f, 4
    jz t, c2
    ret 2
c2: andi t, f, 8
    jz t, c3
    ret 3
c3: andi t, f, 16
    jz t, c4
    ret 4
c4: andi t, f, 32
    jz t, c5
    ret 5
c5: andi t, f, 128
    jz t, c6
    ret 6
c6: ret 0
}

; ======================= gor: PMO1 -> gorunum =======================
data D_BSS = "bss\0"

; sidecar satirlari (IB[p, n)): "func AD" / "space AD OFSET"; bos satirlar atlanir. G[26] = nsp, G[27] = nsf. Gecersiz -> fail(14)
func adlarparse(p, n) {
    mov nsf, 0
    mov nsp, 0
a0: ge z, p, n
    jnz z, a9
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, a0n
    call w, issp, c
    jz w, a1
a0n: addi p, p, 1
    jmp a0
a1: ; birinci jeton
    mov s0, p
a1a: ge z, p, n
    jnz z, a1b
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, a1b
    call w, issp, c
    jnz w, a1b
    addi p, p, 1
    jmp a1a
a1b: sub l0, p, s0
    ; ikinci jeton
a2: ge z, p, n
    jnz z, a2e
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, a2e
    call w, issp, c
    jz w, a2e
    addi p, p, 1
    jmp a2
a2e: mov s1, p
a2a: ge z, p, n
    jnz z, a2b
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, a2b
    call w, issp, c
    jnz w, a2b
    addi p, p, 1
    jmp a2a
a2b: sub l1, p, s1
    ; ucuncu jeton
a3: ge z, p, n
    jnz z, a3e
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, a3e
    call w, issp, c
    jz w, a3e
    addi p, p, 1
    jmp a3
a3e: mov s2, p
a3a: ge z, p, n
    jnz z, a3b
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, a3b
    call w, issp, c
    jnz w, a3b
    addi p, p, 1
    jmp a3a
a3b: sub l2, p, s2
    ; satir sonunda baska jeton var mi
a4: ge z, p, n
    jnz z, a5
    add a, p, IB
    ld c, a, 0
    eqi z, c, 10
    jnz z, a5
    call w, issp, c
    jz w, a4bad
    addi p, p, 1
    jmp a4
a4bad: call x, fail, 14
a5: call r, streq, s0, l0, D_FUNC
    jz r, a6
    ; func AD
    jz l1, a4bad2
    jnz l2, a4bad2
    gei z, nsf, 4096
    jz z, a5a
    call x, fail, 5
a5a: add a, nsf, SFS
    st s1, a, 0
    add a, nsf, SFL
    st l1, a, 0
    addi nsf, nsf, 1
    jmp a0
a6: call r, streq, s0, l0, D_SPACE
    jz r, a4bad2
    jz l1, a4bad2
    jz l2, a4bad2
    gei z, nsp, 4096
    jz z, a6a
    call x, fail, 5
a6a: call v, parsenum, s2, l2, 1, 14, 14
