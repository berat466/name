    mov o, 0
    lei z, l1, 0
    jnz z, ebad61
    add a, s1, IB
    ld c1, a, 0
    eqi z, c1, 45
    jz z, o1a
    mov o, 1
o1a: add s2, s1, o
    sub l2, l1, o
    call dg, isdig, s2, l2
    jz dg, ebad61
    call v, parsenum, s1, l1, 0, 30, 31
    jmp ofin
ebad61: call x, fail, 61
o2: eqi z, c, 2
