; ---------- kanonik sayi yazimi: T[0..nt) tablosunu baslik/bolum/kayit satirlariyla yaz ----------
func ptok(p) {
    add a, p, T
    ld v, a, 0
    host puti, v
    ret 0
}
func printtab() {
    ld ns, T, 3
    call x, ptok, 0
    host putc, 32
    call x, ptok, 1
    host putc, 32
    call x, ptok, 2
    host putc, 32
    call x, ptok, 3
    host putc, 10
    mov p, 4
    mov i, 0
b1: ge z, i, ns
    jnz z, b9
    call x, ptok, p
    host putc, 32
    addi q, p, 1
    call x, ptok, q
    host putc, 32
    addi q, p, 2
    call x, ptok, q
    host putc, 32
    addi q, p, 3
    call x, ptok, q
    host putc, 10
    add a, p, T
    ld id, a, 0
    ld vs, a, 2
    ld ln, a, 3
    addi s, p, 4
    add e, s, ln
    ; bilinen ve surumu 1 ise: sayi + kayit basina satir; degilse yuk tek satir
    lti z, id, 1
    jnz z, bo
    gti z, id, 5
    jnz z, bo
    eqi z, vs, 1
    jz z, bo
    call x, ptok, s
    host putc, 10
    addi r, s, 1
b2: ge z, r, e
    jnz z, b8
    add a, r, T
    ld rl, a, 0
    addi k, r, 1
    add f, k, rl
    call x, ptok, r
b3: ge z, k, f
    jnz z, b4
    host putc, 32
    call x, ptok, k
    addi k, k, 1
    jmp b3
b4: host putc, 10
    mov r, f
    jmp b2
bo: mov k, s
b5: ge z, k, e
    jnz z, b6
    jz k, b5a
    ne z, k, s
    jz z, b5a
    host putc, 32
b5a: call x, ptok, k
    addi k, k, 1
    jmp b5
b6: host putc, 10
b8: mov p, e
    addi i, i, 1
    jmp b1
b9: ret 0
}

; ======================= okunabilir gorunum (gor) =======================
data GH = "# PMK1 komut tablosu -- OKUNABILIR GORUNUM (komut @@gor ile uretilir; sayisal tabloyu `komut @@yaz` ile geri uretir, KAYIPSIZ).\n# Tek dogruluk kaynagi sayisal tablodur (komutlar.pmk). Duzenledikten sonra @@yaz ile sayisal bicime isleyin; ham sayi akisi ile ayni olmali.\n# Satirlar: pmk major minor | kinds bayrak surum | kind id karakter bayrak | ops bayrak surum | op opkod SEMBOL ad turler\n#           hosts bayrak surum | host id ad arguman | section id bayrak surum sayilar...   (bilinmeyen/surumu farkli bolumler olduklari gibi korunur)\n# ext anahtar=deger ... : kayit uzantilari   tail sayilar... : bilinmeyen kalan alanlar (korunur, yok sayilir)\n\0"
data W_PMK = "pmk\0"
data W_KINDS = "kinds\0"
data W_OPS = "ops\0"
data W_HOSTS = "hosts\0"
data W_KIND = "kind\0"
data W_OP = "op\0"
data W_HOST = "host\0"
data W_SECTION = "section\0"
data W_EXT = "ext\0"
data W_TAIL = "tail\0"

; kaydin ext/tail kismini yaz: q = ne konumu, e = kayit sonu (dahil degil)
func pext(q, e) {
    add a, q, T
    ld ne2, a, 0
    jz ne2, x1
    call x, pdat, W_EXT_S
    mov i, 0
x0: ge z, i, ne2
    jnz z, x1
    host putc, 32
    shli t, i, 1
    add t, t, q
    addi t, t, 1
    add a, t, T
    ld kk, a, 0
    ld vv, a, 1
    host puti, kk
    host putc, 61
    host puti, vv
    addi i, i, 1
    jmp x0
x1: add a, q, T
    ld ne2, a, 0
    shli t, ne2, 1
    add t, t, q
    addi t, t, 1
    ge z, t, e
    jnz z, x9
    call x, pdat, W_TAIL_S
    mov k, t
x2: ge z, k, e
    jnz z, x9
    host putc, 32
    add a, k, T
    ld v, a, 0
    host puti, v
    addi k, k, 1
    jmp x2
x9: ret 0
}
data W_EXT_S = " ext\0"
data W_TAIL_S = " tail\0"
data W_PMK_S = "pmk \0"

data W_PRIMS = "prims\0"
data W_SEMS = "sems\0"
data W_PRIM = "prim\0"
data W_SEM = "sem\0"
data W_SEMI = ";\0"
data W_TOKENS = "tokens\0"
data W_TPLS = "tpls\0"
data W_TOKEN = "token\0"
data W_TPL = "tpl\0"
data W_SPK = "sp\0"
data W_COLON = ":\0"
data W_TI = "ti\0"
data W_TO = "to\0"
data W_OP2 = "op\0"
data W_N = "n\0"

func pftype(ft) {
    eqi z, ft, 1
    jz z, a1
    host putc, 116
    host putc, 105
    ret 0
a1: eqi z, ft, 2
    jz z, a2
    host putc, 116
    host putc, 111
    ret 0
a2: eqi z, ft, 3
    jz z, a3
    host putc, 111
    host putc, 112
    ret 0
a3: host putc, 110
    ret 0
}
; prim kimliginin adini yaz
func prname(pid) {
    add a, pid, PA
    ld o, a, 0
    add b, o, T
    ld nl, b, 1
    addi np, o, 2
    call x, pstr, np, nl
    ret 0
}
; sem alani: temp (1/2): t<n>, operand (3): a b c, sabit (4): sayi
func pfield(ft, v) {
    lei z, ft, 2
    jz z, f1
    host putc, 116
    host puti, v
    ret 0
f1: eqi z, ft, 3
    jz z, f2
    addi c, v, 97
    host putc, c
    ret 0
f2: host puti, v
    ret 0
}

func hexd(d) {
    lti z, d, 10
    jz z, h1
    addi c, d, 48
    host putc, c
    ret 0
h1: addi c, d, 55
    host putc, c
    ret 0
}
func phex(v) {
    shri h, v, 4
    call x, hexd, h
    andi l, v, 15
    call x, hexd, l
    ret 0
}
; TOKEN kodunun adi
func ptokn(code) {
    add a, code, TKA
    ld o, a, 0
    addi r, o, -1
    add b, r, T
    ld nl, b, 2
    addi np, r, 3
    call x, pstr, np, nl
    ret 0
}
func hexv(c) {
    lti z, c, 48
    jnz z, no
    lei z, c, 57
    jz z, h1
    addi r, c, -48
    ret r
h1: lti z, c, 65
    jnz z, no
    lei z, c, 70
    jz z, no
    addi r, c, -55
    ret r
no: ret -1
}

func emit_gor() {
    call x, pdat, GH
