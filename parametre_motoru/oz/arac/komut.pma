    host puti, v
    host putc, 32
    call x, opfields, r
    ld sp, G, 20
    ld sl, G, 21
    call x, pstr, sp, sl
    host putc, 32
    ld np, G, 22
    ld nl, G, 23
    call x, pstr, np, nl
    host putc, 32
    ld nk, G, 24
    ld kp, G, 25
    jnz nk, g5a
    host putc, 45
    jmp g5c
g5a: mov k, 0
g5b: ge z, k, nk
    jnz z, g5c
    jz k, g5d
    host putc, 44
g5d: add a, kp, k
    add a, a, T
    ld kid, a, 0
    call c, kchar, kid
    host putc, c
    addi k, k, 1
    jmp g5b
g5c: ld q, G, 26
    call x, pext, q, f
    jmp g7
g6: eqi z, id, 3
    jnz z, g6h
    eqi z, id, 4
    jnz z, g6p
    eqi z, id, 8
    jnz z, g6t
    eqi z, id, 9
    jnz z, g6u
    jmp g6s
g6h: call x, pdat, W_HOST
    host putc, 32
    ld v, a, 1
    host puti, v
    host putc, 32
    ld nl, a, 3
    addi np, r, 4
    call x, pstr, np, nl
    host putc, 32
    ld v, a, 2
    host puti, v
    add q, np, nl
    call x, pext, q, f
    jmp g7
g6p: call x, pdat, W_PRIM
    host putc, 32
    ld v, a, 1
    host puti, v
    host putc, 32
    ld nl, a, 2
    addi np, r, 3
    call x, pstr, np, nl
    host putc, 32
    add q, np, nl
    add b, q, T
    ld nf, b, 0
    jnz nf, g6p1
    host putc, 45
    jmp g6p9
g6p1: mov k, 0
g6p2: ge z, k, nf
    jnz z, g6p9
    jz k, g6p3
    host putc, 44
g6p3: add b, q, k
    add b, b, T
    ld ft, b, 1
    call x, pftype, ft
    addi k, k, 1
    jmp g6p2
g6p9: add q, q, nf
    addi q, q, 1
    call x, pext, q, f
    jmp g7
g6t: call x, pdat, W_TOKEN
    host putc, 32
    ld v, a, 1
    host puti, v
    host putc, 32
    ld nl, a, 2
    addi np, r, 3
    call x, pstr, np, nl
    host putc, 32
    add q, np, nl
    add b, q, T
