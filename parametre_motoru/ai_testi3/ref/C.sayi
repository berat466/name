# Gorev C (Collatz) - yapisal tablo: 3000 ornekli sablon, ornek basina dongu, bildirimsel toplama
80 77 89 49
0 0 0 1                 # sahne yok; kare=1
5  z0 z0 z0 z0 z0       # globaller g0..g4
0                       # dizi yok
0 0                     # islev, davranis yok
1                       # 1 sablon
3000                    # adet
3                       # 3 alan
  2 z1 z1               # alan0 id  = 1 + 1*i      (sanal: hicbir yerde yazilmiyor)
  2 z1 z1               # alan1 x   = 1 + 1*i      (yaziliyor -> bellekte)
  1 z0                  # alan2 st  = 0            (yaziliyor)
# kural blogu (her ornek icin): surde (x != 1) { st = st + 1; eger x%2==0 {x = x/2} yoksa {x = 3x+1} }
1
  3  15 12 2 1 1 z1  2
    1 2 2  15 1 2 2 1 z1
    2  15 11 15 5 2 1 1 z2 1 z0
       1   1 2 1 15 4 2 1 1 z2
       1   1 2 1 15 1 15 3 2 1 1 z3 1 z1
0                       # cizim yok
0 0                     # etkilesim, girdi yok
5                       # 5 toplama: global op sablon deger kosul
  0 1 0  2 2   15 11 2 0 1 z27        # g0 = toplam st (id==27)
  2 3 0  2 2   1 z1                   # g2 = enbuyuk st
  1 4 0  2 0   15 11 2 2 3 2          # g1 = enkucuk id (st == g2)
  3 1 0  2 2   1 z1                   # g3 = toplam st
  4 2 0  1 z1  15 15 2 2 1 z100       # g4 = say (st > 100)
