0 11 57          # param=0 yazmac=11 komut=57
# --- baslangic ---
1 0 z0           # 0: ldi r0,0
1 1 z4000        # 1: ldi r1,4000
1 5 z0           # 2: ldi r5,0
1 6 z100000      # 3: ldi r6,100000 (min)
1 7 z-100000     # 4: ldi r7,-100000 (max)
1 8 z0           # 5: ldi r8,0
