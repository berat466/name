# Okuma histogrami. Yazmaclar: r0=i r1=4000 r2=v r3=gecici r4=kutu r5=toplam r6=min r7=max r8=ucun-kati-pozitif-toplam r9=k r10=host penceresi
80 77 66 49      # PMB1
0                # bayrak
16               # bellek 16 sozcuk
0                # giris fonksiyonu 0
0                # sabit yok
0                # veri yok
8                # bss 8 sozcuk (adres 1..8 = kutu sayaclari)
