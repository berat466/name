sablon okuma adet 4000
  alan v sabit 0
  alan t sabit 0
  alan u sabit 0
  alan b sabit 0
  alan p sabit 0
  alan m sabit 0
  kural t = i * i
  kural t = t * 7
  kural u = i * 13
  kural v = t + u
  kural v = v % 1009
  kural v = v - 500
  kural b = v + 500
  kural b = b / 127
  kural m = i % 3
  kural p = 0
  kural p = v eger m == 0 ve v > 0
son
topla g0 say okuma eger b == 0
